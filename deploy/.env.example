# Repositório: https://github.com/viziv-git/sga
# Servidor: 186.233.89.56 | DNS: sga.sgebr.net.br | Instalação: /var/sga

# Porta HTTP exposta no host — o Nginx do servidor (HTTPS) faz proxy para esta porta
SGA_HTTP_PORT=13080
SGA_PUBLIC_HOST=sga.sgebr.net.br

# --- MySQL (container mysql-aliesc no mesmo servidor) ---
#
# Opção A — via host (padrão; requer extra_hosts no compose):
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3312
#
# Opção A2 — se host.docker.internal falhar no Linux:
# MYSQL_HOST=172.17.0.1
# MYSQL_PORT=3312
#
# Opção B — mesma rede Docker do mysql-aliesc (recomendado se A falhar):
#   docker inspect mysql-aliesc --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
#   docker compose -f docker-compose.yml -f docker-compose.mysql.yml up -d
# MYSQL_DOCKER_NETWORK=nome_da_rede
# MYSQL_HOST=mysql-aliesc
# MYSQL_PORT=3306

MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sgealiesc_2023
# Confira o nome exato no mysql-aliesc:
#   docker exec mysql-aliesc mysql -uroot -p -e "SHOW DATABASES LIKE 'sgealiesc%gam%';"
MYSQL_GAM_DATABASE=sgealiesc_gam_2023

# Opção C: MySQL remoto
# MYSQL_HOST=186.233.90.131
# MYSQL_PORT=3306
# MYSQL_USER=rootexterno

# Autenticação JWT (obrigatório em produção — gere um segredo forte)
JWT_SECRET=altere-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Chave de acesso subdelegada à API Busca CEP dos Correios. Sem ela, usa ViaCEP.
CORREIOS_CEP_TOKEN=

# GAM legado
GAM_PASSWORD_ITERATIONS=10
# GX_ENCRYPT_KEY=

# AUTH_ALLOW_PLAIN=false
