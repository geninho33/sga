# Servidor: 186.233.89.56 | DNS: sga.sgebr.net.br | Instalação: /var/alimentacao-escolar

# Porta HTTP exposta no host — o Nginx do servidor (HTTPS) faz proxy para esta porta
SGA_HTTP_PORT=13080
SGA_PUBLIC_HOST=sga.sgebr.net.br

# --- MySQL ---
# Opção A: MySQL no MESMO servidor (container mysql-aliesc → porta 3312 no host)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3312
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sgealiesc_2023
MYSQL_GAM_DATABASE=sgealiesc_gam_2023

# Opção B: MySQL remoto (descomente e comente a opção A)
# MYSQL_HOST=186.233.90.131
# MYSQL_PORT=3306
# MYSQL_USER=rootexterno

# Autenticação JWT (obrigatório em produção — gere um segredo forte)
JWT_SECRET=altere-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# GAM legado
GAM_PASSWORD_ITERATIONS=10
# GX_ENCRYPT_KEY=

# AUTH_ALLOW_PLAIN=false
