    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
[web]
{
parm(in:&Mode, in:&prefCodigo, in:&alunCodigo, in:&mediAlunColeta);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
alunCodigo = &alunCodigo if not &alunCodigo.IsEmpty();
noaccept(alunCodigo) if not &alunCodigo.IsEmpty();
mediAlunColeta = &mediAlunColeta if not &mediAlunColeta.IsEmpty();
noaccept(mediAlunColeta) if not &mediAlunColeta.IsEmpty();

mediAlunAno.Visible = mediAlunAno<>0;
mediAlunAno_Cell.Class = !'Invisible' If not(mediAlunAno<>0);
mediAlunAno_Cell.Class = !'col-xs-12 DataContentCell' If mediAlunAno<>0;
prefCodigo = &ComboprefCodigo;
}

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */
mediAlunDataCadastro = serverNow() 
	on beforeInsert;

mediAlunDataAlteracao = serverNow() 
	on beforeUpdate, beforeInsert;

mediAlunColeta = PRCDGerarNovoCodigo('alunoMedidas')  	
	on BeforeInsert;

mediAlunUserName =  GAMUser.GetLogin()
	on BeforeInsert, beforeUpdate;	

mediAlunAno = mediAlunData.Year()
	on BeforeInsert, beforeUpdate;	
]]></Source>
