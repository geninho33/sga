    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&GAMSession = GAMSession.Get(&GAMErrors)
	Combo_perResLocCodigo.GAMOAuthToken = &GAMSession.Token
	perResLocCodigo.Visible = False
	&ComboperResLocCodigo.SetEmpty()
	&ComboperResLocCodigo.Visible = False
	Do 'LoadComboperResLocCodigo'
	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated perResLocCodigo
				Case &TrnContextAtt.AttributeName = !"perResLocCodigo"
					&Insert_perResLocCodigo.FromString(&TrnContextAtt.AttributeValue)
					If not &Insert_perResLocCodigo.IsEmpty()
						&ComboperResLocCodigo = &Insert_perResLocCodigo
						Combo_perResLocCodigo.SelectedValue_set = &ComboperResLocCodigo.ToString().Trim()
						&Combo_DataJson = trnsPerguntaRespostaLoadDVCombo(!'perResLocCodigo', !'GET', false, &prefCodigo, &perResCodigo, &Insert_prefCodigo, &TrnContextAtt.AttributeValue, &ComboSelectedValue, &ComboSelectedText)
						Combo_perResLocCodigo.SelectedText_set = &ComboSelectedText
						Combo_perResLocCodigo.Enabled = False
					EndIf
			Endcase
		Endfor
	Endif
	
	prefCodigo.Visible = False
	perResCodigo.Visible = False
	perResUserName.Visible = False
	perResDataCadastro.Visible = False
	perResDataAlteracao.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

    LoadWWPContext.Call(&WWPContext)
    &prefCodigo = &WWPContext.prefCodigo

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnsPerguntaRespostaWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_perResLocCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ComboperResLocCodigo.FromString(Combo_perResLocCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		perResData.Enabled = False
	EndIf
	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		Combo_perResLocCodigo.Enabled = False
	EndIf
	If Not SecGAMIsAuthByFunctionalityKey(!'True')
		perResAssunto.Enabled = False
	EndIf
	If Not SecGAMIsAuthByFunctionalityKey(!'True')
		perResPergunta.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboperResLocCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Combo_perResLocCodigo.DataListProcParametersPrefix = format(!' "ComboName": "perResLocCodigo", "TrnMode": "INS", "IsDynamicCall": true, "prefCodigo": 0, "perResCodigo": 0, "Cond_prefCodigo": "#%1#"', prefCodigo.InternalName)
	&Combo_DataJson = trnsPerguntaRespostaLoadDVCombo(!'perResLocCodigo', &Mode, false, &prefCodigo, &perResCodigo, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_perResLocCodigo.SelectedValue_set = &ComboSelectedValue
	Combo_perResLocCodigo.SelectedText_set = &ComboSelectedText
	&ComboperResLocCodigo.FromString(&ComboSelectedValue)
	If &Mode = TrnMode.Display OR &Mode = TrnMode.Delete
		Combo_perResLocCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
