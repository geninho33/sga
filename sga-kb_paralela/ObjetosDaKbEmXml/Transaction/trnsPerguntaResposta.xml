    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&perResCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
perResCodigo = &perResCodigo if not &perResCodigo.IsEmpty();
noaccept(perResCodigo) if not &perResCodigo.IsEmpty();

perResLocCodigo = &Insert_perResLocCodigo if &Mode = TrnMode.Insert and not &Insert_perResLocCodigo.IsEmpty();
noaccept(perResLocCodigo) if &Mode = TrnMode.Insert and not &Insert_perResLocCodigo.IsEmpty();
perResLocCodigo = &ComboperResLocCodigo;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

perResDataCadastro = serverNow() 
	on beforeInsert;

perResDataAlteracao = serverNow() 
	on beforeInsert, beforeUpdate;

perResUserName = &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
	on beforeInsert, beforeUpdate;

perResCodigo = PRCDGerarNovoCodigo('PerguntaResposta') 
	on beforeInsert;

]]></Source>
