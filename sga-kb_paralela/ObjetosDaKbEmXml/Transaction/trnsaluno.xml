AtendimentoCodigo = &AtendimentoCodigo if not &AtendimentoCodigo.IsEmpty();
noaccept(AtendimentoCodigo) if not &AtendimentoCodigo.IsEmpty();
alunCodigo = &alunCodigo if not &alunCodigo.IsEmpty();
noaccept(alunCodigo) if not &alunCodigo.IsEmpty();

}

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


alunDataCadastro = serverNow() 
	on beforeInsert;

alunDataAlteracao = serverNow() 
	on beforeUpdate, beforeInsert;

alunCodigo = PRCDGerarNovoCodigo('aluno')  	
	on BeforeInsert;

alunUserName =  GAMUser.GetLogin()
	on BeforeInsert, beforeUpdate;	

alunStatus = '1'
	on BeforeInsert;
]]></Source>
