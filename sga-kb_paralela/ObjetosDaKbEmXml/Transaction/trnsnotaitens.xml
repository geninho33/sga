    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
[web]
{
parm(in:&Mode, in:&prefCodigo, in:&notaCodigo, in:&notaItemProduto);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
notaCodigo = &notaCodigo if not &notaCodigo.IsEmpty();
noaccept(notaCodigo) if not &notaCodigo.IsEmpty();
notaItemProduto = &notaItemProduto if not &notaItemProduto.IsEmpty();
noaccept(notaItemProduto) if not &notaItemProduto.IsEmpty();

BtnTrn_Enter.Visible = True If (&Mode = 'INS');
BtnTrn_Enter.Visible = False If Not (&Mode = 'INS');
notaItemProduto = &CombonotaItemProduto;
}

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

// Salvando a quantidade anterior
// notaItemQtdeAntes = notaItemQtde
//	on BeforeUpdate, BeforeDelete;

PRCDEstoqueMovimentacao( notaCodigo,notaItemProduto,0,notaItemQtde,'C','N',notaItemQtdeAntes)	
	if not PRCDTemRomaneio( prefCodigo,notaCodigo) on afterinsert, afterUpdate;


PRCDEstoqueMovimentacao( notaCodigo,notaItemProduto,0,notaItemQtde,'C','I',notaItemQtdeAntes)	
	if not PRCDTemRomaneio( prefCodigo,notaCodigo) on beforeDelete;


//PRCDEstoqueMovimentacaoCompra(notaCodigo,notaItemProduto,0,notaItemQtde,'C','N',notaItemProdutoUnidade) 
//	On AfterInsert, afterUpdate;

//PRCDEstoqueMovimentacaoCompra(notaCodigo,notaItemProduto,0,notaItemQtde,'CC','N',notaItemProdutoUnidade) 
//on beforeDelete, beforeUpdate;

Error('Informe a Quantidade !') 
	If notaItemQtde=0;

Error('Informe o Valor !') 
	If notaItemValor=0;

Error('Informe o Produto !') 
	If notaItemProduto = 0;
]]></Source>
