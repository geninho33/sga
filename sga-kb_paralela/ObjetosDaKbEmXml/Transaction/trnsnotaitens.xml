    <Source><![CDATA[
Event Start

    if &prefCodigo = 0
	    LoadWWPContext.Call(&WWPContext)
	    &prefCodigo = &WWPContext.prefCodigo
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	[web]
	{
	notaItemProduto.Visible = False
	&CombonotaItemProduto.SetEmpty()
	&CombonotaItemProduto.Visible = False
	Do 'LoadCombonotaItemProduto'
	}
	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	
    [web]
    {
	prefCodigo.Visible = False
	notaCodigo.Visible = False
	notaItemProdutoDescricao.Visible = False
	}

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	&WWPContext.notaLocal = &notaLocal
	SetWWPContext.Call(&WWPContext)

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

   [web]
   {
	
	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnsnotaitensWW.Call(prefCodigo, notaCodigo)
	Endif

	Return
   }

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

[web]
{
	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		notaItemProdutoUnidade.Enabled = False
	EndIf
	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		notaItemProdutoSaldo.Enabled = False
	EndIf
	
}

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

[web]
{

Event Combo_notaItemProduto.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&CombonotaItemProduto.FromString(Combo_notaItemProduto.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadCombonotaItemProduto'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&notaItemProduto_Data = trnsnotaitensLoadDVCombo(!'notaItemProduto', &Mode, &prefCodigo, &notaCodigo, &notaItemProduto, &ComboSelectedValue)
	Combo_notaItemProduto.SelectedValue_set = &ComboSelectedValue
	&CombonotaItemProduto.FromString(&ComboSelectedValue)
	If &Mode <> TrnMode.Insert Or Not &notaItemProduto.IsEmpty()
		Combo_notaItemProduto.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

}


]]></Source>
