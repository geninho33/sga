  <Part type="9b0a32a3-de6d-4be1-a4dd-1b85d3741534">
    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&notaCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
notaCodigo = &notaCodigo if not &notaCodigo.IsEmpty();
noaccept(notaCodigo) if not &notaCodigo.IsEmpty();

notaFornecedor = &Insert_notaFornecedor if &Mode = TrnMode.Insert and not &Insert_notaFornecedor.IsEmpty();
noaccept(notaFornecedor) if &Mode = TrnMode.Insert and not &Insert_notaFornecedor.IsEmpty();
notaCodigo.Visible = notaCodigo<>0;
notaCodigo_Cell.Class = !'Invisible' If not(notaCodigo<>0);
notaCodigo_Cell.Class = !'col-xs-12 DataContentCell' If notaCodigo<>0;
notaFornecedor = &CombonotaFornecedor;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

notaDataCadastro = serverNow() 
	on beforeInsert;

notaDataAlteracao = serverNow() 
	on beforeUpdate;

notaUserName =  &WWPContext.UserName
	on beforeUpdate;

Error('Informe o número da nota !') 
	If notaNumero.IsEmpty();

Error('Informe o Fornecedor !') 
	If notaFornecedor = 0;

Error('Informe o Local de Destino!') 
	If notaLocal = 0;

Error('Informe a Data !') 
	If notaData.IsEmpty();

Error('Informe a Série da Nota !') 
	If notaSerie.IsEmpty();

notaCodigo = PRCDGerarNovoCodigo('Nota') 
	on BeforeInsert;
]]></Source>
