  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
    &prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	notaFornecedor.Visible = False
	&CombonotaFornecedor.SetEmpty()
	&CombonotaFornecedor.Visible = False
	Do 'LoadCombonotaFornecedor'
	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated notaFornecedor
				Case &TrnContextAtt.AttributeName = !"notaFornecedor"
					&Insert_notaFornecedor.FromString(&TrnContextAtt.AttributeValue)
					If not &Insert_notaFornecedor.IsEmpty()
						&CombonotaFornecedor = &Insert_notaFornecedor
						Combo_notaFornecedor.SelectedValue_set = &CombonotaFornecedor.ToString().Trim()
						Combo_notaFornecedor.Enabled = False
					EndIf
			Endcase
		Endfor
	Endif
	
	prefCodigo.Visible = False
	notaUserName.Visible = False
	notaDataCadastro.Visible = False
	notaDataAlteracao.Visible = False
	notaStatus.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	If (&Mode = TrnMode.Insert) 		
		trnsnotaitensWW(&prefCodigo,notaCodigo)		
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnsnotaWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_notaFornecedor.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&CombonotaFornecedor.FromString(Combo_notaFornecedor.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	notaCodigo.Visible = False
	notaCodigo_Cell.Class = !'Invisible'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadCombonotaFornecedor'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&notaFornecedor_Data = trnsnotaLoadDVCombo(!'notaFornecedor', &Mode, &prefCodigo, &notaCodigo, &ComboSelectedValue)
	Combo_notaFornecedor.SelectedValue_set = &ComboSelectedValue
	&CombonotaFornecedor.FromString(&ComboSelectedValue)
	If &Mode = TrnMode.Display OR &Mode = TrnMode.Delete
		Combo_notaFornecedor.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
