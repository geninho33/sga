psCodigo_Cell.Class = !'col-xs-12 DataContentCell' If psCodigo<>0;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

PRCDGerarNovoCodigo('estoqueUE');
	
psCodigo = PRCDGerarNovoCodigo('preferencias') 
	on beforeInsert;	
