noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
uniConvUnidadeOrigem = &uniConvUnidadeOrigem if not &uniConvUnidadeOrigem.IsEmpty();
noaccept(uniConvUnidadeOrigem) if not &uniConvUnidadeOrigem.IsEmpty();
uniConvUnidadeDestino = &uniConvUnidadeDestino if not &uniConvUnidadeDestino.IsEmpty();
noaccept(uniConvUnidadeDestino) if not &uniConvUnidadeDestino.IsEmpty();

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

uniConvDataCad = serverNow() 
	on beforeInsert;

uniConvDataAlt = serverNow() 
	on beforeUpdate;

Error('Essa unidade já tem conversão !') 
	If PRCDTemConversaoUnidade(&prefCodigo,uniConvUnidadeOrigem) on beforeInsert ;


