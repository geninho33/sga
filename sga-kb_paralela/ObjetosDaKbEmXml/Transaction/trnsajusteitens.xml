  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	[web]
	{
	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&GAMSession = GAMSession.Get(&GAMErrors)
	Combo_ajusItemProduto.GAMOAuthToken = &GAMSession.Token
	ajusItemProduto.Visible = False
	&ComboajusItemProduto.SetEmpty()
	&ComboajusItemProduto.Visible = False
	Combo_prefCodigo.GAMOAuthToken = &GAMSession.Token
	prefCodigo.Visible = False
	&ComboprefCodigo.SetEmpty()
	&ComboprefCodigo.Visible = False
	Do 'LoadComboprefCodigo'
	Do 'LoadComboajusItemProduto'
	}
	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

   [web]
   {
	
	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnsajusteitensWW.Call(prefCodigo, ajusCodigo)
	Endif

	Return
   }

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

[web]
{

Event Combo_ajusItemProduto.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ComboajusItemProduto.FromString(Combo_ajusItemProduto.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_prefCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Cond_prefCodigo = prefCodigo
	&ComboprefCodigo.FromString(Combo_prefCodigo.SelectedValue_get)
	If &Cond_prefCodigo <> &ComboprefCodigo
		&ComboajusItemProduto.SetEmpty()
		Combo_ajusItemProduto.SelectedValue_set = ''
		Combo_ajusItemProduto.SelectedText_set = ''
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadComboajusItemProduto'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Combo_ajusItemProduto.DataListProcParametersPrefix = format(!' "ComboName": "ajusItemProduto", "TrnMode": "INS", "IsDynamicCall": true, "prefCodigo": 0, "ajusCodigo": 0, "ajusItemProduto": 0, "Cond_prefCodigo": "#%1#"', prefCodigo.InternalName)
	&Combo_DataJson = trnsajusteitensLoadDVCombo(!'ajusItemProduto', &Mode, false, &prefCodigo, &ajusCodigo, &ajusItemProduto, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_ajusItemProduto.SelectedValue_set = &ComboSelectedValue
	Combo_ajusItemProduto.SelectedText_set = &ComboSelectedText
	&ComboajusItemProduto.FromString(&ComboSelectedValue)
	If &Mode <> TrnMode.Insert Or Not &ajusItemProduto.IsEmpty()
		Combo_ajusItemProduto.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboprefCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Combo_DataJson = trnsajusteitensLoadDVCombo(!'prefCodigo', &Mode, false, &prefCodigo, &ajusCodigo, &ajusItemProduto, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_prefCodigo.SelectedValue_set = &ComboSelectedValue
	Combo_prefCodigo.SelectedText_set = &ComboSelectedText
	&ComboprefCodigo.FromString(&ComboSelectedValue)
	If &Mode <> TrnMode.Insert Or Not &prefCodigo.IsEmpty()
		Combo_prefCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

}


