    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
[web]
{
parm(in:&Mode, in:&prefCodigo, in:&ajusCodigo, in:&ajusItemProduto);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
ajusCodigo = &ajusCodigo if not &ajusCodigo.IsEmpty();
noaccept(ajusCodigo) if not &ajusCodigo.IsEmpty();
ajusItemProduto = &ajusItemProduto if not &ajusItemProduto.IsEmpty();
noaccept(ajusItemProduto) if not &ajusItemProduto.IsEmpty();

prefCodigo = &ComboprefCodigo;
ajusItemProduto = &ComboajusItemProduto;
}

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Error('Informe a quantidade do produto!') 
	If ajusItemQuantidade = 0;

Error('Informe a Unidade !') 
	If ajusItemUN = 0;

//  ajusItemQuantidadeAntes = ajusItemQuantidade
//	on BeforeUpdate, BeforeDelete;
	
PRCDEstoqueMovimentacao(ajusCodigo,ajusItemProduto,ajusItemLocal,ajusItemQuantidade,ajusItemTipo,'I',ajusItemQuantidadeAntes) 
	On AfterInsert, afterUpdate;

PRCDEstoqueMovimentacao(ajusCodigo,ajusItemProduto,ajusItemLocal,ajusItemQuantidade,ajusItemTipo,'N',ajusItemQuantidadeAntes) 
	On beforeDelete;

/*
PRCDEstoqueMovimentacao(ajusCodigo,ajusItemProduto,ajusItemLocal,ajusItemQuantidade,ajusItemTipo,'N') 
	On AfterInsert, afterUpdate;

PRCDEstoqueMovimentacao(ajusCodigo,ajusItemProduto,ajusItemLocal,ajusItemQuantidade,ajusItemTipo,'I') 
on beforeDelete, beforeUpdate;
*/
]]></Source>
