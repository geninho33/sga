    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&lanestcodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
lanestcodigo = &lanestcodigo if not &lanestcodigo.IsEmpty();
noaccept(lanestcodigo) if not &lanestcodigo.IsEmpty();

lanestcodigo.Visible = lanestcodigo<>0;
lanestcodigo_Cell.Class = !'Invisible' If not(lanestcodigo<>0);
lanestcodigo_Cell.Class = !'col-xs-12 DataContentCell' If lanestcodigo<>0;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

Error('Informe a data Inicial !') 
	If  lanestdatInicial.IsEmpty();

Error('Informe a data Final !') 
	If  lanestdatFinal.IsEmpty();

Error('A data Inicial não pode ser maior que a Final !') 	
	If  lanestdatFinal < lanestdatInicial;

/* 
Error('Data Inicial não pode ser menor que a data atual !')
	If  lanestdatInicial<serverDate(); 
*/

lanestCadastro = serverNow() 
	on beforeInsert;

lanestAlteracao = serverNow() 	
	on beforeUpdate;

lanestcodigo = PRCDGerarNovoCodigo('Lancar Estoque')  
	on BeforeInsert;
	
lanestUsername =  &WWPContext.UserName
	on BeforeInsert, beforeUpdate;
]]></Source>
