    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	[web]
	{
	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&GAMSession = GAMSession.Get(&GAMErrors)
	Combo_distItemProduto.GAMOAuthToken = &GAMSession.Token
	distItemProduto.Visible = False
	&CombodistItemProduto.SetEmpty()
	&CombodistItemProduto.Visible = False
	Combo_prefCodigo.GAMOAuthToken = &GAMSession.Token
	prefCodigo.Visible = False
	&ComboprefCodigo.SetEmpty()
	&ComboprefCodigo.Visible = False
	Do 'LoadComboprefCodigo'
	Do 'LoadCombodistItemProduto'
	}
	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

   [web]
   {
	
	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnsdistribuicaoitensWW.Call(prefCodigo, distCodigo)
	Endif

	Return
   }

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

[web]
{

Event Combo_distItemProduto.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&CombodistItemProduto.FromString(Combo_distItemProduto.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_prefCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Cond_prefCodigo = prefCodigo
	&ComboprefCodigo.FromString(Combo_prefCodigo.SelectedValue_get)
	If &Cond_prefCodigo <> &ComboprefCodigo
		&CombodistItemProduto.SetEmpty()
		Combo_distItemProduto.SelectedValue_set = ''
		Combo_distItemProduto.SelectedText_set = ''
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadCombodistItemProduto'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Combo_distItemProduto.DataListProcParametersPrefix = format(!' "ComboName": "distItemProduto", "TrnMode": "INS", "IsDynamicCall": true, "distCodigo": 0, "prefCodigo": 0, "distItemProduto": 0, "Cond_prefCodigo": "#%1#"', prefCodigo.InternalName)
	&Combo_DataJson = trnsdistribuicaoitensLoadDVCombo(!'distItemProduto', &Mode, false, &distCodigo, &prefCodigo, &distItemProduto, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_distItemProduto.SelectedValue_set = &ComboSelectedValue
	Combo_distItemProduto.SelectedText_set = &ComboSelectedText
	&CombodistItemProduto.FromString(&ComboSelectedValue)
	If &Mode <> TrnMode.Insert Or Not &distItemProduto.IsEmpty()
		Combo_distItemProduto.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboprefCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Combo_DataJson = trnsdistribuicaoitensLoadDVCombo(!'prefCodigo', &Mode, false, &distCodigo, &prefCodigo, &distItemProduto, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_prefCodigo.SelectedValue_set = &ComboSelectedValue
	Combo_prefCodigo.SelectedText_set = &ComboSelectedText
	&ComboprefCodigo.FromString(&ComboSelectedValue)
	If &Mode <> TrnMode.Insert Or Not &prefCodigo.IsEmpty()
		Combo_prefCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

}


