    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
[web]
{
parm(in:&Mode, in:&distCodigo, in:&prefCodigo, in:&distItemProduto);

distCodigo = &distCodigo if not &distCodigo.IsEmpty();
noaccept(distCodigo) if not &distCodigo.IsEmpty();
prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
distItemProduto = &distItemProduto if not &distItemProduto.IsEmpty();
noaccept(distItemProduto) if not &distItemProduto.IsEmpty();

prefCodigo = &ComboprefCodigo;
distItemProduto = &CombodistItemProduto;
}

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

Error('Informe a quantidade do produto!') 
	If distItemQuantidade <= 0;

Error('Informe a Unidade!') 
	If distItemProdutoUN = 0;

/*
Error('Quantidade informada maior que saldo disponível!')
	if distItemQuantidade > 0 and not PRCDTemSaldoEmEstoque(prefCodigo,distItemProduto,distItemQuantidade);
*/

// Processando o insert
distiItemSaldoAntes = PRCDBuscarSaldoProdutoUE(prefCodigo,distItemProduto,distItemLocCodigo) 
	on BeforeInsert, BeforeUpdate;

distiItemSaldoDepois = distItemQuantidade + PRCDBuscarSaldoProdutoUE(prefCodigo,distItemProduto,distItemLocCodigo) 
	on BeforeInsert, afterUpdate;

// Salvando a quantidade anterior
// distItemQtdeAntes = distItemQuantidade
//	on BeforeUpdate, BeforeDelete;

// Processando o update
// distiItemSaldoDepois = distItemQuantidade - PRCDBuscarSaldoProdutoUE(prefCodigo,distItemProduto,distItemLocCodigo) 
// on BeforeUpdate;

PRCDEstoqueMovimentacao( distCodigo,distItemProduto,0,distItemQuantidade,'D','N', distItemQtdeAntes)
	on afterinsert, afterUpdate;

PRCDEstoqueMovimentacao( distCodigo,distItemProduto,0,distItemQuantidade,'D','I',distItemQtdeAntes)
	on beforeDelete;

// PRCDEstoqueMovimentacao( distCodigo,distItemProduto,distItemLocCodigo, distItemQuantidade,'DD','N')
//	on beforeDelete, beforeUpdate;
]]></Source>
