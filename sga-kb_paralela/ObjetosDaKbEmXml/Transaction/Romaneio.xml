  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	Combo_prodCodigo.TitleControlIdToReplace = prodCodigo.InternalName
	prodCodigo.HorizontalAlignment = !'Left'
	forCodigo.Visible = False
	&ComboforCodigo.SetEmpty()
	&ComboforCodigo.Visible = False
	Do 'LoadComboforCodigo'
	Do 'LoadComboprodCodigo'
	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated forCodigo
				Case &TrnContextAtt.AttributeName = !"forCodigo"
					&Insert_forCodigo.FromString(&TrnContextAtt.AttributeValue)
					If not &Insert_forCodigo.IsEmpty()
						&ComboforCodigo = &Insert_forCodigo
						Combo_forCodigo.SelectedValue_set = &ComboforCodigo.ToString().Trim()
						Combo_forCodigo.Enabled = False
					EndIf
				// When inserting with instantiated notaCodigo
				Case &TrnContextAtt.AttributeName = !"notaCodigo"
					&Insert_notaCodigo.FromString(&TrnContextAtt.AttributeValue)
			Endcase
		Endfor
	Endif
	
	prefCodigo.Visible = False
	notaCodigo.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		RomaneioWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_forCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ComboforCodigo.FromString(Combo_forCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If Not SecGAMIsAuthByFunctionalityKey(!'romanLocal_Edit_Attribute')
		romanLocal.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboprodCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&prodCodigo_Data = RomaneioLoadDVCombo(!'prodCodigo', &Mode, &prefCodigo, &romanCodigo, &ComboSelectedValue)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboforCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&forCodigo_Data = RomaneioLoadDVCombo(!'forCodigo', &Mode, &prefCodigo, &romanCodigo, &ComboSelectedValue)
	Combo_forCodigo.SelectedValue_set = &ComboSelectedValue
	&ComboforCodigo.FromString(&ComboSelectedValue)
	If &Mode = TrnMode.Display OR &Mode = TrnMode.Delete
		Combo_forCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
