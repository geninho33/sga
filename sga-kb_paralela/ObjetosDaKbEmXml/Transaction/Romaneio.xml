    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&romanCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
romanCodigo = &romanCodigo if not &romanCodigo.IsEmpty();
noaccept(romanCodigo) if not &romanCodigo.IsEmpty();

forCodigo = &Insert_forCodigo if &Mode = TrnMode.Insert and not &Insert_forCodigo.IsEmpty();
noaccept(forCodigo) if &Mode = TrnMode.Insert and not &Insert_forCodigo.IsEmpty();
notaCodigo = &Insert_notaCodigo if &Mode = TrnMode.Insert and not &Insert_notaCodigo.IsEmpty();
noaccept(notaCodigo) if &Mode = TrnMode.Insert and not &Insert_notaCodigo.IsEmpty();
forCodigo = &ComboforCodigo;
Error(Format('WWP_RequiredAttribute','Quantidade')) if romanItemQuantidade.IsEmpty();
Error(Format('WWP_RequiredAttribute','Data')) if romanData.IsEmpty();
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

default(romanLocal,1);
default(romanData,today());
default(romanDataCadastro,now());

romanCodigo = PRCDGerarNovoCodigo('romaneio') 
	on BeforeInsert;

romanDataAlteracao = now() 
	on BeforeUpdate;

romanUserName = GAMUser.GetEmail()  
	on BeforeUpdate;

noaccept(notaCodigo) 
	if not notaCodigo.IsEmpty();

noaccept(romanItemQuantidade) 
	if not notaCodigo.IsEmpty();


// Salvando a quantidade anterior
// romanItemQuantidadeAntes = romanItemQuantidade
//	On BeforeUpdate, BeforeDelete
//	level romanItemQuantidade;	

error('Romaneio com nota vinculada não pode ser eliminado.') 
	if not notaCodigo.IsEmpty()
	on BeforeDelete
	Level romanData;

error('Romaneio com nota vinculada não permite eliminar itens.') 
	if not notaCodigo.IsEmpty()
	on BeforeDelete
	Level romanItemQuantidade;
	
PRCDEstoqueMovimentacao(romanCodigo,prodCodigo,romanLocal,romanItemQuantidade,'R','N',romanItemQuantidadeAntes) 
	if notaCodigo.IsEmpty()
	On AfterInsert, AfterUpdate 
	level romanItemQuantidade;

PRCDEstoqueMovimentacao(romanCodigo,prodCodigo,romanLocal,romanItemQuantidade,'R','I',romanItemQuantidadeAntes) 
	if notaCodigo.IsEmpty()
	on BeforeDelete
	level romanItemQuantidade;
/*
PRCDEstoqueMovimentacao(romanCodigo,prodCodigo,romanLocal,romanItemQuantidade,'R','N') 
	if notaCodigo.IsEmpty()
	On AfterInsert, AfterUpdate 
	level romanItemQuantidade;

PRCDEstoqueMovimentacao(romanCodigo,prodCodigo,romanLocal,romanItemQuantidade,'RR','N') 
	if notaCodigo.IsEmpty()
	on BeforeDelete, BeforeUpdate 
	level romanItemQuantidade;
*/
]]></Source>
