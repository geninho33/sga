    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&locCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
locCodigo = &locCodigo if not &locCodigo.IsEmpty();
noaccept(locCodigo) if not &locCodigo.IsEmpty();

locCodigo.Visible = locCodigo<>0;
locCodigo_Cell.Class = !'Invisible' If not(locCodigo<>0);
locCodigo_Cell.Class = !'col-xs-12 col-sm-6 DataContentCell' If locCodigo<>0;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

locDataCad = serverNow() 
	on beforeInsert;

locDataAlt = serverNow() 
	on beforeUpdate;

locCodigo = PRCDGerarNovoCodigo('local')  
	on BeforeInsert;
]]></Source>
