  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext) 
    &prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	
	prefCodigo.Visible = False
	locInep.Visible = False
	locArea.Visible = False
	locUnidadeCentral.Visible = False
	locSecretaria.Visible = False
	locNotaSequencia.Visible = False
	locAbreviatura.Visible = False
	locDataCad.Visible = False
	locDataAlt.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnslocalWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnSGE'

	PRCRetornaMunCod.Call(&WWPContext.prefCodigo, &MunCod)
	//PRCRetornaUeCod.Call(&WWPContext.prefCodigo, locCodigo, &UeCod)
	if not &MunCod.IsEmpty() and not locUeCod.IsEmpty()
		&location = getLocation("wsUE")
		&Host    = 'www.sgebr.com.br'
		&BaseURL = '/sge' + str(&MunCod, 4, 0) + '/sgenovo/'	
		&location.Host    = &Host  // don't include protocol (i.e. HTTP/HTTPS)
		&location.BaseUrl = &BaseURL
		&wsUE.Execute(&MunCod, locUeCod, locDescricao, &UECodInep, &TipUECod, &UeTel, locEndereco, locComplemento, locBairro, &Cep, &UeSig, locEmail, &Ret)
		
		if &Ret = 1
			msg('WebService executado com sucesso')
		else
			msg('Unidade Escolar inexistente')
		endif
	else
		msg('Cadastro da Prefeitura e/ou da Escola não tem código do SGE informado')
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	locCodigo.Visible = False
	locCodigo_Cell.Class = !'Invisible'
	If Not SecGAMIsAuthByFunctionalityKey(!'True')
		locCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
