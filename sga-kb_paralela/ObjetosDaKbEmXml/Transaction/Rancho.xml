	LoadWWPContext.Call(&WWPContext)

	[web]
	{
	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&GAMSession = GAMSession.Get(&GAMErrors)
	Combo_prodCodigo.GAMOAuthToken = &GAMSession.Token
	Combo_prodCodigo.TitleControlIdToReplace = prodCodigo.InternalName
	prodCodigo.HorizontalAlignment = !'Left'
	Combo_locCodigo.GAMOAuthToken = &GAMSession.Token
	Combo_locCodigo.TitleControlIdToReplace = locCodigo.InternalName
	locCodigo.HorizontalAlignment = !'Left'
	Combo_prefCodigo.GAMOAuthToken = &GAMSession.Token
	prefCodigo.Visible = False
	&ComboprefCodigo.SetEmpty()
	&ComboprefCodigo.Visible = False
	Do 'LoadComboprefCodigo'
	Do 'LoadCombolocCodigo'
	Do 'LoadComboprodCodigo'
	}
	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

   [web]
   {
	
	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		RanchoWW.Call()
	Endif

	Return
   }

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

[web]
{

Event Combo_prefCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Cond_prefCodigo = prefCodigo
	&ComboprefCodigo.FromString(Combo_prefCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadComboprodCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Combo_prodCodigo.DataListProcParametersPrefix = format(!' "ComboName": "prodCodigo", "TrnMode": "INS", "IsDynamicCall": true, "prefCodigo": 0, "RanchoAno": 0, "RanchoMes": 0, "Cond_prefCodigo": "#%1#"', prefCodigo.InternalName)

