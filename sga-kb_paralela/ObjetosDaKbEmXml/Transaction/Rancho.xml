	Combo_locCodigo.DataListProcParametersPrefix = format(!' "ComboName": "locCodigo", "TrnMode": "INS", "IsDynamicCall": true, "prefCodigo": 0, "RanchoAno": 0, "RanchoMes": 0')

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboprefCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Combo_DataJson = RanchoLoadDVCombo(!'prefCodigo', &Mode, false, &prefCodigo, &RanchoAno, &RanchoMes, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
