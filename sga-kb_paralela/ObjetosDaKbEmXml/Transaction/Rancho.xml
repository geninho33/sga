    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
[web]
{
parm(in:&Mode, in:&prefCodigo, in:&RanchoAno, in:&RanchoMes);

NoAccept(RanchoIncluido);
NoAccept(RanchoAlterado);
prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
RanchoAno = &RanchoAno if not &RanchoAno.IsEmpty();
noaccept(RanchoAno) if not &RanchoAno.IsEmpty();
RanchoMes = &RanchoMes if not &RanchoMes.IsEmpty();
noaccept(RanchoMes) if not &RanchoMes.IsEmpty();

prefCodigo = &ComboprefCodigo;
}

Error(Format('WWP_RequiredAttribute','Código')) if prodCodigo.IsEmpty();
Error(Format('WWP_RequiredAttribute','Unidade')) if locCodigo.IsEmpty();
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

Default(RanchoDataEnvio,Today());
Default(RanchoIncluido,ServerNow());
Default(RanchoStatus,Status.Ativo);

RanchoAlterado = ServerNow() 
	on BeforeUpdate;

]]></Source>
