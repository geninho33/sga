    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&pratoCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
pratoCodigo = &pratoCodigo if not &pratoCodigo.IsEmpty();
noaccept(pratoCodigo) if not &pratoCodigo.IsEmpty();

pratoCodigo.Visible = pratoCodigo<>0;
pratoCodigo_Cell.Class = !'Invisible' If not(pratoCodigo<>0);
pratoCodigo_Cell.Class = !'col-xs-12 DataContentCell' If pratoCodigo<>0;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

pratoDataCad = serverNow() 
	on beforeInsert;

pratoDataAlt = serverNow() 
	on beforeUpdate;

pratoCodigo = PRCDGerarNovoCodigo('prato')  
	on BeforeInsert 
	level pratoDscricao, pratoDataCad, pratoTipoRefeicao;


&AdmLogCha = pratoCodigo.ToFormattedString()
 on AfterInsert, AfterUpdate, AfterDelete;
&AdmLogDad = pratoDscricao.Trim() + '-' + pratoComFreezer + '-' + pratoForno + '-' + pratoRepeticao + '-' + pratoCozinhaCentral + '-' + pratoStatus
 on AfterInsert, AfterUpdate, AfterDelete;
PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, &Mode, &AdmLogDad)
 on AfterInsert, AfterUpdate, AfterDelete;
]]></Source>
