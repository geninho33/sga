  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&UnidPeso  = PRCDBuscarUnidade(&prodCodigo,'P')
	&UnidSaldo = PRCDBuscarUnidade(&prodCodigo,'D')

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	
	prodFracaoConsumo.Visible = False
	prodTipoIndice.Visible = False
	prodIndice.Visible = False
	prodPesoUnidade.Visible = False
	prodPrograma.Visible = False
	prodPrograma_exclusivo.Visible = False
	prodLoteCompra.Visible = False
	prodTipoRemessa.Visible = False
	prodTiipoCompra.Visible = False
	prodZonaUrbana.Visible = False
	prodZonaRural.Visible = False
	prodDataCad.Visible = False
	prodDataAlt.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

&AdmLogCha = prefCodigo.ToFormattedString() + ' -' + prodCodigo.ToFormattedString() 
&AdmLogDad = prodDescricao + ' | Peso Compra: ' + prodPesoCompra.ToFormattedString() 					              
			              + ' | valor Peso Compra : ' + prodUnidMedCompra.ToFormattedString()
						  + ' | Sigla Peso Compra: ' + prodObsCompra
			              + ' | Peso Consumo: ' + prodPesoConsumo.ToFormattedString()
						  + ' | valor Peso Consumo : ' + prodUnidMedConsumo.ToFormattedString()
						  + ' | Sigla Peso Cosumo: ' + prodObsConsumo
If ( &Mode = TrnMode.Insert )						  
	PRC_AliEscGravaLog(&AdmLogCha ,&Pgmname,'INS', &AdmLogDad )
endif

If ( &Mode = TrnMode.Update )						  
	PRC_AliEscGravaLog(&AdmLogCha ,&Pgmname,'UPD', &AdmLogDad )
endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnsprodutosWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAplicarTaco'

	PRCDAplicarTabelaTaco(prodTaco, prodCaloria,prodCarboidrato,prodGorduraTrans,prodGorduraSaturada,prodProteina,
	prodSal,prodPotassio,prodCalcio,prodFerro,prodVitaminaA,prodNpcal,prodNdpcal,prodLipidio,prodFibra,prodVitaminaC,
	prodMagnesio,prodZinco,prodAcucar)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	prodCodigo.Visible = False
	prodCodigo_Cell.Class = !'Invisible'
	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		prodSaldo.Enabled = False
	EndIf
	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		prodLocalCodigo.Enabled = False
	EndIf
	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		prodLocalSaldo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
