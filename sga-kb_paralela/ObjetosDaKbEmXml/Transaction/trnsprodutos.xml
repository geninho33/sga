    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&prodCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
prodCodigo = &prodCodigo if not &prodCodigo.IsEmpty();
noaccept(prodCodigo) if not &prodCodigo.IsEmpty();

BtnbtnAplicarTaco.Visible = True If (&Mode = TrnMode.Insert);
BtnbtnAplicarTaco.Visible = False If not (&Mode = TrnMode.Insert);
prodCodigo.Visible = prodCodigo<>0;
prodCodigo_Cell.Class = !'Invisible' If not(prodCodigo<>0);
prodCodigo_Cell.Class = !'col-xs-12 DataContentCell' If prodCodigo<>0;
Error(Format('WWP_RequiredAttribute','Descrição')) if prodDescricao.IsEmpty();
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

prodDataCad = serverNow() 
	on beforeInsert;

prodDataAlt = serverNow() 
	on beforeUpdate;

prodCodigo = PRCDGerarNovoCodigo('produto')  
	on BeforeInsert;
]]></Source>
