  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	 LoadWWPContext.Call(&WWPContext)
     &prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated forCodigo
				Case &TrnContextAtt.AttributeName = !"forCodigo"
					&Insert_forCodigo.FromString(&TrnContextAtt.AttributeValue)
				// When inserting with instantiated prodCodigo
				Case &TrnContextAtt.AttributeName = !"prodCodigo"
					&Insert_prodCodigo.FromString(&TrnContextAtt.AttributeValue)
			Endcase
		Endfor
	Endif
	
	prefCodigo.Visible = False
	croUsuario.Visible = False
	croDataAlt.Visible = False
	croFeito.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

    if &Mode = TrnMode.Update
       PRCDVerificarProdutoCronograma(&prefCodigo,croCodigo,prodCodigo)
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnscronogramaWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	croCodigo.Visible = False
	croCodigo_Cell.Class = !'Invisible'
	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		croRemessa.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
