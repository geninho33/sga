  <Part type="9b0a32a3-de6d-4be1-a4dd-1b85d3741534">
    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&croCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
croCodigo = &croCodigo if not &croCodigo.IsEmpty();
noaccept(croCodigo) if not &croCodigo.IsEmpty();

forCodigo = &Insert_forCodigo if &Mode = TrnMode.Insert and not &Insert_forCodigo.IsEmpty();
noaccept(forCodigo) if &Mode = TrnMode.Insert and not &Insert_forCodigo.IsEmpty();
prodCodigo = &Insert_prodCodigo if &Mode = TrnMode.Insert and not &Insert_prodCodigo.IsEmpty();
noaccept(prodCodigo) if &Mode = TrnMode.Insert and not &Insert_prodCodigo.IsEmpty();
croCodigo.Visible = croCodigo<>0;
croCodigo_Cell.Class = !'Invisible' If not(croCodigo<>0);
croCodigo_Cell.Class = !'col-xs-12 DataContentCell' If croCodigo<>0;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

error('Não é possível salvar com o status de DISTRIBUIÇÃO, sem informar o código da remessa !') 
	if croRemessa = 0 and croStatus = 'D';

error('Informe a marca do produto !') 
	if croMarca.IsEmpty();
	
error('Informe o fornecedor !') 
	if forCodigo.IsEmpty();

error('Informe a data inicial  é a data Final !') 
	if croDtInicial.IsEmpty() or croDtFinal.IsEmpty(); 

error('Data inicial é maior que a data Final !') 
	if croDtInicial>croDtFinal; 

croDataCad = serverNow() 
	on beforeInsert;

croDataAlt = serverNow() 
	on beforeUpdate;

croCodigo = PRCDGerarNovoCodigo('cronograma')  
	on BeforeInsert;

croStatus = 'A'
	on BeforeInsert;
]]></Source>
