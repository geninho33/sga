    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&ajusCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
ajusCodigo = &ajusCodigo if not &ajusCodigo.IsEmpty();
noaccept(ajusCodigo) if not &ajusCodigo.IsEmpty();

tipajuCodigo = &Insert_tipajuCodigo if &Mode = TrnMode.Insert and not &Insert_tipajuCodigo.IsEmpty();
noaccept(tipajuCodigo) if &Mode = TrnMode.Insert and not &Insert_tipajuCodigo.IsEmpty();
BtnTrn_Enter.Visible = True If (ajusStatus <>'C');
BtnTrn_Enter.Visible = False If Not (ajusStatus <>'C');
ajusCodigo.Visible = ajusCodigo<>0;
ajusCodigo_Cell.Class = !'Invisible' If not(ajusCodigo<>0);
ajusCodigo_Cell.Class = !'col-xs-12 DataContentCell' If ajusCodigo<>0;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

ajusTipo = tipajuAcao on BeforeInsert;

ajusDataCadastro = serverNow() 
	on beforeInsert;

ajusUserName =  &WWPContext.UserName
	on beforeInsert;

ajusCodigo = PRCDGerarNovoCodigo('AJUSTE') 
	on BeforeInsert level ajusLocaCodigo, tipajuAcao, ajusData;

ajusData = serverNow() 
	if ajusData.IsEmpty();

ajusStatus = 'A';

error("Informe uma justificativa !") 
	if ajusOBS.IsEmpty();

error("Informe o tipo do ajuste válido !") 
	if tipajuCodigo=0 on BeforeInsert;

error("Informe o local !") 
	if ajusLocaCodigo=0;
]]></Source>
