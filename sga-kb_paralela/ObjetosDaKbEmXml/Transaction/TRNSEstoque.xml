  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&GAMSession = GAMSession.Get(&GAMErrors)
	Combo_estoProduto.GAMOAuthToken = &GAMSession.Token
	estoProduto.Visible = False
	&ComboestoProduto.SetEmpty()
	&ComboestoProduto.Visible = False
	Combo_prefCodigo.GAMOAuthToken = &GAMSession.Token
	prefCodigo.Visible = False
	&ComboprefCodigo.SetEmpty()
	&ComboprefCodigo.Visible = False
	Do 'LoadComboprefCodigo'
	Do 'LoadComboestoProduto'
	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated estoProduto
				Case &TrnContextAtt.AttributeName = !"estoProduto"
					&Insert_estoProduto.FromString(&TrnContextAtt.AttributeValue)
					If not &Insert_estoProduto.IsEmpty()
						&ComboestoProduto = &Insert_estoProduto
						Combo_estoProduto.SelectedValue_set = &ComboestoProduto.ToString().Trim()
						&Combo_DataJson = TRNSEstoqueLoadDVCombo(!'estoProduto', !'GET', false, &estoCodigo, &prefCodigo, &Insert_prefCodigo, &TrnContextAtt.AttributeValue, &ComboSelectedValue, &ComboSelectedText)
						Combo_estoProduto.SelectedText_set = &ComboSelectedText
						Combo_estoProduto.Enabled = False
					EndIf
			Endcase
		Endfor
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		TRNSEstoqueWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_estoProduto.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ComboestoProduto.FromString(Combo_estoProduto.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_prefCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Cond_prefCodigo = prefCodigo
	&ComboprefCodigo.FromString(Combo_prefCodigo.SelectedValue_get)
	If &Cond_prefCodigo <> &ComboprefCodigo
		&ComboestoProduto.SetEmpty()
		Combo_estoProduto.SelectedValue_set = ''
		Combo_estoProduto.SelectedText_set = ''
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadComboestoProduto'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Combo_estoProduto.DataListProcParametersPrefix = format(!' "ComboName": "estoProduto", "TrnMode": "INS", "IsDynamicCall": true, "estoCodigo": 0, "prefCodigo": 0, "Cond_prefCodigo": "#%1#"', prefCodigo.InternalName)
	&Combo_DataJson = TRNSEstoqueLoadDVCombo(!'estoProduto', &Mode, false, &estoCodigo, &prefCodigo, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_estoProduto.SelectedValue_set = &ComboSelectedValue
	Combo_estoProduto.SelectedText_set = &ComboSelectedText
	&ComboestoProduto.FromString(&ComboSelectedValue)
	If &Mode = TrnMode.Display OR &Mode = TrnMode.Delete
		Combo_estoProduto.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboprefCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Combo_DataJson = TRNSEstoqueLoadDVCombo(!'prefCodigo', &Mode, false, &estoCodigo, &prefCodigo, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_prefCodigo.SelectedValue_set = &ComboSelectedValue
	Combo_prefCodigo.SelectedText_set = &ComboSelectedText
	&ComboprefCodigo.FromString(&ComboSelectedValue)
	If &Mode <> TrnMode.Insert Or Not &prefCodigo.IsEmpty()
		Combo_prefCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
