    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
[web]
{
parm(in:&Mode, in:&prefCodigo, in:&remCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
remCodigo = &remCodigo if not &remCodigo.IsEmpty();
noaccept(remCodigo) if not &remCodigo.IsEmpty();

remCodigo.Visible = remCodigo<>0;
remCodigo_Cell.Class = !'Invisible' If not(remCodigo<>0);
remCodigo_Cell.Class = !'col-xs-12 DataContentCell' If remCodigo<>0;
}

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

Default(remCadastro,ServerDate());

/* Verificando os dados da 1ª semana */
error('Tem problemas com as datas do periodo 1º !')
	if not PRCDVerificandoPeriodo(remCadastro,remGerSemana1Ini,remGerSemana1Fim);

/* Verificando os dados da 2ª semana */
error('Tem problemas com as datas do periodo 2º !')
	if not PRCDVerificandoPeriodo(remCadastro,remGerSemana2Ini,remGerSemana2Fim);

/* Verificando os dados da 3ª semana */
error('Tem problemas com as datas do periodo 3º !')
	if not PRCDVerificandoPeriodo(remCadastro,remGerSemana3Ini,remGerSemana3Fim);

/* Verificando os dados da 4ª semana */
error('Tem problemas com as datas do periodo 4º !')
	if not PRCDVerificandoPeriodo(remCadastro,remGerSemana4Ini,remGerSemana4Fim);

/* Verificando os dados da 5ª semana */
error('Tem problemas com as datas do periodo 5º !')
	if not PRCDVerificandoPeriodo(remCadastro,remGerSemana5Ini,remGerSemana5Fim);

remCodigo = PRCDGerarNovoCodigo('remessas')  
	on BeforeInsert;

remAlteracao = serverDate() 
	on beforeInsert, beforeUpdate;
	
remUsuario =   &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
	on beforeInsert, beforeUpdate;	

[web]
{
	remRancho = false;
}
]]></Source>
