    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&usuCodigo);

usuCodigo = &usuCodigo if not &usuCodigo.IsEmpty();
noaccept(usuCodigo);
noprompt(usuCodigo);

prefCodigo = &Insert_prefCodigo if &Mode = TrnMode.Insert and not &Insert_prefCodigo.IsEmpty();
