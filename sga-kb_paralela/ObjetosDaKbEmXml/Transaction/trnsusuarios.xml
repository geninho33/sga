  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	 LoadWWPContext.Call(&WWPContext) 
     &prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&GAMSession = GAMSession.Get(&GAMErrors)
	Combo_prefCodigo.GAMOAuthToken = &GAMSession.Token
	prefCodigo.Visible = False
	&ComboprefCodigo.SetEmpty()
	&ComboprefCodigo.Visible = False
	Do 'LoadComboprefCodigo'
	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated prefCodigo
				Case &TrnContextAtt.AttributeName = !"prefCodigo"
					&Insert_prefCodigo.FromString(&TrnContextAtt.AttributeValue)
					If not &Insert_prefCodigo.IsEmpty()
						&ComboprefCodigo = &Insert_prefCodigo
						Combo_prefCodigo.SelectedValue_set = &ComboprefCodigo.ToString().Trim()
						&Combo_DataJson = trnsusuariosLoadDVCombo(!'prefCodigo', !'GET', false, &usuCodigo, &TrnContextAtt.AttributeValue, &ComboSelectedValue, &ComboSelectedText)
						Combo_prefCodigo.SelectedText_set = &ComboSelectedText
						Combo_prefCodigo.Enabled = False
					EndIf
			Endcase
		Endfor
	Endif
	
	usuUnidade.Visible = False
	usuSenha.Visible = False
	usuValidadeSenha.Visible = False
	usuDataAcesso.Visible = False
	usuDataCad.Visible = False
	usuDataAlt.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnsusuariosWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_prefCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ComboprefCodigo.FromString(Combo_prefCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	usuCodigo.Visible = False
	usuCodigo_Cell.Class = !'Invisible'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboprefCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Combo_DataJson = trnsusuariosLoadDVCombo(!'prefCodigo', &Mode, false, &usuCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_prefCodigo.SelectedValue_set = &ComboSelectedValue
	Combo_prefCodigo.SelectedText_set = &ComboSelectedText
	&ComboprefCodigo.FromString(&ComboSelectedValue)
	If &Mode = TrnMode.Display OR &Mode = TrnMode.Delete
		Combo_prefCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
