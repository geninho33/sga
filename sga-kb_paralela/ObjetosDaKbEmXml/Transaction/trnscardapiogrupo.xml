    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&carGruCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
carGruCodigo = &carGruCodigo if not &carGruCodigo.IsEmpty();
noaccept(carGruCodigo) if not &carGruCodigo.IsEmpty();

carDapCodigo = &Insert_carDapCodigo if &Mode = TrnMode.Insert and not &Insert_carDapCodigo.IsEmpty();
noaccept(carDapCodigo) if &Mode = TrnMode.Insert and not &Insert_carDapCodigo.IsEmpty();
carGruCodigo.Visible = carGruCodigo<>0;
carGruCodigo_Cell.Class = !'Invisible' If not(carGruCodigo<>0);
carGruCodigo_Cell.Class = !'col-xs-12 DataContentCell' If carGruCodigo<>0;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

Error('Informe a descrição do Grupo !') 
	If carGruDescricao.IsEmpty();

carGruDataCad = serverNow() 
	on beforeInsert;

carGruDataAlt = serverNow() 
	on beforeUpdate;

carGruCodigo = PRCDGerarNovoCodigo('cardapioGrupo')  
	on BeforeInsert;
]]></Source>
