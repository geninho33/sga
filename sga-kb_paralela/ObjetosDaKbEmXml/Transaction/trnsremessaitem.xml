	LoadWWPContext.Call(&WWPContext)

	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&GAMSession = GAMSession.Get(&GAMErrors)
	Combo_remItemProduto.GAMOAuthToken = &GAMSession.Token
	remItemProduto.Visible = False
	&ComboremItemProduto.SetEmpty()
	&ComboremItemProduto.Visible = False
	Combo_remCodigo.GAMOAuthToken = &GAMSession.Token
	remCodigo.Visible = False
	&ComboremCodigo.SetEmpty()
