	&ComboprefCodigo.Visible = False
	Do 'LoadComboprefCodigo'
	Do 'LoadComboremCodigo'
	Do 'LoadComboremItemProduto'
	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated remItemProduto
				Case &TrnContextAtt.AttributeName = !"remItemProduto"
					&Insert_remItemProduto.FromString(&TrnContextAtt.AttributeValue)
					If not &Insert_remItemProduto.IsEmpty()
						&ComboremItemProduto = &Insert_remItemProduto
						Combo_remItemProduto.SelectedValue_set = &ComboremItemProduto.ToString().Trim()
						&Combo_DataJson = trnsremessaitemLoadDVCombo(!'remItemProduto', !'GET', false, &prefCodigo, &remCodigo, &remItemCodigo, &Insert_prefCodigo, &TrnContextAtt.AttributeValue, &ComboSelectedValue, &ComboSelectedText)
						Combo_remItemProduto.SelectedText_set = &ComboSelectedText
						Combo_remItemProduto.Enabled = False
					EndIf
			Endcase
		Endfor
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

