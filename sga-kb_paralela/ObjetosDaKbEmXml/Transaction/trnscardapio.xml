    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	
	carDapDataAlteracao.Visible = False
	carDapDataCadastro.Visible = False
	carDapUsuario.Visible = False
	prefCodigo.Visible = False
	WCWCMacroMicroNutrientes.Object = WCMacroMicroNutrientes.Create(&prefCodigo, &carDapCodigo)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

   if &Mode = trnmode.Update
      PRCDAjustarDataDasRefeicoes(&prefCodigo, carDapCodigo, carDapMesAno) 
   endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnscardapioWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	carDapNutricionista1.Visible = False
	carDapNutricionista1_Cell.Class = !'Invisible'
	carDapNutricionista2.Visible = False
	carDapNutricionista2_Cell.Class = !'Invisible'
	carDapNutricionista3.Visible = False
	carDapNutricionista3_Cell.Class = !'Invisible'
	carDapCodigo.Visible = False
	carDapCodigo_Cell.Class = !'Invisible'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
