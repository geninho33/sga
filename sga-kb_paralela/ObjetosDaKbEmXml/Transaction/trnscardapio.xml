    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&carDapCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
carDapCodigo = &carDapCodigo if not &carDapCodigo.IsEmpty();
noaccept(carDapCodigo) if not &carDapCodigo.IsEmpty();

carDapNutricionista1.Visible = carDapNutricionista<>0;
carDapNutricionista1_Cell.Class = !'Invisible' If not(carDapNutricionista<>0);
carDapNutricionista1_Cell.Class = !'col-xs-12 DataContentCell DscTop' If carDapNutricionista<>0;
carDapNutricionista2.Visible = carDapNutricionista1<>0 and carDapNutricionista<>0;
carDapNutricionista2_Cell.Class = !'Invisible' If not(carDapNutricionista1<>0 and carDapNutricionista<>0);
carDapNutricionista2_Cell.Class = !'col-xs-12 DataContentCell DscTop' If carDapNutricionista1<>0 and carDapNutricionista<>0;
carDapNutricionista3.Visible = carDapNutricionista1<>0 and carDapNutricionista<>0 and carDapNutricionista2<>0;
carDapNutricionista3_Cell.Class = !'Invisible' If not(carDapNutricionista1<>0 and carDapNutricionista<>0 and carDapNutricionista2<>0);
carDapNutricionista3_Cell.Class = !'col-xs-12 DataContentCell DscTop' If carDapNutricionista1<>0 and carDapNutricionista<>0 and carDapNutricionista2<>0;
carDapCodigo.Visible = carDapCodigo<>0;
carDapCodigo_Cell.Class = !'Invisible' If not(carDapCodigo<>0);
carDapCodigo_Cell.Class = !'col-xs-12 DataContentCell DscTop' If carDapCodigo<>0;
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

Error('Este usuário não tem permissão !') 
	If not PRCDNutricionista() on beforeInsert, beforeUpdate; 

Error('Informe a descrição do cardpápio !') 
	If  carDapDescricao.IsEmpty();

carDapDataCadastro = serverNow() 
	on beforeInsert;

carDapDataAlteracao = serverNow() 
	on beforeUpdate;

carDapCodigo = PRCDGerarNovoCodigo('cardapio')  
	on BeforeInsert;
	
carDapUsuario =  GAMUser.GetLogin()
	on BeforeInsert, beforeUpdate;	

/*
Error('Informe o Nutricionista !') 
	If carDapNutricionista.IsEmpty();
*/	

&AdmLogCha = carDapCodigo.ToFormattedString()
 on AfterInsert, AfterUpdate, AfterDelete;
&AdmLogDad = carDapMesAno.ToFormattedString() + '-' + carDapNecessidade.ToFormattedString() + '-' + carDapDescricao.Trim() + '-' + carDapGruCodigo.ToFormattedString() + '-' + carDapLiberarAcesso + '-' + carDapStatus
 on AfterInsert, AfterUpdate, AfterDelete;
PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, &Mode, &AdmLogDad)
 on AfterInsert, AfterUpdate, AfterDelete;


]]></Source>
