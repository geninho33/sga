  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	[web]
	{
	carPratoRefeicao.Visible = False
	&CombocarPratoRefeicao.SetEmpty()
	&CombocarPratoRefeicao.Visible = False
	Do 'LoadCombocarPratoRefeicao'
	}
	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated carPratoTurno
				Case &TrnContextAtt.AttributeName = !"carPratoTurno"
					&Insert_carPratoTurno.FromString(&TrnContextAtt.AttributeValue)
				// When inserting with instantiated carPratoRefeicao
				Case &TrnContextAtt.AttributeName = !"carPratoRefeicao"
					&Insert_carPratoRefeicao.FromString(&TrnContextAtt.AttributeValue)
					[web]
					{
					If not &Insert_carPratoRefeicao.IsEmpty()
						&CombocarPratoRefeicao = &Insert_carPratoRefeicao
						Combo_carPratoRefeicao.SelectedValue_set = &CombocarPratoRefeicao.ToString().Trim()
						Combo_carPratoRefeicao.Enabled = False
					EndIf
					}
			Endcase
		Endfor
	Endif
	
    [web]
    {
	prefCodigo.Visible = False
	carDapCodigo.Visible = False
	carPratoHorario.Visible = False
	carPratoNrSemana.Visible = False
	}

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

   [web]
   {
	
	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnscardapiopratoWW.Call(prefCodigo, carDapCodigo)
	Endif

	Return
   }

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

    PRCDBuscarHorario(&prefCodigo,'N',carPratoTurnoNome,carPratoHorario)

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

[web]
{
	carPratoCodigo.Visible = False
	carPratoCodigo_Cell.Class = !'Invisible'
	
}

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

[web]
{

Event Combo_carPratoRefeicao.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&CombocarPratoRefeicao.FromString(Combo_carPratoRefeicao.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadCombocarPratoRefeicao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&carPratoRefeicao_Data = trnscardapiopratoLoadDVCombo(!'carPratoRefeicao', &Mode, &prefCodigo, &carDapCodigo, &carPratoCodigo, &ComboSelectedValue)
	Combo_carPratoRefeicao.SelectedValue_set = &ComboSelectedValue
	&CombocarPratoRefeicao.FromString(&ComboSelectedValue)
	If &Mode = TrnMode.Display OR &Mode = TrnMode.Delete
		Combo_carPratoRefeicao.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

}


]]></Source>
