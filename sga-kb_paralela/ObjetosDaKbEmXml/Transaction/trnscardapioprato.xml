    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
[web]
{
parm(in:&Mode, in:&prefCodigo, in:&carDapCodigo, in:&carPratoCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
carDapCodigo = &carDapCodigo if not &carDapCodigo.IsEmpty();
noaccept(carDapCodigo) if not &carDapCodigo.IsEmpty();
carPratoCodigo = &carPratoCodigo if not &carPratoCodigo.IsEmpty();
noaccept(carPratoCodigo) if not &carPratoCodigo.IsEmpty();

carPratoTurno = &Insert_carPratoTurno if &Mode = TrnMode.Insert and not &Insert_carPratoTurno.IsEmpty();
noaccept(carPratoTurno) if &Mode = TrnMode.Insert and not &Insert_carPratoTurno.IsEmpty();
carPratoRefeicao = &Insert_carPratoRefeicao if &Mode = TrnMode.Insert and not &Insert_carPratoRefeicao.IsEmpty();
noaccept(carPratoRefeicao) if &Mode = TrnMode.Insert and not &Insert_carPratoRefeicao.IsEmpty();
carPratoCodigo.Visible = carPratoCodigo<>0;
carPratoCodigo_Cell.Class = !'Invisible' If not(carPratoCodigo<>0);
carPratoCodigo_Cell.Class = !'col-xs-12 DataContentCell' If carPratoCodigo<>0;
carPratoRefeicao = &CombocarPratoRefeicao;
}

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

Error('Este usuário não tem permissão !') 
	If not PRCDNutricionista() on beforeInsert, beforeUpdate; 

error('Informe a refeição ! ') 
	if carPratoRefeicao=0;

error('Informe o tipo de refeição! ') 
	if carPratoTurno=0;
	
// error('Informe o horário! ') 
//	if carPratoHorario.ToString() = '';

error('Informe a Data! ') 
	if carPratoData.IsEmpty() ;

error('Esta dia é um final de semana !' ) 
	if Dow(carPratoData ) = 1 or Dow(carPratoData ) = 7;

error('Esta data não é do mesmo Ano do Cardápio !' ) 
	if carPratoData.Year() <> PRCDVerificarAnoMes(&prefCodigo,&carDapCodigo,'A');

error('Esta data não é do mesmo Mês do Cardápio !' ) 
	if carPratoData.Month() <> PRCDVerificarAnoMes(&prefCodigo,&carDapCodigo,'M');

error('Dia não letivo - Não é permitido utilizar !')
	if PRCDVerificaCalendario( &prefCodigo, carPratoData );

carPratoCodigo = PRCDGerarNovoCodigo('cardapioPrato')  
	on BeforeInsert;


&AdmLogCha = carDapCodigo.ToString().Trim() + '-' + carPratoCodigo.ToString().Trim()
 on AfterInsert, AfterUpdate, AfterDelete;
&AdmLogDad = carPratoCodigo.ToFormattedString() + '-' + carPratoData.ToFormattedString() + '-' + carPratoRefeicao.ToFormattedString() + '-' + carPratoTurno.ToFormattedString() + '-' + carPratoTurnoHorario.ToFormattedString()
 on AfterInsert, AfterUpdate, AfterDelete;
PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, &Mode, &AdmLogDad)
 on AfterInsert, AfterUpdate, AfterDelete;
]]></Source>
