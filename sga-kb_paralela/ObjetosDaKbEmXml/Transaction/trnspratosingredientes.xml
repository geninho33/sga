    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&pratoCodigo, in:&pratIngrProdCodigo, in:&AreEnsCodigo, in:&AreEnsSequencial, in:&carGruTurno);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
pratoCodigo = &pratoCodigo if not &pratoCodigo.IsEmpty();
noaccept(pratoCodigo) if not &pratoCodigo.IsEmpty();
pratIngrProdCodigo = &pratIngrProdCodigo if not &pratIngrProdCodigo.IsEmpty();
noaccept(pratIngrProdCodigo) if not &pratIngrProdCodigo.IsEmpty();
AreEnsCodigo = &AreEnsCodigo if not &AreEnsCodigo.IsEmpty();
noaccept(AreEnsCodigo) if not &AreEnsCodigo.IsEmpty();
AreEnsSequencial = &AreEnsSequencial if not &AreEnsSequencial.IsEmpty();
noaccept(AreEnsSequencial) if not &AreEnsSequencial.IsEmpty();
carGruTurno = &carGruTurno if not &carGruTurno.IsEmpty();
noaccept(carGruTurno) if not &carGruTurno.IsEmpty();

prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */
// parm(in:&Mode, in:&prefCodigo, in:&pratoCodigo,in:&pratIngrProdCodigo);

pratIngrDataCad = serverNow() 
	on beforeInsert;

pratIngrDataAlt = serverNow() 
	on beforeUpdate;

carGruTurno = turno.Int
if prefCodigo = 26 on beforeInsert;


error('Informe a percapta! ') 
	if pratIngrQuantidade=0;



&AdmLogCha = pratoCodigo.ToString().Trim() + '-' + pratIngrProdCodigo.ToString().Trim() + '-' + AreEnsCodigo.ToString().Trim() + '-' + AreEnsSequencial.ToString().Trim() + '-' + carGruTurno.ToString().Trim()
 on AfterInsert, AfterUpdate, AfterDelete;
&AdmLogDad = pratIngrProdCodigo.ToFormattedString() + '-' + AreEnsCodigo.ToFormattedString() + '-' + AreEnsSequencial.ToString().Trim() + '-' + carGruTurno.ToFormattedString() + '-' + pratIngrQuantidade.ToFormattedString() + '-' + pratIngrStatus
 on AfterInsert, AfterUpdate, AfterDelete;
PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, &Mode, &AdmLogDad)
 on AfterInsert, AfterUpdate, AfterDelete;
]]></Source>
