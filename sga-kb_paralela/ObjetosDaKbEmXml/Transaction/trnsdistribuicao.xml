  <Part type="9b0a32a3-de6d-4be1-a4dd-1b85d3741534">
    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
parm(in:&Mode, in:&prefCodigo, in:&distCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
distCodigo = &distCodigo if not &distCodigo.IsEmpty();
noaccept(distCodigo) if not &distCodigo.IsEmpty();

distLocalOrigem = &Insert_distLocalOrigem if &Mode = TrnMode.Insert and not &Insert_distLocalOrigem.IsEmpty();
noaccept(distLocalOrigem) if &Mode = TrnMode.Insert and not &Insert_distLocalOrigem.IsEmpty();
distLocalDestino = &Insert_distLocalDestino if &Mode = TrnMode.Insert and not &Insert_distLocalDestino.IsEmpty();
noaccept(distLocalDestino) if &Mode = TrnMode.Insert and not &Insert_distLocalDestino.IsEmpty();
distCodigo.Visible = distCodigo<>0;
distCodigo_Cell.Class = !'Invisible' If not(distCodigo<>0);
distCodigo_Cell.Class = !'MergeDataCell' If distCodigo<>0;
TextBlockdistCodigo_Cell.Class = !'Invisible' If not(distCodigo<>0);
TextBlockdistCodigo_Cell.Class = !'col-sm-2 MergeLabelCell' If distCodigo<>0;
distRemCodigo.Visible = distRemCodigo<>0;
distRemCodigo_Cell.Class = !'Invisible' If not(distRemCodigo<>0);
distRemCodigo_Cell.Class = !'DataContentCell' If distRemCodigo<>0;
distPeriodo.Visible = not distPeriodo.isEmpty();
distPeriodo_Cell.Class = !'Invisible' If not(not distPeriodo.isEmpty());
distPeriodo_Cell.Class = !'DataContentCell' If not distPeriodo.isEmpty();
prefCodigo = &WWPContext.prefCodigo;
/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

PRCRotaLocal(prefCodigo, distLocalDestino, distRotaCodigo) 
	on beforeInsert;

distStatus = 'A'
	on beforeInsert;

distReceber = 'N'
	 on beforeInsert;

// distReceber = 'S'
//    if distCodigoTipoRemessa <>10 on beforeInsert;

//distRotaCodigo = &distRotaCodigo
//	on beforeInsert;

distDataCadastro = serverNow() 
	on beforeInsert;

distDataAlteracao = serverNow() 
	on beforeUpdate;

distUserName = &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
	on beforeInsert, beforeUpdate;

distCodigo = PRCDGerarNovoCodigo('distribuicao') 
	on beforeInsert;
	
error('Informe a Unidade de Origem !') 
	if distLocalOrigem = 0;

error('Informe o Recebedor !') 
	if distRecebedor.IsEmpty();

error('Informe a Unidade de Destino !') 
	if distLocalDestino = 0;

error('O Destino e a Origem não podem ser igual !') 
	if distLocalDestino =distLocalOrigem;

error('Data de Envio não pode ser maior que data de Recepção !')
	if distDataEnvio > distDataRecepcao;
]]></Source>
