  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

   LoadWWPContext.Call(&WWPContext)
   &prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	Do 'AttributesSecurityCode'

	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated distLocalOrigem
				Case &TrnContextAtt.AttributeName = !"distLocalOrigem"
					&Insert_distLocalOrigem.FromString(&TrnContextAtt.AttributeValue)
				// When inserting with instantiated distLocalDestino
				Case &TrnContextAtt.AttributeName = !"distLocalDestino"
					&Insert_distLocalDestino.FromString(&TrnContextAtt.AttributeValue)
			Endcase
		Endfor
	Endif
	
	prefCodigo.Visible = False
	distRotaCodigo.Visible = False
	distUserName.Visible = False
	distDataCadastro.Visible = False
	distDataAlteracao.Visible = False
	distStatus.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

  If ( &Mode = TrnMode.Insert )
		trnsdistribuicaoitensWW(&prefCodigo,distCodigo)
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnsdistribuicaoWW.Call()
	Endif

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	distCodigo.Visible = False
	distCodigo_Cell.Class = !'Invisible'
	TextBlockdistCodigo_Cell.Class = !'Invisible'
	If Not SecGAMIsAuthByFunctionalityKey(!'True')
		distCodigo.Enabled = False
	EndIf
	distRemCodigo.Visible = False
	distRemCodigo_Cell.Class = !'Invisible'
	If Not SecGAMIsAuthByFunctionalityKey(!'true')
		distRemCodigo.Enabled = False
	EndIf
	distPeriodo.Visible = False
	distPeriodo_Cell.Class = !'Invisible'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

// Event &checkBox
	
// EndEvent
]]></Source>
