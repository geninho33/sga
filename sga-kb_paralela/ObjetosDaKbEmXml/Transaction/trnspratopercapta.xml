    <Source><![CDATA[/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */
[web]
{
parm(in:&Mode, in:&prefCodigo, in:&pratoCodigo, in:&pratoPerCaptaCodigo);

prefCodigo = &prefCodigo if not &prefCodigo.IsEmpty();
noaccept(prefCodigo) if not &prefCodigo.IsEmpty();
pratoCodigo = &pratoCodigo if not &pratoCodigo.IsEmpty();
noaccept(pratoCodigo) if not &pratoCodigo.IsEmpty();
pratoPerCaptaCodigo = &pratoPerCaptaCodigo if not &pratoPerCaptaCodigo.IsEmpty();
noaccept(pratoPerCaptaCodigo) if not &pratoPerCaptaCodigo.IsEmpty();

AreEnsCodigo = &Insert_AreEnsCodigo if &Mode = TrnMode.Insert and not &Insert_AreEnsCodigo.IsEmpty();
noaccept(AreEnsCodigo) if &Mode = TrnMode.Insert and not &Insert_AreEnsCodigo.IsEmpty();
AreEnsSequencial = &Insert_AreEnsSequencial if &Mode = TrnMode.Insert and not &Insert_AreEnsSequencial.IsEmpty();
noaccept(AreEnsSequencial) if &Mode = TrnMode.Insert and not &Insert_AreEnsSequencial.IsEmpty();
prefCodigo = &ComboprefCodigo;
pratoCodigo = &CombopratoCodigo;
}

/* Generated by DVelop Work With Plus Pattern [End] - Do not change */
pratoPerCaptaCodigo = PRCDGerarNovoCodigo('pratoPerCapta')  
	on BeforeInsert;
]]></Source>
