    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	[web]{
		LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm
	}

	LoadWWPContext.Call(&WWPContext)

	[web]
	{
	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&GAMSession = GAMSession.Get(&GAMErrors)
	Combo_pratoCodigo.GAMOAuthToken = &GAMSession.Token
	pratoCodigo.Visible = False
	&CombopratoCodigo.SetEmpty()
	&CombopratoCodigo.Visible = False
	Combo_prefCodigo.GAMOAuthToken = &GAMSession.Token
	prefCodigo.Visible = False
	&ComboprefCodigo.SetEmpty()
	&ComboprefCodigo.Visible = False
	Do 'LoadComboprefCodigo'
	Do 'LoadCombopratoCodigo'
	}
	&TrnContext.FromXml(&WebSession.Get(!"TrnContext"))
	If (&TrnContext.TransactionName = &Pgmname and &Mode = TrnMode.Insert)
		For &TrnContextAtt in &TrnContext.Attributes
			Do Case
				// When inserting with instantiated AreEnsCodigo
				Case &TrnContextAtt.AttributeName = !"AreEnsCodigo"
					&Insert_AreEnsCodigo.FromString(&TrnContextAtt.AttributeValue)
				// When inserting with instantiated AreEnsSequencial
				Case &TrnContextAtt.AttributeName = !"AreEnsSequencial"
					&Insert_AreEnsSequencial.FromString(&TrnContextAtt.AttributeValue)
			Endcase
		Endfor
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event After Trn

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

   [web]
   {
	
	If (&Mode = TrnMode.Delete and not &TrnContext.CallerOnDelete)
		trnspratopercaptaWW.Call(prefCodigo, pratoCodigo)
	Endif

	Return
   }

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

[web]
{

Event Combo_pratoCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&CombopratoCodigo.FromString(Combo_pratoCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_prefCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Cond_prefCodigo = prefCodigo
	&ComboprefCodigo.FromString(Combo_prefCodigo.SelectedValue_get)
	If &Cond_prefCodigo <> &ComboprefCodigo
		&CombopratoCodigo.SetEmpty()
		Combo_pratoCodigo.SelectedValue_set = ''
		Combo_pratoCodigo.SelectedText_set = ''
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadCombopratoCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Combo_pratoCodigo.DataListProcParametersPrefix = format(!' "ComboName": "pratoCodigo", "TrnMode": "INS", "IsDynamicCall": true, "prefCodigo": 0, "pratoCodigo": 0, "pratoPerCaptaCodigo": 0, "Cond_prefCodigo": "#%1#"', prefCodigo.InternalName)
	&Combo_DataJson = trnspratopercaptaLoadDVCombo(!'pratoCodigo', &Mode, false, &prefCodigo, &pratoCodigo, &pratoPerCaptaCodigo, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_pratoCodigo.SelectedValue_set = &ComboSelectedValue
	Combo_pratoCodigo.SelectedText_set = &ComboSelectedText
	&CombopratoCodigo.FromString(&ComboSelectedValue)
	If &Mode <> TrnMode.Insert Or Not &pratoCodigo.IsEmpty()
		Combo_pratoCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboprefCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Combo_DataJson = trnspratopercaptaLoadDVCombo(!'prefCodigo', &Mode, false, &prefCodigo, &pratoCodigo, &pratoPerCaptaCodigo, prefCodigo, '', &ComboSelectedValue, &ComboSelectedText)
	Combo_prefCodigo.SelectedValue_set = &ComboSelectedValue
	Combo_prefCodigo.SelectedText_set = &ComboSelectedText
	&ComboprefCodigo.FromString(&ComboSelectedValue)
	If &Mode <> TrnMode.Insert Or Not &prefCodigo.IsEmpty()
		Combo_prefCodigo.Enabled = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

}


