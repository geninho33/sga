  <Part type="1d8aeb5a-6e98-45a7-92d2-d8de7384e432">
    <Source><![CDATA[ListaDeAnos
{
	&Ano = 1939 if &Order = 'A'; (&Today.Year() + 1) otherwise;
	&i   = 1    if &Order = 'A'; -1 otherwise;
	
	Ano Input &x = 1 to (&Today.Year() - 1939)
	{
		&Ano = &Ano + &i
		Valor = &Ano
		Descricao = &Ano.ToString()
	}
}
]]></Source>
