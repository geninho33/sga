    <Source><![CDATA[
DVelop_Menu 
{
	&GAMApplication = GAMApplication.Get() 
	&MinMenuIdAux = &MinMenuId
	Item Input &GAMMenuItem in &GAMMenu
	{
		&MinMenuIdAux = &MinMenuIdAux + 1
		id = &MinMenuIdAux.ToString().Trim()
		link = &GAMMenuItem.Link
		
		iconClass = &GAMMenuItem.Properties.Item(1).Value if &GAMMenuItem.Properties.Count > 0; "menu-icon fa fa-bullseye" if &MenuId > 0 and &GAMMenuItem.Properties.Count = 0; "" otherwise;
		linkTarget = &GAMMenuItem.Properties.Item(2).Value.Trim() if &GAMMenuItem.Properties.Count > 0; "" otherwise;
		
		caption = &GAMMenuItem.Name
		subItems =  WWPBaseObjects.LoadMenu_GAMMenu(&GAMMenuItem.Nodes, 0, &MinMenuIdAux * 100)
		
	}
	
