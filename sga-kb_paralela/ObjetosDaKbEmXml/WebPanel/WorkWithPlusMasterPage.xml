  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start
    LoadWWPContext(&WWPContext)
	Form.HeaderRawHTML = !'<link rel="shortcut icon" type="image/x-icon" href="'+ Favicon.Link()+ !'">'
	LayoutMainTable.Class = StyleClass:MainContainerWithFooter
	&GAMApplication = GAMApplication.Get()
	If &GAMApplication.MainMenuId = 0
		InitializeGAMMenuExample()
		Home()
	Endif


	&GAMMenuAdditionalParameters.LoadProperties = True
	&GAMMenuOptionList = &GAMApplication.GetUserMainMenu(&GAMMenuAdditionalParameters, &GAMErrorCollection)
	&DVelop_Menu = WWPBaseObjects.LoadMenu_GAMMenu(&GAMMenuOptionList.Nodes, &GAMApplication.MainMenuId, 0)

	&GAMUser = GAMUser.Get()
	&UserName = iif(&GAMUser.FirstName.IsEmpty(), &GAMUser.Name, &GAMUser.FirstName.Trim() + " " + &GAMUser.LastName.Trim())
	&GAMRoleCollection = GAMSession.GetRoles(&GAMErrorCollection)
	
	For &GAMRole In &GAMRoleCollection
		If Not &RolesDescriptions.IsEmpty()
			&RolesDescriptions = &RolesDescriptions + ", "
		Endif
		&RolesDescriptions = &RolesDescriptions + iif(&GAMRole.Description.IsEmpty(), &GAMRole.Name, &GAMRole.Description)
	EndFor

	&DVelop_Menu_UserData.FirstLine = &UserName	
	&WWPContext.login     			= &GAMUser.Login
    &WWPContext.firstName 			= &GAMUser.FirstName.Trim()
	&WWPContext.lastName  			= &GAMUser.LastName.Trim()
	&WWPContext.email     			= &GAMUser.EMail
	
	If &Httprequest.Method = HttpMethod.Get
		&WWP_DesignSystemSettings = WWP_GetDesignSystemSettings()
		GeneXus.Common.UI.DesignSystem.SetOption(!"base-color", &WWP_DesignSystemSettings.BaseColor)
		GeneXus.Common.UI.DesignSystem.SetOption(!"background-color", &WWP_DesignSystemSettings.BackgroundStyle)
		GeneXus.Common.UI.DesignSystem.SetOption(!"menu-color", &WWP_DesignSystemSettings.MenuColor)
		GeneXus.Common.UI.DesignSystem.SetOption(!"font-size", &WWP_DesignSystemSettings.FontSize)
		WWPActions.EmpoweredGrids_Refresh()
	EndIf

	For each trnsusuarios
		where usuGUID = &GAMUser.GUID or usuEmail = &GAMUser.EMail
		&prefCodigo = prefCodigo

		For each trnscargos
			where carCodigo = usuCargo
			&DVelop_Menu_UserData.SecondLine = carDescricao
		endFor

	    for each trnsprefeituras
  	        where prefCodigo = &prefCodigo
                  &prefLogo 			 = prefLogo
			      &WWPContext.GLPI_URL   = prefGLPI_URL
			      &WWPContext.APP_TOKEN  = prefAPP_TOKEN
			      &WWPContext.USER_TOKEN = prefUSER_TOKEN
		endfor
		&WWPContext.GLPI_USER_ID = usuGLPI_USER_ID
	endFor

	&ano = date.Today().Year()
	if &prefCodigo in (26)
		TextBlockFooter.Caption = 'Copyright '+ &ano.ToString() +' © VIZIV TI e Software'
	else
		TextBlockFooter.Caption = 'Copyright '+ &ano.ToString() +' © IntelliBR Sistemas'
  endif

  &WWPContext.prefCodigo = &prefCodigo
  &WWPContext.UserName = &GAMUser.FirstName + ' ' + &GAMUser.LastName
  SetWWPContext(&WWPContext)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event ddc_AdminAG.OnLoadComponent

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WWPAux_WC.Object = WWP_MasterPageTopActionsWC.Create()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event ddc_RuntimeDesignSettings.OnLoadComponent

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WWPAux_WC.Object = WWP_MasterPageRuntimeSettings.Create()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoUserActionAbrirChamado'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WPCriacaoChamadosGLPI.Call()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoShowMenu'

	UCMenu.CollapseExpand()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	TextblockTitle.Caption = Form.Caption

EndEvent


]]></Source>
