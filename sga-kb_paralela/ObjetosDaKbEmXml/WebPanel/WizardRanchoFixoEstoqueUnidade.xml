    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid.Rows = 0
	Grid_Empowerer.GridInternalName = Grid.InternalName
	DDO_Grid.GridInternalName = Grid.InternalName
	prefCodigo.Visible = False
	estoUeProdCodigo.Visible = False

	Do 'PrepareTransaction'
	Do 'LoadGridState'
	If &OrderedBy < 1
		&OrderedBy = 1
		Do 'SetDDOSortedStatus'
	EndIf
	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)

	Do 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DDO_Grid.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case DDO_Grid.ActiveEventKey = !'<#OrderASC#>' OR DDO_Grid.ActiveEventKey = !'<#OrderDSC#>'
			&OrderedBy.FromString(DDO_Grid.SelectedValue_get)
			&OrderedDsc = iif(DDO_Grid.ActiveEventKey = !'<#OrderDSC#>', true, false)
			Do 'SetDDOSortedStatus'
			Grid.FirstPage()
		Case DDO_Grid.ActiveEventKey = !'<#Filter#>'
			Do Case
				Case DDO_Grid.SelectedColumn = !'estoUeSaldo'
					&TFestoUeSaldo.FromString(DDO_Grid.FilteredText_get)
					&TFestoUeSaldo_To.FromString(DDO_Grid.FilteredTextTo_get)
				Case DDO_Grid.SelectedColumn = !'estoUEQtdeFixa'
					&TFestoUEQtdeFixa.FromString(DDO_Grid.FilteredText_get)
					&TFestoUEQtdeFixa_To.FromString(DDO_Grid.FilteredTextTo_get)
			EndCase
			Grid.FirstPage()
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&LocDescricao = find(locDescricao,locCodigo = estoUeLocCodigo,'Inexistente')
	&LocDescricao = format('%1 (%2)',&LocDescricao.Trim(),estoUeLocCodigo.ToString().Trim())
	&Previsao = (estoUEQtdeFixa - estoUeSaldo)
	if &Previsao < 0
		&Previsao = 0
	endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'SetDDOSortedStatus'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DDO_Grid.SortedStatus = &OrderedBy.ToString().Trim() + !':' + iif(&OrderedDsc, !'DSC', !'ASC')

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(&PgmName + !"GridState") = !""
		&GridState.FromXml(LoadGridState.Udp(&PgmName + !"GridState"))
	Else
		&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))
	Endif	

	&OrderedBy = &GridState.OrderedBy
	&OrderedDsc = &GridState.OrderedDsc
	Do 'SetDDOSortedStatus'

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFESTOUESALDO"
				&TFestoUeSaldo.FromString(&GridStateFilterValue.Value)
				&TFestoUeSaldo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFESTOUEQTDEFIXA"
				&TFestoUEQtdeFixa.FromString(&GridStateFilterValue.Value)
				&TFestoUEQtdeFixa_To.FromString(&GridStateFilterValue.ValueTo)
		EndCase
	EndFor
	DDO_Grid.FilteredText_set = iif(&TFestoUeSaldo.IsEmpty(), '', &TFestoUeSaldo.ToString()) + !'|' + iif(&TFestoUEQtdeFixa.IsEmpty(), '', &TFestoUEQtdeFixa.ToString())
	DDO_Grid.FilteredTextTo_set = iif(&TFestoUeSaldo_To.IsEmpty(), '', &TFestoUeSaldo_To.ToString()) + !'|' + iif(&TFestoUEQtdeFixa_To.IsEmpty(), '', &TFestoUEQtdeFixa_To.ToString())
	If not &GridState.PageSize.Trim().IsEmpty()
		Grid.Rows = &GridState.PageSize.ToNumeric()
	EndIf
	Grid.CurrentPage = &GridState.CurrentPage

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))

	// Save grid state in session.
	&GridState.OrderedBy = &OrderedBy
	&GridState.OrderedDsc = &OrderedDsc
	&GridState.FilterValues.Clear()
	WWP_GridStateAddFilterValue(&GridState, !"TFESTOUESALDO", "", not (&TFestoUeSaldo.IsEmpty() AND &TFestoUeSaldo_To.IsEmpty()), 0, &TFestoUeSaldo.ToString().Trim(), iif(&TFestoUeSaldo.IsEmpty(), '', trim(&TFestoUeSaldo.ToFormattedString())), True, &TFestoUeSaldo_To.ToString().Trim(), iif(&TFestoUeSaldo_To.IsEmpty(), '', trim(&TFestoUeSaldo_To.ToFormattedString())))
	WWP_GridStateAddFilterValue(&GridState, !"TFESTOUEQTDEFIXA", "", not (&TFestoUEQtdeFixa.IsEmpty() AND &TFestoUEQtdeFixa_To.IsEmpty()), 0, &TFestoUEQtdeFixa.ToString().Trim(), iif(&TFestoUEQtdeFixa.IsEmpty(), '', trim(&TFestoUEQtdeFixa.ToFormattedString())), True, &TFestoUEQtdeFixa_To.ToString().Trim(), iif(&TFestoUEQtdeFixa_To.IsEmpty(), '', trim(&TFestoUEQtdeFixa_To.ToFormattedString())))

	&GridState.PageSize = str(Grid.Rows)
	&GridState.CurrentPage = Grid.CurrentPage
	SaveGridState.Call(&PgmName + !"GridState",  &GridState.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = True
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"TRNSEstoqueUE"

	&TrnContextAtt = new()
	&TrnContextAtt.AttributeName = !"PrefCodigo"
	&TrnContextAtt.AttributeValue = &PrefCodigo.ToString()
	&TrnContext.Attributes.Add(&TrnContextAtt)

	&TrnContextAtt = new()
	&TrnContextAtt.AttributeName = !"estoUeProdCodigo"
	&TrnContextAtt.AttributeValue = &estoUeProdCodigo.ToString()
	&TrnContext.Attributes.Add(&TrnContextAtt)

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
