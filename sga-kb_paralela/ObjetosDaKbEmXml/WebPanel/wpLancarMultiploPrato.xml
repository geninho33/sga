  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

    return
	&DiasMes.Clear()
    for each trnscardapio
		where prefCodigo = &prefCodigo
		where carDapCodigo = &carDapCodigo
		      &carPratoData = carDapMesAno
			  exit
	endFor

	&DataInicial = YMDtoD( &carPratoData.Year(),&carPratoData.Month(),1)
	&DataFinal   = YMDtoD( &carPratoData.Year(),&carPratoData.Month(), &carPratoData.EndOfMonth().Day() )
	&DataAtual   = &DataInicial

	// &DataFinal   = &carPratoData. EndOfMonth()
	//msg('Dt Inicial: ' + &DataAtual.ToString() + '|  Dt Final:' + &DataFinal.ToString() )

	Do while &DataAtual <= &DataFinal

		&Item 			= new()
		&Item.Data 		= &DataAtual
		&Item.DiaSemana = cDoW(&DataAtual,'por')

		If DoW(&DataAtual) = 1 or DoW(&DataAtual) = 7
			&Item.EhFinalSemana = True
		Else
			&Item.EhFinalSemana = False
		EndIf

		&SDTDiasMes.Add(&Item)
		&DataAtual = &DataAtual.AddDays( 1 )
	EndDo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&carPratoRefeicao.Visible = False
	Do 'LoadCombocarPratoRefeicao'
	GridSDTDiasMess_Empowerer.GridInternalName = GridSDTDiasMess.InternalName
	GridSDTDiasMess.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTDiasMess.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoactionConfirmar'

	&tem = false

	for &Item in &SDTDiasMes
		if &Item.ok
		   PRCDSalvarRefeicaoDia(&prefCodigo,&carDapCodigo,&carPratoRefeicao,&Item.Data,&carPratoTurno)
		   &tem = true
		endif
	endfor

    if &tem
		msg('Refeições foram lançadas com sucesso no cardápio !')
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoactionFechar'

    return

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_carPratoRefeicao.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&carPratoRefeicao.FromString(Combo_carPratoRefeicao.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadCombocarPratoRefeicao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//&carPratoRefeicao initial value has to be loaded manually at the beginning of this Subrutine
	For Each
		Order pratoDscricao50
		Where prefCodigo=&prefCodigo and pratoStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = pratoCodigo.ToString().Trim()
		&Combo_DataItem.Title = pratoDscricao50
		&carPratoRefeicao_Data.Add(&Combo_DataItem)
	EndFor
	Combo_carPratoRefeicao.SelectedValue_set = iif(&carPratoRefeicao.IsEmpty(), '', &carPratoRefeicao.ToString().Trim())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
