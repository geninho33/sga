  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)

	For each trnsprefeituras
		where prefCodigo = &prefCodigo
		Form.Caption = prefNome.ToString()
		&Exists = True

	When none
		Form.Caption = "WWP_RecordNotFound"
		&Exists = False
	Endfor

	If (&Exists)
		&SelectedTabCode = &TabCode
		Tabs.ActivePageControlName = &SelectedTabCode
		Do 'LoadTabs'
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Tabs.TabChanged

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&SelectedTabCode = Tabs.ActivePageControlName
	&LoadAllTabs = false
	Do 'LoadTabs'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadTabs'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If &LoadAllTabs OR &SelectedTabCode = '' OR &SelectedTabCode = !"General"
		GeneralWC.Object = trnsprefeiturasGeneral.Create(&prefCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnsprodutos"
		trnsprodutosWC.Object = trnsprefeiturastrnsprodutosWC.Create(&prefCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnsunidades"
		trnsunidadesWC.Object = trnsprefeiturastrnsunidadesWC.Create(&prefCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnsconvqtde"
		trnsconvqtdeWC.Object = trnsprefeiturastrnsconvqtdeWC.Create(&prefCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnslocal"
		trnslocalWC.Object = trnsprefeiturastrnslocalWC.Create(&prefCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnsfornecedores"
		trnsfornecedoresWC.Object = trnsprefeiturastrnsfornecedoresWC.Create(&prefCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnsrota"
		trnsrotaWC.Object = trnsprefeiturastrnsrotaWC.Create(&prefCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnssalas"
		trnssalasWC.Object = trnsprefeiturastrnssalasWC.Create(&prefCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnsdoencas"
		trnsdoencasWC.Object = trnsprefeiturastrnsdoencasWC.Create(&prefCodigo)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
