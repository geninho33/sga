    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)
	Do 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	prefCodigo.Visible = False
	notaUserName.Visible = False
	notaDataCadastro.Visible = False
	notaDataAlteracao.Visible = False
	notaStatus.Visible = False

	// Security check for 'Actions'
	&IsAuthorized_Update = SecGAMIsAuthByFunctionalityKey.Udp(!'trnsnotaww_Update')
	If not (&IsAuthorized_Update)
		BtnUpdate.Visible = False
	Endif
	&IsAuthorized_Delete = SecGAMIsAuthByFunctionalityKey.Udp(!'trnsnotaww_Delete')
	If not (&IsAuthorized_Delete)
		BtnDelete.Visible = False
	Endif
	 

	// Visible Conditions
	If Not (notaCodigo<>0)
		notaCodigo.Visible = False
		notaCodigo_Cell.Class = !'Invisible'
	Else
		notaCodigo.Visible = True
		notaCodigo_Cell.Class = !'col-xs-12 DataContentCell'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoUpdate'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Update)
		trnsnota.Call(TrnMode.Update, prefCodigo, notaCodigo)
	Else
		msg("WWP_ActionNoLongerAvailable")
		BtnUpdate.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoDelete'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Delete)
		trnsnota.Call(TrnMode.Delete, prefCodigo, notaCodigo)
	Else
		msg("WWP_ActionNoLongerAvailable")
		BtnDelete.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = False
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"trnsnota"

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


