  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&GAMSession = GAMSession.Get(&GAMErrors)
	UCMentions.GAMOAuthToken = &GAMSession.Token
	UCMentions.ItemHtmlTemplate = WWP_GetStyledDVCombo(!'Title, subtitle and image')
	UCMentions.Attach(!'+', &Message.InternalName)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WWPDiscussionMessageId.Visible = False

	Grid.Rows = 0
	WWPDiscussionMessageThreadId.Visible = False

	Do 'PrepareTransaction'
	Do 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	&Message.SetFocus()
	Grid.Visible = False
	WWPActions.Textarea_EnterBehaviourToAction(&Message.InternalName, Enter.InternalName)

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)

	Do 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid.Load

	Grid.Visible = True
	If WWPUserExtendedPhoto.ImageURI = ''
		&UserExtendedPhoto.FromImage(AvatarDiscussionPhoto)
	Else
		&UserExtendedPhoto.ImageURI = WWPUserExtendedPhoto.ImageURI
	Endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Enter

	If Not &Message.IsEmpty()
		&WWPDiscussionMessageThread.Load(&WWPDiscussionMessageThreadId)
		If &WWPDiscussionMessageThread.Success()
			If WWPBaseObjects.Discussions.WWP_CreateAndNotifyDiscussionMessage(&WWPDiscussionMessageThread.WWPEntityId, &WWPDiscussionMessageThreadId, &WWPDiscussionMessageThread.WWPDiscussionMessageEntityRecordId, &Message, UCMentions.SelectedItemsJson, &WWPDiscussionMessageThreadId.ToString(), "WWP_Notifications_NewDiscussionMessage", &WWPSubscriptionEntityRecordDescription, &WWPNotificationLink)
				&Message.SetEmpty()
				Grid.Refresh()
				&Message.SetFocus()
			Endif
		Endif
	Endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(&PgmName + !"GridState") = !""
		&GridState.FromXml(LoadGridState.Udp(&PgmName + !"GridState"))
	Else
		&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))
	Endif	
	If not &GridState.PageSize.Trim().IsEmpty()
		Grid.Rows = &GridState.PageSize.ToNumeric()
	EndIf
	Grid.CurrentPage = &GridState.CurrentPage

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))

	// Save grid state in session.

	&GridState.PageSize = str(Grid.Rows)
	&GridState.CurrentPage = Grid.CurrentPage
	SaveGridState.Call(&PgmName + !"GridState",  &GridState.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = True
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"WWPBaseObjects.Discussions.WWP_DiscussionMessage"

	&TrnContextAtt = new()
	&TrnContextAtt.AttributeName = !"WWPDiscussionMessageThreadId"
	&TrnContextAtt.AttributeValue = &WWPDiscussionMessageThreadId.ToString()
	&TrnContext.Attributes.Add(&TrnContextAtt)

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event OnMessage(&NotificationInfo)

	If &NotificationInfo.Id.StartsWith(!"WebNotification#")
		&WebNotification.FromJson(&NotificationInfo.Message)
		If &WebNotification.WWPNotificationDefinitionName.StartsWith("Discussion")
			If Not &WebNotification.WWPNotificationMetadata.IsEmpty()
				&WWPNotificationMetadataSDT.FromJson(&WebNotification.WWPNotificationMetadata)
				If &WWPDiscussionMessageThreadId.ToString().Trim() = &WWPNotificationMetadataSDT.SessionValue.Trim()
					WWPBaseObjects.Notifications.Common.WWP_ChangeNotificationStatus.SetNotificationReadById(&WebNotification.WWPNotificationId)
					GlobalEvents.Master_RefreshHeader()
				EndIf
			EndIf	
			Grid.Refresh()
		EndIf
	
	EndIf

EndEvent


]]></Source>
