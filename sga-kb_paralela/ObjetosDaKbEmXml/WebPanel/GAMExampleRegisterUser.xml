  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start
	TBPwdRequirements.Caption = GAM_GetTextPasswordRequirement()
	&GAMRepository = GAMRepository.Get()
	If &GAMRepository.UserIdentification = GAMRepositoryUserIdentifications.EMail
		&Name.Visible	= False
	Endif
	Do 'MarkRequieredUserData'
EndEvent

Event Enter
	&GAMRepository = GAMRepository.Get()
	If &Password = &PasswordConf
		&GAMUser.Name			= &Name
		&GAMUser.EMail			= &EMail
		&GAMUser.FirstName		= &FirstName
		&GAMUser.LastName		= &LastName
		&GAMUser.Birthday		= &Birthday
		&GAMUser.Gender			= &Gender
		&GAMUser.Password		= &Password
		&GAMUser.Save()
		If &GAMUser.Success()
			Commit
			If &GAMRepository.UserActivationMethod = GAMUserActivationMethod.Automatic
				If &Name.IsEmpty()
					&Name = &EMail
				Endif
				&LoginOK = GAMRepository.Login(&Name, &Password, &GAMLoginAdditionalParameters, &GAMErrorCollection)
				If &LoginOK
					GAMHome()
				Else
					Do 'DisplayMessages'
				EndIf
			Else
				&LinkURL = GAMRepository.ApplicationGetAccountActivationURL("")
				If &LinkURL.IsEmpty()
					&LinkURL = GAM_BuildAppURL(!"gam_activateuseraccount")
					&LinkURL+= !"%1"
				Endif
				GAM_CheckUserActivationMethod(&GAMUser.GUID, &LinkURL, &Messages)
				&isRegisterError = False
				For &Message in &Messages
					If &Message.Type = MessageTypes.Error
						&isRegisterError = True
						Exit
					Endif
				Endfor
				If &isRegisterError	= False
					&Name.Enabled 			= False
					&EMail.Enabled 			= False
					&Password.Enabled		= False
					&PasswordConf.Enabled 	= False
					&FirstName.Enabled 		= False
					&LastName.Enabled 		= False
					Login.Visible			= False
 				Endif
				Do 'DisplayMessages'
			Endif
		Else
			&GAMErrorCollection = &GAMUser.GetErrors()
			Do 'DisplayMessages'
		Endif
	Else
		Msg("GAM_Thepasswordandconfirmationpassworddonotmatch")
	Endif
EndEvent

Sub 'MarkRequieredUserData'
	If &GAMRepository.RequiredEmail
		&EMail.Caption += !'  *'
	EndIf
	If &GAMRepository.RequiredFirstName
		&FirstName.Caption += !'  *'
	EndIf
	If &GAMRepository.RequiredLastName
		&LastName.Caption += !' *'
	EndIf	
	If &GAMRepository.RequiredPassword
		&Password.Caption += !'  *'
		&PasswordConf.Caption += !'  *'
	EndIf
EndSub

Event 'Login'
	GAMExampleLogin()
EndEvent

Sub 'DisplayMessages'
	For &Message in &Messages
		Msg(&Message.Description)
	Endfor
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
EndSub
]]></Source>
