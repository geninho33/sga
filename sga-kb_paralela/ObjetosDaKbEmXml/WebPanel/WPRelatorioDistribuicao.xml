  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&dataIncial  = Today()-60
	&dataFinal   = Today()
	&localOrigem = 1
	&situacaoData  = 'R'
	&ordem = 'N'
	&totalizacao = 'N'
    LoadWWPContext.Call(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&produto.Visible = False
	Do 'LoadComboproduto'

	Do 'AttributesSecurityCode'
	&tipoRelatorio.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnImprimir'

     NovaAba.Target = PRINTRelatorioDistribuicao.Link( &dataIncial,
													   &dataFinal,
													   &rotaCodigo,
													   &localDestino,
													   &produto,
													   &situacaoData,
													   &ordem,
													   &totalizacao,
													   &tipoRelatorio,
													   &buscarGrupo )
    novaAba.OpenWindow()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_produto.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&produto.FromString(Combo_produto.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If Not (&rotaCodigo=0)
		&localDestino.Visible = False
		localDestino_Cell.Class = !'Invisible'
	Else
		&localDestino.Visible = True
		localDestino_Cell.Class = !'col-xs-12'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboproduto'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//&produto initial value has to be loaded manually at the beginning of this Subrutine
	For Each
		Order prodDescricao
		Where prefCodigo = &prefCodigo and
prodStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = prodCodigo.ToString().Trim()
		&Combo_DataItem.Title = prodDescricao
		&produto_Data.Add(&Combo_DataItem)
	EndFor
	Combo_produto.SelectedValue_set = iif(&produto.IsEmpty(), '', &produto.ToString().Trim())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
