    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid_Empowerer.GridInternalName = Grid.InternalName
	Grid.Rows = Page.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	&GridSelected = (&AtendimentoCodigoCollection.IndexOf(AtendimentoCodigo) = 0)
	&AreEnsNome = concat(AreEnsCodigo.ToString().Trim(),AreEnsNome,'-')
	&AreEnsEtapaNome = concat(AreEnsSequencial.ToString().Trim(),AreEnsEtapaNome,'-')
	&TurnoDescricao = concat(AtendimentoTurno.ToString().Trim(),Turno.EnumerationDescription(AtendimentoTurno),'-')
	&carGruDescricao = concat(carGruCodigo.ToString().Trim(),carGruDescricao,'-')

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	/* Acumula no Totalizador */
	if &GridSelected
		&TotAtendimentoNormalSegunda += AtendimentoNormalSegunda
		&TotValueAtendimentoNormalSegunda = &TotAtendimentoNormalSegunda.ToFormattedString()
	endif

EndEvent

Event Refresh

	/* Carrega linhas selecionadas */
	&AtendimentoCodigoCollection.FromJson(&IgnorarAtendimentoJson)

	&TotAtendimentoNormalSegunda = 0
	&GridSelected.Enabled = true

EndEvent

Event &GridSelected.ControlValueChanged

	if not &GridSelected
		/* Adiciona as linhas selecionadas */
		&AtendimentoCodigoCollection.Add(AtendimentoCodigo)

		/* Diminui no total da coluna */
		&TotAtendimentoNormalSegunda -= AtendimentoNormalSegunda
	else
		/* Remove das linhas selecionadas */
		&Index = &AtendimentoCodigoCollection.IndexOf(AtendimentoCodigo)
		if &Index > 0
			&AtendimentoCodigoCollection.Remove(&Index)
		endif

		/* Soma do total da coluna */
		&TotAtendimentoNormalSegunda += AtendimentoNormalSegunda
	endif

	&TotValueAtendimentoNormalSegunda = &TotAtendimentoNormalSegunda.ToFormattedString()

	GlobalEvents.IgnorarDados(&AtendimentoCodigoCollection.ToJson())

EndEvent


]]></Source>
