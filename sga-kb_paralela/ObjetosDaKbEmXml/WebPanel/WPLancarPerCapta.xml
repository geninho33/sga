  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTPerCaptas_Empowerer.GridInternalName = GridSDTPerCaptas.InternalName
	GridSDTPerCaptas.Rows = Page.Rows
	GridSDTPerCaptasPaginationBar.RowsPerPageSelectedValue = GridSDTPerCaptas.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

    for each
	    where prefCodigo = &prefCodigo
		where pratoCodigo = &pratoCodigo
	          &pratoDscricao = pratoDscricao
	endFor

    for each
	    where prefCodigo = &prefCodigo
		where prodCodigo = &prodCodigo
	          &prodDescricao = prodDescricao
	endFor

    &SDTPerCapta.Clear()
	&SDTPerCapta = new()
    for each trnsAreaEnsino
		where prefCodigo = &prefCodigo
		where ArenEnsStatus = 'A'
		      &AreEnsCodigo = AreEnsCodigo
		for each trnsAreaEnsino.Etapa
			where prefCodigo   = &prefCodigo
			where AreEnsCodigo = &AreEnsCodigo
				&item = new()
				&item.AreEnsCodigo      = AreEnsCodigo
				&item.AreEnsNome        = AreEnsNome
				&item.AreEnsSequencial  = AreEnsSequencial
				&item.AreEnsEtapaNome   = AreEnsEtapaNome
				&item.Turno             = 4
				&item.pratIngrQuantidade = PRCDBuscarPerCapta(&prefCodigo,&pratoCodigo, AreEnsCodigo,AreEnsSequencial,&prodCodigo)
				&SDTPerCapta.Add( &item )
		endFor
	endFor

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTPerCaptasCurrentPage = GridSDTPerCaptas.CurrentPage
	&GridSDTPerCaptasPageCount = GridSDTPerCaptas.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTPerCaptas.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTPerCaptasPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTPerCaptasPaginationBar.SelectedPage = !'Previous'
			GridSDTPerCaptas.PreviousPage()
		Case GridSDTPerCaptasPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTPerCaptas.CurrentPage
			&PageToGo += 1
			GridSDTPerCaptas.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTPerCaptasPaginationBar.SelectedPage)
			GridSDTPerCaptas.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTPerCaptasPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTPerCaptas.Rows = GridSDTPerCaptasPaginationBar.RowsPerPageSelectedValue
	GridSDTPerCaptas.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobotaoSalvar'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_BtnbotaoSalvar.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_BtnbotaoSalvar.Close

     if PRCDNutricionista()
     	Do 'SalvarPerCapta'
	 else
		msg('Este usuário não tem permissão !') 
    endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Ask If DVelop_ConfirmPanel_BtnbotaoSalvar.Result = !'Yes'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobotaoRetornar'

return

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'SalvarPerCapta'

	for &item in &SDTPerCapta
		PRCDSalvarPerCapta(&prefCodigo,&pratoCodigo,&prodCodigo,&item.AreEnsCodigo,&item.AreEnsSequencial,&item.pratIngrQuantidade)
	endFor
   msg('Percapta salva com sucesso !')

EndSub


