  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid.Rows = Page.Rows
	Grid_Empowerer.GridInternalName = Grid.InternalName

	If &HTTPRequest.Method = HttpMethod.Get
		Do 'LoadSavedFilters'
	EndIf
	ddo_AGExport.TitleControlIdToReplace = BtnAGExport.InternalName
	&AGExportData = new()
	
	&AGExportDataItem = new()
	&AGExportDataItem.Title = 'WWP_ExportCaption'
	&AGExportDataItem.Icon = ActionExport.Link()
	&AGExportDataItem.EventKey = !'Export'
	&AGExportDataItem.IsDivider = False
	&AGExportData.Add(&AGExportDataItem)
	
	&AGExportDataItem = new()
	&AGExportDataItem.Title = 'WWP_ExportReportCaption'
	&AGExportDataItem.Icon = ActionExportReport.Link()
	&AGExportDataItem.EventKey = !'ExportReport'
	&AGExportDataItem.IsDivider = False
	&AGExportData.Add(&AGExportDataItem)
	
	&IsAuthorized_doenDescricao = SecGAMIsAuthByFunctionalityKey.Udp(!'<Check_Is_Authenticated>')
	
	&GAMSession = GAMSession.Get(&GAMErrors)
	DDO_Grid.GridInternalName = Grid.InternalName
	DDO_Grid.GAMOAuthToken = &GAMSession.Token
	Form.Caption = ' Cadastro de Doenças'

	Do 'PrepareTransaction'
	Do 'LoadGridState'
	If &OrderedBy < 1
		&OrderedBy = 1
		Do 'SetDDOSortedStatus'
	EndIf
	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	GridPaginationBar.RowsPerPageSelectedValue = Grid.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: LoadPrefeitura
	LoadWWPContext(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo

	LoadWWPContext.Call(&WWPContext)

	Do 'CheckSecurityForActions'

	Do Case
		Case &ManageFiltersExecutionStep = 1
			&ManageFiltersExecutionStep = 2
		Case &ManageFiltersExecutionStep = 2
			&ManageFiltersExecutionStep = 0
			Do 'LoadSavedFilters'
	EndCase
	Do 'SaveGridState'

	&GridCurrentPage = Grid.CurrentPage
	&GridPageCount = Grid.PageCount
	&GridAppliedFilters = WWP_GetAppliedFiltersDescription(&Pgmname)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridPaginationBar.SelectedPage = !'Previous'
			Grid.PreviousPage()
		Case GridPaginationBar.SelectedPage = !'Next'
			Grid.NextPage()
		Otherwise
			&PageToGo.FromString(GridPaginationBar.SelectedPage)
			Grid.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid.Rows = GridPaginationBar.RowsPerPageSelectedValue
	Grid.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DDO_Grid.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case DDO_Grid.ActiveEventKey = !'<#OrderASC#>' OR DDO_Grid.ActiveEventKey = !'<#OrderDSC#>'
			&OrderedBy.FromString(DDO_Grid.SelectedValue_get)
			&OrderedDsc = iif(DDO_Grid.ActiveEventKey = !'<#OrderDSC#>', true, false)
			Do 'SetDDOSortedStatus'
			Grid.FirstPage()
		Case DDO_Grid.ActiveEventKey = !'<#Filter#>'
			Do Case
				Case DDO_Grid.SelectedColumn = !'doenCodigo'
					&TFdoenCodigo.FromString(DDO_Grid.FilteredText_get)
					&TFdoenCodigo_To.FromString(DDO_Grid.FilteredTextTo_get)
				Case DDO_Grid.SelectedColumn = !'doenDescricao'
					&TFdoenDescricao = DDO_Grid.FilteredText_get
					&TFdoenDescricao_Sel = DDO_Grid.SelectedValue_get
				Case DDO_Grid.SelectedColumn = !'doenStatus'
					&TFdoenStatus_SelsJson = DDO_Grid.SelectedValue_get
					&TFdoenStatus_Sels.FromJson(&TFdoenStatus_SelsJson)
			EndCase
			Grid.FirstPage()
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&Update = !'<i class="fa fa-pen"></i>'
	If (&IsAuthorized_Update)
		&Update.Link = trnsdoencas.Link(TrnMode.Update, prefCodigo, doenCodigo)
	Endif
	&Delete = !'<i class="fa fa-times"></i>'
	If (&IsAuthorized_Delete)
		&Delete.Link = trnsdoencas.Link(TrnMode.Delete, prefCodigo, doenCodigo)
	Endif
	If (&IsAuthorized_doenDescricao)
		doenDescricao.Link = trnsdoencasView.Link(prefCodigo, doenCodigo, '')
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event ddo_ManageFilters.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case ddo_ManageFilters.ActiveEventKey = !'<#Clean#>'
			Do 'CleanFilters'
			Grid.FirstPage()
		Case ddo_ManageFilters.ActiveEventKey = !'<#Save#>'
			Do 'SaveGridState'
			SaveFilterAs.Popup(!'trnsdoencasWWFilters', &PgmName + !"GridState")
			&ManageFiltersExecutionStep = 2
			Refresh
		Case ddo_ManageFilters.ActiveEventKey = !'<#Manage#>'
			ManageFilters.Popup(!'trnsdoencasWWFilters')
			&ManageFiltersExecutionStep = 2
			Refresh
		Otherwise
			&ManageFiltersXml = GetFilterByName(!'trnsdoencasWWFilters', ddo_ManageFilters.ActiveEventKey)
			If &ManageFiltersXml.IsEmpty()
				msg('WWP_FilterNotExist')
			Else
				Do 'CleanFilters'
				SaveGridState.Call(&PgmName + !"GridState",  &ManageFiltersXml)
				&GridState.FromXml(&ManageFiltersXml)
				&OrderedBy = &GridState.OrderedBy
				&OrderedDsc = &GridState.OrderedDsc
				Do 'SetDDOSortedStatus' 
				Do 'LoadRegFiltersState'
				Grid.FirstPage()
			EndIf
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoInsert'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Insert)
		trnsdoencas.Call(TrnMode.Insert, nullvalue(prefCodigo), nullvalue(doenCodigo))
	Else
		msg("WWP_ActionNoLongerAvailable")
		Refresh
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event ddo_AGExport.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case ddo_AGExport.ActiveEventKey = !'Export'
			Do 'DoExport'
		Case ddo_AGExport.ActiveEventKey = !'ExportReport'
			Do 'DoExportReport'
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'SetDDOSortedStatus'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DDO_Grid.SortedStatus = &OrderedBy.ToString().Trim() + !':' + iif(&OrderedDsc, !'DSC', !'ASC')

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'CheckSecurityForActions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&IsAuthorized_Update = SecGAMIsAuthByFunctionalityKey.Udp(!'trnsdoencasww_Update')
	If not (&IsAuthorized_Update)
		&Update.Visible = False
	Endif 
	&IsAuthorized_Delete = SecGAMIsAuthByFunctionalityKey.Udp(!'trnsdoencasww_Delete')
	If not (&IsAuthorized_Delete)
		&Delete.Visible = False
	Endif 
	&IsAuthorized_Insert = SecGAMIsAuthByFunctionalityKey.Udp(!'trnsdoencasww_Insert')
	If not (&IsAuthorized_Insert)
		BtnInsert.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadSavedFilters'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&ManageFiltersData = WWP_ManageFiltersLoadSavedFilters(!'trnsdoencasWWFilters', '', '', False)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'CleanFilters'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFdoenCodigo.SetEmpty()
	&TFdoenCodigo_To.SetEmpty()
	&TFdoenDescricao.SetEmpty()
	&TFdoenDescricao_Sel.SetEmpty()
	&TFdoenStatus_Sels = new()
	DDO_Grid.SelectedValue_set = ''
	DDO_Grid.FilteredText_set = ''
	DDO_Grid.FilteredTextTo_set = ''

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(&PgmName + !"GridState") = !""
		&GridState.FromXml(LoadGridState.Udp(&PgmName + !"GridState"))
	Else
		&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))
	Endif	

	&OrderedBy = &GridState.OrderedBy
	&OrderedDsc = &GridState.OrderedDsc
	Do 'SetDDOSortedStatus'
	Do 'LoadRegFiltersState'
	If not &GridState.PageSize.Trim().IsEmpty()
		Grid.Rows = &GridState.PageSize.ToNumeric()
	EndIf
	Grid.CurrentPage = &GridState.CurrentPage

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadRegFiltersState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFDOENCODIGO"
				&TFdoenCodigo.FromString(&GridStateFilterValue.Value)
				&TFdoenCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFDOENDESCRICAO"
				&TFdoenDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDOENDESCRICAO_SEL"
				&TFdoenDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDOENSTATUS_SEL"
				&TFdoenStatus_SelsJson = &GridStateFilterValue.Value
				&TFdoenStatus_Sels.FromJson(&TFdoenStatus_SelsJson)
		EndCase
	EndFor
	DDO_Grid.SelectedValue_set = !'|' + WWP_GetFilterVal(&TFdoenDescricao_Sel.IsEmpty(), &TFdoenDescricao_Sel) + !'|' + WWP_GetFilterVal(&TFdoenStatus_Sels.Count = 0, &TFdoenStatus_SelsJson)
	DDO_Grid.FilteredText_set = iif(&TFdoenCodigo.IsEmpty(), '', &TFdoenCodigo.ToString()) + !'|' + WWP_GetFilterVal(&TFdoenDescricao.IsEmpty(), &TFdoenDescricao) + !'|'
	DDO_Grid.FilteredTextTo_set = iif(&TFdoenCodigo_To.IsEmpty(), '', &TFdoenCodigo_To.ToString()) + !'||'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))

	// Save grid state in session.
	&GridState.OrderedBy = &OrderedBy
	&GridState.OrderedDsc = &OrderedDsc
	&GridState.FilterValues.Clear()
	WWP_GridStateAddFilterValue(&GridState, !"TFDOENCODIGO", "Código", not (&TFdoenCodigo.IsEmpty() AND &TFdoenCodigo_To.IsEmpty()), 0, &TFdoenCodigo.ToString().Trim(), iif(&TFdoenCodigo.IsEmpty(), '', trim(&TFdoenCodigo.ToFormattedString())), True, &TFdoenCodigo_To.ToString().Trim(), iif(&TFdoenCodigo_To.IsEmpty(), '', trim(&TFdoenCodigo_To.ToFormattedString())))
	WWP_GridStateAddFilterValueAndSel(&GridState, !"TFDOENDESCRICAO", "Descrição", not &TFdoenDescricao.IsEmpty(), 0, &TFdoenDescricao, &TFdoenDescricao, False, '', '', not &TFdoenDescricao_Sel.IsEmpty(), &TFdoenDescricao_Sel, &TFdoenDescricao_Sel)
	&AuxText = iif(&TFdoenStatus_Sels.Count = 1, !'[' + &TFdoenStatus_Sels.Item(1) + !']', 'WWP_FilterValueDescription_MultipleValues')
	WWP_GridStateAddFilterValue(&GridState, !"TFDOENSTATUS_SEL", "Situação", not &TFdoenStatus_Sels.Count = 0, 0, &TFdoenStatus_Sels.ToJson(), iif(&AuxText = '', '', &AuxText.Replace(!"[S]", "Sim").Replace(!"[N]", "Não")), False, '', '')

	&GridState.PageSize = str(Grid.Rows)
	&GridState.CurrentPage = Grid.CurrentPage
	SaveGridState.Call(&PgmName + !"GridState",  &GridState.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = True
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"trnsdoencas"

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'DoExport'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Generate Excel spreadsheet and download it.
	Do 'LoadGridState'
	trnsdoencasWWExport.Call(&ExcelFilename, &ErrorMessage)
	If (&ExcelFilename <> "")
		Link(&ExcelFilename)
	Else
		msg(&ErrorMessage)
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'DoExportReport'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Generate PDF file.
	Do 'LoadGridState'
	InNewWindow1.Target = trnsdoencasWWExportReport.Link()
	InNewWindow1.Height = !'600'
	InNewWindow1.Width = !'800'
	InNewWindow1.OpenWindow()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


