    <Source><![CDATA[
Event Start

	LoadWWPContext(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'LoadVariablesFromWizardData'

	Do 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	CompletedTitle.Caption = format(CompletedTitle.Caption,&WizardData.Guias.remCodigo.ToString().Trim())

EndEvent

Event Enter

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If not &HasValidationErrors
		Do 'SaveVariablesToWizardData'
		Do 'FinishWizard'
		&WebSession.Remove(&WebSessionKey)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	RanchoWizardPlanilha('','',false)

EndEvent

Event 'DoDistribuicao'

	do 'FinishWizard'
	&WebSession.Set(!'Wizard_remCodigo',&WizardData.Guias.remCodigo.ToString())
	trnsdistribuicaoWW()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoLargada'

	&Arquivo = format(!'PublicTempStorage\Largadas-%1.xlsx',GUID.NewGuid())
	&IsSucess = LargadaGeraExcel(&prefCodigo,&WizardData.Locais.rotaCodigo.ToJson(),False,&WizardData.Periodo.DataEnvio,&WizardData.Alimentos.prodCodigoTipoRemessa,&Arquivo,0,&Message)
	if not &IsSucess
		msg( DVMessageGetBasicNotificationMsg('Erro!',&Message.Description,DVMessageType.error,"",true,"","") )
	else
		&Url = &HttpRequest.BaseUrl + &Arquivo
		Link(&Url)
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: XmlFileToWizardData
	&WizardData.FromXML(FileXmlToWizardData(&WebSessionKey))
	&WebSession.Set(&WebSessionKey,&WizardData.ToJson())

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveVariablesToWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())

	//Code block: WizardDataToXmlFile
	WizardDataToFileXML(&WebSessionKey,&WizardData.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'FinishWizard'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: RemoveXmlFileWizardData
	RemoveFileXMLFromWizardData(&WebSessionKey)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

