  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start
	//Used when multiple repository connections exist  ////////////////////////////
	&ConnectionInfoCollection = GeneXusSecurity.GAM.GetConnections()
	If &ConnectionInfoCollection.Count > 0 
		//The first connection found is established by default 
		&isOK = GeneXusSecurity.GAM.SetConnection(&ConnectionInfoCollection.Item(1).Name, &GAMErrorCollection)
	EndIf
	///////////////////////////////////////////////////////////////////////////////

	&isRedirect = False
	//Gets last error in the GAM /////////////////////////////
	&GAMErrorCollection = GAMRepository.GetLastErrors()
	If &GAMErrorCollection.Count > 0  AND  &GAMErrorCollection.Item(1).Code <> GAMErrorMessages.UserMustBeAuthenticated
		Do 'DisplayMessages'
	Else
		&SessionValid = GAMSession.IsValid(&Session, &GAMErrorCollection)
		If &SessionValid and not &Session.IsAnonymous
			&URL = GAMRepository.GetLastErrorsURL()
			If &URL.IsEmpty()
				GAMApplication.GoHome()
			Else
				Link(&URL)
			Endif
		Else
			//This method uses the first authentication type GAMRemote by name
			GAMRepository.LoginGAMRemote()
			&GAMErrorCollection = GAMRepository.GetLastErrors()
			//When in GAM you defined many type of authentication GAMRemote you should use the following method:
			//&GAMLoginAdditionalParameters.AuthenticationTypeName = use the name of your authentication type
			//&isLoginOK = GAMRepository.Login("", "", &AdditionalParameter, &GAMErrorCollection )
			If &GAMErrorCollection.Count > 0
				Do 'DisplayMessages'
			Endif
		Endif
	Endif
Endevent


Sub 'DisplayMessages'
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
EndSub
]]></Source>
