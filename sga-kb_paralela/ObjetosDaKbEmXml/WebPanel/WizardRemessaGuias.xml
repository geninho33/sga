  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
   	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'LoadVariablesFromWizardData'
	&remCodigo.Visible = False
	&Locais_locCodigo.Visible = False
	Grid_Empowerer.GridInternalName = Grid.InternalName
	Grid.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	/* Padrão sem guias */
	LabelGridEmpty.Visible = true
	BtnWizardNext.Visible = false
	BtnPrevisaoCompra.Visible = false

EndEvent

Event FreeStyleGridLocais.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	for &GridLocaisItem in &WizardData.Atendimento.GridLocais

		&Locais_locCodigo = &GridLocaisItem.locCodigo
		&Locais_Observacao = &GridLocaisItem.LocObservacaoGuia

		Do 'ValidaGuia'

		if &GerarGuia
			LabelGridEmpty.Visible = false
			BtnWizardNext.Visible = true
			BtnPrevisaoCompra.Visible = true
			Local.Caption = format('LOCAL: %1 (%2) - %3',&GridLocaisItem.locDescricao,&GridLocaisItem.locCodigo.ToString().Trim(),&GridLocaisItem.rotaDescricao)
			FreeStyleGridLocais.Load()
		endif

	endfor

EndEvent

Event Grid.Load

	if 1=2 // Inutiliza código do WWPLus

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	&GridSelected = false
	For &GridSelectedRow in &WizardData.Guias.Grid
		If &GridSelectedRow.locCodigo = &locCodigo
			AND &GridSelectedRow.prodCodigo = &prodCodigo
			AND &GridSelectedRow.prodDescricao = &prodDescricao
			AND &GridSelectedRow.Quantidade = &Quantidade
			AND &GridSelectedRow.uniDescricao = &uniDescricao
			AND &GridSelectedRow.distObservacao = &distObservacao
			AND &GridSelectedRow.prodPesoConsumo = &prodPesoConsumo
			AND &GridSelectedRow.QtdeOferta = &QtdeOferta
			&GridSelected = True
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	Endif

	&locCodigo = &Locais_locCodigo
	&distObservacao = &Locais_Observacao

	/* Calcula necessidade dos produtos por unidade */
	for &GridAlimentosItem in &WizardData.Alimentos.GridAlimentos

		&GridSelected	 = true
		&prodCodigo 	 = &GridAlimentosItem.prodCodigo
		&prodDescricao 	 = &GridAlimentosItem.prodDescricao
		&uniDescricao	 = &GridAlimentosItem.uniDescricao
		&prodPesoConsumo = &GridAlimentosItem.prodPesoConsumo
		&Quantidade		 = 0
		&ValorPerCapta 	 = 0
		&QtdeOferta		 = 0

		/* Localiza Percaptas/Ofertas do produto */
		for &IngredienteSDT in &ListaIngredienteSDT

			if &IngredienteSDT.prodCodigo = &prodCodigo

				/* Soma Percapta */
				For each Atendimento
					Where prefCodigo = &prefCodigo
					Where locCodigo = &locCodigo
					Where carGruCodigo in GruposCardapioReferenteMesAno(&prefCodigo,&WizardData.Periodo.Mes,&WizardData.Periodo.Ano)
					Where carGruStatus = Status.Ativo
					Where not AtendimentoCodigo in &AtendimentoCodigoCollection

					for &PercaptaOfertaItem in &IngredienteSDT.PercaptaOferta

						if  &PercaptaOfertaItem.AreEnsCodigo = AreEnsCodigo and
							&PercaptaOfertaItem.AreEnsSequencial = AreEnsSequencial and
							&PercaptaOfertaItem.carGruTurno = AtendimentoTurno

							&ValorPerCapta  += ((&PercaptaOfertaItem.Percapta * AtendimentoNormalSegunda) * &PercaptaOfertaItem.Oferta)
							&QtdeOferta 	+= &PercaptaOfertaItem.Oferta

							Exit

						endif

					endfor

				Endfor

				Exit

			endif

		endfor

		if &ValorPerCapta > 0
			&Quantidade = round(((&ValorPerCapta / &prodPesoConsumo) + 0.49),0)
			if &Quantidade = 0
				&Quantidade = 1
			endif

			Load
		endif

	endfor

EndEvent

Event Enter

	// Grava os dados e gera a distribuição
	Do 'SaveVariablesToWizardData'
	&HasValidationErrors = false
	&IsSucess = WizardRemessaGravaDados(&WebSessionKey,&remCodigo,&Message)
	if not &IsSucess
		&HasValidationErrors = true
		msg(&Message.Description)
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If not &HasValidationErrors
		Do 'SaveVariablesToWizardData'
		WizardRemessa(!'Guias', !'Conclusao', false)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'WizardPrevious'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'SaveVariablesToWizardData'
	WizardRemessa(!'Guias', !'Alimentos', true)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoPrevisaoCompra'

	Do 'SaveVariablesToWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	PRINTPrevisaoCompra.PopUp(&prefCodigo, &WebSessionKey)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadGridSelectedRows'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.Guias.Grid.Clear()
	For Each Line in Grid
		If (&GridSelected)
			&GridSelectedRow = new()

			&GridSelectedRow.locCodigo = &locCodigo
			&GridSelectedRow.prodCodigo = &prodCodigo
			&GridSelectedRow.prodDescricao = &prodDescricao
			&GridSelectedRow.Quantidade = &Quantidade
			&GridSelectedRow.uniDescricao = &uniDescricao
			&GridSelectedRow.distObservacao = &distObservacao
			&GridSelectedRow.prodPesoConsumo = &prodPesoConsumo
			&GridSelectedRow.QtdeOferta = &QtdeOferta

			&WizardData.Guias.Grid.Add(&GridSelectedRow)
		Endif
	Endfor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadVariablesFromWizardData'

	/* Carrega dados do arquivo XML */
	&WizardData.FromXml(FileXmlToWizardData(&WebSessionKey))
	&WizardData.Guias.Grid.Clear()
	&WebSession.Set(&WebSessionKey,&WizardData.ToJson())

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&remCodigo = &WizardData.Guias.remCodigo

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveVariablesToWizardData'

	if 1=2 // Inutiliza código do WWPLus

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Guias.remCodigo = &remCodigo
	&WizardData.Guias.FreeStyleGridLocais.Clear()
	For Each Line in FreeStyleGridLocais
		&FreeStyleGridLocaisItem = new()
		&FreeStyleGridLocaisItem.Locais_locCodigo = &Locais_locCodigo
		&FreeStyleGridLocaisItem.Locais_Observacao = &Locais_Observacao

		&WizardData.Guias.FreeStyleGridLocais.Add(&FreeStyleGridLocaisItem)
	EndFor
	Do 'LoadGridSelectedRows'
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	endif

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Guias.remCodigo = &remCodigo
	&WizardData.Guias.FreeStyleGridLocais.Clear()
	&WizardData.Guias.Grid.Clear()
//	&GuiasGrid = new()

	For Each Line in FreeStyleGridLocais

		For Each Line in Grid
			If (&GridSelected)
				&GridSelectedRow = new()

				&GridSelectedRow.locCodigo = &locCodigo
				&GridSelectedRow.prodCodigo = &prodCodigo
				&GridSelectedRow.prodDescricao = &prodDescricao
				&GridSelectedRow.Quantidade = &Quantidade
				&GridSelectedRow.uniDescricao = &uniDescricao
				&GridSelectedRow.distObservacao = &distObservacao
				&GridSelectedRow.prodPesoConsumo = &prodPesoConsumo
				&GridSelectedRow.QtdeOferta = &QtdeOferta

				&WizardData.Guias.Grid.Add(&GridSelectedRow)
//				&GuiasGrid.Add(&GridSelectedRow)
			Endif
		Endfor

	Endfor

	/* Grava dados no arquivo XML */
	WizardDataToFileXML(&WebSessionKey,&WizardData.ToXml())

	&WizardData.Guias.Grid.Clear()
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())
//	&WebSession.Set(&WebSessionKey + !'_Guias', &GuiasGrid.ToJson())

EndSub

Event GlobalEvents.ForceUpdateWizardData

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: ForceUpdateWizardDataGlobalEvent
	do 'SaveVariablesToWizardData'
	do 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Carrega coleção de Áreas, Etapas e Turnos de atendimento */
	&AreasEtapasTurnosAtendimentoCollection.FromJson(&WebSession.Get(!'WizardRemessa_AreasEtapasTurnosAtendimentoCollection'))

	/* Carrega coleção de atendimentos a serem ignorados */
	&AtendimentoCodigoCollection.Clear()
	&AtendimentoCodigoCollection.FromJson(&WizardData.Atendimento.IgnorarAtendimentoJson)

	/* Carrega coleção de Percaptas a serem ignoradas */
	&IgnorarPercaptaPropertiesCollection.Clear()
	&IgnorarPercaptaPropertiesCollection.FromJson(&WizardData.Alimentos.IgnorarPercaptaJson)

	/* Monta lista de ingredientes */
	&ListaIngredienteSDT = new()
	for &GridAlimentosItem in &WizardData.Alimentos.GridAlimentos

		&IngredienteSDT = new()
		&IngredienteSDT.prodCodigo = &GridAlimentosItem.prodCodigo

		for &Properties in &AreasEtapasTurnosAtendimentoCollection

			&AreEnsCodigo.FromString(&Properties.Get(!'AreEnsCodigo'))
			&AreEnsSequencial.FromString(&Properties.Get(!'AreEnsSequencial'))
			&carGruTurno.FromString(&Properties.Get(!'AtendimentoTurno'))
			&carDapGruCodigo.FromString(&Properties.Get(!'carGruCodigo'))

			/* Filtra Percaptas que não entram no cálculo */
			&Chave.Clear()
			&Chave.Set(!'AreEnsCodigo',&AreEnsCodigo.ToString())
			&Chave.Set(!'AreEnsSequencial',&AreEnsSequencial.ToString())
			&Chave.Set(!'carGruTurno',&carGruTurno.ToString())
			&ChaveJson = &Chave.ToJson()
			if (&IgnorarPercaptaPropertiesCollection.IndexOf(&ChaveJson) = 0)

				For each trnspratosingredientes, trnscardapioprato
					Order prefCodigo, pratIngrProdCodigo, AreEnsCodigo, AreEnsSequencial, carGruTurno
					Where prefCodigo = &prefCodigo
					Where pratIngrProdCodigo = &GridAlimentosItem.prodCodigo
					Where AreEnsCodigo = &AreEnsCodigo
					Where AreEnsSequencial = &AreEnsSequencial
					Where carGruTurno = &carGruTurno
					Where carDapGruCodigo = &carDapGruCodigo
					Where carPratoData >= &WizardData.Periodo.DataInicial
					Where carPratoData <= &WizardData.Periodo.DataFinal
					Where carDapStatus = Status.Ativo
					Where pratoCodigo = carPratoRefeicao
					Where pratIngrStatus = Status.Ativo
					Where pratIngrQuantidade > 0

					&PercaptaOfertaItem = new()
					&PercaptaOfertaItem.AreEnsCodigo 	 = AreEnsCodigo
					&PercaptaOfertaItem.AreEnsSequencial = AreEnsSequencial
					&PercaptaOfertaItem.carGruTurno		 = carGruTurno
					&PercaptaOfertaItem.Percapta		 = pratIngrQuantidade

					&Oferta = 0
					/* Calcula oferta */
					For each trnspratosingredientes
						&Oferta += 1
					Endfor

					&PercaptaOfertaItem.Oferta = &Oferta
					&IngredienteSDT.PercaptaOferta.Add(&PercaptaOfertaItem)

				Endfor

			endif

		endfor

		if &IngredienteSDT.PercaptaOferta.Count > 0
			&ListaIngredienteSDT.Add(&IngredienteSDT)
		endif

	endfor

	log.Info(&ListaIngredienteSDT.ToJson(),&Pgmname+'.ListaIngredienteSDT')

EndEvent

Sub 'ValidaGuia'

	&GerarGuia = false
	for &GridAlimentosItem in &WizardData.Alimentos.GridAlimentos

		for &IngredienteSDT in &ListaIngredienteSDT

			if &IngredienteSDT.prodCodigo = &GridAlimentosItem.prodCodigo

				For each Atendimento
					Where prefCodigo = &prefCodigo
					Where locCodigo = &Locais_locCodigo
					Where carGruCodigo in GruposCardapioReferenteMesAno(&prefCodigo,&WizardData.Periodo.Mes,&WizardData.Periodo.Ano)
					Where carGruStatus = Status.Ativo
					Where not AtendimentoCodigo in &AtendimentoCodigoCollection

					for &PercaptaOfertaItem in &IngredienteSDT.PercaptaOferta

						if  &PercaptaOfertaItem.AreEnsCodigo = AreEnsCodigo and
							&PercaptaOfertaItem.AreEnsSequencial = AreEnsSequencial and
							&PercaptaOfertaItem.carGruTurno = AtendimentoTurno

							&GerarGuia = true
							Exit
						endif

					endfor

					if &GerarGuia
						Exit
					endif

				Endfor

			endif

			if &GerarGuia
				Exit
			endif

		endfor

		if &GerarGuia
			Exit
		endif

	endfor

