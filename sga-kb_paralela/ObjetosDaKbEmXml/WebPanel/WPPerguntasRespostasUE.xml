EndSub

Sub 'popular'

    for each
		where prefCodigo   = &prefCodigo
		where perResCodigo = &perResCodigo
			  &perResAssunto  = perResAssunto
			  &perResPergunta = perResPergunta
			  &perResResposta = perResResposta
    endFor

EndSub


