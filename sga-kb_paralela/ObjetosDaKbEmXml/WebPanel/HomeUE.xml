  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
    if &WWPContext.prefCodigo.IsEmpty()
	   WPLoginUE()	
	else   
		&prefCodigo = &WWPContext.prefCodigo
		&locCodigo  = &WWPContext.locCodigo
		&locDescricao = PRCDVinculadaUE(&prefCodigo,&locCodigo)
		if not &locDescricao.IsEmpty()
		   WPLoginUE( &locDescricao )	
		endif	
		
		// PRCDFechamentoEstoqueUE(&prefCodigo,&locCodigo)
		
		&Card1_Value  = 0
		&Card2_Value  = 0
		&Card3_Value  = 0
		&Card4_Value  = 0
		&mes          = &Today.Month()
		&ano          = &Today.Year()
		&Mmes         = false
		
		Do 'Alunos da Unidade'
		Do 'Compras do Mes'
		Do 'Total de Distribuicao do Mes'
		Do 'Total de Pratos do Mes'
		
		if &Card1_Value = 0
		   if &mes=1
			  &mes = 12
			  &ano = &ano-1
		   else
		      &mes = &mes - 1
		   endif
	       &Mmes = true
	       Do 'Compras do Mes'
	    endif
		
		if &Card2_Value = 0
		   if not &Mmes
			   if &mes=1
				  &mes = 12
				  &ano = &ano-1
			   else
			      &mes = &mes - 1
			   endif
	       endif
	       &Mmes = true
	       Do 'Total de Distribuicao do Mes'
			
	    endif
		
		if &Card3_Value = 0
		   if not &Mmes
			   if &mes=1
				  &mes = 12
				  &ano = &ano-1
			   else
			      &mes = &mes - 1
			   endif
	       endif
	       &Mmes = true
	       Do 'Total de Pratos do Mes'
	    endif
		
		if &Card4_Value = 0
	   	  if not &Mmes
		     if &mes=1
				  &mes = 12
				  &ano = &ano-1
		     else
			      &mes = &mes - 1
		     endif
	       endif
	       &Mmes = true
	       Do 'Alunos da Unidade'
			
	    endif
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: AssignProgressUCValue - Card1
	Card1_Progress.Percentage = &Card1_ProgressValue
	Card1_Progress.Caption = &Card1_ProgressValue.ToFormattedString()

	//Code block: AssignProgressUCValue - Card2
	Card2_Progress.Percentage = &Card2_ProgressValue
	Card2_Progress.Caption = &Card2_ProgressValue.ToFormattedString()

	//Code block: AssignProgressUCValue - Card3
	Card3_Progress.Percentage = &Card3_ProgressValue
	Card3_Progress.Caption = &Card3_ProgressValue.ToFormattedString()

	//Code block: AssignProgressUCValue - Card4
	Card4_Progress.Percentage = &Card4_ProgressValue
	Card4_Progress.Caption = &Card4_ProgressValue.ToFormattedString()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Total de Distribuicao do Mes'

    for each
		where prefCodigo            = &prefCodigo
		where distDataEnvio.Year()  = &ano
		where distDataEnvio.Month() = &mes
		where distLocalDestino      = &WWPContext.locCodigo
              &Card2_Value += 1
	endFor

EndSub

Sub 'Compras do Mes'

    //  Totalizando as compras total do mês
	for each
		where prefCodigo = &prefCodigo
		where notaData.Year() = &ano
		where notaData.Month() = &mes
		where notaStatus<>'C'
              &Card1_Value += notaTotal
    endfor

EndSub

Sub 'Alunos da Unidade'

	//  Totalizando os alunos da Unidade
	For each
		Where prefCodigo = &prefCodigo
		where RanchoMes  = &mes
		where RanchoAno  = &ano
		where locCodigo = &WWPContext.locCodigo
		where RanchoAreasEnsinoCodigo<>99999997
              &Card4_Value +=  RanchoAreasEnsinoPessoasQuantidade
	Endfor

EndSub

Sub 'Total de Pratos do Mes'

    // Totalizando os pratos do mês
    for each
		where prefCodigo = &prefCodigo
		where carPratoData.Year()  = &ano
		where carPratoData.Month() = &mes
              &Card3_Value += 1
	endFor

EndSub


]]></Source>
