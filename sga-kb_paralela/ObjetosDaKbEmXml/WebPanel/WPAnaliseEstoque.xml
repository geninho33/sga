Sub 'Popular Produtos'

    &SDTEstoqueUE.Clear()
	&processado = 1

	for each trnsprodutos
		where prefCodigo       = &prefCodigo
		where prodCodigo        = &prodCodigo when &prodCodigo<>0
		where prodStatus   = 'A'
			  &estoUeSaldo = find(estoUeSaldo,estoUeProdCodigo = prodCodigo and estoUeLocCodigo = &locCodigo and prefCodigo = &prefCodigo,0 )
			  if &estoUeSaldo > -1
				 &estoque  = new()
				 &estoque.estoUeCodigo        = find(estoUeCodigo,estoUeProdCodigo = prodCodigo and estoUeLocCodigo = &locCodigo and prefCodigo = &prefCodigo,0 )   
				 &estoque.estoUelocCodigo     = &locCodigo
				 &estoque.estoUelocDescricao  = find( locDescricao, locCodigo = &locCodigo and prefCodigo = &prefCodigo,'' )
				 &estoque.estoUeProdCodigo    = prodCodigo
				 &estoque.estoUeProdDescricao = prodDescricao
				 &estoque.estoUeSaldo         = &estoUeSaldo
				 &estoque.estoUeQtdeFixo      = PRCDAnaliseEstoque(&prefCodigo,&locCodigo,prodCodigo,&mesAno)
				 &estoque.estoUePrevisao      = &processado
				 for each
					 where uniCodigo = prodUnidMedConsumo
						   &estoque.estoUeUniDescricao  = uniDescricao
				 endFor
				
				 Do Case
					Case &opcao = 'I'
						if  &estoque.estoUeSaldo = &estoque.estoUeQtdeFixo
							&SDTEstoqueUE.Add( &estoque )
							&processado += 1
						endif
					Case &opcao = 'D'
						if  &estoque.estoUeSaldo <> &estoque.estoUeQtdeFixo
							&SDTEstoqueUE.Add( &estoque )
							&processado += 1
						endif
					Case &opcao = 'A'
						if  &estoque.estoUeSaldo<0
							&SDTEstoqueUE.Add( &estoque )
							&processado += 1
						endif
					Case &opcao = 'P'
						if  &estoque.estoUeQtdeFixo<0
							&SDTEstoqueUE.Add( &estoque )
							&processado += 1
						endif
					Otherwise
						&SDTEstoqueUE.Add( &estoque )
						&processado += 1
				 Endcase
			 endif	
	endfor

    msg( &processado.ToString().Trim() +' Produto(s) Processado(s) ' )

EndSub


