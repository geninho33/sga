	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'CheckSecurityForActions'

	&GridSDTEstoqueUEsCurrentPage = GridSDTEstoqueUEs.CurrentPage
	&GridSDTEstoqueUEsPageCount = GridSDTEstoqueUEs.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEstoqueUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid
	&btnSalvarEstoqueUE = !'<i class="fas fa-balance-scale"></i>'
	
	&btnMovEstoque = !'<i class="fas fa-tasks"></i>'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEstoqueUEsPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTEstoqueUEsPaginationBar.SelectedPage = !'Previous'
			GridSDTEstoqueUEs.PreviousPage()
		Case GridSDTEstoqueUEsPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTEstoqueUEs.CurrentPage
			&PageToGo += 1
			GridSDTEstoqueUEs.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTEstoqueUEsPaginationBar.SelectedPage)
			GridSDTEstoqueUEs.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEstoqueUEsPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTEstoqueUEs.Rows = GridSDTEstoqueUEsPaginationBar.RowsPerPageSelectedValue
	GridSDTEstoqueUEs.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &btnSalvarEstoqueUE.Click

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_btnSalvarEstoqueUE.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_btnSalvarEstoqueUE.Close

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If DVelop_ConfirmPanel_btnSalvarEstoqueUE.Result = !'Yes'
		Do 'Do btnSalvarEstoqueUE'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &btnMovEstoque.Click

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_btnMovEstoque)
		WPMovimentacaoProdutoUE.PopUp(&prefCodigo, &SDTEstoqueUE.CurrentItem.estoUeLocCodigo, &SDTEstoqueUE.CurrentItem.estoUeProdCodigo, &mesAno)
		Refresh
	Else
		msg("WWP_ActionNoLongerAvailable")
		Refresh
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

