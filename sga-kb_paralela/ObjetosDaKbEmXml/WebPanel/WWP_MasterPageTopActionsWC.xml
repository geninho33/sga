    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	&GAMUser = GAMUser.Get()
	&UserName = iif(&GAMUser.FirstName.IsEmpty(), &GAMUser.Name, &GAMUser.FirstName.Trim() + " " + &GAMUser.LastName.Trim())
	&GAMRoleCollection = GAMSession.GetRoles(&GAMErrorCollection)
	For &GAMRole In &GAMRoleCollection
		If Not &RolesDescriptions.IsEmpty()
			&RolesDescriptions = &RolesDescriptions + ", "
		Endif
		&RolesDescriptions = &RolesDescriptions + iif(&GAMRole.Description.IsEmpty(), &GAMRole.Name, &GAMRole.Description)
	EndFor
	&UserImage = Avatar.Link()

EndEvent

Event 'DoActionChangePassword'

	WWPActions.DropDownComponent_Close(TableMain.InternalName)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GAMChangeYourPassword.Call()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoLogout'

	&isOk = GAMRepository.Logout(&GAMErrorCollection)
	&WebSession.Clear()
	GAMExampleLogin()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent


