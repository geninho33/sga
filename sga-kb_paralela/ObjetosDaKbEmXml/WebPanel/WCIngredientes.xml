  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&totalPerCapta = 0
	&SDTIngredientes.Clear()
    for each trnspratosingredientes, trnsprodutos
		where prefCodigo = &prefCodigo
		where pratoCodigo = &pratoCodigo	
		where prodCodigo = pratIngrProdCodigo
		  &item = new()
		  &item.pratIngrProdCodigo  	  = pratIngrProdCodigo
		  &item.pratIngrProdDescricaoItem = prodDescricao
		  &item.pratIngrQuantidade        = pratIngrQuantidade
		  &totalPerCapta    			 += pratIngrQuantidade
		  // &item.pratIngrProdUnidDescricao = uniFracao
		  &SDTIngredientes.Add( &item )
    endFor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTIngredientess_Empowerer.GridInternalName = GridSDTIngredientess.InternalName
	GridSDTIngredientess.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

