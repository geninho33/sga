  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start
	&GAMUser = GAMRepository.GetUserToChangePassword()
	If not &GAMUser.Name.IsEmpty()
		&UserName = &GAMUser.Name
	Else
		&GAMErrorCollection = GAMRepository.GetLastErrors()
		Do 'DisplayMessages'
	Endif		
Endevent

Event Enter
	If &UserPasswordNew = &UserPasswordNewConf
		&isOK = GAMRepository.UpdateUserToChangePassword(&UserPassword, &UserPasswordNew, &GAMErrorCollection)
		If &isOK
			If &GAMErrorCollection.Count = 0
				Msg("GAM_Yourpasswordwaschangedsuccessfully")
				If GAMRepository.IsRemoteAuthentication(&IDP_State)
					//Redirect to remote authentication
					GAMRepository.RedirectToRemoteAuthentication(&IDP_State)
				Else
					&URL = GAMRepository.GetLastErrorsURL()
					If &URL.IsEmpty()
						GAMHome()
					Else
						Link(&URL)
					Endif
				Endif
			Else
				Do 'DisplayMessages'
			Endif
		Else
			Do 'DisplayMessages'
		Endif
	Else
		Msg("GAM_Thenewpasswordandconfirmationdonotmatch")
	Endif
EndEvent


Event 'Login'
	&isOK = GAMRepository.Logout(&GAMErrorCollection)
	GAMRepository.ApplicationGoHome(GAMInternalGUIDs.AppGAMUserBackend)
EndEvent


Sub 'DisplayMessages'
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
EndSub
]]></Source>
