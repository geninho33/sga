Sub 'BuscaQtdePessoas'

	// Procura no Ano e Mês informado
	For each Rancho.AreasEnsino.Pessoas
		Order prefCodigo,RanchoAno,(RanchoMes),RanchoAreasEnsinoCodigo,locCodigo
		Where prefCodigo 				= &prefCodigo
		Where RanchoAno 				= &WizardData.Periodo.Ano
		Where RanchoMes					<= &WizardData.Periodo.Mes
		Where RanchoAreasEnsinoCodigo	= &AreEnsCodigo
		Where locCodigo 				= &locCodigo
		
		&Quantidade = RanchoAreasEnsinoPessoasQuantidade
		Exit
	When none
		&Quantidade = 0
	Endfor

EndSub


