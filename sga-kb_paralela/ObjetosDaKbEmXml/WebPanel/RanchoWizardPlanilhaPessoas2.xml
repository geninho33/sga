  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
   	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'LoadVariablesFromWizardData'

	Do 'AttributesSecurityCode'
	&TotBercario1.Visible = False
	&TotBercario2.Visible = False
	&TotCreche.Visible = False
	&TotEmeb.Visible = False
	&TotIntegral.Visible = False
	&TotFuncionarios.Visible = False
	Grid_Empowerer.GridInternalName = Grid.InternalName
	Grid.Rows = 0
	Grid_TitlesCategories.GridInternalName = Grid.InternalName

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	for &GridLocaisItem in &WizardData.Locais.GridLocais

		&locCodigo 		= &GridLocaisItem.locCodigo
		&locUeCod		= &GridLocaisItem.locUeCod
		&locDescricao 	= &GridLocaisItem.locDescricao

		&Bercario1.SetEmpty()
		&Bercario2.SetEmpty()
		&Creche.SetEmpty()
		&Emeb.SetEmpty()
		&Integral.SetEmpty()
		&Funcionarios.SetEmpty()
		&TotalEstudantes.SetEmpty()
		&TotalPessoas.SetEmpty()

		/* Verifica se existe informação no WizardData */
		for &PessoasGridItem in &WizardData.Pessoas2.Grid

			if &PessoasGridItem.locCodigo = &locCodigo
				&Bercario1 			= &PessoasGridItem.Bercario1
				&Bercario2 			= &PessoasGridItem.Bercario2
				&Creche				= &PessoasGridItem.Creche
				&Emeb				= &PessoasGridItem.Emeb
				&Integral			= &PessoasGridItem.Integral
				&Funcionarios	 	= &PessoasGridItem.Funcionarios
				&TotalPessoas		= &PessoasGridItem.TotalPessoas
				Exit
			endif

		endfor

		/* Se não achou busca do SGE */
		if &TotalPessoas = 0
			QtdeAlunosPorUEAreaEnsino(&WizardData.Periodo.Ano,&locUeCod,&Bercario1,&Bercario2,&Creche,&Emeb,&Integral,&Funcionarios)
			&TotalPessoas = (&Bercario1+&Bercario2+&Creche+&Emeb+&Integral+&Funcionarios)
		endif

		if &TotalPessoas = 0
			/* Verifica se ainda existem colunas sem dados e busca de Ranchos anteriores */
			if &Bercario1 = 0
				// Berçario 1
				&AreEnsCodigo = 1
				do 'BuscaQtdePessoas'
				&Bercario1 = &Quantidade
			endif
			if &Bercario2 = 0
				// Berçario 2
				&AreEnsCodigo = 2
				do 'BuscaQtdePessoas'
				&Bercario2 = &Quantidade
			endif
			if &Creche = 0
				// Creche
				&AreEnsCodigo = 3
				do 'BuscaQtdePessoas'
				&Creche = &Quantidade
			endif
			if &Emeb = 0
				// EMEB
				&AreEnsCodigo = 4
				do 'BuscaQtdePessoas'
				&Emeb = &Quantidade
			endif
			if &Integral = 0
				// Integral
				&AreEnsCodigo = 5
				do 'BuscaQtdePessoas'
				&Integral = &Quantidade
			endif
			if &Funcionarios = 0
				// Funcionários
				&AreEnsCodigo = 99999997
				do 'BuscaQtdePessoas'
				&Funcionarios = &Quantidade
			endif
		endif

		// Total linha
		&TotalEstudantes = (&Bercario1+&Bercario2+&Creche+&Emeb+&Integral)
		&TotalPessoas	 = (&TotalEstudantes + &Funcionarios)

		// Total coluna
		&TotBercario1 	 	+= &Bercario1
		&TotBercario2 	 	+= &Bercario2
		&TotCreche 		 	+= &Creche
		&TotEmeb 		 	+= &Emeb
		&TotIntegral	 	+= &Integral
		&TotFuncionarios 	+= &Funcionarios
		&TotTotalEstudantes += &TotalEstudantes
		&TotTotalPessoas 	+= &TotalPessoas

		// Guarda valores anteriores
		&xBercario1 = &Bercario1
		&xBercario2 = &Bercario2
		&xCreche	= &Creche
		&xEmeb		= &Emeb
		&xIntegral	= &Integral
		&xFuncionarios = &Funcionarios

		Load
	endfor

	&TotValueBercario1		 = &TotBercario1.ToFormattedString()
	&TotValueBercario2		 = &TotBercario2.ToFormattedString()
	&TotValueCreche			 = &TotCreche.ToFormattedString()
	&TotValueEmeb			 = &TotEmeb.ToFormattedString()
	&TotValueIntegral		 = &TotIntegral.ToFormattedString()
	&TotValueFuncionarios 	 = &TotFuncionarios.ToFormattedString()
	&TotValueTotalEstudantes = &TotTotalEstudantes.ToFormattedString()
	&TotValueTotalPessoas	 = &TotTotalPessoas.ToFormattedString()

EndEvent

Event Enter

	// Remove locais sem quantidade total de pessoas
	&Atualizou = false
	For each line in Grid
		if &TotalPessoas = 0
			&Atualizou = true
			&Index = 0
			for &GridLocaisItem in &WizardData.Locais.GridLocais
				&Index += 1
				if &GridLocaisItem.locCodigo = &locCodigo
					&WizardData.Locais.GridLocais.Remove(&Index)
					Exit
				endif
			endfor
		endif
	Endfor

	if &Atualizou
		&WebSession.Set(&WebSessionKey, &WizardData.ToJson())
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If not &HasValidationErrors
		Do 'SaveVariablesToWizardData'
		RanchoWizardPlanilha(!'Pessoas2', !'PerCapta2', false)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'WizardPrevious'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'SaveVariablesToWizardData'
	RanchoWizardPlanilha(!'Pessoas2', !'Alimentos', true)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: XmlFileToWizardData
	&WizardData.FromXML(FileXmlToWizardData(&WebSessionKey))
	&WebSession.Set(&WebSessionKey,&WizardData.ToJson())

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&TotBercario1 = &WizardData.Pessoas2.TotBercario1
	&TotBercario2 = &WizardData.Pessoas2.TotBercario2
	&TotCreche = &WizardData.Pessoas2.TotCreche
	&TotEmeb = &WizardData.Pessoas2.TotEmeb
	&TotIntegral = &WizardData.Pessoas2.TotIntegral
	&TotFuncionarios = &WizardData.Pessoas2.TotFuncionarios
	&Origem = &WizardData.Pessoas2.Origem

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveVariablesToWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Pessoas2.TotBercario1 = &TotBercario1
	&WizardData.Pessoas2.TotBercario2 = &TotBercario2
	&WizardData.Pessoas2.TotCreche = &TotCreche
	&WizardData.Pessoas2.TotEmeb = &TotEmeb
	&WizardData.Pessoas2.TotIntegral = &TotIntegral
	&WizardData.Pessoas2.TotFuncionarios = &TotFuncionarios
	&WizardData.Pessoas2.Origem = &Origem
	&WizardData.Pessoas2.Grid.Clear()
	For Each Line in Grid
		&GridItem = new()
		&GridItem.locDescricao = &locDescricao
		&GridItem.Bercario1 = &Bercario1
		&GridItem.Bercario2 = &Bercario2
		&GridItem.Creche = &Creche
		&GridItem.Emeb = &Emeb
		&GridItem.Integral = &Integral
		&GridItem.Funcionarios = &Funcionarios
		&GridItem.TotalEstudantes = &TotalEstudantes
		&GridItem.TotalPessoas = &TotalPessoas
		&GridItem.locCodigo = &locCodigo
		&GridItem.locUeCod = &locUeCod
		&GridItem.xBercario1 = &xBercario1
		&GridItem.xBercario2 = &xBercario2
		&GridItem.xCreche = &xCreche
		&GridItem.xEmeb = &xEmeb
		&GridItem.xIntegral = &xIntegral
		&GridItem.xFuncionarios = &xFuncionarios

		&WizardData.Pessoas2.Grid.Add(&GridItem)
	EndFor
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())

	//Code block: WizardDataToXmlFile
	WizardDataToFileXML(&WebSessionKey,&WizardData.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

