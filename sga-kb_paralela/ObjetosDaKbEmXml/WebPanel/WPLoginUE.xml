  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

If &Httprequest.Method = HttpMethod.Get
	&WWP_DesignSystemSettings = WWP_GetDesignSystemSettings()
    GeneXus.Common.UI.DesignSystem.SetOption(!"base-color", &WWP_DesignSystemSettings.BaseColor)
	GeneXus.Common.UI.DesignSystem.SetOption(!"background-color", &WWP_DesignSystemSettings.BackgroundStyle)
	GeneXus.Common.UI.DesignSystem.SetOption(!"menu-color", &WWP_DesignSystemSettings.MenuColor)
	GeneXus.Common.UI.DesignSystem.SetOption(!"font-size", &WWP_DesignSystemSettings.FontSize)
	WWPActions.EmpoweredGrids_Refresh()
EndIf

if not &locDescricao.IsEmpty()
	msg('Essa unidade é vinculada com a  ' + &locDescricao )
	&locDescricao = ''
endif

	
// &prefCodigo = &WebSession.Get('prefCodigo').ToNumeric()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoUserActionEntrar'

	 for each
		 where locUsuario = &login
		 where locSenha   = &senha
			//where prefCodigo = &prefCodigo
			LoadWWPContext.Call(&WWPContext)
			&WWPContext.login        = locUsuario
			&WWPContext.senha        = locSenha
			&WWPContext.locCodigo    = locCodigo
			&WWPContext.locDescricao = locDescricao
			&WWPContext.prefCodigo   = prefCodigo
			&WWPContext.locVinculada = locVinculada
			IncluiAcessoUE(prefCodigo, locUsuario, 2)
			if locStatus = 'A'
				SetWWPContext(&WWPContext)
				HomeUE()
			else
				msg('Essa Unidade de Ensino não está ativa !')
			endif
     when none
		 &login  = ""
		 &senha  = ""
		 msg("O usuário não foi encontrado !")
	 endFor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent


]]></Source>
