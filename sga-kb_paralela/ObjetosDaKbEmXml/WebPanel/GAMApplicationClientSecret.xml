  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&GAMApplication = GAMApplication.GetByClientId(&ClientID, &GAMErrorCollection)
	If &GAMErrorCollection.Count = 0
		Form.Caption 	= &GAMApplication.Name
		&ClientSecret 	= &GAMApplication.ClientSecret
	Endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoAutogenerate'

	&ClientSecret = GetEncryptionKey()
	&ClientSecret += GetEncryptionKey()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Enter

	&GAMApplication = GAMApplication.GetByClientId(&ClientID, &GAMErrorCollection)
	If &GAMErrorCollection.Count = 0
		If &GAMApplication.SetClientSecret(&ClientSecret, &GAMErrorCollection)
			Commit
			&ClientSecret.Enabled 				= False
			BtnAutogenerate.Visible				= False
			BtnEnter.Visible	= False
			Msg("The client secret was successfully changed!")
		Else
			Do 'ShowMessages'
		Endif
	Else
		Do 'ShowMessages'
	Endif

EndEvent

Sub 'ShowMessages'

	If &GAMErrorCollection.Count > 0
		For &GAMError in &GAMErrorCollection
			Msg(Format(!"%1 (GAM%2)", &GAMError.Message, &GAMError.Code))
		EndFor
	EndIf

EndSub


]]></Source>
