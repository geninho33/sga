  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start
	&GAMRepository = GAMRepository.Get()
	If &GAMRepository.UserIdentification = GAMRepositoryUserIdentifications.EMail
		&Name.Visible	= False
	Endif	
	Do 'MarkRequieredUserData'
	&GAMUser = GAMRepository.GetUserByKeyToCompleteUserData(&GAMErrorCollection)
	If &GAMErrorCollection.Count > 0
		Do 'DisplayMessages'
	Else
		//Gets last error in the GAM 
		&GAMErrorCollection = GAMRepository.GetLastErrors()
		Do 'DisplayMessages'
		&Name 		= &GAMUser.Name
		&EMail		= &GAMUser.EMail
		&FirstName	= &GAMUser.FirstName
		&LastName	= &GAMUser.LastName
		&Birthday	= &GAMUser.Birthday
		&Gender		= &GAMUser.Gender
	Endif
EndEvent

Event Enter
	&GAMUser = GAMRepository.GetUserByKeyToCompleteUserData(&GAMErrorCollection)
	&GAMUser.Name			= &Name
	&GAMUser.EMail			= &EMail
	&GAMUser.FirstName		= &FirstName
	&GAMUser.LastName		= &LastName
	&GAMUser.Birthday		= &Birthday
	&GAMUser.Gender			= &Gender
	&isOK = GAMRepository.UpdateUserByKeyToCompleteUserData(&GAMUser, &GAMErrorCollection)
	If &isOK
		If &GAMErrorCollection.Count > 0
			Msg("GAM_Yourdatahasbeenupdatedsuccessfully")
			Do 'DisplayMessages'
		Else		
			If GAMRepository.IsRemoteAuthentication(&IDP_State)
				//Redirect to remote authentication
				GAMRepository.RedirectToRemoteAuthentication(&IDP_State)
			Else
				&URL = GAMRepository.GetLastErrorsURL()
				If &URL.IsEmpty()
					GAMHome()
				Else
					Link(&URL)
				Endif
			Endif
		Endif
	Else
		Do 'DisplayMessages'
	Endif
EndEvent

Sub 'MarkRequieredUserData'		
	If &GAMRepository.RequiredEmail
		&EMail.Caption += !'  *'
	EndIf
	If &GAMRepository.RequiredFirstName
		&FirstName.Caption += !'  *'
	EndIf
	If &GAMRepository.RequiredLastName
		&LastName.Caption += !'  *'
	EndIf	
	If &GAMRepository.RequiredBirthday
		&Birthday.Caption += !'  *'
	EndIf
	If &GAMRepository.RequiredGender
		&Gender.Caption += !'  *'
	EndIf
EndSub

Event 'ReturnToLogin'
	&isOK = GAMRepository.Logout(&GAMErrorCollection)
	GAMRepository.ApplicationGoHome(GAMInternalGUIDs.AppGAMUserBackend)
Endevent

Sub 'DisplayMessages'
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
EndSub
]]></Source>
