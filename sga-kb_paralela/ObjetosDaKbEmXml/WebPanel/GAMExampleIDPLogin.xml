  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start	
	//Valid current connection
	&isConnectionOK = GeneXusSecurity.GAM.CheckConnection()
	If GeneXusSecurity.GAM.isMultitenant()
		Do 'isMultitenantInstallation'
	Else
		If not &isConnectionOK
			If GeneXusSecurity.GAM.GetDefaultRepository(&RepositoryGUID)
				&isConnectionOK = GeneXusSecurity.GAM.SetConnectionByRepositoryGUID(&RepositoryGUID, &Errors)
			Else
				&ConnectionInfoCollection = GeneXusSecurity.GAM.GetConnections()
				If &ConnectionInfoCollection.Count > 0
					//The first connection found is established by default
					&isConnectionOK = GeneXusSecurity.GAM.SetConnection(&ConnectionInfoCollection.Item(1).Name, &Errors)
				EndIf
			Endif
		Endif
	Endif
	&GAMApplication = GeneXusSecurity.GAMRepository.GetRemoteApplication(&IDP_State, &Errors)
	If not &GAMApplication.ClientImageURL.IsEmpty()
		&LogoAppClient.Visible	= True
		TBAppName.Visible 		= False
		&LogoAppClient.FromURL(&GAMApplication.ClientImageURL)
	Else
		&LogoAppClient.Visible	= False
		TBAppName.Visible 		= True
		TBAppName.Caption 		= &GAMApplication.Name
	Endif
EndEvent


Event Refresh
	GridAuthTypes.Visible 		= False
	
	//Gets last error in the GAM 
	&isRedirect = False
	&ErrorsLogin = GAMRepository.GetLastErrors()
	If &ErrorsLogin.Count > 0
		Do Case
		Case &ErrorsLogin.Item(1).Code = GAMErrorMessages.ConnectionNotSpecified  OR  &ErrorsLogin.Item(1).Code = GAMErrorMessages.UserMustBeAuthenticated
			//DO NOT display these messages
		Case (&ErrorsLogin.Item(1).Code = GAMErrorMessages.UserPasswordExpired  OR  &ErrorsLogin.Item(1).Code = GAMErrorMessages.UserPasswordMustBeChanged)
			//Webpanel to Change Password
			GAMExampleChangePassword(&IDP_State)
			&isRedirect 	= True
		Case &ErrorsLogin.Item(1).Code = GAMErrorMessages.UserMissingRequiredData
			//Webpanel to Complete User data
			GAMExampleUpdateRegisterUser(&IDP_State)
			&isRedirect 	= True
		Otherwise
			&UserPassword = ""
			&Errors = &ErrorsLogin
			Do 'DisplayMessages'
		EndCase
	Endif

	If not &isRedirect
		//Gets last error in GAM
		&SessionValid = GAMSession.IsValid(&Session, &Errors)

		If &SessionValid and not &Session.IsAnonymous
			If GAMRepository.IsRemoteAuthentication(&IDP_State)
				//Redirect to remote authentication
				GAMRepository.RedirectToRemoteAuthentication(&IDP_State)
			Else
				&URL = GAMRepository.GetLastErrorsURL()
				If &URL.IsEmpty()
					GAMApplication.GoHome()
				Else
					Link(&URL)
				Endif
			Endif
		Else
			//List Log on to
			&LogOnTo.Clear()
			&AuthenticationTypes = GAMRepository.GetEnabledAuthenticationTypes(&Language, &Errors)
			For &AuthenticationType in &AuthenticationTypes
				If &AuthenticationType.NeedUserName //Authentication types you must enter the username in this web panel
					&LogOnTo.AddItem(&AuthenticationType.Name, &AuthenticationType.Description)
				Else
					GridAuthTypes.Visible = True
				EndIf
			EndFor
			If &LogOnTo.Count 	<= 1
				&LogOnTo.Visible = False
			Else
				&LogOnTo = &AuthenticationTypes.Item(1).Name
			Endif

			//Initialize variables if the user chooses to keep that information 
			&isOK = GAMRepository.GetRememberLogin(&LogOnTo, &AuxUserName, &UserRememberMe, &Errors)
			If not &AuxUserName.IsEmpty()
				&UserName = &AuxUserName
			Endif
			If &UserRememberMe = GAMRememberUserTypes.Login
				&RememberMe = True
			Endif

			//Select Default Authentication Type, Display Remember User if it is enabled on Repository
			&GAMRepository = GAMRepository.Get()
			If &LogOnTo.Count > 1
				&LogOnTo = &GAMRepository.DefaultAuthenticationTypeName
			Endif
			Do 'DisplayCheckBox'
			For &AuthenticationType in &AuthenticationTypes
				If &AuthenticationType.Name = &LogOnTo
					Do "ValidLogOnToOTP"
					Exit
				Endif
			EndFor
		EndIf
	Endif
EndEvent

Event GridAuthTypes.Load()
	For &AuthenticationType in &AuthenticationTypes
		If &AuthenticationType.RedirToAuthenticate
			&NameAuthType 						= URLEncode(&AuthenticationType.Name.Trim())
			ExternalAuthentication.Caption 		= &AuthenticationType.Description.Trim()
			ExternalAuthentication.TooltipText 	= Format("GAM_Signinwith1", &AuthenticationType.Description.Trim() )
			If TblExternalsAuth.Visible = False
				TblExternalsAuth.Visible		= True
			EndIf
			Load
		EndIf
	EndFor
EndEvent

Event &LogOnTo.Click
	&AuthenticationTypes 	= GAMRepository.GetEnabledAuthenticationTypes(&Language, &GAMErrorCollection)
	&isModeOTP 				= False
	For &AuthenticationType in &AuthenticationTypes
		If &AuthenticationType.Name = &LogOnTo
			Do "ValidLogOnToOTP"
			Exit
		Endif
	EndFor
	If &isModeOTP = False
		&UserPassword.Visible 		= True
		&UserPassword.InviteMessage	= "GAM_Password"
		Login.Caption				= "GAM_SIGNIN"
		TBForgotPwd.Visible			= True
	Endif
EndEvent


Event Enter
	//Set Remember User type
	Do Case
	Case &KeepMeLoggedIn
		&AdditionalParameter.RememberUserType = GAMRememberUserTypes.Authentication
	Case &RememberMe
		&AdditionalParameter.RememberUserType = GAMRememberUserTypes.Login
	Otherwise
		&AdditionalParameter.RememberUserType = GAMRememberUserTypes.None
	EndCase
		
	////////////////////////////////////////////////////////////
	//Read initial properties sent by the CLIENT (optional) ///
	&GAMProperties = GAMRepository.GetGAMRemoteInitialProperties(&IDP_State)
	&AdditionalParameter.Properties = &GAMProperties
	//You can here add more properties to the collection, these 
	//are saved in the session when the user authenticates
	////////////////////////////////////////////////////////////

	&AdditionalParameter.AuthenticationTypeName = &LogOnTo
	&AdditionalParameter.IDPState				= &IDP_State
	&AdditionalParameter.OTPStep				= 1
	// Login User 
	&LoginOK = GAMRepository.Login(&UserName, &UserPassword, &AdditionalParameter, &Errors )
	If &LoginOK
		//Login OK!
	Else
		If &Errors.Count > 0 
			Do Case
			Case (&Errors.Item(1).Code = GAMErrorMessages.UserPasswordExpired   OR  &Errors.Item(1).Code = GAMErrorMessages.UserPasswordMustBeChanged)
				//Webpanel to Change Password
				GAMExampleChangePassword(&IDP_State)
			Case &Errors.Item(1).Code = GAMErrorMessages.UserMissingRequiredData
				//Webpanel to Complete User data
				GAMExampleUpdateRegisterUser(&IDP_State)
			Case &Errors.Item(1).Code = GAMErrorMessages.UserAccessCodeSent  OR  &Errors.Item(1).Code = GAMErrorMessages.UserMustValidateSecondFactorToFinishAuthentication
				&GAMErrorDelete = GAMRepository.GetLastErrors()
				//Webpanel to validate access code
				GAMExampleOTPAuthentication(&IDP_State)
			Otherwise
				&UserPassword.SetEmpty()
				Do 'DisplayMessages'
			EndCase
		EndIf
	Endif
EndEvent

Event 'ForgotPassword'
	GAMExampleRecoverPasswordStep1.Link(&IDP_State)
EndEvent

Event 'SelectAuthenticationType'
	//Set Remember User type
	Do Case
	Case &KeepMeLoggedIn
		&AdditionalParameter.RememberUserType = GAMRememberUserTypes.Authentication
	Case &RememberMe
		&AdditionalParameter.RememberUserType = GAMRememberUserTypes.Login
	Otherwise
		&AdditionalParameter.RememberUserType = GAMRememberUserTypes.None
	EndCase
	
	////////////////////////////////////////////////////////////
	//Send properties to GAM Identity Provider (optional) //////
	//&CustomGAMProperty = new()
	//&CustomGAMProperty.Id		= "language"
	//&CustomGAMProperty.Value	= "en"
	//&AdditionalParameter.Properties.Add(&CustomGAMProperty)
	////////////////////////////////////////////////////////////
	
	&AdditionalParameter.AuthenticationTypeName = &NameAuthType
	&AdditionalParameter.IDPState				= &IDP_State
	&LoginOK = GAMRepository.Login(&UserName, &UserPassword, &AdditionalParameter, &Errors )
EndEvent

Sub 'isMultitenantInstallation'
	//Read Curent Repository
	&GAMRepository = GeneXusSecurity.GAMRepository.Get()
	//Check if the current repository uses an authentication master repository
	If not &GAMRepository.AuthenticationMasterRepositoryId.IsEmpty()
		&isConnectionOK = GeneXusSecurity.GAM.SetConnectionByRepositoryId(&GAMRepository.AuthenticationMasterRepositoryId, &Errors)
	Endif
	If not &isConnectionOK
		If GeneXusSecurity.GAM.GetDefaultRepository(&RepositoryGUID)
			&isConnectionOK = GeneXusSecurity.GAM.SetConnectionByRepositoryGUID(&RepositoryGUID, &Errors)
		Else
			&ConnectionInfoCollection = GeneXusSecurity.GAM.GetConnections()
			If &ConnectionInfoCollection.Count > 0
				//The first connection found is established by default
				&isConnectionOK = GeneXusSecurity.GAM.SetConnection(&ConnectionInfoCollection.Item(1).Name, &Errors)
			EndIf
		Endif
	Endif

	If &isConnectionOK
		&GAMRepository = GeneXusSecurity.GAMRepository.Get()
		//Check if the current repository uses an authentication master repository
		If not &GAMRepository.AuthenticationMasterRepositoryId.IsEmpty()
			&isConnectionOK = GeneXusSecurity.GAM.SetConnectionByRepositoryId(&GAMRepository.AuthenticationMasterRepositoryId, &Errors)
			&GAMRepository 	= GeneXusSecurity.GAMRepository.Get()
		Endif
	Endif
EndSub


Sub 'DisplayCheckBox'
	Do Case
	Case &Repository.UserRememberMeType = GAMRepositoryRememberUserTypes.Login
		&KeepMeLoggedIn.Visible	= False
		&RememberMe.Visible 	= True
	Case &Repository.UserRememberMeType = GAMRepositoryRememberUserTypes.Authentication
		&KeepMeLoggedIn.Visible	= True
		&RememberMe.Visible		= False
	Case &Repository.UserRememberMeType = GAMRepositoryRememberUserTypes.Both
		&KeepMeLoggedIn.Visible	= True
		&RememberMe.Visible		= True
	Otherwise	
		&KeepMeLoggedIn.Visible	= False
		&RememberMe.Visible		= False
	EndCase
EndSub


Sub "ValidLogOnToOTP"
	If not &AuthenticationType.NeedUserPassword
		&isModeOTP = True
		&UserPassword.Visible 	= False
		Login.Caption			= "GAM_SENDMEACODE"
		TBForgotPwd.Visible		= False
	EndIf
EndSub


Sub 'DisplayMessages'
	&GAMErrorDelete = GAMRepository.GetLastErrors()
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
