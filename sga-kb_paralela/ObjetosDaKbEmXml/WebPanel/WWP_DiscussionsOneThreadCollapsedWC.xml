  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event OnMessage(&NotificationInfo)

	If &NotificationInfo.Id.StartsWith(!"WebNotification#")
		Refresh
	EndIf

EndEvent

Event Refresh

	&HiddenAnswersCount = Count(WWPDiscussionMessageDate, WWPDiscussionMessageThreadId = &WWPDiscussionMessageThreadId)
	For each WWPBaseObjects.Discussions.WWP_DiscussionMessage
		Order (WWPDiscussionMessageId)
		Where WWPDiscussionMessageThreadId = &WWPDiscussionMessageThreadId
		
		&HiddenAnswersLastOnDate = WWPDiscussionMessageDate
		Exit
	EndFor
	
	If &HiddenAnswersCount > 0
		&HiddenAnswersLastOn = Format("Last on %1",&HiddenAnswersLastOnDate.ToFormattedString())
		If &HiddenAnswersCount = 1
			&HiddenAnswers = "1 answer"
		Else
			&HiddenAnswers = Format("%1 answers",&HiddenAnswersCount.ToString().Trim())
		EndIf
		&HiddenAnswers.Class = ThemeClass:AttributeDiscussionTag
	Else
		&HiddenAnswersLastOn.Visible = False
		&HiddenAnswers = "No answers"
		&HiddenAnswers.Class = ThemeClass:AttributeDiscussionTagGray
	EndIf

EndEvent


]]></Source>
