  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardSteps = new()

	&WizardStep = new()
	&WizardStep.Code = !'Periodo'
	&WizardStep.Title = 'Período'
	&WizardStep.Description = 'Informe o Ano e o Mês base dos dados a serem utilizados nos cálculos para as Compras.'
	&WizardSteps.Add(&WizardStep)

	&WizardStep = new()
	&WizardStep.Code = !'Locais'
	&WizardStep.Title = 'Locais'
	&WizardStep.Description = 'Selecione os locais de destino.'
	&WizardSteps.Add(&WizardStep)

	&WizardStep = new()
	&WizardStep.Code = !'Alimentos'
	&WizardStep.Title = 'Alimentos'
	&WizardStep.Description = 'Lista de alimentos do período.'
	&WizardSteps.Add(&WizardStep)

	&WizardStep = new()
	&WizardStep.Code = !'Pessoas2'
	&WizardStep.Title = 'Pessoas'
	&WizardStep.Description = 'Quantidade de pessoas atendidas.'
	&WizardSteps.Add(&WizardStep)

	&WizardStep = new()
	&WizardStep.Code = !'PerCapta2'
	&WizardStep.Title = 'Totais para Compra'
	&WizardStep.Description = 'Define Percapta e  Oferta para cada alimento por Área de Ensino.'
	&WizardSteps.Add(&WizardStep)

	If &CurrentStep.IsEmpty()
		&CurrentStepAux = !'Periodo'
		&WebSession.Remove(&Pgmname + !'_Data')
	Else
		&CurrentStepAux = &CurrentStep
	EndIf
	Do 'LoadWizardStepWC'
	StepTitles.Object = WizardStepsLineWC.Create(&WizardSteps, &CurrentStepAux)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadWizardStepWC'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case &CurrentStepAux = !'Periodo'
			WizardStepWC.Object = ComprasWizardPeriodo.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
		Case &CurrentStepAux = !'Locais'
			WizardStepWC.Object = ComprasWizardLocais.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
		Case &CurrentStepAux = !'Alimentos'
			WizardStepWC.Object = ComprasWizardAlimentos.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
		Case &CurrentStepAux = !'Pessoas2'
			WizardStepWC.Object = ComprasWizardPessoas2.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
		Case &CurrentStepAux = !'PerCapta2'
			WizardStepWC.Object = ComprasWizardPerCapta2.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
