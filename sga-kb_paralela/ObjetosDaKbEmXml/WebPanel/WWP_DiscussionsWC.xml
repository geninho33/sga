  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&GAMSession = GAMSession.Get(&GAMErrors)
	UCMentions.GAMOAuthToken = &GAMSession.Token
	UCMentions.ItemHtmlTemplate = WWP_GetStyledDVCombo(!'Title, subtitle and image')
	UCMentions.Attach(!'+', &Message.InternalName)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&IsDiscussionAnswersWCLoaded.Visible = False
	WWPDiscussionMessageId.Visible = False

	Grid.Rows = Page.Rows
	WWPDiscussionMessageEntityRecordId.Visible = False

	Do 'PrepareTransaction'
	Do 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	&WWPEntityId = WWP_GetEntityByName(&WWPEntityName)
	WWPActions.Textarea_EnterBehaviourToAction(&Message.InternalName, Enter.InternalName)

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)

	Do 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	WCDiscussionsOneThreadCell.Visible = True
	&IsFirstDiscussionRecord = True
	&WWPDiscussionMessageIdToExpand = 0
	
	If &WebSession.Get(!"DiscussionThreadIdToOpen") <> ''
		&WWPDiscussionMessageIdToExpand.FromString(&WebSession.Get(!"DiscussionThreadIdToOpen"))
		&WebSession.Remove(!"DiscussionThreadIdToOpen")
	EndIf
	
	If &WWPDiscussionMessageIdToExpand = 0
		For Each WWPBaseObjects.Discussions.WWP_DiscussionMessage Order (WWPDiscussionMessageId)
			Where WWPEntityId = &WWPEntityId
			Where WWPDiscussionMessageEntityRecordId = &WWPDiscussionMessageEntityRecordId
			Where WWPDiscussionMessageThreadId.IsNull() or WWPDiscussionMessageThreadId.IsEmpty()
			&WWPDiscussionMessageIdToExpand = WWPDiscussionMessageId
			Exit
		EndFor
	EndIf
	GridCell.Visible = False
	&IsDiscussionAnswersWCLoaded = False
	NewThread.Visible = False

EndEvent

Event Grid.Load

	If &IsFirstDiscussionRecord
		&IsFirstDiscussionRecord = False
		NewThreadCell.Visible = false
		GridCell.Visible = True
		NewThread.Visible = True
	Endif
	
	If WWPUserExtendedPhoto.ImageURI = ''
		&UserExtendedPhoto.FromImage(AvatarDiscussionPhoto)
	Else
		&UserExtendedPhoto.ImageURI = WWPUserExtendedPhoto.ImageURI
	EndIf

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DiscussionsOneThreadCollapsedWC.Object = WWP_DiscussionsOneThreadCollapsedWC.Create(WWPDiscussionMessageId)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	If WWPDiscussionMessageId = &WWPDiscussionMessageIdToExpand
		&IsDiscussionAnswersWCLoaded = True
		WCDiscussionsOneThreadCell.Visible = True
		DiscussionsOneThreadCollapsedWCCell.Visible = False
		WCDiscussionsOneThreadWC.Object = WWPBaseObjects.Discussions.WWP_DiscussionsOneThreadWC.Create(WWPDiscussionMessageId, &WWPSubscriptionEntityRecordDescription, &WWPNotificationLink)
	Else
		&IsDiscussionAnswersWCLoaded = False
		WCDiscussionsOneThreadCell.Visible = False
		DiscussionsOneThreadCollapsedWCCell.Visible = True
		
	EndIf

EndEvent

Event Enter

	If Not &Message.IsEmpty()
		&WWPEntityId = WWP_GetEntityByName(&WWPEntityName)
		If &WWPEntityId > 0
			If WWPBaseObjects.Discussions.WWP_CreateAndNotifyDiscussionMessage(&WWPEntityId, 0, &WWPDiscussionMessageEntityRecordId, &Message, UCMentions.SelectedItemsJson, &WWPDiscussionMessage.WWPDiscussionMessageId.ToString(), "WWP_Notifications_NewDiscussionThread", &WWPSubscriptionEntityRecordDescription, &WWPNotificationLink)
				&Message.SetEmpty()
				NewThreadCell.Visible = False
				Grid.Refresh()
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(&PgmName + !"GridState") = !""
		&GridState.FromXml(LoadGridState.Udp(&PgmName + !"GridState"))
	Else
		&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))
	Endif	
	If not &GridState.PageSize.Trim().IsEmpty()
		Grid.Rows = &GridState.PageSize.ToNumeric()
	EndIf
	Grid.CurrentPage = &GridState.CurrentPage

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))

	// Save grid state in session.

	&GridState.PageSize = str(Grid.Rows)
	&GridState.CurrentPage = Grid.CurrentPage
	SaveGridState.Call(&PgmName + !"GridState",  &GridState.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = True
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"WWPBaseObjects.Discussions.WWP_DiscussionMessage"

	&TrnContextAtt = new()
	&TrnContextAtt.AttributeName = !"WWPDiscussionMessageEntityRecordId"
	&TrnContextAtt.AttributeValue = &WWPDiscussionMessageEntityRecordId.ToString()
	&TrnContext.Attributes.Add(&TrnContextAtt)

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event DiscussionCard.Click

	WCDiscussionsOneThreadCell.Visible = Not WCDiscussionsOneThreadCell.Visible
	DiscussionsOneThreadCollapsedWCCell.Visible = Not DiscussionsOneThreadCollapsedWCCell.Visible
	
	If DiscussionsOneThreadCollapsedWCCell.Visible
		DiscussionsOneThreadCollapsedWC.Refresh()
	Else
		If &IsDiscussionAnswersWCLoaded
			WCDiscussionsOneThreadWC.Refresh()
		Else
			WCDiscussionsOneThreadWC.Object = WWPBaseObjects.Discussions.WWP_DiscussionsOneThreadWC.Create(WWPDiscussionMessageId, &WWPSubscriptionEntityRecordDescription, &WWPNotificationLink)
			&IsDiscussionAnswersWCLoaded = True
		EndIf
	EndIf

EndEvent

Event NewThread.Click

	For each line in Grid
		WCDiscussionsOneThreadCell.Visible = False
		DiscussionsOneThreadCollapsedWCCell.Visible = True
		DiscussionsOneThreadCollapsedWC.Refresh()
	EndFor
	NewThreadCell.Visible = true
	&Message.SetFocus()

EndEvent


]]></Source>
