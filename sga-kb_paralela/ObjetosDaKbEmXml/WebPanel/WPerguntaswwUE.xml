    <Source><![CDATA[
Event Start

	LoadWWPContext.Call( &WWPContext )
	
	if &WWPContext.prefCodigo.IsEmpty()
	   WPLoginUE()
	else   
	    &prefCodigo = &WWPContext.prefCodigo
		&locCodigo  = &WWPContext.locCodigo
		&situacao   = "S"
		Do 'popularGrade'
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	grupoHistoricos.Width = 800
	GridSDTPerguntasRespostass_Empowerer.GridInternalName = GridSDTPerguntasRespostass.InternalName
	GridSDTPerguntasRespostass.Rows = Page.Rows
	GridSDTPerguntasRespostassPaginationBar.RowsPerPageSelectedValue = GridSDTPerguntasRespostass.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTPerguntasRespostassCurrentPage = GridSDTPerguntasRespostass.CurrentPage
	&GridSDTPerguntasRespostassPageCount = GridSDTPerguntasRespostass.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTPerguntasRespostass.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid
	&btnVisualizar = !'<i class="fas fa-search"></i>'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTPerguntasRespostassPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTPerguntasRespostassPaginationBar.SelectedPage = !'Previous'
			GridSDTPerguntasRespostass.PreviousPage()
		Case GridSDTPerguntasRespostassPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTPerguntasRespostass.CurrentPage
			&PageToGo += 1
			GridSDTPerguntasRespostass.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTPerguntasRespostassPaginationBar.SelectedPage)
			GridSDTPerguntasRespostass.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTPerguntasRespostassPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTPerguntasRespostass.Rows = GridSDTPerguntasRespostassPaginationBar.RowsPerPageSelectedValue
	GridSDTPerguntasRespostass.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnEnviarPergunta'

     WPPerguntasRespostasUE.Popup( &prefCodigo, &locCodigo,0,'N')
	 refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &btnVisualizar.Click

	WPPerguntasRespostasUE.Popup(&prefCodigo,&locCodigo,&SDTPerguntasRespostas.CurrentItem.perResCodigo,'E')

EndEvent

Sub 'popularGrade'

	&SDTPerguntasRespostas.Clear()

	for each
		order (perResData)
		where prefCodigo      = &prefCodigo
		where perResLocCodigo = &locCodigo
		where perResStatus    = 'A'
		      &item = new()
			  &item.perResAssunto   = perResAssunto
			  &item.perResData      = perResData
			  &item.perResPergunta  = perResPergunta
			  &item.perResResposta  = perResResposta
			  &item.perResLocCodigo = perResLocCodigo
			  &item.perResCodigo    = perResCodigo
		      &SDTPerguntasRespostas.Add( &item )
	endFor

EndSub


]]></Source>
