  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Enter	
	&User = GAMRepository.GetUserByLogin(&UserAuthTypeName, &UserName, &GAMErrorCollection)
	If &GAMErrorCollection.Count = 0	
		&LinkURL = GAM_BuildAppURL(GAMExampleRecoverPasswordStep2.Link(&IDP_State, ""))
		&LinkURL += !"%1"
		&GAMApplication = GAMApplication.Get()
		&User.SendEmailToRecoverPassword(&Application, &LinkURL, &GAMErrorCollection)
		If &GAMErrorCollection.Count = 0
			&UserName.Enabled = False
			Msg("GAM_Anemailwassentwithinstructionstochangeyourpassword")
		Else
			Do 'DisplayMessages'
		Endif
	Else
		Do 'DisplayMessages'
	Endif
EndEvent

Event 'GoBack'
	If GAMRepository.IsRemoteAuthentication(&IDP_State)
		GAMExampleIDPLogin(&IDP_State)
	Else
		GAMExampleLogin()
	Endif
EndEvent

Sub 'DisplayMessages'
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
EndSub

]]></Source>
