Event Start

LoadWWPContext.Call(&WWPContext)
&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTLocaisQtdeUEs_Empowerer.GridInternalName = GridSDTLocaisQtdeUEs.InternalName
	GridSDTLocaisQtdeUEs.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTLocaisQtdeUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnSalvar'

	&total = 0

	for &local in &SDTLocaisQtdeUE
		&total += PRCDSalvarValorFixo(&prefCodigo,&local.loccodigo,&prodCodigo,&local.estoUEQtdeFixa)
	endfor

    if &total>0
		Do 'Popular Locais'
		msg(&total.ToString().Trim() + ' produto(s) atualizado(s)')
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnBuscar'

	Do 'Popular Locais'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Popular Locais'

	for each
		where prefCodigo = &prefCodigo
		where prodCodigo = &prodCodigo
		  &uniDescricao = find( uniDescricao,prefCodigo = &prefCodigo and uniCodigo = prodUnidMedConsumo,'' )
	endfor

	&SDTLocaisQtdeUE.Clear()

    for each trnslocal
		order prefCodigo, locDescricao
		where prefCodigo = &prefCodigo
		where locStatus  = 'A'
		      &local = new()
			  &local.loccodigo      = locCodigo
			  &local.locDescricao   = locDescricao
			  &local.estoUeSaldo    = find( estoUeSaldo, prefCodigo = &prefCodigo and estoUeLocCodigo = locCodigo and estoUeProdCodigo = &prodCodigo,0)
			  &local.estoUEQtdeFixa = find( estoUEQtdeFixa, prefCodigo = &prefCodigo and estoUeLocCodigo = locCodigo and estoUeProdCodigo = &prodCodigo,0)
			  &SDTLocaisQtdeUE.Add( &local )
    endFor

EndSub


