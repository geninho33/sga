  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&romanCodigoCollection.FromJson(&romanCodigoCollectionString)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid1_Empowerer.GridInternalName = Grid1.InternalName
	Grid1.Rows = Page.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid1.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	&prodCodigo.SetEmpty()
	For each Romaneio.Item
		order prodCodigo, prodDescricao, prodUnidMedCompra
		Where prefCodigo = &prefCodigo
		Where romanCodigo in &romanCodigoCollection
		
		if &prodCodigo <> prodCodigo 
			if not &prodCodigo.IsEmpty()
				Load
			endif
			&prodCodigo 	= prodCodigo
			&prodDescricao 	= prodDescricao
			&UniDescricao 	= find(uniDescricao,uniCodigo = prodUnidMedCompra,'Indefinido')
			&notaItemQtde 	= romanItemQuantidade
			&notaItemValor.SetEmpty()
			&notaItemValidade.SetEmpty()
			&notaItemLote.SetEmpty()
		else
			&notaItemQtde += romanItemQuantidade
		endif
		
	Endfor

	if not &prodCodigo.IsEmpty()
		Load
	endif

EndEvent

Event Enter

	// Verifica se todos os produtos tem valor informado
	&FaltaValor = false
	For each line in Grid1
		if &notaItemValor.IsEmpty()
			&FaltaValor = true
			Exit
		endif
	Endfor

	if &FaltaValor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_Enter.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	else
		Do 'VinculaRomaneio'
	endif

EndEvent

Event DVelop_ConfirmPanel_Enter.Close

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If DVelop_ConfirmPanel_Enter.Result = !'Yes'
		Do 'Do Action Enter'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Do Action Enter'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	Do 'VinculaRomaneio'

EndSub

Sub 'GravaItensNota'

	For each line in Grid1
		if &notaItemValor > 0
			&IsSucess = VinculaRomaneioNotaIncluiItensNota(&prefCodigo,&notaCodigo,&prodCodigo,&notaItemQtde,&notaItemValor,&notaItemValidade,&notaItemLote,&Message)
			if not &IsSucess
				msg(&Message.Description)
				Exit
			endif
		endif
	Endfor

EndSub

Sub 'VinculaRomaneio'

	&IsSucess = VinculaRomaneioNotaProcesso(true,&prefCodigo,&notaCodigo,&romanCodigoCollection,&Message)
	if not &IsSucess
		msg(&Message.Description)
	else
		Do 'GravaItensNota'
		if &IsSucess
			Commit
			Return
		else
			Rollback
		endif
	endif

EndSub


]]></Source>
