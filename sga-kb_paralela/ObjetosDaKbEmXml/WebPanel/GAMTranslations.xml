  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid.Rows = Page.Rows
	Grid_Empowerer.GridInternalName = Grid.InternalName
	Form.Caption = 'GAMExampleTranslations'
	Do 'LoadGridState'
	GridPaginationBar.RowsPerPageSelectedValue = Grid.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	Form.Caption = &Title

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: LoadPrefeitura
	LoadWWPContext(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo

	LoadWWPContext.Call(&WWPContext)

	Do 'SaveGridState'

	&GridCurrentPage = Grid.CurrentPage
	//&GridPageCount has to be loaded manually
	&GridAppliedFilters = WWP_GetAppliedFiltersDescription(&Pgmname)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	Do 'ReadByType'
	If &Type.StartsWith(!"Application")
		&GAMApplication.Load(&PrimaryID)
		&GAMLanguages = &GAMApplication.Languages
	Else
		&GAMApplication = GAMApplication.Get()
		&GAMLanguages = &GAMApplication.Languages
	EndIf
	&GridPageCount = &GAMLanguages.Count / Grid.Rows

EndEvent

Event GridPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridPaginationBar.SelectedPage = !'Previous'
			Grid.PreviousPage()
		Case GridPaginationBar.SelectedPage = !'Next'
			Grid.NextPage()
		Otherwise
			&PageToGo.FromString(GridPaginationBar.SelectedPage)
			Grid.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid.Rows = GridPaginationBar.RowsPerPageSelectedValue
	Grid.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid.Load

	For &GAMLanguage in &GAMLanguages

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the data
	
	&Delete = !'<i class="fa fa-times"></i>'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

		If &GAMLanguage.Online
			&LngID 		= &GAMLanguage.Culture
			&Language	= &GAMLanguage.Description
			&Name		= !""
			&Text		= !""
			For &GAMDescription in &GAMDescriptions
				If &LngID.ToLower() = Lower(&GAMDescription.Language)
					&Name 		= &GAMDescription.Name
					&Text 		= &GAMDescription.Text
					Exit
				EndIf
			EndFor
			Do 'LoadGrid'
			Load
		EndIf
	EndFor

EndEvent

Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(&PgmName + !"GridState") = !""
		&GridState.FromXml(LoadGridState.Udp(&PgmName + !"GridState"))
	Else
		&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))
	Endif	
	If not &GridState.PageSize.Trim().IsEmpty()
		Grid.Rows = &GridState.PageSize.ToNumeric()
	EndIf
	Grid.CurrentPage = &GridState.CurrentPage

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))

	// Save grid state in session.

	&GridState.PageSize = str(Grid.Rows)
	&GridState.CurrentPage = Grid.CurrentPage
	SaveGridState.Call(&PgmName + !"GridState",  &GridState.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event 'Confirm'

	Do 'SaveByType'

EndEvent

Event &Delete.Click

	&Name.SetEmpty()
	&Text.SetEmpty()

EndEvent

Sub 'ShowMessages'

	If &GAMErrorCollection.Count > 0
		For &Error in &GAMErrorCollection
			Msg(Format(!"%1 (GAM%2)", &Error.Message, &Error.Code))
		EndFor
	EndIf

EndSub

Sub 'LoadGrid'

	&Delete		= "GAM_Delete"
	If &Mode = TrnMode.Display Or &Mode = TrnMode.Delete
		&Language.Enabled	= False
		&Name.Enabled 		= False
		&Text.Enabled 		= False
		&Delete.Visible 	= False
	Else
		&Name.Enabled		= True
		&Text.Enabled		= True
	EndIf

EndSub

Sub 'ReadByType'

	Do Case
		Case &Type = !"Application"
			&GAMApplication.Load(&PrimaryID)
			If &GAMApplication.Success()
				&GAMDescriptions = &GAMApplication.Descriptions
			Else
				&GAMErrorColletion = &GAMApplication.GetErrors()
				Do 'ShowMessages'
			EndIf

		Case &Type = !"ApplicationMenu"
			&GAMApplication.Load(&PrimaryID)
			If &GAMApplication.Success()
				&GAMApplicationMenu = &GAMApplication.GetMenu(&SecondaryID, &GAMErrorCollection)
				If &GAMErrorCollection.Count = 0
				 	&GAMDescriptions = &GAMApplicationMenu.Descriptions
				Else
					Do 'ShowMessages'
				EndIf
			Else
				&GAMErrorColletion = &GAMApplication.GetErrors()
				Do 'ShowMessages'
			EndIf


		Case &Type = !"ApplicationMenuOption"
			&GAMApplication.Load(&PrimaryID)
			If &GAMApplication.Success()
				&GAMApplicationMenu = &GAMApplication.GetMenu(&SecondaryID, &GAMErrorCollection)
				If &GAMErrorCollection.Count = 0
					&GAMApplicationMenuOption = &GAMApplicationMenu.GetMenuOptionById(&PrimaryID, &TertiaryID, &GAMErrorCollection)
					If &GAMErrorCollection.Count = 0
						&GAMDescriptions = &GAMApplicationMenuOption.Descriptions
					Else
						Do 'ShowMessages'
					EndIf
				Else
					Do 'ShowMessages'
				EndIf
			Else
				&GAMErrorColletion = &GAMApplication.GetErrors()
				Do 'ShowMessages'
			EndIf

		Case &Type = !"Role"
			&GAMRole.Load(&PrimaryID)
			If &GAMRole.Success()
				&GAMDescriptions  = &GAMRole.Descriptions
			Else
				&GAMErrorColletion = &GAMRole.GetErrors()
				Do 'ShowMessages'
			EndIf

		Case &Type = !"SecurityPolicy"
			&GAMSecurityPolicy.Load(&PrimaryID)
			If &GAMSecurityPolicy.Success()
				&GAMDescriptions  = &GAMSecurityPolicy.Descriptions
			Else
				&GAMErrorColletion = &GAMSecurityPolicy.GetErrors()
				Do 'ShowMessages'
			EndIf

	EndCase

EndSub

Sub 'SaveByType'

	Do Case
		Case &Type = !"Application"
			&GAMApplication.Load(&PrimaryID)
			If &GAMApplication.Success()
				&GAMApplication.Descriptions.Clear()
				For Each line
					If Not &Name.IsEmpty() Or Not &Text.IsEmpty()
						&GAMDescription = New()
						&GAMDescription.Language	= &LngID
						&GAMDescription.Name		= &Name
						&GAMDescription.Text		= &Text
						&GAMApplication.Descriptions.Add(&GAMDescription)
					EndIf
				EndFor
				&GAMApplication.Save()
				If &GAMApplication.Success()
					Commit
					Return
				Else
					&GAMErrorColletion = &GAMApplication.GetErrors()
					Do 'ShowMessages'
				EndIf
			Else
				&GAMErrorColletion = &GAMApplication.GetErrors()
				Do 'ShowMessages'
			EndIf

		Case &Type = !"ApplicationMenu"
			&GAMApplication.Load(&PrimaryID)
			If &GAMApplication.Success()
				&GAMApplicationMenu = &GAMApplication.GetMenu(&SecondaryID, &GAMErrorCollection)
				If &GAMErrorCollection.Count = 0
					&GAMApplicationMenu.Descriptions.Clear()
					For Each line
						If Not &Name.IsEmpty() Or Not &Text.IsEmpty()
							&GAMDescription = New()
							&GAMDescription.Language	= &LngID
							&GAMDescription.Name		= &Name
							&GAMDescription.Text		= &Text
							&GAMApplicationMenu.Descriptions.Add(&GAMDescription)
						EndIf
					EndFor
					If &GAMApplication.UpdateMenu(&GAMApplicationMenu, &GAMErrorColletion)
						Commit
						Return
					Else
						Do 'ShowMessages'
					EndIf
				Else
					Do 'ShowMessages'
				EndIf
			Else
				&GAMErrorColletion = &GAMApplication.GetErrors()
				Do 'ShowMessages'
			EndIf

		Case &Type = !"ApplicationMenuOption"
			&GAMApplication.Load(&PrimaryID)
			If &GAMApplication.Success()
				&GAMApplicationMenu = &GAMApplication.GetMenu(&SecondaryID, &GAMErrorCollection)
				If &GAMErrorCollection.Count = 0
					&GAMApplicationMenuOption = &GAMApplication.GetMenuOption(&SecondaryID, &TertiaryID, &GAMErrorCollection)
					If &GAMErrorCollection.Count = 0
						&GAMApplicationMenuOption.Descriptions.Clear()
						For Each line
							If Not &Name.IsEmpty() Or Not &Text.IsEmpty()
								&GAMDescription = New()
								&GAMDescription.Language	= &LngID
								&GAMDescription.Name		= &Name
								&GAMDescription.Text		= &Text
								&GAMApplicationMenuOption.Descriptions.Add(&GAMDescription)
							EndIf
						EndFor
						If &GAMApplication.UpdateMenuOption(&SecondaryID, &GAMApplicationMenuOption, &GAMErrorCollection)
							Commit
							Return
						Else
							Do 'ShowMessages'
						EndIf
					Else
						Do 'ShowMessages'
					EndIf
				Else
					Do 'ShowMessages'
				EndIf
			Else
				&GAMErrorColletion = &GAMApplication.GetErrors()
				Do 'ShowMessages'
			EndIf

		Case &Type = !"Role"
			&GAMRole.Load(&PrimaryID)
			If &GAMRole.Success()
				&GAMRole.Descriptions.Clear()
				For Each line
					If Not &Name.IsEmpty() Or Not &Text.IsEmpty()
						&GAMDescription = New()
						&GAMDescription.Language	= &LngID
						&GAMDescription.Name		= &Name
						&GAMDescription.Text		= &Text
						&GAMRole.Descriptions.Add(&GAMDescription)
					EndIf
				EndFor
				&GAMRole.Save()
				If &GAMRole.Success()
					Commit
					Return
				Else
					&GAMErrorColletion = &GAMRole.GetErrors()
					Do 'ShowMessages'
				EndIf
			Else
				&GAMErrorColletion = &GAMRole.GetErrors()
				Do 'ShowMessages'
			EndIf

		Case &Type = !"SecurityPolicy"
			&GAMSecurityPolicy.Load(&PrimaryID)
			If &GAMSecurityPolicy.Success()
				&GAMSecurityPolicy.Descriptions.Clear()
				For Each line
					If Not &Name.IsEmpty() Or Not &Text.IsEmpty()
						&GAMDescription = New()
						&GAMDescription.Language	= &LngID
						&GAMDescription.Name		= &Name
						&GAMDescription.Text		= &Text
						&GAMSecurityPolicy.Descriptions.Add(&GAMDescription)
					EndIf
				EndFor
				&GAMSecurityPolicy.Save()
				If &GAMSecurityPolicy.Success()
					Commit
					Return
				Else
					&GAMErrorColletion = &GAMSecurityPolicy.GetErrors()
					Do 'ShowMessages'
				EndIf
			Else
				&GAMErrorColletion = &GAMSecurityPolicy.GetErrors()
				Do 'ShowMessages'
			EndIf

	EndCase

EndSub


]]></Source>
