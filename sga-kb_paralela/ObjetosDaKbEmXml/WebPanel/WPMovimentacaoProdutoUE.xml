    <Source><![CDATA[
Event Start

    Do 'Popular'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTMovimentacaoUEs_Empowerer.GridInternalName = GridSDTMovimentacaoUEs.InternalName
	GridSDTMovimentacaoUEs.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTMovimentacaoUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnFechar'

	return

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Popular'

	&mesAno = &dataCorrente.Month().ToString().Trim() + '/' + &dataCorrente.Year().ToString().Trim()

    for each
		where prodCodigo = &prodCodigo
		where prefCodigo = &prefCodigo
	          &prodDescricao	= prodDescricao
			  &uniDescricao     = find( uniDescricao, prefCodigo = &prefCodigo and uniCodigo = prodUnidMedConsumo,'' )
			  &estoUeSaldo      = find( estoUeSaldo, prefCodigo = &prefCodigo and estoUeProdCodigo = prodCodigo and estoUeLocCodigo = &locCodigo ,0 )
	endfor


//	for each
//		order prefCodigo, (lanestcodigo)
//		where lanestStatus = 'A'
//		where prefCodigo   = &prefCodigo
//			  &lanestCodigo = lanestcodigo
//			  exit
//	endfor

	&SDTMovimentacaoUE.Clear()

	for each trnsdistribuicao, trnsdistribuicaoitens
		order prefCodigo, distCodigo
		where prefCodigo = &prefCodigo
		where distLocalDestino = &locCodigo
		where distDataEnvio.Month() = &dataCorrente.Month()
		where distDataEnvio.year()  = &dataCorrente.year()
		where distItemProduto = &prodCodigo
		where distStatus = 'A'
		where distReceber = 'S'
	      &item = new()
		  &item.data   = distDataEnvio
		  &item.Codigo = 'Guia nr. ' + distCodigo.ToString().Trim()
		  &item.Tipo   = 'Entrada'
		  &item.SaldoAntes  = distiItemSaldoAntes
		  &item.Quantidade  = distItemQuantidade
		  &item.SaldoDepois = distiItemSaldoDepois
		  &item.lancamento  = distDataAlteracao.ToString()
		  &SDTMovimentacaoUE.Add( &item )
    Endfor

//    for each
//		order prefCodigo, lanestItemAlteracao
//		where lanestItemLocCodigo         = &locCodigo
//		where prefCodigo                  = &prefCodigo
//		// where lanestcodigo                = &lanestCodigo
//		where lanestItemAlteracao.Month() = &dataCorrente.Month()
//		where lanestItemAlteracao.year()  = &dataCorrente.year()
//		where lanestItemProdCodigo        = &prodCodigo
//	      &item = new()
//		  &item.data   = lanestItemAlteracao
//		  &item.Codigo = 'Saldo do Mês Anterior nr. ' + &lanestCodigo.ToString().Trim()
//		  &item.Tipo   = 'Entrada'
//		  &item.Quantidade = lanestItemQuantidade
//		  &SDTMovimentacaoUE.Add( &item )
//	endfor

	for each
		order prefCodigo, mapaUeCodigo
		where prefCodigo         = &prefCodigo
		where mapaUeLocCodigo    = &locCodigo
		where mapaUeData.Month() = &dataCorrente.Month()
		where mapaUeData.year()  = &dataCorrente.year()
		where mapaUeProdCodigo   = &prodCodigo
	      &item = new()
		  &item.data       = mapaUeData
		  &item.Codigo     = 'Mapa Consumo nr. ' +  mapaUeCodigo.ToString().Trim()
		  &item.Tipo       = 'Saida'
		  &item.SaldoAntes  = mapaUeSaldoAntes
		  &item.Quantidade  = mapaUeQuantidade
		  &item.SaldoDepois = mapaUeSaldoDepois
		  &item.lancamento  = mapaUeDataAlteracao.ToString()
		  &SDTMovimentacaoUE.Add( &item )
	endFor

    &SDTMovimentacaoUE.Sort('data')

EndSub


