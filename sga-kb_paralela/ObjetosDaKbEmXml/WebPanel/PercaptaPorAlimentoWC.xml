  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid_Empowerer.GridInternalName = Grid.InternalName
	Grid.Rows = Page.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	log.Info(format('%1 a %2',&DataInicial.ToFormattedString(),&DataFinal.ToFormattedString()),&Pgmname+'.Start')

EndEvent

Event Grid.Load

	for &Properties in &AreasEtapasTurnosAtendimentoCollection

		&AreEnsCodigo.FromString(&Properties.Get(!'AreEnsCodigo'))
		&AreEnsSequencial.FromString(&Properties.Get(!'AreEnsSequencial'))
		&carGruTurno.FromString(&Properties.Get(!'AtendimentoTurno'))
		&carDapGruCodigo.FromString(&Properties.Get(!'carGruCodigo'))

		For each trnspratosingredientes, trnscardapioprato
			Order prefCodigo, carDapGruCodigo, pratIngrProdCodigo, AreEnsCodigo, AreEnsSequencial, carGruTurno
			Where prefCodigo = &prefCodigo
			Where pratIngrProdCodigo = &pratIngrProdCodigo
			Where AreEnsCodigo = &AreEnsCodigo
			Where AreEnsSequencial = &AreEnsSequencial
			Where carGruTurno = &carGruTurno
			Where carDapGruCodigo = &carDapGruCodigo
			Where carPratoData >= &DataInicial
			Where carPratoData <= &DataFinal
			Where carDapStatus = Status.Ativo
			Where pratoCodigo = carPratoRefeicao
			Where pratIngrStatus = Status.Ativo
			Where pratIngrQuantidade > 0

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	&Chave.Clear()
	&Chave.Set(!'AreEnsCodigo',AreEnsCodigo.ToString())
	&Chave.Set(!'AreEnsSequencial',AreEnsSequencial.ToString())
	&Chave.Set(!'carGruTurno',carGruTurno.ToString())
	&ChaveJson = &Chave.ToJson()
	&GridSelected = (&IgnorarPercaptaPropertiesCollection.IndexOf(&ChaveJson) = 0)
	&AreEnsNome = concat(AreEnsCodigo.ToString().Trim(),AreEnsNome,'-')
	&AreEnsEtapaNome = concat(AreEnsSequencial.ToString().Trim(),AreEnsEtapaNome,'-')
	&TurnoDescricao = concat(carGruTurno.ToString().Trim(),Turno.EnumerationDescription(carGruTurno),'-')
	&pratIngrQuantidade = pratIngrQuantidade
	&Oferta = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

			/* Calcula oferta */
			For each trnspratosingredientes
				&Oferta += 1
			Endfor

			Load

		Endfor

	endfor

EndEvent

Event Refresh

	/* Carrega linhas selecionadas */
	&IgnorarPercaptaPropertiesCollection.FromJson(&IgnorarPercaptaJson)
	log.Info(&IgnorarPercaptaJson,&Pgmname+'.Refresh')

	&GridSelected.Enabled = true
	&Mes = &DataInicial.Month()
	&Ano = &DataInicial.Year()

	/* Carrega coleção de locais de atendimento */
	&locCodigoCollection.FromJson(&WebSession.Get(!'WizardRemessa_locCodigoCollection'))

	/* Carrega coleção de Áreas, Etapas e Turnos de atendimento */
	&AreasEtapasTurnosAtendimentoCollection.FromJson(&WebSession.Get(!'WizardRemessa_AreasEtapasTurnosAtendimentoCollection'))

EndEvent

Event &GridSelected.ControlValueChanged

	if not &GridSelected
		/* Adiciona as linhas selecionadas */
		&IgnorarPercaptaPropertiesCollection.Add(&ChaveJson)
	else
		/* Remove das linhas selecionadas */
		&Index = &IgnorarPercaptaPropertiesCollection.IndexOf(&ChaveJson)
		if &Index > 0
			&IgnorarPercaptaPropertiesCollection.Remove(&Index)
		endif
	endif

	GlobalEvents.IgnorarDados(&IgnorarPercaptaPropertiesCollection.ToJson())
	log.Info(&IgnorarPercaptaPropertiesCollection.ToJson(),&Pgmname+'.&GridSelected.ControlValueChanged')

EndEvent


]]></Source>
