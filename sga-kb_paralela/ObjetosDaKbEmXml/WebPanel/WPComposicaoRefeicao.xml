Event Start

	LoadWWPContext.Call(&WWPContext)
    &prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&prodCodigo.Visible = False
	Do 'LoadComboprodCodigo'

	Do 'AttributesSecurityCode'
	GridSDTComposicaoRefeicaos_Empowerer.GridInternalName = GridSDTComposicaoRefeicaos.InternalName
	GridSDTComposicaoRefeicaos.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTComposicaoRefeicaos.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnSalvar'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_BtnbtnSalvar.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_BtnbtnSalvar.Close

    if PRCDNutricionista()
		For &refeicao in &SDTComposicaoRefeicao
		    PRCDSalvarPerCapta(&prefCodigo,&refeicao.pratoCodigo,&refeicao.prodCodigo,&refeicao.AreEnsCodigo,&refeicao.AreEnsSequencial,&refeicao.perCapta)
		endFor
    else
		msg('Este usuário não tem permissão !') 
    endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Ask If DVelop_ConfirmPanel_BtnbtnSalvar.Result = !'Yes'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnReturn'

	return

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnProcurar'

	Do 'PopularGRID'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_prodCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&prodCodigo.FromString(Combo_prodCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If Not (&prefCodigo <> 26)
		SDTComposicaoRefeicao__AreEnsEtapaNome.Visible = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboprodCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//&prodCodigo initial value has to be loaded manually at the beginning of this Subrutine
	For Each
		Order prodDescricao
		Where prefCodigo = &prefCodigo and prodStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = prodCodigo.ToString().Trim()
		&Combo_DataItem.Title = prodDescricao
		&prodCodigo_Data.Add(&Combo_DataItem)
	EndFor
	Combo_prodCodigo.SelectedValue_set = iif(&prodCodigo.IsEmpty(), '', &prodCodigo.ToString().Trim())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'PopularGRID'

  &SDTComposicaoRefeicao.Clear()
  &oferta = 0

  /*msg('PrefCodigo ' + &prefCodigo.ToString() +
      '| Produto :  ' + &prodCodigo.ToString() +
	  ' Data Inicial ' + &dtInicial.ToString() +
	  ' Data Final ' + &dtFinal.ToString() )*/

  for each trnscardapioprato
      where prefCodigo  = &prefCodigo
      where carPratoData>=&dtInicial
      where carPratoData<=&dtFinal
            &carPratoRefeicao = carPratoRefeicao
	        &cardapCodigo     = carDapCodigo
			for each  trnspratosingredientes, trnsAreaEnsino
				order prefCodigo, carPratoData, carPratoHorario, AreEnsCodigo,AreEnsSequencial
				where prefCodigo         = &prefCodigo
				where pratoCodigo        = &carPratoRefeicao
				where pratIngrProdCodigo = &prodCodigo
				where AreEnsCodigo	      = &AreEnsCodigo when not &AreEnsCodigo.IsEmpty()
				where pratIngrStatus     = 'A'
				where pratIngrQuantidade>0                when &temPercapta
					  // msg('Entrou em ingrediente ')
					  &cardapCodigo = carDapCodigo
					  &refeicao         		 = new()
					  &refeicao.carDapCodigo     = &cardapCodigo
					  &refeicao.carDapDescricao  = PRCDBuscarCardapioDescricao(&prefCodigo,&cardapCodigo)
					  &refeicao.carPratoHorario  = carPratoHorario
					  &refeicao.carPratoData     = carPratoData
					  &refeicao.prodCodigo   	 = pratIngrProdCodigo
					  &refeicao.pratoCodigo      = &carPratoRefeicao
					  &refeicao.pratoDscricao    = PRCDBuscarPratoDescricao(&prefCodigo,&carPratoRefeicao)
					  &refeicao.perCapta         = pratIngrQuantidade
					  &refeicao.AreEnsCodigo     = AreEnsCodigo
					  &refeicao.AreEnsSequencial = AreEnsSequencial
					  &refeicao.AreEnsEtapaNome  = PRCDBuscarAreaEtapaNome(&prefCodigo,AreEnsCodigo,AreEnsSequencial)
					  &refeicao.AreEnsNome       = AreEnsNome
					  &SDTComposicaoRefeicao.Add( &refeicao )
					  &oferta += 1
			endFor
  endFor

EndSub


