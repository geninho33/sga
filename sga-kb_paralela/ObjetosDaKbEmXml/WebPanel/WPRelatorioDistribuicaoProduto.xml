  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&dataIncial  = Today()-60
	&dataFinal   = Today()
    LoadWWPContext.Call(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo
	&SDTProdutos.Clear()

	for each  trnsprodutos, trnsunidades
		order prefCodigo, prodDescricao
		where prefCodigo = &prefCodigo
		where uniCodigo = prodUnidMedConsumo
		where prodStatus = 'A'
		      &item = new()
			  &item.prodDescricao  = prodDescricao
			  &item.UNDistribuicao = uniDescricao
			  &item.prodCodigo     = prodCodigo
			  &SDTProdutos.Add(&item)
	Endfor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'AttributesSecurityCode'
	GridSDTProdutoss_Empowerer.GridInternalName = GridSDTProdutoss.InternalName
	GridSDTProdutoss.Rows = Page.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTProdutoss.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnImprimir'

	 &tem = false
	 for &item in &SDTProdutos
	    if &item.check
		   &tem = true
		   exit
		endif
	 endFor

    if &tem
	   &WWPContext.sdtprodutos.FromJson( &SDTProdutos.ToJson() )
	   SetWWPContext(&WWPContext)
	   NovaAba.Target = PRINTRelatorioDistribuicaoProdutos.Link( &dataIncial, &dataFinal, &rotaCodigo )
	   novaAba.OpenWindow()
	else
	   msg('Não foi selecionado nenhum produto para fazer apuração de distribuição! ')
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If Not (&rotaCodigo=0)
		&localDestino.Visible = False
		localDestino_Cell.Class = !'Invisible'
	Else
		&localDestino.Visible = True
		localDestino_Cell.Class = !'hidden-xs hidden-sm hidden-md hidden-lg col-xs-12'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
