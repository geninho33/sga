    <Source><![CDATA[
Event Start

    LoadWWPContext.Call(&WWPContext)
	if &WWPContext.prefCodigo.IsEmpty()
	   WPLoginUE()
	else
		&prefCodigo  = &WWPContext.prefCodigo
		&locCodigo   = &WWPContext.locCodigo
		&codigoAjuda = 7
    endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&grupo.Visible = False
	&classificacao.Visible = False
	&ContagemEstoque.Visible = False
	&ImprimirConferencia.Visible = False
	GridSDTProdutoss_Empowerer.GridInternalName = GridSDTProdutoss.InternalName
	GridSDTProdutoss.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTProdutoss.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAjuda'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WPAjudaUE.PopUp(&prefCodigo, &codigoAjuda)
	Refresh

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnProcurar'

  for each
		where prefCodigo = &prefCodigo
		&prefLocalDeposito = prefLocalDeposito
		Do 'BuscarProduto'
	endFor
	GridSDTProdutoss.Refresh()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'Dosalvar'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_Btnsalvar.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_Btnsalvar.Close

	Do 'SalvarEstoque'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Ask If DVelop_ConfirmPanel_Btnsalvar.Result = !'Yes'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoImprimir'

    &ContagemEstoque = true
	novaAba.Target   = RelatorioInventarioUE.Link(&grupo, &classificacao, &ComSaldo, &ContagemEstoque)
	novaAba.OpenWindow()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'BuscarProduto'

	&SDTProdutos.Clear()
	for each trnsprodutos
	// for each trnsprodutos, trnsprodutosgrupo
		order prodDescricao
		where prefCodigo = &prefCodigo
		where prodDescricao.ToLower() like '%' + &Nome.ToLower() when not &Nome.IsEmpty()
		where prodStatus = 'A'
		// where prodGrupCodigo = prodTipo
		// where not prodDescricao.IsEmpty()
		// where prodTipo = &grupo when not &grupo.IsEmpty()
		// where prodClassificacao = &classificacao when not &classificacao.IsEmpty()
		  // &item.Grupo           = prodGrupdescricao
	      // Do 'Local'
	      // &item.LocalNome       = &locDescricao
          &estoUeCodigo = find(estoUeCodigo,estoUeProdCodigo=prodCodigo and estoUeLocCodigo = &locCodigo and prefCodigo = &prefCodigo,0)
		  if &estoUeCodigo > -1
			  &item = new()
			  &item.estoUeCodigo    = &estoUeCodigo
			  &item.prodCodigo      = prodCodigo
			  &item.prodDescricao   = prodDescricao
			  &item.prefCodigo      = &prefCodigo
			  &item.UNCompra        = find(uniDescricao,uniCodigo = prodUnidMedCompra and prefCodigo = &prefCodigo,'')
			  &item.prodLocalSaldo  = find(estoUeSaldo,estoUeProdCodigo=prodCodigo and estoUeLocCodigo = &locCodigo and prefCodigo = &prefCodigo,0)
	          &SDTProdutos.Add(&item)
		  endif

	endFor

EndSub

Sub 'SalvarEstoque'

  &entrou = false

  for &item in &SDTProdutos
	  PRCDSalvarSaldoUE(  &item.prefCodigo, &item.estoUeCodigo, &item.prodLocalSaldo, &item.prodCodigo, &locCodigo )
	  &entrou = true
  endFor

  if &entrou
	  msg('Produtos atualizados com sucesso !')
  endif

EndSub


]]></Source>
