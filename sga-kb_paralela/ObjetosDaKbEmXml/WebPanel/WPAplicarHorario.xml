    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAplicar'

	&qtdePrato = 0

	if &carPratoCodigo<>0
		&tabela.load(&prefCodigo,&carDapCodigo,&carPratoCodigo)
		if &tabela.carPratoHorario<>&carPratoHorario
		   &tabela.carPratoHorario = &carPratoHorario
		   &tabela.Save()
		   if &tabela.Success()
			  commit
			  msg('Horário alterado com sucesso !')
		   else 
			  &Messages = &tabela.GetMessages()
			  for &Message in &Messages
			 	  msg( &Message.Id + '-' + &Message.Type + '' + &Message.Description )
			  endFor	
			endif
		endif
	else
		msg('Informe a refeição !')
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnRetorno'

	return

