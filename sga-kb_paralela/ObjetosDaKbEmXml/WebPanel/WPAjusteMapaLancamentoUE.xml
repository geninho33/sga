  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call( &WWPContext )
	if &WWPContext.prefCodigo.IsEmpty()
	   WPLoginUE()
	else   
	    &prefCodigo   = &WWPContext.prefCodigo
		&locCodigo    = &WWPContext.locCodigo
		&dataCorrente2 = now()
		&codigoAjuda   = 2
	    Do 'Popular Produtos'
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	tableBotoes.Height = 50
	GridSDTConsumoUEs_Empowerer.GridInternalName = GridSDTConsumoUEs.InternalName
	GridSDTConsumoUEs.Rows = Page.Rows
	GridSDTConsumoUEsPaginationBar.RowsPerPageSelectedValue = GridSDTConsumoUEs.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTConsumoUEsCurrentPage = GridSDTConsumoUEs.CurrentPage
	&GridSDTConsumoUEsPageCount = GridSDTConsumoUEs.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTConsumoUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTConsumoUEsPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTConsumoUEsPaginationBar.SelectedPage = !'Previous'
			GridSDTConsumoUEs.PreviousPage()
		Case GridSDTConsumoUEsPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTConsumoUEs.CurrentPage
			&PageToGo += 1
			GridSDTConsumoUEs.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTConsumoUEsPaginationBar.SelectedPage)
			GridSDTConsumoUEs.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTConsumoUEsPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTConsumoUEs.Rows = GridSDTConsumoUEsPaginationBar.RowsPerPageSelectedValue
	GridSDTConsumoUEs.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAjuda'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WPAjudaUE.PopUp(&prefCodigo, &codigoAjuda)
	Refresh

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnBuscar'

     Do 'Popular Produtos'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnSalvar'

      if &SDTConsumoUE.Count>0
	     &total =0
	     for &produto in &SDTConsumoUE
			  if &produto.qtdeAjuste>0
		         &total = &total + PRCDSalvarMapaAjuste(&prefCodigo,&dataCorrente2,&locCodigo,&produto.prodCodigo,&produto.qtdeAjuste,&produto.obsAjuste)
			  endif
		 endfor

		 if &total>0
			&msgTxt =  &total.ToString() + ' produto(s) atualizado(s) ! '
		 endif
		 msg( &msgTxt )
         Do 'Popular Produtos'
	  else
		 msg('Não existe produtos para serem lançados !')
  	  endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Popular Produtos'

&SDTConsumoUE.Clear()
for each
	order prodCodigoTipoRemessa, prodDescricao
	where prefCodigo = &prefCodigo
	where prodStatus = 'A'
	where prodDescricao like '%'+&prodBusca+'%' when not &prodBusca.IsEmpty()
	      if find(mapaUeQuantidade,mapaUeProdCodigo=prodCodigo and mapaUeLocCodigo=&locCodigo and mapaUeData = &dataCorrente2 ,0)>0

			  &ajuste = find(mapaUeAjuste,mapaUeProdCodigo=prodCodigo and mapaUeLocCodigo=&locCodigo and mapaUeData = &dataCorrente2 ,'')
			  if &ajuste = '' or &ajuste = 'A'
				 if &ajuste = 'A'
				    &ajuste = 'Aguardando'
				 endif
			  else
				 &ajuste = 'Confirmado'
			  endif

			  &produto = new()
			  &produto.prodCodigo      = prodCodigo
			  &produto.prodDescricao   = prodDescricao
			  &produto.uniDescricao    = find(uniDescricao,uniCodigo=prodUnidMedConsumo,'')
			  &produto.Quantidade      = find(mapaUeQuantidade,mapaUeProdCodigo=prodCodigo and mapaUeLocCodigo=&locCodigo and mapaUeData = &dataCorrente2 ,0)
			  &produto.Obs             = find(mapaUeObs,mapaUeProdCodigo=prodCodigo and mapaUeLocCodigo=&locCodigo and mapaUeData = &dataCorrente2 ,'')
			  &produto.distipDescricao = find(disTipDescricao ,disTipNumero = prodCodigoTipoRemessa ,'')
			  &produto.saldo           = find(estoUeSaldo,estoUeProdCodigo=prodCodigo and estoUeLocCodigo=&locCodigo,0)
			  &produto.obsAjuste       = find(mapaUeObsAjuste,mapaUeProdCodigo=prodCodigo and mapaUeLocCodigo=&locCodigo and mapaUeData = &dataCorrente2 ,'')
			  &produto.qtdeAjuste      = find(mapaUeQtdeAjuste,mapaUeProdCodigo=prodCodigo and mapaUeLocCodigo=&locCodigo and mapaUeData = &dataCorrente2 ,0)
			  &produto.ajuste          = &ajuste
			  &SDTConsumoUE.Add( &produto )
		  endIf
endFor

EndSub


]]></Source>
