    <Source><![CDATA[
Event Start

	LoadWWPContext.Call( &WWPContext )
	if &WWPContext.prefCodigo.IsEmpty()
	   WPLoginUE()
	else

	    &prefCodigo   = &WWPContext.prefCodigo
		&locCodigo    = &WWPContext.locCodigo
		&dataCorrente = now()
		&dataCorrente2 = now()
		&mes_corrente  = &dataCorrente.Month()
		&ano_corrente = &dataCorrente.Year()
		&codigoAjuda   = 4
		&temPendencias = false

		Do 'Verificar Recebimento'

	    Do 'Popular Produtos'
    endif

    if &temPendencias
	   msg('Existe guias para você dar baixa ! Vá em GUIAS DE ENTREGAS e clique no botão em destaque para dar baixa.')
    endif

	// DVPanel_cpanelLancamento.Title += ' | Data : ' +  &dataAtual.ToString()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	tableBotoes.Height = 50
	&comSaldo.Visible = False
	GridSDTConsumoUEs_Empowerer.GridInternalName = GridSDTConsumoUEs.InternalName
	GridSDTConsumoUEs.Rows = Page.Rows
	GridSDTConsumoUEsPaginationBar.RowsPerPageSelectedValue = GridSDTConsumoUEs.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTConsumoUEsCurrentPage = GridSDTConsumoUEs.CurrentPage
	&GridSDTConsumoUEsPageCount = GridSDTConsumoUEs.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTConsumoUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTConsumoUEsPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTConsumoUEsPaginationBar.SelectedPage = !'Previous'
			GridSDTConsumoUEs.PreviousPage()
		Case GridSDTConsumoUEsPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTConsumoUEs.CurrentPage
			&PageToGo += 1
			GridSDTConsumoUEs.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTConsumoUEsPaginationBar.SelectedPage)
			GridSDTConsumoUEs.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTConsumoUEsPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTConsumoUEs.Rows = GridSDTConsumoUEsPaginationBar.RowsPerPageSelectedValue
	GridSDTConsumoUEs.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAjuda'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WPAjudaUE.PopUp(&prefCodigo, &codigoAjuda)
	Refresh

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnBuscar'

      Do 'Popular Produtos'

	  // GridSDTConsumoUEs.Refresh()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnSalvar'

      &critica = ''
	  &retorno = ''

      if &SDTConsumoUE.Count>0
	     &total =0
	     for &produto in &SDTConsumoUE			 
				if &produto.quantidade<>PRCDBuscarQtdeMapa(&prefCodigo,&dataCorrente,&locCodigo,&produto.prodCodigo)
					
					// verifica se já foi feito algum lançamento
					// do produto em uma data superior
					&retorno = PRCDVerificarDataConsumo(&prefCodigo,&dataCorrente,&locCodigo,&produto.prodCodigo)
					if &retorno = ''
					   if &produto.quantidade>&produto.saldo
						  &critica += '  ==> ' + &produto.prodDescricao + ' | Quantidade : ' + &produto.quantidade.ToString() + ' é maior que o estoque ' + chr(13)
					   else
						  &total = &total + PRCDSalvarMapa(&prefCodigo,&dataCorrente,&locCodigo,&produto.prodCodigo,&produto.quantidade,&produto.obs)
					   endif
					else
					   &critica += &retorno
					   &retorno = ''
					endif			  
				else
					if &produto.obs<>PRCDBuscarObsMapa(&prefCodigo,&dataCorrente,&locCodigo,&produto.prodCodigo)
					   &total = &total + PRCDSalvarMapa(&prefCodigo,&dataCorrente,&locCodigo,&produto.prodCodigo,&produto.quantidade,&produto.obs)
					endif
				endif

		  
		 endfor

		 if &total>0
			&msgTxt =  &total.ToString() + ' produto(s) atualizado(s) ! '
		 endif

	     if not &critica.IsEmpty()
			&msgTxt += chr(13) + &critica
	     endif

		 msg( &msgTxt )

	  else
		 msg('Não existe produtos para serem lançados !')
  	  endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnImprimirAtual'

	PRINTRelatorioConsumoUE.Popup(&locCodigo,&dataCorrente,&dataCorrente)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnImprimirTudo'

	&dataInicial = date.New(&dataCorrente.Year(),&dataCorrente.Month(),1)
	&dataFinal   = &dataCorrente.EndOfMonth()
	PRINTRelatorioConsumoUE.Popup(&locCodigo,&dataInicial,&dataFinal)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnFechar'

//   WWPActions.DropDownComponent_Close(TableMain.InternalName)
//   wpMapaUE.Call()

EndEvent

Event &dataCorrente.ControlValueChanged

&dataCorrente2 = &dataCorrente

Do 'Popular Produtos'

EndEvent

Sub 'Popular Produtos'

	if &mes_corrente = &dataCorrente.Month() and  &ano_corrente = &dataCorrente.Year()
		&SDTConsumoUE.Clear()
		for each
			order prodCodigoTipoRemessa, prodDescricao
			where prefCodigo = &prefCodigo
			where prodStatus = 'A'
			where prodDescricao like '%'+&prodBusca+'%' when not &prodBusca.IsEmpty()
					&saldo = find(estoUeSaldo, prefCodigo = &prefCodigo and estoUeProdCodigo=prodCodigo and estoUeLocCodigo=&locCodigo,0)

					if &saldo > -1
						&produto = new()
						&produto.prodCodigo      = prodCodigo
						&produto.prodDescricao   = prodDescricao
						&produto.uniDescricao    = prodObsConsumo
						&produto.uniDescricao    = find(uniDescricao, prefCodigo = &prefCodigo and uniCodigo=prodUnidMedConsumo,'')
						&produto.Quantidade      = find(mapaUeQuantidade, prefCodigo = &prefCodigo and mapaUeProdCodigo=prodCodigo and mapaUeLocCodigo=&locCodigo and mapaUeData = &dataCorrente ,0)
						&produto.Obs             = find(mapaUeObs, prefCodigo = &prefCodigo and mapaUeProdCodigo=prodCodigo and mapaUeLocCodigo=&locCodigo and mapaUeData = &dataCorrente ,'')
						&produto.distipDescricao = find(disTipDescricao, prefCodigo = &prefCodigo and disTipNumero = prodCodigoTipoRemessa ,'')
						&produto.saldo           = &saldo
						&SDTConsumoUE.Add( &produto )
					endIf

		endFor
	else
	   &SDTConsumoUE.Clear()
       msg('Só é permitido lançamento de estoque no mês corrente !')
	endif

EndSub

Sub 'Verificar Recebimento'

	for each
		where distLocalDestino = &loccodigo
		where distStatus = 'A'
		where distReceber<>'S'
		where distCodigoTipoRemessa = 10
		where distDataEnvio<Date.Today()
		      &temPendencias = true
			  exit
    endfor

EndSub

