//			if &index > 0
//				&locCodigoCollection.Remove(&index)
//			endif
//		endif
//	endfor

EndSub

Sub 'CalculaNecessidade'

	&TotCalculo = 0
	&Necessidade.Clear()

	for &GridPessoasItem in &WizardData.Pessoas2.Grid

		&LocaisIgnorarGridSDTItem = new()
		&LocaisIgnorarGridSDTItem.Selected		= (&locCodigoCollection.IndexOf(&GridPessoasItem.locCodigo) > 0)
		&LocaisIgnorarGridSDTItem.locCodigo 	= &GridPessoasItem.locCodigo
		&LocaisIgnorarGridSDTItem.locDescricao 	= &GridPessoasItem.locDescricao

		/* Calcula necessidade */
		&ValorPerCapta  = ((&Bercario1PerCapta * &GridPessoasItem.Bercario1) * &Bercario1Oferta)
		&ValorPerCapta += ((&Bercario2PerCapta * &GridPessoasItem.Bercario2) * &Bercario2Oferta)
		&ValorPerCapta += ((&CrechePerCapta * &GridPessoasItem.Creche) * &CrecheOferta)
		&ValorPerCapta += ((&EmebPerCapta * &GridPessoasItem.Emeb) * &EmebOferta)
		&ValorPerCapta += ((&IntegralPerCapta * &GridPessoasItem.Integral) * &IntegralOferta)
		&ValorPerCapta += ((&FuncionarioPerCapta * &GridPessoasItem.Funcionarios) * &FuncionarioOferta)

		if &ValorPerCapta > 0
			&Calculo = round(((&ValorPerCapta / &prodPesoConsumo) + 0.49),0)
			if &Calculo = 0
				&Calculo = 1
			endif
		else
			&Calculo = 0
		endif

		&LocaisIgnorarGridSDTItem.Calculo = &Calculo

		&Necessidade.Add(&LocaisIgnorarGridSDTItem)

		/* Acumula total da necessidade */
		if not &LocaisIgnorarGridSDTItem.Selected
			&TotCalculo += &Calculo
		endif

	endfor

EndSub

