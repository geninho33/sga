	log.Info(&locCodigoCollection.ToJson(),'locCodigoCollection-Start')

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridLocaisIgnorarGridSDTs_Empowerer.GridInternalName = GridLocaisIgnorarGridSDTs.InternalName
	GridLocaisIgnorarGridSDTs.Rows = 0
	LocaisIgnorarGridSDT__Selected.TitleFormat = 1
	LocaisIgnorarGridSDT__Selected.Title = format(!'<input name="selectAllCheckboxGridLocaisIgnorarGridSDTs" type="checkbox" value="Select All" onClick="WWPSelectAll(this, %1);" onMouseOver="WWPSelectAllRemoveParentOnClick(this)" class="AttributeCheckBox" >', !"'LOCAISIGNORARGRIDSDT__SELECTED'")

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	do 'CalculaNecessidade'

EndEvent

