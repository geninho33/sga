	Return

EndEvent

Event Refresh

	LocaisIgnorarGridSDT__Selected.TitleFormat = 1
	LocaisIgnorarGridSDT__Selected.Title = format(!'<input name="selectAllCheckboxGridLocaisIgnorarGridSDTs" type="checkbox" value="Select All" onClick="WWPSelectAll(this, %1);" onMouseOver="WWPSelectAllRemoveParentOnClick(this)" class="AttributeCheckBox" >', !"'LOCAISIGNORARGRIDSDT__SELECTED'")

	&SelCalculo = 0
	&LocaisIgnorarGridSDT.Clear()
	for &LocaisIgnorarGridSDTItem in &Necessidade

		if &locDescricaoPesquisa.IsEmpty() or (&LocaisIgnorarGridSDTItem.locDescricao.RemoveDiacritics().ToLower().IsMatch(&locDescricaoPesquisa.RemoveDiacritics().ToLower()))
			&LocaisIgnorarGridSDT.Add(&LocaisIgnorarGridSDTItem)
		endif

	endfor

EndEvent

Sub 'LoadGridSelectedRows'

	For each line in GridLocaisIgnorarGridSDTs
		if &LocaisIgnorarGridSDT.CurrentItem.Selected
			if &locCodigoCollection.IndexOf(&LocaisIgnorarGridSDT.CurrentItem.locCodigo) = 0
				&locCodigoCollection.Add(&LocaisIgnorarGridSDT.CurrentItem.locCodigo)
			endif
		else
			&index = &locCodigoCollection.IndexOf(&LocaisIgnorarGridSDT.CurrentItem.locCodigo)
			if &index > 0
				&locCodigoCollection.Remove(&index)
			endif
		endif
	Endfor

//	for &LocaisIgnorarGridSDTItem in &LocaisIgnorarGridSDT
