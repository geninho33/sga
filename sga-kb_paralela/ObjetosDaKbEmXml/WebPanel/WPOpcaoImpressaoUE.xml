  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&hoje = now()
    LoadWWPContext.Call(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo
	&dataIncial = &hoje
	&dataFinal  = &hoje.AddDays(30)

    Do 'Popular Grid'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'AttributesSecurityCode'
	GridSDTProdutoss_Empowerer.GridInternalName = GridSDTProdutoss.InternalName
	GridSDTProdutoss.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTProdutoss.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnImprimir'

	 &varListProd = ''
     if &dataFinal<&dataIncial
	    msg('Data Inicial é maior que a data Final')
	 else

		// Buscando os produtos selecionados
		for &produto in &SDTProdutos
			if &produto.checar
				&varListProd += '[' + &produto.prodCodigo.ToString().Trim()+']'
			endif
		endFor

		if &varListProd.IsEmpty()
			msg('Não foi selecionado nenhum produto !')
		else
			 novaAba.Target =  PRINTEntradaSaidaUE.Link(&dataIncial,&dataFinal,&localDestino,&varListProd,&tipo)
			 novaAba.OpenWindow()
		endif

	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If Not (&rotaCodigo=0)
		&localDestino.Visible = False
		localDestino_Cell.Class = !'Invisible'
	Else
		&localDestino.Visible = True
		localDestino_Cell.Class = !'col-xs-12'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'Popular Grid'

	&SDTProdutos.Clear()

	for each
		order prefCodigo, prodDescricao
		where prodStatus = 'A'
		where prefCodigo = &prefCodigo
			  &produto               = new()
			  &produto.checar        = False
			  &produto.prodCodigo    = prodCodigo
			  &produto.prodDescricao = prodDescricao
			  &SDTProdutos.Add( &produto )
	endfor

EndSub


]]></Source>
