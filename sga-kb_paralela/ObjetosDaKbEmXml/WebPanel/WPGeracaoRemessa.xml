  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&tem = false
	for each
		where prefCodigo = &prefCodigo
		  &locCodigo = prefLocalDeposito
		  for each
			  where prefCodigo = &prefCodigo
			  where remCodigo = &remCodigo
			  &remCadastro =  PadL(remCadastro.Month().ToString().Trim(),2,'0') + '/'+remCadastro.Year().ToString().Trim()

			  if not remGerSemana1Ini.IsEmpty()
		          &periodoSemana1Ini = remGerSemana1Ini
				  &periodoSemana1Fim = remGerSemana1Fim
				  &tem = true
			  endif

		      if not remGerSemana2Ini.IsEmpty()
		          &periodoSemana2Ini = remGerSemana2Ini
				  &periodoSemana2Fim = remGerSemana2Fim
				  &tem = true
			  endif

		      if not remGerSemana3Ini.IsEmpty()
		          &periodoSemana3Ini = remGerSemana3Ini
				  &periodoSemana3Fim = remGerSemana3Fim
				  &tem = true
			  endif

		      if not remGerSemana4Ini.IsEmpty()
				  &periodoSemana4Ini = remGerSemana4Ini
			      &periodoSemana4Fim = remGerSemana4Fim
				  &tem = true
			  endif

		      if not remGerSemana5Ini.IsEmpty()
		          &periodoSemana5Ini = remGerSemana5Ini
				  &periodoSemana5Fim = remGerSemana5Fim
				  &tem = true
			  endif

		  endfor

	      if not &tem
			 msg('Informe um periodo para poder ser feito o processamento !')
		  endif
	endFor

	&dataEnvio = Now()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'AttributesSecurityCode'
	&dataEnvio.Visible = False

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnRetornar'

	return

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnZerarRemessa'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_BtnbtnZerarRemessa.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_BtnbtnZerarRemessa.Close

    PRCDRemessaZerar(&prefCodigo,&remCodigo,&disTipNumero)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Ask If DVelop_ConfirmPanel_BtnbtnZerarRemessa.Result = !'Yes'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnGerar'

	&remItemPeriodo = &periodoSemana5Ini.ToString()+' a ' + &periodoSemana5Fim.ToString()
	&dataInicial    = &periodoSemana5Ini
	&dataFinal      = &periodoSemana5Fim
	Do 'Geracao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnGerarSemana4'

	&remItemPeriodo = &periodoSemana4Ini.ToString()+' a ' + &periodoSemana4Fim.ToString()
	&dataInicial    = &periodoSemana4Ini
	&dataFinal      = &periodoSemana4Fim
	Do 'Geracao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnGerarSemana3'

	&remItemPeriodo = &periodoSemana3Ini.ToString()+' a ' + &periodoSemana3Fim.ToString()
	&dataInicial    = &periodoSemana3Ini
	&dataFinal      = &periodoSemana3Fim
	Do 'Geracao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnGerarSemana2'

	&remItemPeriodo = &periodoSemana2Ini.ToString()+' a ' + &periodoSemana2Fim.ToString()
	&dataInicial    = &periodoSemana2Ini
	&dataFinal      = &periodoSemana2Fim
	Do 'Geracao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnGerarSemana1'

	&remItemPeriodo = &periodoSemana1Ini.ToString()+' a ' + &periodoSemana1Fim.ToString()
	&dataInicial    = &periodoSemana1Ini
	&dataFinal      = &periodoSemana1Fim
	Do 'Geracao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	tableSemana2.Visible = (not &periodoSemana2Ini.isEmpty())
	tableSemana3.Visible = (not &periodoSemana3Ini.isEmpty())
	tableSemana4.Visible = (not &periodoSemana4Ini.isEmpty())
	tableSemana5.Visible = (not &periodoSemana5Ini.isEmpty())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'Geracao'

	for each trnsremessaatendimento
		where prefCodigo = &prefCodigo
		where remCodigo  = &remCodigo
           exit
	when none
    	 PRCDPopularRemessaAtendimento(&prefCodigo, &remCodigo,&dataInicial,&dataFinal)
    endfor

	for each
		where prefCodigo     = &prefCodigo
		where remItemPeriodo = &remItemPeriodo
		where remCodigo      = &remCodigo
	          msg('Já existe uma remessa nesse Período !')
		      exit
	when none
		
		 if &tipoGeracao in ('P','T')
		 	PRCDPopularRemessaAlimento(&prefCodigo, &remCodigo,&dataInicial,&dataFinal,&disTipNumero)
		 endif
	      
		 if &tipoGeracao in ('D','T')
			 PRCDPopularDistribuicao(&remCodigo,&dataEnvio,&locCodigo,&dataInicial,&dataFinal,&disTipNumero)
		 endif
	 
		 msg('Geração finalizada !' )
    endFor

EndSub


