    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridRomaneios_Empowerer.GridInternalName = GridRomaneios.InternalName
	GridRomaneios.Rows = Page.Rows
	&GridRomaneiosSelected.TitleFormat = 1
	&GridRomaneiosSelected.Title = format(!'<input name="selectAllCheckboxGridRomaneios" type="checkbox" value="Select All" onClick="WWPSelectAll(this, %1);" onMouseOver="WWPSelectAllRemoveParentOnClick(this)" class="AttributeCheckBox" >', !"'GRIDROMANEIOSSELECTED'")

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	if &Vinculados
		DvPanel_TableRomaneios.Title = 'Romaneios Vinculados'
		BtnEnter.Caption = 'Remover'
	else
		DvPanel_TableRomaneios.Title = 'Romaneios Não Vinculados'
		BtnEnter.Caption = 'Adicionar'
	endif

EndEvent

Event GridRomaneios.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	&GridRomaneiosSelected = false

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Enter

	Do 'LoadGridRomaneiosSelectedRows'
	if &GridRomaneiosSelectedRows.Count > 0

		&romanCodigoCollection = new()
		for &GridRomaneiosSelectedRow in &GridRomaneiosSelectedRows
			&romanCodigoCollection.Add(&GridRomaneiosSelectedRow.romanCodigo)
		endfor

		if &Vinculados
			&IsSucess = VinculaRomaneioNotaProcesso(false,&prefCodigo,&notaCodigo,&romanCodigoCollection,&Message)
			if &IsSucess
				Commit
			else
				Rollback
				msg(&Message.Description)
			endif
		else
			&IsSucess = VinculaRomaneioNotaProcesso(true,&prefCodigo,&notaCodigo,&romanCodigoCollection,&Message)
			if &IsSucess
				Commit
			else
				Rollback
				msg(&Message.Description)
			endif
			// VinculaRomaneioNotaValorProduto.Popup(&prefCodigo,&notaCodigo,&romanCodigoCollection.ToJson())
		endif

		GlobalEvents.RomaneioWC_Refresh()
	else
		msg('Nenhum romaneio foi selecionado.')
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadGridRomaneiosSelectedRows'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridRomaneiosSelectedRows = new()
	For Each Line in GridRomaneios
		If (&GridRomaneiosSelected)
			&GridRomaneiosSelectedRow = new()

			&GridRomaneiosSelectedRow.romanCodigo = romanCodigo
			&GridRomaneiosSelectedRow.romanData = romanData

			&GridRomaneiosSelectedRows.Add(&GridRomaneiosSelectedRow)
		Endif
	Endfor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event Refresh

	&TotalSelected = 0

EndEvent


