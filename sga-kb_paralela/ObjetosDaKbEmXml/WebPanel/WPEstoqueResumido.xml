    <Source><![CDATA[
Event Start

	LoadWWPContext.Call( &WWPContext )
    &prefCodigo = &WWPContext.prefCodigo
	&hoje       = now()
	&dtInicial  = &hoje - 60
	&dtFinal    = &hoje

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTMovimentacaoUEs_Empowerer.GridInternalName = GridSDTMovimentacaoUEs.InternalName
	GridSDTMovimentacaoUEs.Rows = Page.Rows
	GridSDTMovimentacaoUEsPaginationBar.RowsPerPageSelectedValue = GridSDTMovimentacaoUEs.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTMovimentacaoUEsCurrentPage = GridSDTMovimentacaoUEs.CurrentPage
	&GridSDTMovimentacaoUEsPageCount = GridSDTMovimentacaoUEs.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTMovimentacaoUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTMovimentacaoUEsPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTMovimentacaoUEsPaginationBar.SelectedPage = !'Previous'
			GridSDTMovimentacaoUEs.PreviousPage()
		Case GridSDTMovimentacaoUEsPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTMovimentacaoUEs.CurrentPage
			&PageToGo += 1
			GridSDTMovimentacaoUEs.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTMovimentacaoUEsPaginationBar.SelectedPage)
			GridSDTMovimentacaoUEs.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTMovimentacaoUEsPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTMovimentacaoUEs.Rows = GridSDTMovimentacaoUEsPaginationBar.RowsPerPageSelectedValue
	GridSDTMovimentacaoUEs.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnBuscar'

if &dtInicial>&dtFinal
   msg("A data inicial do período é maior que a data final !")
else
	&SDTMovimentacaoUE.Clear()
	&estoCadastro.SetEmpty()
	&estoCadastroInicial.SetEmpty()
	&estoTipo            = ''
	&estoQuantidade      = 0
	&estoQtdeAnterior    = 0
    // msg("prefCodigo : " + &prefCodigo.ToString() + "| prodCodigo : " + &prodCodigo.ToString() + " | Tipo  " + &tipo )
	for each TRNSEstoque
		order prefCodigo, estoTipo, (estoAlteracao)
		where prefCodigo    =  &prefCodigo
		where estoProduto   =  &prodCodigo
		where estoAlteracao >= &dtInicial
		where estoAlteracao <= &dtFinal
		where upper(estoTipo) =  upper(&tipo) when upper(&tipo) <> 'T'
		if estoTipo<>&estoTipo
			if &estoTipo<>''
				&item             = new()
				&item.Tipo        = iif( &estoTipo = 'S','Saida','Entrada' )
				&item.Periodo     = &estoCadastroInicial.ToDate().ToString().Trim() + ' a '+ estoAlteracao.ToDate().ToString().Trim()
				&item.SaldoAntes  = &estoQtdeAnterior
				&item.Quantidade  = &estoQuantidade
				&item.SaldoDepois = estoSaldoAtual
				&item.Descricao   = estoProdutoDescricao
				&item.Codigo      = estoProduto.ToString().Trim()
				&item.Unidade     = estoUnidadeSigla
				&SDTMovimentacaoUE.Add(&item)
				&estoQuantidade   = 0
			endif
			&estoCadastroInicial = estoAlteracao
			&estoQtdeAnterior    = iif( &estoTipo = 'S',(estoSaldoAtual+estoQuantidade),(estoSaldoAtual-estoQuantidade) )
		endif
		&estoQuantidade   += estoQuantidade
		&estoTipo          = estoTipo
	when none
		msg("Não foi encontrado nenhuma movimentação nesse período !")
	endFor
endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent


]]></Source>
