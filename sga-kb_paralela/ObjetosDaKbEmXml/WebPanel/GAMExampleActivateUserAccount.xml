  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start
	&isOK = GAMRepository.ActivateUser(&ActivationKey, True, &GAMErrorCollection)
	If &isOK
		Msg("GAM_Youruseraccountwasactivatedsuccessfully" + NewLine() + "GAM_YoumustgototheLoginpagetoentertheapplication")
	Else
		Do 'DisplayMessages'
	Endif
Endevent


Event 'Login'
	GAMExampleLogin()
Endevent


Sub 'DisplayMessages'
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
EndSub
]]></Source>
