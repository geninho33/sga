    <Source><![CDATA[
Event Start

     Do 'calculandoMacroMicroNutrientes'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTNutrientess_Empowerer.GridInternalName = GridSDTNutrientess.InternalName
	GridSDTNutrientess.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTNutrientess.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'calculandoMacroMicroNutrientes'

    &SDTNutrientes.Clear()
	&prodCaloria	  =0
	&prodCarboidrato  =0
	&prodProteina     =0
	&prodLipidio 	  =0
	&prodFibra  	  =0
	&prodVitaminaA 	  =0
	&prodVitaminaC    =0
	&prodCalcio       =0
	&prodFerro  	  =0
	&prodMagnesio 	  =0
	&prodZinco 		  =0
	&prodSodio 		  =0
	
	For each trnscardapio 		
		where prefCodigo  = &prefCodigo		
		where carDapCodigo = &carDapCodigo
	 	      &carDapGruCodigo = carDapGruCodigo
	endFor


	For each trnscardapioprato 		
		where prefCodigo  = &prefCodigo		
		where carDapCodigo = &carDapCodigo
		&pratoCodigo = carPratoRefeicao
		// &pratoCodigo = carPratoCodigo
		
		//For each  trnspratos 
			//where prefCodigo  = &prefCodigo
			//where pratoCodigo = &pratoCodigo
			
			// apuração de ingredientes
			For each trnspratosingredientes			
				where prefCodigo  = &prefCodigo
				where pratoCodigo = &pratoCodigo
					  &pratIngrProdCodigo = pratIngrProdCodigo
				
				For each trnsprodutos
					where prodCodigo  = &pratIngrProdCodigo
					where prefCodigo  = &prefCodigo
						&prodCaloria	  += prodCaloria
						&prodCarboidrato  += prodCarboidrato
						&prodProteina     += prodProteina
						&prodLipidio 	  += prodLipidio
						/*
						&prodFibra  	  += prodFibra
						&prodVitaminaA 	  += prodVitaminaA
						&prodVitaminaC    += prodVitaminaC
						&prodCalcio       += prodCalcio
						&prodFerro  	  += prodFerro
						&prodMagnesio 	  += prodMagnesio
						&prodZinco 		  += prodZinco
						&prodSodio 		  += prodNdpcal + prodNpcal
						*/
				EndFor 					  				
			EndFor		
		//EndFor
	EndFor

   &totalAtendimentoNormal = 0
	For each Atendimento
		order prefCodigo, carGruCodigo 
		where prefCodigo = &prefCodigo
		where carGruCodigo = &carDapGruCodigo
	          &totalAtendimentoNormal += AtendimentoNormalSegunda
	endFor		  

    &item = new()
	&item.Nutriente = 'Calorias'
	&item.unidade   = 'kcal'
	&item.valor     = (&prodCaloria* &totalAtendimentoNormal)/4
	&SDTNutrientes.Add( &item )
	
    &item = new()
	&item.Nutriente = 'Carboidratos'
	&item.unidade   = 'g'
	&item.valor     = (&prodCarboidrato* &totalAtendimentoNormal)/4
	&SDTNutrientes.Add( &item )
	
    &item = new()
	&item.Nutriente = 'Proteinas'
	&item.unidade   = 'g'
	&item.valor     = (&prodProteina* &totalAtendimentoNormal)/4
	&SDTNutrientes.Add( &item )
	
    &item = new()
	&item.Nutriente = 'Lipidios'
	&item.unidade   = 'g'
	&item.valor     = (&prodLipidio* &totalAtendimentoNormal)/4
	&SDTNutrientes.Add( &item )
	
	/*
    &item = new()
	&item.Nutriente = 'Fibras'
	&item.unidade   = 'g'
	&item.valor     = &prodFibra/4
	&SDTNutrientes.Add( &item )

    &item = new()
	&item.Nutriente = 'Vitamina A'
	&item.unidade   = 'mg'
	&item.valor     = &prodVitaminaA/4
	&SDTNutrientes.Add( &item )

    &item = new()
	&item.Nutriente = 'Vitamina C'
	&item.unidade   = 'mg'
	&item.valor     = &prodVitaminaC/4
	&SDTNutrientes.Add( &item )

    &item = new()
	&item.Nutriente = 'Calcio'
	&item.unidade   = 'mg'
	&item.valor     = &prodCalcio/4
	&SDTNutrientes.Add( &item )

    &item = new()
	&item.Nutriente = 'Ferro'
	&item.unidade   = 'mg'
	&item.valor     = &prodFerro/4
	&SDTNutrientes.Add( &item )

    &item = new()
	&item.Nutriente = 'Magnesio'
	&item.unidade   = 'mg'
	&item.valor     = &prodMagnesio/4
	&SDTNutrientes.Add( &item )

    &item = new()
	&item.Nutriente = 'Zinco'
	&item.unidade   = 'mg'
	&item.valor     = &prodZinco/4
	&SDTNutrientes.Add( &item )

    &item = new()
	&item.Nutriente = 'Sódio'
	&item.unidade   = 'mg'
	&item.valor     = &prodSodio/4
	&SDTNutrientes.Add( &item )
	*/

EndSub


]]></Source>
