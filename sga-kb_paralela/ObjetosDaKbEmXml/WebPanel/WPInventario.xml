    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTProdutoss_Empowerer.GridInternalName = GridSDTProdutoss.InternalName
	GridSDTProdutoss.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTProdutoss.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnProcurar'

  for each
		where prefCodigo = &prefCodigo
		&prefLocalDeposito = prefLocalDeposito
		Do 'BuscarProduto'
	endFor
	GridSDTProdutoss.Refresh()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoImprimir'

	InNewWindow.Target = RelatorioInventario.Link(&grupo, &classificacao, &ComSaldo, &ContagemEstoque)
	InNewWindow.OpenWindow()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnSalvar'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_BtnbtnSalvar.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_BtnbtnSalvar.Close

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Ask If DVelop_ConfirmPanel_BtnbtnSalvar.Result = !'Yes'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	If DVelop_ConfirmPanel_BtnbtnSalvar.Result = !'Yes'
		Do 'salvarDados'
	endif

EndEvent

Sub 'BuscarProduto'

	// &SDTProdutos.Clear()
	&SDTProdutos = New()
	for each trnsprodutos, trnsprodutosgrupo, trnsunidades
		order prodDescricao
		where prefCodigo = &prefCodigo
		where prodGrupCodigo = prodTipo
		where not prodDescricao.IsEmpty()
		where prodDescricao.ToLower() like '%' + &Nome.ToLower() when not &Nome.IsEmpty()
		where prodStatus = 'A'
		where prodTipo = &grupo when not &grupo.IsEmpty()
		where uniCodigo = prodUnidMedCompra
		where prodClassificacao = &classificacao when not &classificacao.IsEmpty()
			  &item = new()
			  &item.prodCodigo      = prodCodigo
			  &item.prodDescricao   = prodDescricao
			  &item.prefCodigo      = &prefCodigo
			  &item.QtdeMaximo      = prodQtdeMaximo
			  &item.QtdeMinimo      = prodQtdeMinimo
			  &item.Grupo           = prodGrupdescricao
			  &item.prodLocalSaldo  = prodSaldo
			  &item.UNCompra        = uniDescricao
		      Do 'Local'
		      &item.LocalNome       = &locDescricao
	          &SDTProdutos.Add(&item)
	endFor

EndSub

Sub 'Local'

  for each
	  where locCodigo = &prefLocalDeposito
    &locDescricao = locDescricao
	when none
		&locDescricao = ''
  endFor

EndSub

Sub 'salvarDados'

	for each
		where prefCodigo = &prefCodigo
			 &locCodigo = prefLocalDeposito
	endFor

    &quantidade  = 0
	for &item in &SDTProdutos

		&lancaAjuste = false

		for each trnsprodutos
			where prefCodigo     = &prefCodigo
			where prodCodigo 	  = &item.prodCodigo

			if &item.prodLocalSaldo<>prodSaldo
			   if &item.prodLocalSaldo>prodSaldo
				  &ajusTipo = 'E'
				  &ajusItemQuantidade = &item.prodLocalSaldo - prodSaldo
			   else
				  &ajusTipo = 'S'
				  &ajusItemQuantidade = prodSaldo - &item.prodLocalSaldo
			   endif
		       &lancaAjuste = true
			   exit
			endif

		when none
			&ajusTipo = 'E'
			&ajusItemQuantidade = &item.prodLocalSaldo
			&lancaAjuste = true
		endfor

	    if &lancaAjuste
			PRCDLancarInventario( &ajusTipo, &item.prodLocalCodigo, &item.prodCodigo, &ajusItemQuantidade, &item.prodLocalSaldo )
			&quantidade  += 1
	    endif

    endFor

	if &quantidade>0
		msg('Atualização de inventário realizada com sucesso !')
    else
		msg('Nenhuma atualização foi registrada!')
	endif

	if &ImprimirConferencia
		&ChaveSessao = &Pgmname + '_Dados'
		&Websession.Set(&ChaveSessao,&SDTProdutos.ToJson())
		InNewWindow.Target = RelatorioConferenciaInventario.Link(&ChaveSessao)
		InNewWindow.OpenWindow()
	endif

EndSub


