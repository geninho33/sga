Sub 'ajustarDistribuicao'

   // varrendo os produtos das unidades
   For &Item in &SDTLancaEstoqueUE
	   If &Item.lanestItemQuantidade>0
       PRCDAplicarAjusteDistribuicaoEstoque( &lanestRemessa,
       &Item.lanestItemLocCodigo,
			 &prefCodigo,
			 &lanestCodigo,
			 &Item.lanestItemProdCodigo,
			 &Item.lanestItemQuantidade )
     EndIf
   EndFor
 	Do 'Popular'

EndSub

Sub 'Cabecalho'

	For Each trnslancarestoqueUE
		Where prefCodigo   = &prefCodigo
	    Where lanestcodigo = &lanestCodigo
			  &DtFinal           = lanestdatFinal
			  &DtInicial         = lanestdatInicial
			  &dsPeriodo         = lanestObs
			  &lanestRemessa     = lanestCodigoRemessa
			  &lanestTipoRemessa = lanestTipoRemessa
    EndFor

EndSub

Sub 'Popular'

	If &lanestCodigo>0
		&SDTLancaEstoqueUE.Clear()

		If &lanestRemessa = 0

			For Each  trnsdistribuicaotipo
				Order prefCodigo, disTipNumero
				Where prefCodigo = &prefCodigo
				Where disTipStatus = 'A'
				Where disTipNumero = &disTipNumero when &disTipNumero<>0
		        &disTipNumero2 = disTipNumero
				For Each trnsprodutos
					Order prefCodigo, prodCodigoTipoRemessa, prodDescricao
					Where prefCodigo = &prefCodigo
					Where prodStatus = 'A'
					Where prodCodigoTipoRemessa = &disTipNumero2
					  &Item = New()
					  &Item.lanestdisTipDescricao   = disTipDescricao
					  &Item.lanestcodigo            = &lanestCodigo
					  &Item.lanestItemLocCodigo     = &locCodigo
					  &Item.lanestItemProdCodigo    = prodCodigo
					  &Item.lanestItemProdDescricao = prodDescricao
					  &Item.lanestItemPesoUni       = prodPesoUnidade
					  &Item.lanestItemPeso          = prodPesoConsumo
					  &Item.lanestItemProdUni       = prodUnidMedConsumo
					  &Item.lanestItemValidade      = PRCDBuscarValidadeLanEst(&prefCodigo, &lanestCodigo,&locCodigo,prodCodigo)
					  &Item.lanestItemObservacao    = PRCDBuscarOBSLanEst(&prefCodigo, &lanestCodigo,&locCodigo,prodCodigo)
					  &Item.lanestItemQuantidade    = PRCDBuscarQtdeLanEst(&prefCodigo, &lanestCodigo,&locCodigo,prodCodigo)
					  &Item.lanestItemStatus        = PRCDBuscarStatusLanEst(&prefCodigo, &lanestCodigo,&locCodigo,prodCodigo)
					  &SDTLancaEstoqueUE.Add( &Item )
				EndFor
			EndFor
	    Else

			For Each
				Where disTipNumero = &disTipNumero
				Where prefCodigo   = &prefCodigo
			      &disTipDescricao = disTipDescricao
			EndFor

			For Each
				Where prefCodigo            = &prefCodigo
				Where distStatus            = 'A'
				Where distRemCodigo         = &lanestRemessa
				Where distLocalDestino      = &locCodigo
				where distCodigoTipoRemessa = &lanestTipoRemessa
		        &distCodigo = distCodigo

				For Each trnsdistribuicaoitens
					Order prefCodigo, distItemProdutoDescricao
					Where prefCodigo          = &prefCodigo
					Where distItemTipoRemessa = &disTipNumero
					Where distCodigo          = &distCodigo
						  &Item = New()
						  &Item.lanestdisTipDescricao   = &disTipDescricao
						  &Item.lanestcodigo            = &lanestCodigo
						  &Item.lanestItemLocCodigo     = &locCodigo
						  &Item.lanestItemProdCodigo    = distItemProduto
						  &Item.lanestItemProdDescricao = distItemProdutoDescricao
						  &Item.lanestItemPeso          = distItemProdutoPeso
						  &Item.lanestItemProdUni       = distItemProdutoUN
						  &Item.lanestItemQuantidade    = PRCDBuscarQtdeLanEst(&prefCodigo, &lanestCodigo,&locCodigo,distItemProduto)
						  &Item.lanestItemStatus        = PRCDBuscarStatusLanEst(&prefCodigo, &lanestCodigo,&locCodigo,distItemProduto)
						  &SDTLancaEstoqueUE.Add( &Item )
					      //&Item.lanestItemPesoUni       = distItemProdutoUNPeso
				When None
					 msg('Não foi localizado nenhum produto para o tipo de remessa n. '+
					 &disTipNumero.ToString() + ', distribuição n. '+ &distCodigo.ToString() +
					 ' e Prefeitura n. '+ distItemTipoRemessa.ToString() )
				EndFor
			EndFor
		EndIf

	Else
		msg('Não tem nenhum período aberto para lançamento de Estoque !')
	EndIf

EndSub

Sub 'popularCombo'

    &locCodigo.Clear()
	For Each
		Order prefCodigo, locDescricao
		Where prefCodigo = &prefCodigo
		Where locStatus = 'A'
          &locCodigo.AddItem(locCodigo, locDescricao)
	EndFor

    &disTipNumero.Clear()
	For Each
		Order prefCodigo, disTipDescricao
		Where prefCodigo = &prefCodigo
		Where disTipStatus = 'A'
          &disTipNumero.AddItem( disTipNumero, disTipDescricao )
	EndFor

EndSub


