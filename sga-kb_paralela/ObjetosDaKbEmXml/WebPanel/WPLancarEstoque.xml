	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTLancaEstoqueUEsPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTLancaEstoqueUEsPaginationBar.SelectedPage = !'Previous'
			GridSDTLancaEstoqueUEs.PreviousPage()
		Case GridSDTLancaEstoqueUEsPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTLancaEstoqueUEs.CurrentPage
			&PageToGo += 1
			GridSDTLancaEstoqueUEs.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTLancaEstoqueUEsPaginationBar.SelectedPage)
			GridSDTLancaEstoqueUEs.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

