Event GridSDTLancaEstoqueUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	&lanestItemStatusAux = &SDTLancaEstoqueUE.CurrentItem.lanestItemStatus
	&SDTLancaEstoqueUE__lanestItemStatusWithTags = trim(&lanestItemStatusAux.EnumerationDescription())
	If &SDTLancaEstoqueUE.CurrentItem.lanestItemStatus = 'I'
