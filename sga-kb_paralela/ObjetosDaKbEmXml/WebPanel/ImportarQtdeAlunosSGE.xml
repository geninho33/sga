  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm

	&locCodigo.Visible = False
	Do 'LoadCombolocCodigo'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	&AtendimentoTurno = turno.Mat

EndEvent

Event 'DoPesquisar'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	if &locCodigo.IsEmpty()
		msg('Faltou selecionar o Local (Escola).')
	else
		&UeCod = PRCRetornaUeCod(&prefCodigo, &locCodigo)
		if &UeCod = 0
			msg('Falta definir "Cod.SGE" para o Local (Escola) selecionado.')
		else
			&AreEnsEtapaNivel = find(AreEnsEtapaNivel,prefCodigo = &prefCodigo and AreEnsCodigo = &AreEnsCodigo and AreEnsSequencial = &AreEnsSequencial)
			
			&Ano   = Year(Serverdate())
			&Area  = &AreEnsCodigo.ToString().Trim()
			&Nivel = &AreEnsEtapaNivel.ToString().Trim()
			&Etapa = &AreEnsSequencial.ToString().Trim()
			
			QtdeAlunos.Call(&Ano,&UeCod,&Area,&Nivel,&AtendimentoTurno,&Etapa,&Alunos_Diabetes,&Alunos_Gluten,&Alunos_Lactose,&Alunos_Normal)
			if (&Alunos_Diabetes + &Alunos_Gluten + &Alunos_Lactose + &Alunos_Normal) = 0
				msg('Nenhuma informação foi localizada.')
			endif
		endif
	endif

EndEvent

Event Combo_locCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&locCodigo.FromString(Combo_locCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	&UeCod = PRCRetornaUeCod(&prefCodigo, &locCodigo)

EndEvent

Sub 'LoadCombolocCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//&locCodigo initial value has to be loaded manually at the beginning of this Subrutine
	For Each
		Order locDescricao
		Where prefCodigo = &prefCodigo and locStatus = Status.Ativo
		&Combo_DataItem = new()
		&Combo_DataItem.ID = locCodigo.ToString().Trim()
		&Combo_DataItem.Title = locDescricao
		&locCodigo_Data.Add(&Combo_DataItem)
	EndFor
	Combo_locCodigo.SelectedValue_set = iif(&locCodigo.IsEmpty(), '', &locCodigo.ToString().Trim())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event Enter

	do case
		case (&Alunos_Colesterol + &Alunos_Diabetes + &Alunos_Gluten + &Alunos_Lactose + &Alunos_Normal) = 0	
			msg('Falta informr a quantidade de alunos.')
		otherwise
			&Atendimento.locCodigo = &locCodigo
			&Atendimento.carGruCodigo = &carGruCodigo
			&Atendimento.AreEnsCodigo = &AreEnsCodigo
			&Atendimento.AreEnsSequencial = &AreEnsSequencial
			&Atendimento.AtendimentoTurno = &AtendimentoTurno
			&Atendimento.AtendimentoNormalSegunda = &Alunos_Normal
			&Atendimento.AtendimentoGlutenSegunda = &Alunos_Gluten
			&Atendimento.AtendimentoLactoseSegunda = &Alunos_Lactose
			&Atendimento.AtendimentoDiabeticoSegunda = &Alunos_Diabetes
			&Atendimento.AtendimentoColesterolSegunda = &Alunos_Colesterol
			&Atendimento.Insert()
			
			if &Atendimento.Success()
				Commit
				Return
			else
				for &Message in &Atendimento.GetMessages()
					msg(&Message.Description)
				endfor
				Rollback
			endif
	endcase

EndEvent

Event &AreEnsCodigo.ControlValueChanged

	&AreEnsEtapaNivel = find(AreEnsEtapaNivel,prefCodigo = &prefCodigo and AreEnsCodigo = &AreEnsCodigo and AreEnsSequencial = &AreEnsSequencial)

EndEvent


]]></Source>
