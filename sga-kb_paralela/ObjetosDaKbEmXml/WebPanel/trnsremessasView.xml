    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)
	WorkWithLink.Link = trnsremessasWW.Link()

	For each trnsremessas
		where prefCodigo = &prefCodigo and remCodigo = &remCodigo
		&Exists = True

	When none
		Form.Caption = "WWP_RecordNotFound"
		&Exists = False
	Endfor

	If (&Exists)
		&SelectedTabCode = &TabCode
		Tabs.ActivePageControlName = &SelectedTabCode
		Do 'LoadFixedTabs'
		Do 'LoadTabs'
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Tabs.TabChanged

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&SelectedTabCode = Tabs.ActivePageControlName
	&LoadAllTabs = false
	Do 'LoadTabs'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadFixedTabs'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WebComponent_General.Object = trnsremessasGeneral.Create(&prefCodigo, &remCodigo)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadTabs'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If &LoadAllTabs OR &SelectedTabCode = '' OR &SelectedTabCode = !"trnsremessaitem"
		trnsremessaitemWC.Object = trnsremessastrnsremessaitemWC.Create(&prefCodigo, &remCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnsremessaproduto"
		trnsremessaprodutoWC.Object = trnsremessastrnsremessaprodutoWC.Create(&prefCodigo, &remCodigo)
	EndIf
	If &LoadAllTabs OR &SelectedTabCode = !"trnsremessaatendimento"
		trnsremessaatendimentoWC.Object = trnsremessastrnsremessaatendimentoWC.Create(&prefCodigo, &remCodigo)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
