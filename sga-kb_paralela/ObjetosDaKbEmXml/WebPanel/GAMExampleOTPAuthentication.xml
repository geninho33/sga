  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start
	&User = GAMRepository.GetUserToOTPAuthentication(&AuthenticationTypeName, &UseTwoFactorAuthentication, &GAMErrorCollection)
	If &GAMErrorCollection.Count > 0
		&UserName.Visible		= False
		&UserPassword.Visible	= False
		Enter.Visible			= False
		Do 'DisplayMessages'
	Else
		&GAMAuthenticationTypeSimple = GAMRepository.GetEnabledAuthenticationTypeByName(&AuthenticationTypeName, &Language ,&GAMErrorCollection)
		If not &GAMAuthenticationTypeSimple.IsTOTP  AND  not &GAMAuthenticationTypeSimple.TwoFactorAuthentication_IsTOTP
			Msg("GAM_Useraccesscodewassent")
		Endif
		&UserName 		= &User.Name
	Endif
EndEvent

Event Enter	
	&User = GAMRepository.GetUserToOTPAuthentication(&AuthenticationTypeName, &UseTwoFactorAuthentication, &GAMErrorCollection)
	If &GAMErrorCollection.Count = 0
		&AdditionalParameter.AuthenticationTypeName 	= &AuthenticationTypeName
		&AdditionalParameter.UseTwoFactorAuthentication	= &UseTwoFactorAuthentication
		&AdditionalParameter.OTPStep					= 2
		&AdditionalParameter.IDPState					= &IDP_State
		&LoginOK = GAMRepository.Login(&UserName, &UserPassword, &AdditionalParameter, &GAMErrorCollection )
		If &LoginOK
			If &IDP_State.IsEmpty()
				&URL = GAMRepository.GetLastErrorsURL()
				If &URL.IsEmpty()
					GAMHome()
				Else
					Link(&URL)
				Endif
			Endif
		Else
			If &GAMErrorCollection.Count > 0 
				Do Case
				Case &GAMErrorCollection.Item(1).Code = GAMErrorMessages.UserMissingRequiredData
					//Webpanel to Complete User data
					GAMExampleUpdateRegisterUser(&IDP_State)
				Otherwise
					&UserPassword.SetEmpty()
					Do 'DisplayMessages'
				EndCase
			Endif
		Endif
	Else
		Do 'DisplayMessages'
	Endif
EndEvent

Event 'Login'
	If GAMRepository.IsRemoteAuthentication(&IDP_State)
		GAMExampleIDPLogin(&IDP_State)
	Else
		Return
	Endif
EndEvent

Sub 'DisplayMessages'
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
EndSub
]]></Source>
