    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)
	Do 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	prefCodigo.Visible = False
	locInep.Visible = False
	locArea.Visible = False
	locUnidadeCentral.Visible = False
	locSecretaria.Visible = False
	locNotaSequencia.Visible = False
	locAbreviatura.Visible = False
	locDataCad.Visible = False
	locDataAlt.Visible = False

	// Security check for 'Actions'
	&IsAuthorized_Update = SecGAMIsAuthByFunctionalityKey.Udp(!'trnslocalww_Update')
	If not (&IsAuthorized_Update)
		BtnUpdate.Visible = False
	Endif
	&IsAuthorized_Delete = SecGAMIsAuthByFunctionalityKey.Udp(!'trnslocalww_Delete')
	If not (&IsAuthorized_Delete)
		BtnDelete.Visible = False
	Endif
	 

	// Visible Conditions
	If Not (locCodigo<>0)
		locCodigo.Visible = False
		locCodigo_Cell.Class = !'Invisible'
	Else
		locCodigo.Visible = True
		locCodigo_Cell.Class = !'col-xs-12 col-sm-6 DataContentCell'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoUpdate'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Update)
		trnslocal.Call(TrnMode.Update, prefCodigo, locCodigo)
	Else
		msg("WWP_ActionNoLongerAvailable")
		BtnUpdate.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoDelete'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Delete)
		trnslocal.Call(TrnMode.Delete, prefCodigo, locCodigo)
	Else
		msg("WWP_ActionNoLongerAvailable")
		BtnDelete.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = False
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"trnslocal"

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
