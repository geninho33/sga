    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)
	Do 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	prefCodigo.Visible = False
	salaAtendNormal.Visible = False
	salaCodigoPaiAtend.Visible = False
	salaDataCad.Visible = False
	salaDataAlt.Visible = False

	// Security check for 'Actions'
	&IsAuthorized_Update = SecGAMIsAuthByFunctionalityKey.Udp(!'trnssalasww_Update')
	If not (&IsAuthorized_Update)
		BtnUpdate.Visible = False
	Endif
	&IsAuthorized_Delete = SecGAMIsAuthByFunctionalityKey.Udp(!'trnssalasww_Delete')
	If not (&IsAuthorized_Delete)
		BtnDelete.Visible = False
	Endif
	 

	// Visible Conditions
	If Not (salaCodigo<>0)
		salaCodigo.Visible = False
		salaCodigo_Cell.Class = !'Invisible'
	Else
		salaCodigo.Visible = True
		salaCodigo_Cell.Class = !'col-xs-12 col-sm-4 DataContentCell'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoUpdate'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Update)
		trnssalas.Call(TrnMode.Update, prefCodigo, salaLocCodigo, salaCodigo)
	Else
		msg("WWP_ActionNoLongerAvailable")
		BtnUpdate.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoDelete'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Delete)
		trnssalas.Call(TrnMode.Delete, prefCodigo, salaLocCodigo, salaCodigo)
	Else
		msg("WWP_ActionNoLongerAvailable")
		BtnDelete.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = False
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"trnssalas"

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
