  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call( &WWPContext )
	&prefCodigo   = &WWPContext.prefCodigo
	&disTipNumero = 0

	if not PRCDNutricionista()
	   home()
	   msg('Esse usuário não tem permissão para cancelar remessa !')
    endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTEntregasUEs_Empowerer.GridInternalName = GridSDTEntregasUEs.InternalName
	GridSDTEntregasUEs.Rows = Page.Rows
	GridSDTEntregasUEsPaginationBar.RowsPerPageSelectedValue = GridSDTEntregasUEs.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTEntregasUEsCurrentPage = GridSDTEntregasUEs.CurrentPage
	&GridSDTEntregasUEsPageCount = GridSDTEntregasUEs.PageCount
	SDTEntregasUE__distCodigo.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distSituacao.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distCodigoTipoRemessa.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distLocalDestino.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distDataEnvio.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distDataRecepcao.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distRecebedor.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distObservacao.ColumnHeaderClass = !'WWColumn'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEntregasUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	SDTEntregasUE__distCodigo.ColumnClass = iif(&situacao = 'C', !'WWColumn WWColumnWarning WWColumnWarningFirstColumn', !'WWColumn')
	SDTEntregasUE__distSituacao.ColumnClass = iif(&situacao = 'C', !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distCodigoTipoRemessa.ColumnClass = iif(&situacao = 'C', !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distLocalDestino.ColumnClass = iif(&situacao = 'C', !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distDataEnvio.ColumnClass = iif(&situacao = 'C', !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distDataRecepcao.ColumnClass = iif(&situacao = 'C', !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distRecebedor.ColumnClass = iif(&situacao = 'C', !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distObservacao.ColumnClass = iif(&situacao = 'C', !'WWColumn WWColumnWarning', !'WWColumn')

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEntregasUEsPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTEntregasUEsPaginationBar.SelectedPage = !'Previous'
			GridSDTEntregasUEs.PreviousPage()
		Case GridSDTEntregasUEsPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTEntregasUEs.CurrentPage
			&PageToGo += 1
			GridSDTEntregasUEs.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTEntregasUEsPaginationBar.SelectedPage)
			GridSDTEntregasUEs.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEntregasUEsPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTEntregasUEs.Rows = GridSDTEntregasUEsPaginationBar.RowsPerPageSelectedValue
	GridSDTEntregasUEs.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnExcluirRemessa'

  if &SDTEntregasUE.Count>0
	 if &dsCancelamento<>'' 
	     PRCDRemessaZerar(&prefCodigo,&distRemCodigo,&disTipNumero,&dsCancelamento)
	     Do 'Popular'
	 else
		 msg('Informe o motivo de cancelamento de toda a remessa.')
		 &dsCancelamento.SetFocus()
	 endif
 
  else
	 msg('Faça um busca para verificar as guias da remessa !')
  endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnBuscar'

	  if &distRemCodigo.IsEmpty()
		 msg('Informe o código da remessa.')
	  else
	     Do 'Popular'
	  endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Popular'

	&SDTEntregasUE.Clear()
	for each
		order prefCodigo, distLocalDestino, (distDataEnvio)
		where prefCodigo       = &prefCodigo
		where distRemCodigo    = &distRemCodigo
		      &disTipNumero                   = distCodigoTipoRemessa
		      &entregas                       = new()
		      &entregas.distCodigo            = distCodigo
			  &entregas.distCodigoTipoRemessa = distCodigoTipoRemessa
			  &entregas.distDataEnvio         = distDataEnvio
			  &entregas.distDataRecepcao      = distDataRecepcao
			  &entregas.distLocalDestino      = distLocalDestino
			  &entregas.distLocalOrigem       = distLocalOrigem
			  &entregas.distObservacao        = distDSCancelamento
			  &entregas.distRecebedor         = distRecebedor
			  &entregas.distReceber           = distReceber
			  if distDSCancelamento<>''
				 &situacao = 'C'
			  endif
			  if distReceber = 'S'
				 &entregas.distSituacao = 'Recebido'
			  else
  			     &entregas.distSituacao = 'Aguardando'
			  endif
	   		  &SDTEntregasUE.Add( &entregas )
    endFor

EndSub


]]></Source>
