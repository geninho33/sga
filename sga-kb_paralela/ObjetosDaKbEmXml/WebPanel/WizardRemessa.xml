  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Carrega dados do Wizard */
	&WizardRemessaData.FromJson(&WebSession.Get(&Pgmname + !'_Data'))

	/* Define Steps a ignorar no cronometro */
	&IgnoredSteps.Add(!'Periodo')
	&IgnoredSteps.Add(!'Conclusao')

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardSteps = new()

	&WizardStep = new()
	&WizardStep.Code = !'Periodo'
	&WizardStep.Title = 'Período'
	&WizardStep.Description = 'Selecione o período de remessa'
	&WizardSteps.Add(&WizardStep)

	&WizardStep = new()
	&WizardStep.Code = !'Atendimento'
	&WizardStep.Title = 'Atendimento'
	&WizardStep.Description = 'Defina os locais de destino e o atendimento'
	&WizardSteps.Add(&WizardStep)

	&WizardStep = new()
	&WizardStep.Code = !'Alimentos'
	&WizardStep.Title = 'Alimentos'
	&WizardStep.Description = 'Lista de alimentos do período.'
	&WizardSteps.Add(&WizardStep)

	&WizardStep = new()
	&WizardStep.Code = !'Guias'
	&WizardStep.Title = 'Guias'
	&WizardStep.Description = 'Locais e quantidades de cada alimento a ser distribuido. Verifique todas as informações antes de finalizar.'
	&WizardSteps.Add(&WizardStep)

	&WizardStep = new()
	&WizardStep.Code = !'Conclusao'
	&WizardStep.Title = 'Conclusão'
	&WizardStep.Description = 'O processo foi finalizado com sucesso!'
	&WizardSteps.Add(&WizardStep)

	If &CurrentStep.IsEmpty()
		&CurrentStepAux = !'Periodo'
		&WebSession.Remove(&Pgmname + !'_Data')
	Else
		&CurrentStepAux = &CurrentStep
	EndIf
	Do 'LoadWizardStepWC'

	Do 'AttributesSecurityCode'
	StepTitles.Object = WizardStepsLineWC.Create(&WizardSteps, &CurrentStepAux)

	//Code block: StartChronometer
	/* 
		Adicione a variável &IgnoredSteps os passos que não deseja 
		monitorar usando: &IgnoredSteps.Add(!"Step")
	*/
	if not &CurrentStepAux in &IgnoredSteps
		Chronometer.TickInterval = 60 // 1 minuto
		Chronometer.Start()
	else
		Chronometer.Stop()
	endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadWizardStepWC'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case &CurrentStepAux = !'Periodo'
			WizardStepWC.Object = WizardRemessaPeriodo.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
		Case &CurrentStepAux = !'Atendimento'
			WizardStepWC.Object = WizardRemessaAtendimento.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
		Case &CurrentStepAux = !'Alimentos'
			WizardStepWC.Object = WizardRemessaAlimentos.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
		Case &CurrentStepAux = !'Guias'
			WizardStepWC.Object = WizardRemessaGuias.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
		Case &CurrentStepAux = !'Conclusao'
			WizardStepWC.Object = WizardRemessaConclusao.Create(&Pgmname + !'_Data', &PreviousStep, &GoingBack)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If Not (&CurrentStepAux = !'Guias' or &CurrentStepAux = !'Conclusao')
		WizardRemessaData_Alimentos_disTipDescricao.Visible = False
		WizardRemessaData_Alimentos_disTipDescricao_Cell.Class = !'Invisible'
	Else
		WizardRemessaData_Alimentos_disTipDescricao.Visible = True
		WizardRemessaData_Alimentos_disTipDescricao_Cell.Class = !'col-xs-12 col-sm-6'
	EndIf
	
	TablePeriodo.Visible = (&CurrentStepAux <> !'Periodo')
	TableInfo.Visible = (&CurrentStepAux <> !'Periodo' and &CurrentStepAux <> !'Atendimento')

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event Chronometer.Tick

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: ChronometerTick
	GlobalEvents.ForceUpdateWizardData()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent


]]></Source>
