  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	&GAMUser.Load(&UserGUID)
	&AuthenticationTypeName = &GAMUser.AuthenticationTypeName
	&AuthenticationTypeName 		= &GAMUser.AuthenticationTypeName			
	&UserNameSpace  = &GAMUser.NameSpace
	&Name 			= &GAMUser.Name
	&EMail	 		= &GAMUser.EMail
	&FirstName 		= &GAMUser.FirstName
	&LastName		= &GAMUser.LastName
	If not &GAMUser.URLImage.IsEmpty()
		&Image.FromURL(&GAMUser.URLImage)
	Endif
	&ExternalId				= &GAMUser.ExternalId
	Do 'ValidIsLocalAuthentication'
	
	&GAMApplication = GAMApplication.Get()
	&UserName 		= &GAMUser.Name
	&UserEmail 		= &GAMUser.EMail
	If &GAMUser.GenerateQRDataTOTP(&GAMApplication.Name, &SecretKey, &QRString, &GAMErrorCollection)
		QRimage.caption = Format('<img src="%1" width="200px"></img>', &QRString)
	Else
		Do 'ShowMessages'
	Endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm

	Do 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If Not (Not &GAMUser.URLImage.IsEmpty())
		&Image.Visible = False
		Image_Cell.Class = !'Invisible'
	Else
		&Image.Visible = True
		Image_Cell.Class = !'col-xs-12 DataContentCell'
	EndIf
	If Not (&AuthenticationTypeName.Count > 1)
		&AuthenticationTypeName.Visible = False
		AuthenticationTypeName_Cell.Class = !'Invisible'
	Else
		&AuthenticationTypeName.Visible = True
		AuthenticationTypeName_Cell.Class = !'col-xs-12 DataContentCell'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event Enter

	&GAMUser.Load(&UserGUID)
	If &GAMUser.ValidateTOTPCode(&TOTPCode, &GAMErrorCollection)
		If &GAMUser.EnableTOTPAuthenticator(&GAMErrorCollection)
			BtnEnter.Visible = False
			Msg(DVMessageGetBasicNotificationMsg('', "TOTP authenticator enabled!", DVMessageType.success, '', DVMessageBoolean.True, ''))
			GAMUserEntry(GAMAPIMode.Display, &UserGUID)
		Else
			Do 'ShowMessages'
		Endif
	Else
		Do 'ShowMessages'
	Endif

EndEvent

Sub 'ShowMessages'

	&GAMErrorCollection = GAMRepository.GetLastErrors()
	If &GAMErrorCollection.Count > 0
		For &GAMError in &GAMErrorCollection
			Msg(DVMessageGetBasicNotificationMsg('Error', &GAMError.Message, DVMessageType.Error, '', DVMessageBoolean.True, ''))
			exit
		Endfor
	Else
		&Message = &WebSession.Get(GAM.GAMMessageType.Message) 
		If not &Message.IsEmpty()
			Msg(DVMessageGetBasicNotificationMsg('Information', &Message, DVMessageType.Information, '', DVMessageBoolean.True, ''))
			&WebSession.Remove(GAM.GAMMessageType.Message) 
		Endif
		&Warning = &WebSession.Get(GAM.GAMMessageType.Warning)
		If not &Warning.IsEmpty()
			Msg(DVMessageGetBasicNotificationMsg('Warning', &Warning, DVMessageType.regular, '', DVMessageBoolean.True, ''))
			&WebSession.Remove(GAM.GAMMessageType.Warning) 
		Endif
		&ErrorMsg = &WebSession.Get(GAM.GAMMessageType.Error)
		If not &ErrorMsg.IsEmpty()
			Msg(DVMessageGetBasicNotificationMsg('Error', &ErrorMsg, DVMessageType.Error, '', DVMessageBoolean.True, ''))
			&WebSession.Remove(GAM.GAMMessageType.Error) 
		Endif
	Endif

EndSub

Sub 'ValidIsLocalAuthentication'

	&isLocalAuthentication = False
	&AuthenticationTypes = GAMRepository.GetEnabledAuthenticationTypes(&Language, &GAMErrorCollection)
	If &GAMErrorCollection.Count > 0
		Do 'ShowMessages'
	Else
		For &AuthenticationTypeSimple in &AuthenticationTypes
			If &AuthenticationTypeSimple.Name = &AuthenticationTypeName
				If not &AuthenticationTypeSimple.Impersonate.IsEmpty()
					If &AuthenticationTypeSimple.Impersonate = !"local"
						&isLocalAuthentication = True
					Endif
				Else
					If &AuthenticationTypeSimple.Type = GAMAuthenticationTypes.GAMLocal
						&isLocalAuthentication = True
					Endif
				Endif
				Exit
			Endif
		EndFor
	Endif

EndSub

// Generate de Key for the user and the associated QR
]]></Source>
