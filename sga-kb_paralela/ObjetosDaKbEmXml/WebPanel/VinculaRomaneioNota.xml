  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	For each trnsnota
		Where prefCodigo = &prefCodigo
		Where notaCodigo = &notaCodigo

		&notaFornecedor = notaFornecedor
	   	&DadosNota = ' Nota nr. : ' + notaNumero +' - Série : ' + notaSerie +' - Data : ' + notaData.ToString()

		For each trnsfornecedores
			Where forCodigo = notaFornecedor
	    	&DadosNota += ' - Fornecedor : '+ forNome
		endfor
	Endfor

    for each trnsnotaitens
		Where prefCodigo = &prefCodigo
		Where notaCodigo = &notaCodigo
		      // msg("Não é possível fazer alterarção no romaneio depois que for lançado algum item na nota !")
		      return
	endFor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WCRomaneiosNaoVinculados.Object = RomaneiosWC.Create(&prefCodigo, &notaCodigo, &notaFornecedor, false)
	WCRomaneiosVinculados.Object = RomaneiosWC.Create(&prefCodigo, &notaCodigo, &notaFornecedor, true)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GlobalEvents.RomaneioWC_Refresh

	WCRomaneiosVinculados.Object = RomaneiosWC.Create(&prefCodigo, &notaCodigo, &notaFornecedor, true)
	WCRomaneiosNaoVinculados.Object = RomaneiosWC.Create(&prefCodigo, &notaCodigo, &notaFornecedor, false)

EndEvent


