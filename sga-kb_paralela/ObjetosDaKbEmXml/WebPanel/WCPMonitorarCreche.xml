    <Source><![CDATA[
Event Start

    LoadWWPContext.Call(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo

    Do 'Popular Creche'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridCreche_Empowerer.GridInternalName = GridCreche.InternalName
	GridCreche.Rows = Page.Rows
	GridCrechePaginationBar.RowsPerPageSelectedValue = GridCreche.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridCrecheCurrentPage = GridCreche.CurrentPage
	&GridCrechePageCount = GridCreche.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridCreche.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridCrechePaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridCrechePaginationBar.SelectedPage = !'Previous'
			GridCreche.PreviousPage()
		Case GridCrechePaginationBar.SelectedPage = !'Next'
			&PageToGo = GridCreche.CurrentPage
			&PageToGo += 1
			GridCreche.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridCrechePaginationBar.SelectedPage)
			GridCreche.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridCrechePaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridCreche.Rows = GridCrechePaginationBar.RowsPerPageSelectedValue
	GridCreche.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Popular Creche'

    //msg( 'Entrou aqui' )
	&SDTMonitorarCreches.Clear()
	for each
		order locDescricao
		where prefCodigo     = &prefCodigo
		where locTipoUnidade = &tipoUnidade when &tipoUnidade in (6,5)
		where locStatus      = 'A'
		where not locTipoUnidade in (6,5) when &tipoUnidade = 0
              &locCodigo               = locCodigo
			  &itemCreche              = new()
			  &itemCreche.locCodigo    = locCodigo
			  &itemCreche.locDescricao = locDescricao
			  // msg(' | PrefCodigo : ' + &prefCodigo.ToString() + ' | Data :  '  + &dataHoje.ToDate().ToString() + ' | Local : ' + &locCodigo.ToString() )
			  for each TRNSEstoqueUE
			 	  where prefCodigo      = &prefCodigo
				  where estoUeLocCodigo = &locCodigo
				  where estoUeAlteracao.ToDate() = &dataHoje
				    &itemCreche.locAtividades = &itemCreche.locAtividades + 1
			  endFor
		      
			  Do Case
			 	 Case &opcaoBusca = 1
					if &itemCreche.locAtividades > 0  
						&SDTMonitorarCreches.Add( &itemCreche )
					endif		
				 Case &opcaoBusca = 2
					if &itemCreche.locAtividades = 0  
						&SDTMonitorarCreches.Add( &itemCreche )
					endif			
				 Otherwise
					&SDTMonitorarCreches.Add( &itemCreche )	
			  Endcase	
	EndFor

EndSub


]]></Source>
