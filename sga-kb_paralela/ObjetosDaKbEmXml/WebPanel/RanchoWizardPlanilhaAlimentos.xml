  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
   	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'LoadVariablesFromWizardData'

	Do 'AttributesSecurityCode'
	GridAlimentos_Empowerer.GridInternalName = GridAlimentos.InternalName
	GridAlimentos.Rows = 0
	&GridAlimentosSelected.TitleFormat = 1
	&GridAlimentosSelected.Title = format(!'<input name="selectAllCheckboxGridAlimentos" type="checkbox" value="Select All" onClick="WWPSelectAll(this, %1);" onMouseOver="WWPSelectAllRemoveParentOnClick(this)" class="AttributeCheckBox" >', !"'GRIDALIMENTOSSELECTED'")

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	/* Monta coleção de produtos dos cardápios */
	&carPratoCodigoCollection.Clear()
	For each trnscardapioprato
		Unique carPratoRefeicao
		Where prefCodigo = &prefCodigo
		Where carPratoData >= &WizardData.Periodo.DataInicial
		Where carPratoData <= &WizardData.Periodo.DataFinal

		&carPratoCodigoCollection.Add(carPratoRefeicao)
	Endfor

	log.Info(&carPratoCodigoCollection.ToJson(),'RanchoWizardPlanilhaAlimentos.carPratoCodigoCollection')

	&prodCodigoCollection.Clear()
	For each trnspratosingredientes
		Order prefCodigo, pratIngrProdCodigo
		Unique pratIngrProdCodigo
		Where prefCodigo = &prefCodigo
		Where pratoCodigo in &carPratoCodigoCollection

		&prodCodigoCollection.Add(pratIngrProdCodigo)
	Endfor

	log.Info(&prodCodigoCollection.ToJson(),'RanchoWizardPlanilhaAlimentos.prodCodigoCollection')

EndEvent

Event GridAlimentos.Load

	&uniFracao = find(uniFracao,uniCodigo = prodUnidMedConsumo,'XX')
	&uniDescricao = iif(prodObsConsumo.IsEmpty(),&uniFracao,prodObsConsumo)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	&GridAlimentosSelected = false
	&QtdeEmbalagem = prodPesoConsumo
	For &GridAlimentosSelectedRow in &WizardData.Alimentos.GridAlimentos
		If &GridAlimentosSelectedRow.prodCodigo = prodCodigo
			AND &GridAlimentosSelectedRow.prodDescricao = prodDescricao
			AND &GridAlimentosSelectedRow.prodSaldo = prodSaldo
			AND &GridAlimentosSelectedRow.uniDescricao = &uniDescricao
			AND &GridAlimentosSelectedRow.QtdeEmbalagem = &QtdeEmbalagem
			AND &GridAlimentosSelectedRow.prodPesoConsumo = prodPesoConsumo
			&GridAlimentosSelected = True
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	if not &GridAlimentosSelected
		&GridAlimentosSelected = (&prodCodigoCollection.IndexOf(prodCodigo) > 0 and prodSaldo > 0)
	endif

	if &GridAlimentosSelected and &QtdeEmbalagem = 0
		&QtdeEmbalagem = iif(prodPesoConsumo = 0,1,prodPesoConsumo)
	endif

	&GridAlimentosSelected.Visible = (prodSaldo > 0)

EndEvent

Event Enter

	// Verifica se quantidade porembalagem foi informada em todos os produtos selecionados
	&HasValidationErrors = false
	For each line in GridAlimentos
		if &GridAlimentosSelected and &QtdeEmbalagem = 0
			msg('Todos os produtos selecionados precisam ter a quantidade por embalagem informada.')
			&HasValidationErrors = true
			Exit
		endif
	Endfor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If not &HasValidationErrors
		Do 'SaveVariablesToWizardData'
		RanchoWizardPlanilha(!'Alimentos', !'Pessoas2', false)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'WizardPrevious'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'SaveVariablesToWizardData'
	RanchoWizardPlanilha(!'Alimentos', !'Locais', true)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadGridAlimentosSelectedRows'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.Alimentos.GridAlimentos.Clear()
	For Each Line in GridAlimentos
		If (&GridAlimentosSelected)
			&GridAlimentosSelectedRow = new()

			&GridAlimentosSelectedRow.prodCodigo = prodCodigo
			&GridAlimentosSelectedRow.prodDescricao = prodDescricao
			&GridAlimentosSelectedRow.prodSaldo = prodSaldo
			&GridAlimentosSelectedRow.uniDescricao = &uniDescricao
			&GridAlimentosSelectedRow.QtdeEmbalagem = &QtdeEmbalagem
			&GridAlimentosSelectedRow.prodPesoConsumo = prodPesoConsumo

			&WizardData.Alimentos.GridAlimentos.Add(&GridAlimentosSelectedRow)
		Endif
	Endfor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: XmlFileToWizardData
	&WizardData.FromXML(FileXmlToWizardData(&WebSessionKey))
	&WebSession.Set(&WebSessionKey,&WizardData.ToJson())

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&prodCodigoTipoRemessa = &WizardData.Alimentos.prodCodigoTipoRemessa

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveVariablesToWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Alimentos.prodCodigoTipoRemessa = &prodCodigoTipoRemessa
	Do 'LoadGridAlimentosSelectedRows'
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())

	//Code block: WizardDataToXmlFile
	WizardDataToFileXML(&WebSessionKey,&WizardData.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event GlobalEvents.ForceUpdateWizardData

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: ForceUpdateWizardDataGlobalEvent
	do 'SaveVariablesToWizardData'
	do 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &GridAlimentosSelected.ControlValueChanged

	if &GridAlimentosSelected and &QtdeEmbalagem = 0
		&QtdeEmbalagem = iif(prodPesoConsumo = 0,1,prodPesoConsumo)
	endif

EndEvent

Event &prodCodigoTipoRemessa.ControlValueChanged

	Refresh

EndEvent


]]></Source>
