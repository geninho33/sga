  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	TableOptions.Height = 50
	
	Grid.Rows = 50
	Grid_Empowerer.GridInternalName = Grid.InternalName
	&prodClassificacao = nullvalue(&prodClassificacao)
	Form.Caption = 'Inventário'

	Do 'PrepareTransaction'
	Do 'LoadGridState'
	GridPaginationBar.RowsPerPageSelectedValue = Grid.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)

	Do 'SaveGridState'

	&GridCurrentPage = Grid.CurrentPage
	&GridPageCount = Grid.PageCount
	&GridAppliedFilters = WWP_GetAppliedFiltersDescription(&Pgmname)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridPaginationBar.SelectedPage = !'Previous'
			Grid.PreviousPage()
		Case GridPaginationBar.SelectedPage = !'Next'
			Grid.NextPage()
		Otherwise
			&PageToGo.FromString(GridPaginationBar.SelectedPage)
			Grid.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Grid.Rows = GridPaginationBar.RowsPerPageSelectedValue
	Grid.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Grid.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&prodGrupdescricao = find(prodGrupdescricao,prodGrupCodigo = prodTipo,'Inexistente')
	&locDescricao = find(locDescricao,locCodigo = prefLocalDeposito,'Inexistente')
	&uniDescricao = find(uniDescricao,uniCodigo = prodUnidMedCompra,'Inexistente')
	&prodSaldo = prodSaldo
	&prodSaldo.Enabled = true

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoCleanFilters'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'CleanFilters'
	Grid.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoImprimir'

	InNewWindow.Target = RelatorioInventario.Link(&prodTipo, &prodClassificacao, &ComSaldo, &ContagemEstoque)
	InNewWindow.OpenWindow()

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnSalvar'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_BtnbtnSalvar.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_BtnbtnSalvar.Close

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Ask If DVelop_ConfirmPanel_BtnbtnSalvar.Result = !'Yes'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	If DVelop_ConfirmPanel_BtnbtnSalvar.Result = !'Yes'
		Do 'salvarDados'
	endif

EndEvent

Sub 'CleanFilters'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&prodTipo.SetEmpty()
	&prodClassificacao.SetEmpty()
	&prodDescricaoOperator = 0
	&prodDescricao.SetEmpty()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(&PgmName + !"GridState") = !""
		&GridState.FromXml(LoadGridState.Udp(&PgmName + !"GridState"))
	Else
		&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))
	Endif	
	Do 'LoadRegFiltersState'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadRegFiltersState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"PRODTIPO"
				&prodTipo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PRODCLASSIFICACAO"
				&prodClassificacao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PRODDESCRICAO"
				&prodDescricao.FromString(&GridStateFilterValue.Value)
				&prodDescricaoOperator = &GridStateFilterValue.Operator
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridState.FromXml(&Session.Get(&PgmName + !"GridState"))

	// Save grid state in session.
	&GridState.FilterValues.Clear()
	WWP_GridStateAddFilterValue(&GridState, !"PRODTIPO", "Grupo", not &prodTipo.IsEmpty(), 0, &prodTipo.ToString().Trim(), trim(&prodTipo.ToFormattedString()), False, '', '')
	&AuxText = !'[' + &prodClassificacao.ToString().Trim() + !']'
	WWP_GridStateAddFilterValue(&GridState, !"PRODCLASSIFICACAO", "Classificação", not &prodClassificacao.IsEmpty(), 0, &prodClassificacao.ToString().Trim(), &AuxText.Replace(!"[2]", "Perecíveis").Replace(!"[4]", "Semi-perecíveis").Replace(!"[3]", "Não perecíveis"), False, '', '')
	WWP_GridStateAddFilterValue(&GridState, !"PRODDESCRICAO", "Descrição", not &prodDescricao.IsEmpty(), &prodDescricaoOperator, &prodDescricao, format(!'%' + Trim(Str(&prodDescricaoOperator + 1)), "WWP_FilterLike" + !' ' + &prodDescricao, "WWP_FilterContains" + !' ' + &prodDescricao), False, '', '')

	SaveGridState.Call(&PgmName + !"GridState",  &GridState.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = True
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"trnsprodutos"

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'salvarDados'

	&quantidade = 0
	&SDTProdutos = new()
	
	For each Line in Grid
		
		&lancaAjuste = false
		if prodSaldo <> &prodSaldo // houve alteração
			&prodSaldoAtual = BuscaSaldoAtual(prefCodigo,prodCodigo) // busca saldo atualizado
			if &prodSaldo > &prodSaldoAtual
			  	&ajusTipo = 'E'
			  	&ajusItemQuantidade = &prodSaldo - &prodSaldoAtual
		    	&lancaAjuste = true
		  	else
				if &prodSaldo < &prodSaldoAtual
				  	&ajusTipo = 'S'
				  	&ajusItemQuantidade = &prodSaldoAtual - &prodSaldo
			    	&lancaAjuste = true
			  	endif	
			endif
		endif
	
	    if &lancaAjuste			
			PRCDLancarInventario( &ajusTipo, prefLocalDeposito, prodCodigo, &ajusItemQuantidade, &prodSaldoAtual )
			&quantidade  += 1
		
			if &ImprimirConferencia
				&Item = new()
				&Item.prodCodigo 	= prodCodigo
				&Item.prodDescricao = prodDescricao
				&Item.Grupo			= &prodGrupdescricao
				&Item.LocalNome		= &locDescricao
				&Item.UNCompra		= &uniDescricao
				&Item.QtdeMinimo	= prodQtdeMinimo
				&Item.QtdeMaximo	= prodQtdeMaximo
				&Item.prodLocalSaldo= &prodSaldo
				&SDTProdutos.Add(&Item)
			endif
	    endif
		
	Endfor
   
	if &quantidade > 0
		msg('Atualização de inventário realizada com sucesso !')
  	else
		msg('Nenhuma atualização foi registrada!')
	endif
	
	if &ImprimirConferencia
		&ChaveSessao = &Pgmname + '_Dados'
		&Websession.Set(&ChaveSessao,&SDTProdutos.ToJson())
		InNewWindow.Target = RelatorioConferenciaInventario.Link(&ChaveSessao)
		InNewWindow.OpenWindow()		
	endif

EndSub


