    <Source><![CDATA[
Event Start

	&codigoAjuda   = 8
	Do 'Popular'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTCardapiosUEs_Empowerer.GridInternalName = GridSDTCardapiosUEs.InternalName
	GridSDTCardapiosUEs.Rows = Page.Rows
	GridSDTCardapiosUEsPaginationBar.RowsPerPageSelectedValue = GridSDTCardapiosUEs.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTCardapiosUEsCurrentPage = GridSDTCardapiosUEs.CurrentPage
	&GridSDTCardapiosUEsPageCount = GridSDTCardapiosUEs.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTCardapiosUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid
	&btnImprimir = !'<i class="fas fa-print"></i>'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTCardapiosUEsPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTCardapiosUEsPaginationBar.SelectedPage = !'Previous'
			GridSDTCardapiosUEs.PreviousPage()
		Case GridSDTCardapiosUEsPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTCardapiosUEs.CurrentPage
			&PageToGo += 1
			GridSDTCardapiosUEs.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTCardapiosUEsPaginationBar.SelectedPage)
			GridSDTCardapiosUEs.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTCardapiosUEsPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTCardapiosUEs.Rows = GridSDTCardapiosUEsPaginationBar.RowsPerPageSelectedValue
	GridSDTCardapiosUEs.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAjuda'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WPAjudaUE.PopUp(&prefCodigo, &codigoAjuda)
	Refresh

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &btnImprimir.Click

	//      if &SDTCardapiosUE.CurrentItem.carDapLiberarAcesso = 'A'
	//		  PRINTCardapio.Popup(&prefCodigo,&SDTCardapiosUE.CurrentItem.carDapCodigo,&SDTCardapiosUE.CurrentItem.carDapMesAno,&locCodigo,'S','S','N','N',1,6)
	//	  else
	//  		  If &prefCodigo<>26
	//			 PRINTCardapio.Popup(&prefCodigo,&SDTCardapiosUE.CurrentItem.carDapCodigo,&SDTCardapiosUE.CurrentItem.carDapMesAno,&locCodigo,'S','S','N','N',1,6)
	//		  else
	//			 PRINTCardapioMacrosMicros.Popup(&prefCodigo,&SDTCardapiosUE.CurrentItem.carDapCodigo,&SDTCardapiosUE.CurrentItem.carDapMesAno,0,'N','S','TS','S',1,6)
	//          endif
	//	  endif

	if &SDTCardapiosUE.CurrentItem.carDapLiberarAcesso in ('A','L')
	    if not &SDTCardapiosUE.CurrentItem.carDapArquivo.IsEmpty()
			&BlobFile   = &SDTCardapiosUE.CurrentItem.carDapArquivo
			&Filename   = &BlobFile.FileURI
			&Window.Url = &filename
			&Window.Open()
	    else
	      	PRINTCardapioMacrosMicros.Popup(&prefCodigo,&SDTCardapiosUE.CurrentItem.carDapCodigo,&SDTCardapiosUE.CurrentItem.carDapMesAno,0,'N','S','TS','S',1,6)
		endif
	endif

EndEvent

Event &options.ControlValueChanged()

	Do 'Popular'

EndEvent

Sub 'Popular'

  &SDTCardapiosUE.Clear()

  &FiltroDescricao = "%E%"

  If &options = 1
  	 &FiltroDescricao = "%EMEB%"
  EndIf
  If &options = 2
  	 &FiltroDescricao = "%CEIM%"
  EndIf

  for each
	  order prefCodigo, (carDapCodigo)
	  where prefCodigo   = &prefCodigo
	  Where carDapLiberarAcesso in ('L','A')
      Where Upper(carDapDescricao) Like &FiltroDescricao
	        &item                      = new()
			&item.carDapCodigo  	   = carDapCodigo
			&item.carDapDescricao  	   = carDapDescricao
			&item.carDapMesAno  	   = carDapMesAno
			// &item.carDapNutricionista1 = find(usuNome, usuCodigo = carDapNutricionista1 and usuCargo = 1 and prefCodigo = &prefCodigo,'')
			&item.prefCodigo		   = prefCodigo
			&item.carDapLiberarAcesso  = carDapLiberarAcesso
			&item.carDapArquivo		   = carDapArquivo
			&SDTCardapiosUE.Add( &item )
  endFor

EndSub


