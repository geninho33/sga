    <Source><![CDATA[
Event Start

	LoadWWPContext.Call( &WWPContext )	
	if &WWPContext.prefCodigo.IsEmpty()
	   WPLoginUE()
	else   						
	    &prefCodigo  = &WWPContext.prefCodigo
		&locCodigo   = &WWPContext.locCodigo
		&codigoAjuda = 6
		
		for each
			order prefCodigo, (lanestcodigo)
			where lanestStatus = 'A'
			where prefCodigo   = &prefCodigo
			  &lanestCodigo = lanestcodigo
		      &DtFinal      = lanestdatFinal
		      &DtInicial    = lanestdatInicial
		      &dsPeriodo    = lanestObs
		      Do 'popularProduto'
			  exit
		endfor
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTLancaEstoqueUEs_Empowerer.GridInternalName = GridSDTLancaEstoqueUEs.InternalName
	GridSDTLancaEstoqueUEs.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTLancaEstoqueUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAjuda'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WPAjudaUE.PopUp(&prefCodigo, &codigoAjuda)
	Refresh

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnBuscar'

	Do 'popularProduto'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoBtnSalvarEstoque'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_BtnBtnSalvarEstoque.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_BtnBtnSalvarEstoque.Close

	If DVelop_ConfirmPanel_BtnBtnSalvarEstoque.Result = !'Yes'

		for &Item in &SDTLancaEstoqueUE
			PRCDSalvarItemLancamentoEstoque( &prefCodigo,
											&lanestCodigo,
											&Item.lanestItemLocCodigo,
											&Item.lanestItemProdCodigo,
											&Item.lanestItemQuantidade,
											&Item.lanestItemObservacao,
											&Item.lanestItemValidade )
		endFor
		msg('Produtos foram atualizados com sucesso !')

	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Ask If DVelop_ConfirmPanel_BtnBtnSalvarEstoque.Result = !'Yes'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'popularProduto'

    &SDTLancaEstoqueUE.Clear()
	for each trnsprodutos
		order prefCodigo, prodCodigoTipoRemessa, prodDescricao
		where prefCodigo = &prefCodigo
		where prodStatus = 'A'
		where prodDescricao like '%'+&prodBusca+'%' when not &prodBusca.IsEmpty()
			  &Item = new()
			  &Item.lanestdisTipDescricao     = find(disTipDescricao,prefCodigo = &prefCodigo and disTipNumero = prodCodigoTipoRemessa)
			  &Item.lanestcodigo              = &lanestCodigo
			  &Item.lanestItemLocCodigo       = &locCodigo
			  &Item.lanestItemProdCodigo      = prodCodigo
			  &Item.lanestItemProdDescricao   = prodDescricao
			  &Item.lanestItemPesoUni         = prodPesoUnidade
			  &Item.lanestItemPeso            = prodPesoConsumo
			  &Item.lanestItemProdUni         = prodUnidMedConsumo

			  // buscando dados
			  &Item.lanestItemValidade        = PRCDBuscarValidadeLanEst(&prefCodigo, &lanestCodigo,&locCodigo,prodCodigo)
			  &Item.lanestItemObservacao      = PRCDBuscarOBSLanEst(&prefCodigo, &lanestCodigo,&locCodigo,prodCodigo)
			  &Item.lanestItemQuantidade      = PRCDBuscarQtdeLanEst(&prefCodigo, &lanestCodigo,&locCodigo,prodCodigo)
			  &Item.lanestItemStatus          = PRCDBuscarStatusLanEst(&prefCodigo, &lanestCodigo,&locCodigo,prodCodigo)
			  &SDTLancaEstoqueUE.Add( &Item )
	endFor

EndSub


