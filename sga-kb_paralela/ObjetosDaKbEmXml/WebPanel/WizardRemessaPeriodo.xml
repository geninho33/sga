    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	LoadWWPContext.Call(&WWPContext)
   	&prefCodigo = &WWPContext.prefCodigo

	if &Ano = 0
		&Ano = &Today.Year()
	endif

	if &Mes = 0
		&Mes = &Today.Month()
	endif

	do 'MontaPeriodo'

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'CheckSecurityForActions'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Enter

	// Verifica se existe cardápio definido para o mes e ano selecionados.
	For Each trnscardapio
		Where prefCodigo = &prefCodigo
		Where carDapMesAno.Month() = &Mes
		Where carDapMesAno.Year() = &Ano
		Where carDapStatus = Status.Ativo

		&HasValidationErrors = false
		Exit
	When none
		msg('Não foram definidos cardápios para o mês/ano informados.')
		&HasValidationErrors = true
	endFor

	// Valida data de envio
	do case
		case &DataEnvio < &DataInicial.AddDays(-7)
			msg('A data de envio não pode ser anterior a 7 dias do início do período informado.')
			&HasValidationErrors = true
		case &DataEnvio > &DataFinal
			msg('A data de envio não pode ser maior que o período informado.')
			&HasValidationErrors = true
	endcase

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'CheckRequiredFields'
	If &CheckRequiredFieldsResult AND not &HasValidationErrors
		Do 'SaveVariablesToWizardData'
		WizardRemessa(!'Periodo', !'Atendimento', false)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'WizardPrevious'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Return

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'CheckSecurityForActions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If not (not &GoingBack)
		BtnWizardFirstPrevious.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: XmlFileToWizardData
	&WizardData.FromXML(FileXmlToWizardData(&WebSessionKey))
	&WebSession.Set(&WebSessionKey,&WizardData.ToJson())

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&DataInicial = &WizardData.Periodo.DataInicial
	&DataFinal = &WizardData.Periodo.DataFinal
	&DataEnvio = &WizardData.Periodo.DataEnvio
	&Mes = &WizardData.Periodo.Mes
	&Ano = &WizardData.Periodo.Ano

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveVariablesToWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Periodo.DataInicial = &DataInicial
	&WizardData.Periodo.DataFinal = &DataFinal
	&WizardData.Periodo.DataEnvio = &DataEnvio
	&WizardData.Periodo.Mes = &Mes
	&WizardData.Periodo.Ano = &Ano
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())

	//Code block: WizardDataToXmlFile
	WizardDataToFileXML(&WebSessionKey,&WizardData.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'CheckRequiredFields'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&CheckRequiredFieldsResult = True
	If &DataInicial.IsEmpty()
		Msg(DVMessageGetBasicNotificationMsg('', Format('WWP_RequiredAttribute','Período'), DVMessageType.error, &DataInicial.InternalName, DVMessageBoolean.True, ''))
		&CheckRequiredFieldsResult = False
	EndIf
	If &DataFinal.IsEmpty()
		Msg(DVMessageGetBasicNotificationMsg('', Format('WWP_RequiredAttribute','até'), DVMessageType.error, &DataFinal.InternalName, DVMessageBoolean.True, ''))
		&CheckRequiredFieldsResult = False
	EndIf
	If &DataEnvio.IsEmpty()
		Msg(DVMessageGetBasicNotificationMsg('', Format('WWP_RequiredAttribute','Data Envio'), DVMessageType.error, &DataEnvio.InternalName, DVMessageBoolean.True, ''))
		&CheckRequiredFieldsResult = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event GlobalEvents.ForceUpdateWizardData

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: ForceUpdateWizardDataGlobalEvent
	do 'SaveVariablesToWizardData'
	do 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &Mes.ControlValueChanged

	do 'MontaPeriodo'

EndEvent

Event &Ano.ControlValueChanged

	do 'MontaPeriodo'

EndEvent

Sub 'MontaPeriodo'

	&DataInicial.Set(&Ano,&Mes,1)
	&DataFinal = &DataInicial.EndOfMonth()

	if &DataEnvio.IsEmpty() or &DataEnvio < &DataInicial or &DataEnvio > &DataFinal
		&DataEnvio = &DataInicial
	endif

EndSub


]]></Source>
