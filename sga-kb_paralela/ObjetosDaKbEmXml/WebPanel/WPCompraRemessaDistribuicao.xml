Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	tableSemana2.Visible = (not &periodoSemana2Ini.isEmpty())
	tableSemana3.Visible = (not &periodoSemana3Ini.isEmpty())
	tableSemana4.Visible = (not &periodoSemana4Ini.isEmpty())
	tableSemana5.Visible = (not &periodoSemana5Ini.isEmpty())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'Impressao'

	for each
		where prefCodigo     = &prefCodigo
		where remItemPeriodo = &remItemPeriodo
		where remCodigo      = &remCodigo
			Do Case
				Case &opc = 1 or &opc = 0
					 InNewWindow.Target = PRINTGuiaCompra.Link( &prefCodigo,&remCodigo,&remItemPeriodo,&disTipNumero,&rotaCodigo,&AreEnsCodigo,&dataInicial, &dataFinal )
				Case &opc = 2
					 InNewWindow.Target = PRINTGuiaRemessa.Link( &prefCodigo,&remCodigo,&remItemPeriodo,&disTipNumero,&rotaCodigo,&AreEnsCodigo )
				Otherwise
				     // InNewWindow.Target = PRINTGuiasDistribuicaoRemessa.Link(&prefCodigo,&remCodigo,&remItemPeriodo,&disTipNumero,&rotaCodigo,&AreEnsCodigo )
			EndCase
		    InNewWindow.OpenWindow()
			exit
	when none
		msg('Não foi gerado nenhuma remessa nesse Período !')
	endFor

EndSub


