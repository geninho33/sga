  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

   LoadWWPContext( &wwPContext )

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoUserActionEnviar'

    // Verificar se usuário existe
    If  &wwPContext.GLPI_USER_ID = 0
        GLPI_CreateUser( 4, &USER_ID,&Success,&ErrorMessage )
		if &USER_ID<>0
		   &wwPContext.GLPI_USER_ID = &USER_ID
		   SetWWPContext( &wwPContext )
		else
		   msg('Problema na criação do usuário ! | Retorno : ' + &Success.ToString() +
		       ' | Mensagem :  ' + &ErrorMessage +			  
			   ' | Token usuario : ' +  &wwPContext.USER_TOKEN +
			   ' | Token App : ' + &wwPContext.APP_TOKEN  )
		endif
    EndIf

    if &USER_ID>0
	    // Autenticar
	    GLPI_initSession( &SessionToken, &Success,&ErrorMessage)

	    If &Success
	        // Criar chamado
	        GLPI_CreateTicket(&TicketTitle, &TicketDescription, &ENTITY_ID, &TicketId, &Success, &ErrorMessage)

	        If &Success
	            &Message = "Chamado criado com sucesso! ID: " + &TicketId.ToString()
	        Else
	            &Message = "Erro ao criar chamado: " + &ErrorMessage
	        EndIf
	    Else
	        &Message = "Erro de autenticação: " + &ErrorMessage
	    EndIf

	    msg( &Message )
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'CreateUser'

	// Autenticar
    GLPI_initSession( &SessionToken, &Success, &ErrorMessage)

    If &Success
        // Buscar usuário existente
        GLPI_SearchUser( &UserId, &Success, &ErrorMessage)

        If Not &Success Or &UserId = 0
            // Criar novo usuário
            GLPI_CreateUser( &ENTITY_ID, &UserId, &Success, &ErrorMessage)

            If &Success
                &Message = "Usuário criado com sucesso! ID: " + &UserId.ToString()
            Else
                &Message = "Erro ao criar usuário: " + &ErrorMessage
            EndIf
        Else
            &Message = "Usuário já existe! ID: " + &UserId.ToString()
        EndIf
    Else
        &Message = "Erro de autenticação: " + &ErrorMessage
    EndIf

	msg( &Message )

EndEvent


]]></Source>
