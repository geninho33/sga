    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
   	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'LoadVariablesFromWizardData'

	Do 'AttributesSecurityCode'
	&remCodigo.Visible = False
	&Locais_locCodigo.Visible = False
	Grid_Empowerer.GridInternalName = Grid.InternalName
	Grid.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	/* Padrão sem guias */
	LabelGridEmpty.Visible = true
	BtnWizardNext.Visible = false

EndEvent

Event FreeStyleGridLocais.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	for &GridLocaisItem in &WizardData.Locais.GridLocais

		// Localiza quantidade de pessoas do local
		for &PessoasGridItem in &WizardData.Pessoas2.Grid

			if &PessoasGridItem.locCodigo = &GridLocaisItem.locCodigo and &PessoasGridItem.TotalPessoas > 0
				&Locais_locCodigo = &GridLocaisItem.locCodigo
				&Locais_Observacao = &GridLocaisItem.LocObservacaoGuia

				Do 'ValidaGuia'

				if &GerarGuia
					LabelGridEmpty.Visible = false
					BtnWizardNext.Visible = true
					Local.Caption = format('LOCAL: %1 (%2) - %3',&GridLocaisItem.locDescricao,&GridLocaisItem.locCodigo.ToString().Trim(),&GridLocaisItem.rotaDescricao)
					FreeStyleGridLocais.Load()
				endif

				Exit
			endif

		endfor

	endfor

EndEvent

Event Grid.Load

	if 1=2 // Inutiliza código do WWPLus

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	&GridSelected = false
	&Quantidade.SetEmpty()
	For &GridSelectedRow in &WizardData.Guias.Grid
		If &GridSelectedRow.locCodigo = &locCodigo
			AND &GridSelectedRow.prodCodigo = &prodCodigo
			AND &GridSelectedRow.prodDescricao = &prodDescricao
			AND &GridSelectedRow.uniDescricao = &uniDescricao
			AND &GridSelectedRow.xQuantidade = &xQuantidade
			AND &GridSelectedRow.distObservacao = &distObservacao
			&GridSelected = True
			&Quantidade = &GridSelectedRow.Quantidade
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	Endif

	&locCodigo = &Locais_locCodigo
	&distObservacao = &Locais_Observacao

	// Calcula quantidades por produto
	for &GridAlimentosItem in &WizardData.Alimentos.GridAlimentos

		&GridSelected	= true
		&prodCodigo 	= &GridAlimentosItem.prodCodigo
		&prodDescricao 	= &GridAlimentosItem.prodDescricao
		&uniDescricao	= &GridAlimentosItem.uniDescricao
		&Quantidade		= 0
		&ValorPerCapta 	= 0
		&xQuantidade	= 0

		for &PercaptaGridItem in &WizardData.PerCapta2.Grid

			if &PercaptaGridItem.prodCodigo = &prodCodigo
				&locCodigoCollection.FromJson(&PercaptaGridItem.locCodigoCollectionJson)

				/* Verifica se o produto tem estoque */
				if (&GridAlimentosItem.prodSaldo > 0) and (not &locCodigo in &locCodigoCollection)

					/* soma Percapta */
					&ValorPerCapta += ((&PercaptaGridItem.Bercario1PerCapta * &PessoasGridItem.Bercario1) * &PercaptaGridItem.Bercario1Oferta)
					&ValorPerCapta += ((&PercaptaGridItem.Bercario2PerCapta * &PessoasGridItem.Bercario2) * &PercaptaGridItem.Bercario2Oferta)
					&ValorPerCapta += ((&PercaptaGridItem.CrechePerCapta * &PessoasGridItem.Creche) * &PercaptaGridItem.CrecheOferta)
					&ValorPerCapta += ((&PercaptaGridItem.EmebPerCapta * &PessoasGridItem.Emeb) * &PercaptaGridItem.EmebOferta)
					&ValorPerCapta += ((&PercaptaGridItem.IntegralPerCapta * &PessoasGridItem.Integral) * &PercaptaGridItem.IntegralOferta)
					&ValorPerCapta += ((&PercaptaGridItem.FuncionarioPerCapta * &PessoasGridItem.Funcionarios) * &PercaptaGridItem.FuncionarioOferta)
				endif

				Exit

			endif

		endfor

		if &ValorPerCapta > 0
			&Quantidade = round(((&ValorPerCapta / &GridAlimentosItem.QtdeEmbalagem) + 0.49),0)
			if &Quantidade = 0
				&Quantidade = 1
			endif

			&xQuantidade = &Quantidade
			Load
		Endif

	endfor

EndEvent

Event Enter

	// Grava os dados e gera a distribuição
	Do 'SaveVariablesToWizardData'
	&HasValidationErrors = false
	&IsSucess = RanchoWizardPlanilhaGravaDados(&WebSessionKey,&remCodigo,&Messages)
	if not &IsSucess
		&HasValidationErrors = true
		for &Message in &Messages
			msg(&Message.Description)
		endfor
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If not &HasValidationErrors
		Do 'SaveVariablesToWizardData'
		RanchoWizardPlanilha(!'Guias', !'Conclusao', false)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'WizardPrevious'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'SaveVariablesToWizardData'
	RanchoWizardPlanilha(!'Guias', !'PerCapta2', true)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadGridSelectedRows'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.Guias.Grid.Clear()
	For Each Line in Grid
		If (&GridSelected)
			&GridSelectedRow = new()

			&GridSelectedRow.locCodigo = &locCodigo
			&GridSelectedRow.prodCodigo = &prodCodigo
			&GridSelectedRow.prodDescricao = &prodDescricao
			&GridSelectedRow.Quantidade = &Quantidade
			&GridSelectedRow.uniDescricao = &uniDescricao
			&GridSelectedRow.xQuantidade = &xQuantidade
			&GridSelectedRow.distObservacao = &distObservacao

			&WizardData.Guias.Grid.Add(&GridSelectedRow)
		Endif
	Endfor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadVariablesFromWizardData'

	/* Carrega dados do XML */
	&WizardData.FromXml(FileXMLToWizardData(&WebSessionKey))

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&remCodigo = &WizardData.Guias.remCodigo

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveVariablesToWizardData'

	if 1=2 // Inutiliza código do WWPLus

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Guias.remCodigo = &remCodigo
	&WizardData.Guias.FreeStyleGridLocais.Clear()
	For Each Line in FreeStyleGridLocais
		&FreeStyleGridLocaisItem = new()
		&FreeStyleGridLocaisItem.Locais_locCodigo = &Locais_locCodigo
		&FreeStyleGridLocaisItem.Locais_Observacao = &Locais_Observacao

		&WizardData.Guias.FreeStyleGridLocais.Add(&FreeStyleGridLocaisItem)
	EndFor
	Do 'LoadGridSelectedRows'
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	endif

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Guias.remCodigo = &remCodigo
	&WizardData.Guias.FreeStyleGridLocais.Clear()
	&WizardData.Guias.Grid.Clear()
//	&GuiasGrid = new()

	For each line in FreeStyleGridLocais

		For Each Line in Grid
			If (&GridSelected)
				&GridSelectedRow = new()

				&GridSelectedRow.locCodigo = &locCodigo
				&GridSelectedRow.prodCodigo = &prodCodigo
				&GridSelectedRow.prodDescricao = &prodDescricao
				&GridSelectedRow.Quantidade = &Quantidade
				&GridSelectedRow.xQuantidade = &xQuantidade
				&GridSelectedRow.distObservacao = &Locais_Observacao

				&WizardData.Guias.Grid.Add(&GridSelectedRow)
//				&GuiasGrid.Add(&GridSelectedRow)
			Endif
		Endfor

	Endfor

	/* Grava para arquivo XML */
	WizardDataToFileXML(&WebSessionKey,&WizardData.ToXml())

	&WizardData.Guias.Grid.Clear()
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())
//	&WebSession.Set(&WebSessionKey + !'_Guias', &GuiasGrid.ToJson())

EndSub

Sub 'AttributesSecurityCode'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event GlobalEvents.ForceUpdateWizardData

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: ForceUpdateWizardDataGlobalEvent
	do 'SaveVariablesToWizardData'
	do 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'ValidaGuia'

	&GerarGuia = false
	for &GridAlimentosItem in &WizardData.Alimentos.GridAlimentos

		if &GridAlimentosItem.prodSaldo > 0

			for &PercaptaGridItem in &WizardData.PerCapta2.Grid

				if &PercaptaGridItem.prodCodigo = &GridAlimentosItem.prodCodigo
					&locCodigoCollection.FromJson(&PercaptaGridItem.locCodigoCollectionJson)

					if 	(not &Locais_locCodigo in &locCodigoCollection) and
						(((&PercaptaGridItem.Bercario1PerCapta * &PessoasGridItem.Bercario1) * &PercaptaGridItem.Bercario1Oferta) +
						((&PercaptaGridItem.Bercario2PerCapta * &PessoasGridItem.Bercario2) * &PercaptaGridItem.Bercario2Oferta) +
						((&PercaptaGridItem.CrechePerCapta * &PessoasGridItem.Creche) * &PercaptaGridItem.CrecheOferta) +
						((&PercaptaGridItem.EmebPerCapta * &PessoasGridItem.Emeb) * &PercaptaGridItem.EmebOferta) +
						((&PercaptaGridItem.IntegralPerCapta * &PessoasGridItem.Integral) * &PercaptaGridItem.IntegralOferta) +
						((&PercaptaGridItem.FuncionarioPerCapta * &PessoasGridItem.Funcionarios) * &PercaptaGridItem.FuncionarioOferta)) > 0

						&GerarGuia = true
					endif

					Exit

				endif

			endfor

			if &GerarGuia
				Exit
			endif

		endif

	endfor

EndSub


