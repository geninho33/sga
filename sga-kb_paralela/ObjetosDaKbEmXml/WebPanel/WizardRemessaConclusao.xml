	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	&WebSession.Remove(!'WizardRemessa_carDapGruCodigoCollection')
	&WebSession.Remove(!'WizardRemessa_locCodigoCollection')
	&WebSession.Remove(!'WizardRemessa_AreasEtapasTurnosAtendimentoCollection')

EndSub


