  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	TblRESTScopes.Visible				= False
	&Expires.Visible 					= False

	&GAMUser.Load(&UserGUID)
	If &GAMUser.Success()
		&GAMUserEmail = &GAMUser.EMail
	Else
		Return
	Endif
	&GAMApplication = GAMApplication.GetByClientId(&ClientID, &GAMErrorCollection)
	If &GAMErrorCollection.Count = 0
		Form.Caption 	= Format("WWP_GAM_1applicationAPIkeyfor2", &GAMApplication.Name, &GAMUser.Name)
		//The application must have the property APIKeyEnable=true and ClientAllowRemoteRESTAuthentication=true
		If &GAMApplication.APIKeyEnable  AND  &GAMApplication.ClientAllowRemoteRESTAuthentication
			If &GAMApplication.APIKeyAllowScopeCustomization
				&ClientAllowGetUserDataREST			= &GAMApplication.ClientAllowGetUserDataREST
				&ClientAllowGetUserAddDataREST 		= &GAMApplication.ClientAllowGetUserAdditionalDataREST
				&ClientAllowGetUserRolesREST		= &GAMApplication.ClientAllowGetUserRolesREST
				&ClientAllowGetSessionIniPropREST	= &GAMApplication.ClientAllowGetSessionInitialPropertiesREST
				&ClientAllowGetSessionAppDataREST	= &GAMApplication.ClientAllowGetSessionApplicationDataREST
				&ClientAllowAdditionalScopeREST		= &GAMApplication.ClientAllowAdditionalScopeREST

				If not &ClientAllowGetUserDataREST
					&ClientAllowGetUserDataREST.Visible = False
				Endif
				If not &ClientAllowGetUserAddDataREST
					&ClientAllowGetUserAddDataREST.Visible = False
				Endif
				If not &ClientAllowGetUserRolesREST
					&ClientAllowGetUserRolesREST.Visible = False
				Endif
				If not &ClientAllowGetSessionIniPropREST
					&ClientAllowGetSessionIniPropREST.Visible = False
				Endif
				If not &ClientAllowGetSessionAppDataREST
					&ClientAllowGetSessionAppDataREST.Visible = False
				Endif
				If not &ClientAllowGetUserDataREST  AND  not &ClientAllowGetUserAddDataREST  AND  not &ClientAllowGetUserRolesREST AND
				   not &ClientAllowGetSessionIniPropREST  AND  not &ClientAllowGetSessionAppDataREST
					TblRESTPredScopes.Visible	= False
				Else
					TblRESTScopes.Visible		= True
				Endif
				If not &ClientAllowAdditionalScopeREST.IsEmpty()
					TblRESTScopes.Visible		= True
				Endif
			Endif
		Else
			Return
		Endif
	Else
		Return
	Endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'Confirm'

	&GAMUser.Load(&UserGUID)
	If &GAMUser.Success()
		GeneXusSecurity.GAM.BuildDetailedScope(&ClientAllowGetUserDataREST, &ClientAllowGetUserAddDataREST, &ClientAllowGetUserRolesREST, &ClientAllowGetSessionIniPropREST, &ClientAllowGetSessionAppDataREST, &ClientAllowAdditionalScopeREST, &DetailedScope)
		&GenerateAPIKeyOK = &GAMUser.GenerateApplicationAPIkey(&ClientID, &DetailedScope, &UserAPIkey, &UserAPIkeyExpires, &GAMErrorCollection)
		If &GenerateAPIKeyOK
			Commit
			&APIkey = &UserAPIkey
			&ClientAllowGetUserDataREST.Enabled 		= False
			&ClientAllowGetUserAddDataREST.Enabled 		= False
			&ClientAllowGetUserRolesREST.Enabled 		= False
			&ClientAllowGetSessionIniPropREST.Enabled	= False
			&ClientAllowGetSessionAppDataREST.Enabled	= False
			&ClientAllowAdditionalScopeREST.Enabled		= False
			If not &UserAPIkeyExpires.IsEmpty()
				&Expires			= &UserAPIkeyExpires
				&Expires.Visible 	= True
			Endif
			BtnEnter.Visible 			= False
			BtnCancel.Caption			= "WWP_GAM_Close"
			msg("WWP_GAM_YourAPIkeywasgeneratedsuccessfully")
		Endif
	Endif

EndEvent


]]></Source>
