  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Start
	If GAMSession.IsValid(&GAMSEssion, &GAMError) and not &GAMSEssion.IsAnonymous
		&GAMApplication = GAMApplication.Get()
		&Id = &GAMApplication.Id
		If NOT &GAMApplication.HomeObject.IsEmpty() and &GAMApplication.HomeObject.ToLower() <> !"gamhome"
			GAMApplication.GoHome()
		EndIf
	Else
		GAMExampleLogin()
	EndIf	
Endevent

Event 'Confirm'
	&GAMApplication.Load(&Id)
	&GAMApplication.HomeObject = &ApplicationHomeObject
	&GAMApplication.Save()
	If &GAMApplication.Success()
		commit
	Else
		rollback
	EndIf
	GAMApplication.GoHome()
Endevent

Event 'GoDevMenu'
	java [!&isJavaEnvironment!] = true;	
	If &isJavaEnvironment
		&Url = &HttpRequest.BaseUrl.ReplaceRegEx(!"/servlet/","") + !"/static/developermenu.html"
		link(&Url)
	Else
		link(!"developermenu.html")
	EndIf
	
Endevent

Event 'GoBackend'
	java [!&isJavaEnvironment!] = true;
	If &isJavaEnvironment
		link(!"genexus.security.backend.gam_dashboard")
	Else
		link(!"gam_dashboard.aspx")
	EndIf
Endevent

Event 'GoDoc'
	link(!"https://wiki.genexus.com/commwiki/servlet/wiki?15935,Category%3AGAM+Web+Backoffice,")
Endevent
]]></Source>
