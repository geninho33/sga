    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)
	WorkWithLink.Link = Auditoria.AliEscLogWW.Link()

	For each AliEscLog
		where AdmLogID = &AdmLogID
		Form.Caption = AdmLogCha.ToString()
		&Exists = True

	When none
		Form.Caption = "WWP_RecordNotFound"
		&Exists = False
	Endfor

	If (&Exists)
		Do 'LoadTabs'
	Endif

