    <Source><![CDATA[
Event Start

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	LoadWWPContext.Call(&WWPContext)
	Do 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	prefCodigo.Visible = False
	distRotaCodigo.Visible = False
	distUserName.Visible = False
	distDataCadastro.Visible = False
	distDataAlteracao.Visible = False
	distStatus.Visible = False

	// Security check for 'Actions'
	&IsAuthorized_Update = SecGAMIsAuthByFunctionalityKey.Udp(!'trnsdistribuicaoww_Update')
	If not (&IsAuthorized_Update)
		BtnUpdate.Visible = False
	Endif
	&IsAuthorized_Delete = SecGAMIsAuthByFunctionalityKey.Udp(!'trnsdistribuicaoww_Delete')
	If not (&IsAuthorized_Delete)
		BtnDelete.Visible = False
	Endif
	 

	// Visible Conditions
	If Not (distCodigo<>0)
		distCodigo.Visible = False
		distCodigo_Cell.Class = !'Invisible'
		TextBlockdistCodigo_Cell.Class = !'Invisible'
	Else
		distCodigo.Visible = True
		distCodigo_Cell.Class = !'MergeDataCell'
		TextBlockdistCodigo_Cell.Class = !'col-sm-2 MergeLabelCell'
	EndIf
	If Not (distRemCodigo<>0)
		distRemCodigo.Visible = False
		distRemCodigo_Cell.Class = !'Invisible'
	Else
		distRemCodigo.Visible = True
		distRemCodigo_Cell.Class = !'DataContentCell'
	EndIf
	If Not (not distPeriodo.isEmpty())
		distPeriodo.Visible = False
		distPeriodo_Cell.Class = !'Invisible'
	Else
		distPeriodo.Visible = True
		distPeriodo_Cell.Class = !'DataContentCell'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoUpdate'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Update)
		trnsdistribuicao.Call(TrnMode.Update, prefCodigo, distCodigo)
	Else
		msg("WWP_ActionNoLongerAvailable")
		BtnUpdate.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoDelete'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If (&IsAuthorized_Delete)
		trnsdistribuicao.Call(TrnMode.Delete, prefCodigo, distCodigo)
	Else
		msg("WWP_ActionNoLongerAvailable")
		BtnDelete.Visible = False
	Endif

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'PrepareTransaction'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TrnContext = new()
	&TrnContext.CallerObject = &Pgmname
	&TrnContext.CallerOnDelete = False
	&TrnContext.CallerURL = &HTTPRequest.ScriptName + !"?" + &HTTPRequest.QueryString
	&TrnContext.TransactionName = !"trnsdistribuicao"

	&Session.Set(!"TrnContext", &TrnContext.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub


]]></Source>
