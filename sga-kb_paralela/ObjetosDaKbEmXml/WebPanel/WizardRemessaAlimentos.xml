    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
   	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'LoadVariablesFromWizardData'

	Cell_GridAlimentos_DWC.Class = !'Invisible WCD_' + upper(GridAlimentos.InternalName)
	&IgnorarPercaptaJson.Visible = False
	&disTipDescricao.Visible = False
	GridAlimentos_Empowerer.GridInternalName = GridAlimentos.InternalName
	GridAlimentos.Rows = 0
	&GridAlimentosSelected.TitleFormat = 1
	&GridAlimentosSelected.Title = format(!'<input name="selectAllCheckboxGridAlimentos" type="checkbox" value="Select All" onClick="WWPSelectAll(this, %1);" onMouseOver="WWPSelectAllRemoveParentOnClick(this)" class="AttributeCheckBox" >', !"'GRIDALIMENTOSSELECTED'")

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridAlimentos.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid
	&DetailWebComponent = !'<i class="fas fa-angle-right ArrowIcon"></i>'

	&GridAlimentosSelected = false
	&uniFracao = find(uniFracao,uniCodigo = prodUnidMedConsumo,'XX')
	&uniDescricao = iif(prodObsConsumo.IsEmpty(),&uniFracao,prodObsConsumo)
	&Selecionavel = (prodPesoConsumo > 0)
	For &GridAlimentosSelectedRow in &WizardData.Alimentos.GridAlimentos
		If &GridAlimentosSelectedRow.prodCodigo = prodCodigo
			AND &GridAlimentosSelectedRow.prodDescricao = prodDescricao
			AND &GridAlimentosSelectedRow.prodPesoConsumo = prodPesoConsumo
			AND &GridAlimentosSelectedRow.uniDescricao = &uniDescricao
			AND &GridAlimentosSelectedRow.Selecionavel = &Selecionavel
			&GridAlimentosSelected = True
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	if not &Selecionavel
		&GridAlimentosSelected = false
		&GridAlimentosSelected.Visible = false
	else
		&GridAlimentosSelected.Visible = true
	endif

EndEvent

Event Enter

	&disTipDescricao = &prodCodigoTipoRemessa.Text

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If not &HasValidationErrors
		Do 'SaveVariablesToWizardData'
		WizardRemessa(!'Alimentos', !'Guias', false)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'WizardPrevious'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'SaveVariablesToWizardData'
	WizardRemessa(!'Alimentos', !'Atendimento', true)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &DetailWebComponent.Click

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridAlimentos_DWC.Object = PercaptaPorAlimentoWC.Create(&prefCodigo, prodCodigo, &DataInicial, &DataFinal, &IgnorarPercaptaJson)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'LoadGridAlimentosSelectedRows'

	if 1=2 // Desabilita código WWPlus

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.Alimentos.GridAlimentos.Clear()
	For Each Line in GridAlimentos
		If (&GridAlimentosSelected)
			&GridAlimentosSelectedRow = new()

			&GridAlimentosSelectedRow.prodCodigo = prodCodigo
			&GridAlimentosSelectedRow.prodDescricao = prodDescricao
			&GridAlimentosSelectedRow.prodPesoConsumo = prodPesoConsumo
			&GridAlimentosSelectedRow.uniDescricao = &uniDescricao
			&GridAlimentosSelectedRow.Selecionavel = &Selecionavel

			&WizardData.Alimentos.GridAlimentos.Add(&GridAlimentosSelectedRow)
		Endif
	Endfor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	endif

	&WizardData.Alimentos.GridAlimentos.Clear()
	For Each Line in GridAlimentos
		If (&GridAlimentosSelected and &Selecionavel)
			&GridAlimentosSelectedRow = new()

			&GridAlimentosSelectedRow.prodCodigo = prodCodigo
			&GridAlimentosSelectedRow.prodDescricao = prodDescricao
			&GridAlimentosSelectedRow.prodPesoConsumo = prodPesoConsumo
			&GridAlimentosSelectedRow.uniDescricao = &uniDescricao
			&GridAlimentosSelectedRow.Selecionavel = &Selecionavel

			&WizardData.Alimentos.GridAlimentos.Add(&GridAlimentosSelectedRow)
		Endif
	Endfor

EndSub

Sub 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: XmlFileToWizardData
	&WizardData.FromXML(FileXmlToWizardData(&WebSessionKey))
	&WebSession.Set(&WebSessionKey,&WizardData.ToJson())

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&IgnorarPercaptaJson = &WizardData.Alimentos.IgnorarPercaptaJson
	&prodCodigoTipoRemessa = &WizardData.Alimentos.prodCodigoTipoRemessa
	&disTipDescricao = &WizardData.Alimentos.disTipDescricao

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveVariablesToWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Alimentos.IgnorarPercaptaJson = &IgnorarPercaptaJson
	&WizardData.Alimentos.prodCodigoTipoRemessa = &prodCodigoTipoRemessa
	&WizardData.Alimentos.disTipDescricao = &disTipDescricao
	Do 'LoadGridAlimentosSelectedRows'
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())

	//Code block: WizardDataToXmlFile
	WizardDataToFileXML(&WebSessionKey,&WizardData.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event GlobalEvents.ForceUpdateWizardData

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: ForceUpdateWizardDataGlobalEvent
	do 'SaveVariablesToWizardData'
	do 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	&DataInicial = &WizardData.Periodo.DataInicial
	&DataFinal	 = &WizardData.Periodo.DataFinal

	/* Coleção de locais de atendimento */
	&locCodigoCollection.Clear()
	for &GridLocaisItem in &WizardData.Atendimento.GridLocais
		&locCodigoCollection.Add(&GridLocaisItem.locCodigo)
	endfor

	/* Armazena coleção na sessão */
	&WebSession.Set(!'WizardRemessa_locCodigoCollection',&locCodigoCollection.ToJson())

	/* Coleção de Áreas, Etapas e Turnos de atendimento */
	&AreasEtapasTurnosAtendimentoCollection.Clear()
	For Each Atendimento
		Order AreEnsCodigo, AreEnsSequencial, AtendimentoTurno, carGruCodigo
		Unique AreEnsCodigo, AreEnsSequencial, AtendimentoTurno, carGruCodigo
		Where prefCodigo = &prefCodigo
		Where locCodigo in &locCodigoCollection
		Where carGruCodigo in GruposCardapioReferenteMesAno(&prefCodigo,&WizardData.Periodo.Mes,&WizardData.Periodo.Ano)
		Where AtendimentoStatus = Status.Ativo
		Where AtendimentoNormalSegunda > 0

		&Properties = new()
		&Properties.Set(!'AreEnsCodigo',AreEnsCodigo.ToString())
		&Properties.Set(!'AreEnsSequencial',AreEnsSequencial.ToString())
		&Properties.Set(!'AtendimentoTurno',AtendimentoTurno.ToString())
		&Properties.Set(!'carGruCodigo',carGruCodigo.ToString())
		&AreasEtapasTurnosAtendimentoCollection.Add(&Properties)
	Endfor

	/* Armazena coleção na sessão */
	&WebSession.Set(!'WizardRemessa_AreasEtapasTurnosAtendimentoCollection',&AreasEtapasTurnosAtendimentoCollection.ToJson())

	/* Coleção de Produtos (Ingredientes)*/
	&prodCodigoCollection.Clear()
	for &Properties in &AreasEtapasTurnosAtendimentoCollection

		&AreEnsCodigo.FromString(&Properties.Get(!'AreEnsCodigo'))
		&AreEnsSequencial.FromString(&Properties.Get(!'AreEnsSequencial'))
		&carGruTurno.FromString(&Properties.Get(!'AtendimentoTurno'))
		&carDapGruCodigo.FromString(&Properties.Get(!'carGruCodigo'))

		For each trnspratosingredientes, trnscardapioprato
			Order pratIngrProdCodigo
			Unique pratIngrProdCodigo
			Where prefCodigo = &prefCodigo
			Where AreEnsCodigo = &AreEnsCodigo
			Where AreEnsSequencial = &AreEnsSequencial
			Where carGruTurno = &carGruTurno
			Where carDapGruCodigo = &carDapGruCodigo
			Where carPratoData >= &DataInicial
			Where carPratoData <= &DataFinal
			Where carDapStatus = Status.Ativo
			Where pratoCodigo = carPratoRefeicao
			Where pratIngrStatus = Status.Ativo
			Where pratIngrQuantidade > 0

			if &prodCodigoCollection.IndexOf(pratIngrProdCodigo) = 0
				&prodCodigoCollection.Add(pratIngrProdCodigo)
			endif
		Endfor

	endfor
	log.Info(&prodCodigoCollection.ToJson(),&Pgmname+'.prodCodigoCollection')

EndEvent

Event GlobalEvents.IgnorarDados(&JsonString)

	&IgnorarPercaptaJson = &JsonString
	log.Info(&JsonString,&Pgmname+'.GlobalEvents.IgnorarDados')

EndEvent


]]></Source>
