  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

 	LoadWWPContext.Call(&WWPContext) 
    &prefCodigo = &WWPContext.prefCodigo
	 
	&SDTCardapio.Clear()
	
	for each
		order prefCodigo, carDapCodigo
		where prefCodigo = &prefCodigo
			&item = new()
			&item.carDapCodigo = carDapCodigo
			&item.carDapDescricao = carDapDescricao
			&item.carDapMesAno = carDapMesAno
			&SDTCardapio.Add( &item )		
	endFor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTCardapios_Empowerer.GridInternalName = GridSDTCardapios.InternalName
	GridSDTCardapios.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTCardapios.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnMigrarPratos'

&dataTime = dateTime.New(1899,12,1,08,00,00)

 for  &item in &SDTCardapio
	  for each cardapios_ocorrencia
		  where prefeitura = &prefCodigo
		  where cardapio   = &item.carDapCodigo
				&data = PRCDRetornarData( dia, semana, &item.carDapMesAno.Month(), &item.carDapMesAno.Year() )
				Do Case
				   Case refeicao_tipo in (1,2,3,4,11,12,13,17,18,28,29,35,36)
				   		&dataTime = dateTime.New(1899,12,1,08,00,00)	
				   Case refeicao_tipo in ( 5, 14, 19, 30,12,19,30)
				   		&dataTime = dateTime.New(1899,12,1,12,00,00)	 		
				   Case refeicao_tipo in ( 15,20,21,22, 31,32,33,34,37)
				   		&dataTime = dateTime.New(1899,12,1,14,00,00)	 		
				   Case refeicao_tipo in ( 16,23, 25,26,27)
				   		&dataTime = dateTime.New(1899,12,1,19,00,00)	 								
				endCase
			     
				for each  trnscardapioprato
					where prefCodigo       = &prefCodigo
					where carDapCodigo     = cardapio
					where carPratoRefeicao = produtofinal				
					      &totalRefeicao +=1 
				when none		  
						  PRCDGravarPratosCardapios(&prefCodigo,&item.carDapCodigo,&dataTime,produtofinal, refeicao_tipo, &data )
						  &totalRefeicao +=1 
				endfor		  
	 endFor 	 
 endFor

 msg('Total de Refeição : ' + &totalRefeicao.ToString() )

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAtualizaTipo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	PRCDAtualizarTipoMovimentacao.Call()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAjusteMovimentacao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	PRCDAjustarSaldo.Call()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent


]]></Source>
