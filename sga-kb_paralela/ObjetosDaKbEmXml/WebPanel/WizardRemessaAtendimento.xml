  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[
Event Start

	LoadWWPContext.Call(&WWPContext)
   	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'LoadVariablesFromWizardData'

	Cell_GridLocais_DWC.Class = !'Invisible WCD_' + upper(GridLocais.InternalName)
	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	Do 'LoadComborotaCodigo'
	&IgnorarAtendimentoJson.Visible = False
	&Rotas.Visible = False
	GridLocais_Empowerer.GridInternalName = GridLocais.InternalName
	GridLocais.Rows = 0
	&GridLocaisSelected.TitleFormat = 1
	&GridLocaisSelected.Title = format(!'<input name="selectAllCheckboxGridLocais" type="checkbox" value="Select All" onClick="WWPSelectAll(this, %1);" onMouseOver="WWPSelectAllRemoveParentOnClick(this)" class="AttributeCheckBox" >', !"'GRIDLOCAISSELECTED'")

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridLocais.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid
	&DetailWebComponent = !'<i class="fas fa-angle-right ArrowIcon"></i>'

	&GridLocaisSelected = false
	&rotaDescricao = find(rotaDescricao,rotaCodigo = locNota)
	For &GridLocaisSelectedRow in &WizardData.Atendimento.GridLocais
		If &GridLocaisSelectedRow.locCodigo = locCodigo
			AND &GridLocaisSelectedRow.locDescricao = locDescricao
			AND &GridLocaisSelectedRow.rotaDescricao = &rotaDescricao
			AND &GridLocaisSelectedRow.LocObservacaoGuia = LocObservacaoGuia
			&GridLocaisSelected = True
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Enter

	&rotaDescricaoCollection.FromJson(Combo_rotaCodigo.SelectedText_get)
	&Rotas = &rotaDescricaoCollection.ToJson()

	/* Verifica se foi selecionado algum local de entrega */
	&HasValidationErrors = true
	For each line in GridLocais
		if &GridLocaisSelected
			&HasValidationErrors = false
			Exit
		endif
	Endfor

	if &HasValidationErrors
		msg('Selecione pelo menos um local de entrega antes de prosseguir.')
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'CheckRequiredFields'
	If &CheckRequiredFieldsResult AND not &HasValidationErrors
		Do 'SaveVariablesToWizardData'
		WizardRemessa(!'Atendimento', !'Alimentos', false)
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'WizardPrevious'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do 'SaveVariablesToWizardData'
	WizardRemessa(!'Atendimento', !'Periodo', true)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &DetailWebComponent.Click

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridLocais_DWC.Object = AtendimentoPorUnidadeWC.Create(&prefCodigo, locCodigo, &IgnorarAtendimentoJson)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_rotaCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&rotaCodigo.FromJson(Combo_rotaCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	GridLocais.Refresh()

EndEvent

Sub 'LoadGridLocaisSelectedRows'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.Atendimento.GridLocais.Clear()
	For Each Line in GridLocais
		If (&GridLocaisSelected)
			&GridLocaisSelectedRow = new()

			&GridLocaisSelectedRow.locCodigo = locCodigo
			&GridLocaisSelectedRow.locDescricao = locDescricao
			&GridLocaisSelectedRow.rotaDescricao = &rotaDescricao
			&GridLocaisSelectedRow.LocObservacaoGuia = LocObservacaoGuia

			&WizardData.Atendimento.GridLocais.Add(&GridLocaisSelectedRow)
		Endif
	Endfor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: XmlFileToWizardData
	&WizardData.FromXML(FileXmlToWizardData(&WebSessionKey))
	&WebSession.Set(&WebSessionKey,&WizardData.ToJson())

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&IgnorarAtendimentoJson = &WizardData.Atendimento.IgnorarAtendimentoJson
	&rotaCodigo = &WizardData.Atendimento.rotaCodigo
	&Rotas = &WizardData.Atendimento.Rotas

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'SaveVariablesToWizardData'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
	&WizardData.Atendimento.IgnorarAtendimentoJson = &IgnorarAtendimentoJson
	&WizardData.Atendimento.rotaCodigo = &rotaCodigo
	&WizardData.Atendimento.Rotas = &Rotas
	Do 'LoadGridLocaisSelectedRows'
	&WebSession.Set(&WebSessionKey, &WizardData.ToJson())

	//Code block: WizardDataToXmlFile
	WizardDataToFileXML(&WebSessionKey,&WizardData.ToXml())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'CheckRequiredFields'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&CheckRequiredFieldsResult = True
	If &rotaCodigo.Count = 0
		Msg(DVMessageGetBasicNotificationMsg('', Format('WWP_RequiredAttribute','Rota'), DVMessageType.error, Combo_rotaCodigo.DDOInternalName, DVMessageBoolean.True, ''))
		&CheckRequiredFieldsResult = False
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComborotaCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//&rotaCodigo initial value has to be loaded manually at the beginning of this Subrutine
	For Each
		Order rotaDescricao
		Where prefCodigo = &prefCodigo and rotaStatus = Status.Ativo
		&Combo_DataItem = new()
		&Combo_DataItem.ID = rotaCodigo.ToString().Trim()
		&Combo_DataItem.Title = rotaDescricao
		&rotaCodigo_Data.Add(&Combo_DataItem)
	EndFor
	Combo_rotaCodigo.SelectedValue_set = &rotaCodigo.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event GlobalEvents.ForceUpdateWizardData

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: ForceUpdateWizardDataGlobalEvent
	do 'SaveVariablesToWizardData'
	do 'LoadVariablesFromWizardData'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GlobalEvents.IgnorarDados(&JsonString)

	&IgnorarAtendimentoJson = &JsonString

EndEvent

Event Refresh

	/* Carrega coleção de locais */
	&locCodigoCollection.Clear()
	For Each Atendimento
		Order locCodigo
		Unique locCodigo
		Where prefCodigo = &prefCodigo
		Where carGruCodigo in GruposCardapioReferenteMesAno(&prefCodigo,&WizardData.Periodo.Mes,&WizardData.Periodo.Ano)

		&locCodigoCollection.Add(locCodigo)
	EndFor

EndEvent


]]></Source>
