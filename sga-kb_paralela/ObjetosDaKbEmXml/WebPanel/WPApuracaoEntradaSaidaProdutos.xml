    <Source><![CDATA[
Event Start

    LoadWWPContext.Call(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo
	&dataHoje   = now()
    &dtInicial  = &dataHoje
	&dtFinal    = &dataHoje.AddDays(30)
	&prodCodigo = 0

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTProdutoss_Empowerer.GridInternalName = GridSDTProdutoss.InternalName
	GridSDTProdutoss.Rows = Page.Rows
	GridSDTProdutossPaginationBar.RowsPerPageSelectedValue = GridSDTProdutoss.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTProdutossCurrentPage = GridSDTProdutoss.CurrentPage
	&GridSDTProdutossPageCount = GridSDTProdutoss.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTProdutoss.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTProdutossPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTProdutossPaginationBar.SelectedPage = !'Previous'
			GridSDTProdutoss.PreviousPage()
		Case GridSDTProdutossPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTProdutoss.CurrentPage
			&PageToGo += 1
			GridSDTProdutoss.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTProdutossPaginationBar.SelectedPage)
			GridSDTProdutoss.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTProdutossPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTProdutoss.Rows = GridSDTProdutossPaginationBar.RowsPerPageSelectedValue
	GridSDTProdutoss.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAplicar'

    for &item in &SDTProdutos
		if &item.prodLocalSaldo<>&item.QtdeMaximo and &item.check
			if &item.prodLocalSaldo>&item.QtdeMaximo
			   &saldo    = &item.prodLocalSaldo - &item.QtdeMaximo
			   &ajusTipo = 'E'
			else
			   &saldo    = &item.QtdeMaximo - &item.prodLocalSaldo
			   &ajusTipo = 'S'
			endif
			PRCDLancarInventario( &ajusTipo,0, &item.prodCodigo, &saldo , &item.prodLocalSaldo )
			msg('O ' + &item.prodDescricao + ' foi atualizado com sucesso !')
		endif
	endfor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnProcessar'

	if &dtFinal<&dtInicial
		msg('Data Inicial não poder ser maior que a data Final !')
	else
		Do 'processarMovimentacao'
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'processarMovimentacao'

	&prodDescricao = ''
	&unEntrada     = ''
	&unSaida       = ''
	&qtdeEntrada   = 0
	&qtdeSaida     = 0
	&saldo         = 0
	&SDTProdutos.Clear()

	for each
		order prefCodigo, prodCodigo
		where prefCodigo = &prefCodigo
		where prodCodigo = &prodCodigo when &prodCodigo<>0
		where prodClassificacao = &classificacao when not &classificacao.IsEmpty()
		where prodStatus = 'A'
		      &item = new()
			  &prodDescricao = prodDescricao
			  &unEntrada     = find( uniDescricao, prefCodigo = &prefCodigo and uniCodigo = prodUnidMedCompra, 'Nenhuma' )
			  &unSaida       = find( uniDescricao, prefCodigo = &prefCodigo and uniCodigo = prodUnidMedConsumo, 'Nenhuma' )
			  &produto       = prodCodigo

			  // apuração de Compra
			  for each trnsnota, trnsnotaitens
				  order prefCodigo, notaDataCadastro
				  where prefCodigo        = &prefCodigo
				  where notaDataCadastro >= &dtInicial
				  where notaDataCadastro <= &dtFinal
				  where notaItemProduto   = prodCodigo
				  where not notaStatus in ('C','I')
		                &qtdeEntrada += notaItemQtde
			  endfor

			  // apuração de Romaneio
			  for each  Romaneio, Romaneio.Item
				  order prefCodigo, romanData
				  where prefCodigo = &prefCodigo
				  where romanData >= &dtInicial
				  where romanData <= &dtFinal
				  where prodCodigo = &produto
				  		if romanItemQuantidade > 0
		                   &qtdeEntrada += romanItemQuantidade
						   // msg('Quantidade : ' + romanItemQuantidade.ToString() )
						endif
			  endfor

			  // apuração de ajuste de Entrada
			  for each trnsajuste, trnsajusteitens
				  order prefCodigo, ajusDataCadastro
				  where prefCodigo        = &prefCodigo
				  where ajusDataCadastro >= &dtInicial
				  where ajusDataCadastro <= &dtFinal
				  where ajusItemProduto   = prodCodigo
				  where ajusStatus        = 'A'
				  where ajusItemTipo      = 'E'
			            &qtdeEntrada += ajusItemQuantidade
			  endfor

			  // apuração da distribuição
			  for each trnsdistribuicao, trnsdistribuicaoitens
				  order prefCodigo, distDataCadastro
				  where prefCodigo        = &prefCodigo
				  where distDataCadastro >= &dtInicial
				  where distDataCadastro <= &dtFinal
				  where distItemProduto   = prodCodigo
				  where distStatus        = 'A'
			            &qtdeSaida += distItemQuantidade
			  endfor

			  // apuração de ajuste de saida
			  for each trnsajuste, trnsajusteitens
				  order prefCodigo, ajusDataCadastro
				  where prefCodigo        = &prefCodigo
				  where ajusDataCadastro >= &dtInicial
				  where ajusDataCadastro <= &dtFinal
				  where ajusItemProduto   = prodCodigo
				  where ajusItemTipo      = 'S'
			            &qtdeSaida +=  ajusItemQuantidade
			  endfor

			  if &qtdeEntrada<>0 or &qtdeSaida<>0
				 &item.prodCodigo     = prodCodigo
				 &item.QtdeMaximo     = prodSaldo
				 &item.prodDescricao  = &prodDescricao
				 &item.UNCompra       = &unEntrada
				 &item.UNDistribuicao = &unSaida
				 &item.qtdeEntrada    = &qtdeEntrada
				 &item.qtdeSaida      = &qtdeSaida
				 &item.prodLocalSaldo = &qtdeEntrada - &qtdeSaida
				 &SDTProdutos.Add( &item )
			  endif

              &qtdeEntrada = 0
			  &qtdeSaida   = 0

	endfor

EndSub


