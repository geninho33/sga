ue&gt;&amp;amp;GridSDTProdutossPageCount&lt;/Value&gt;&lt;/Property&gt;&lt;Property&gt;&lt;Name&gt;AppliedFilters&lt;/Name&gt;&lt;Value&gt;&amp;amp;GridSDTProdutossAppliedFilters&lt;/Value&gt;&lt;/Property&gt;&lt;/Properties&gt;" /></cell></row></table></cell></row></table></ucw></cell></row><row><cell><action controlName="BtnbtnAplicar" onClickEvent="'DobtnAplicar'" caption="Aplicar o saldo no estoque" /></cell></row></table></ucw></cell></row></table></cell></row><row><cell><html controlName="Html_BottomAuxiliarControls" formId="2" /></cell></row></table></layout></detail></Form><Form id="2" type="html"><BODY><gxWWP.GridEmpowerer ControlName="GridSDTProdutoss_Empowerer" /></BODY></Form></GxMultiForm>]]></Source>
