  <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
    <Source><![CDATA[Event Enter
	If &UserPasswordNew = &UserPasswordNewConf
		&User = GAMRepository.GetUserByLogin(&UserAuthTypeName, &UserName, &GAMErrorCollection)
		If &GAMErrorCollection.Count = 0		
			&ChangePwdOK = &User.ChangePasswordByKey(&KeyToChangePassword, &UserPasswordNew, &GAMErrorCollection)
			If &ChangePwdOK
				Commit
				
				&AdditionalParameter.RememberUserType	= &UserRememberMe
				&AdditionalParameter.IDPState			= &IDP_State
				&LoginOK = GAMRepository.Login(&UserName, &UserPasswordNew, &AdditionalParameter, &GAMErrorCollection )
				If &LoginOK
					If GAMRepository.IsRemoteAuthentication(&IDP_State)
						//Redirect to remote authentication
						GAMRepository.RedirectToRemoteAuthentication(&IDP_State)
					Else
						&URL = GAMRepository.GetLastErrorsURL()
						If &URL.IsEmpty()
							GAMHome()
						Else
							Link(&URL)
						Endif
					Endif
				Else
					Do 'DisplayMessages'
				EndIf
			Else
				Do 'DisplayMessages'
			Endif
		Else
			Do 'DisplayMessages'
		Endif
	Else
		Msg("GAM_Thenewpasswordandconfirmationdonotmatch")
	Endif	
EndEvent

Event 'Login'
	If GAMRepository.IsRemoteAuthentication(&IDP_State)
		GAMExampleIDPLogin(&IDP_State)
	Else
		GAMExampleLogin()
	Endif
EndEvent

Sub 'DisplayMessages'
	For &GAMError in &GAMErrorCollection
		Msg(&GAMError.Message)
	EndFor
EndSub


]]></Source>
