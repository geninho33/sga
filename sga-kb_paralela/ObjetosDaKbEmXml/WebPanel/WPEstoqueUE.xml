    <Source><![CDATA[
Event Start

	LoadWWPContext.Call( &WWPContext )
	if &WWPContext.prefCodigo.IsEmpty()
	   WPLoginUE()
	else   				
	    &prefCodigo  = &WWPContext.prefCodigo
		&locCodigo   = &WWPContext.locCodigo
		&codigoAjuda = 5
		&locVinculada = &WWPContext.locVinculada
		Do 'Popular'
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTEstoqueUEs_Empowerer.GridInternalName = GridSDTEstoqueUEs.InternalName
	GridSDTEstoqueUEs.Rows = Page.Rows
	GridSDTEstoqueUEsPaginationBar.RowsPerPageSelectedValue = GridSDTEstoqueUEs.Rows

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&GridSDTEstoqueUEsCurrentPage = GridSDTEstoqueUEs.CurrentPage
	&GridSDTEstoqueUEsPageCount = GridSDTEstoqueUEs.PageCount

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEstoqueUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEstoqueUEsPaginationBar.ChangePage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	Do Case
		Case GridSDTEstoqueUEsPaginationBar.SelectedPage = !'Previous'
			GridSDTEstoqueUEs.PreviousPage()
		Case GridSDTEstoqueUEsPaginationBar.SelectedPage = !'Next'
			&PageToGo = GridSDTEstoqueUEs.CurrentPage
			&PageToGo += 1
			GridSDTEstoqueUEs.GotoPage(&PageToGo)
		Otherwise
			&PageToGo.FromString(GridSDTEstoqueUEsPaginationBar.SelectedPage)
			GridSDTEstoqueUEs.GotoPage(&PageToGo)
	EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEstoqueUEsPaginationBar.ChangeRowsPerPage

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTEstoqueUEs.Rows = GridSDTEstoqueUEsPaginationBar.RowsPerPageSelectedValue
	GridSDTEstoqueUEs.FirstPage()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAjuda'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WPAjudaUE.PopUp(&prefCodigo, &codigoAjuda)
	Refresh

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnBuscar'

   Do 'Popular'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DoBtnImprimirSaldo'

  PRINTRelatorioEstoqueUE.Popup(&locCodigo)

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Popular'

	&SDTEstoqueUE.Clear()
	for each trnsprodutos
	   order prefCodigo, prodCodigoTipoRemessa, prodDescricao
	   where prefCodigo = &prefCodigo
	   where prodStatus = 'A'
	   where prodDescricao like '%'+&prodBusca+'%' when not &prodBusca.IsEmpty()
      	     // where estoUeLocCodigo  = &locCodigo
	         // where prodCodigo       = estoUeProdCodigo
			 if find(estoUeProdCodigo,estoUeProdCodigo=prodCodigo and estoUeLocCodigo = &locCodigo,0) > -1
				&estoque                     = new()
				&estoque.estoUeProdCodigo    = prodCodigo
				&estoque.estoUeProdDescricao = prodDescricao
				// &estoque.estoUeUniDescricao  = prodObsConsumo
				&estoque.estoUeUniDescricao  = find(uniDescricao,uniCodigo=prodUnidMedConsumo,'')
				&estoque.estoUeSaldo         = find(estoUeSaldo,estoUeProdCodigo=prodCodigo and estoUeLocCodigo = &locCodigo and prefCodigo = &prefCodigo,0)
				&estoque.estoUeAlteracao     = find(estoUeAlteracao,estoUeProdCodigo=prodCodigo and estoUeLocCodigo = &locCodigo and prefCodigo = &prefCodigo)
				&estoque.estoUeTipoRemessa   = find(disTipDescricao,disTipNumero=prodCodigoTipoRemessa and prefCodigo = &prefCodigo,'')
				&SDTEstoqueUE.Add( &estoque )
			 endif
    endFor

EndSub


