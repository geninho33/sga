    <Source><![CDATA[
Event Start

	LoadWWPContext.Call( &WWPContext )

	if &WWPContext.prefCodigo.IsEmpty()
	   WPLoginUE()
	else
	    &distCodigo       = 0
	    &prefCodigo       = &WWPContext.prefCodigo
		&locCodigo        = &WWPContext.locCodigo
		&locVinculada     = &WWPContext.locVinculada
		&locVincDescricao = &WWPContext.locVincDescricao
		Do 'Popular'
		&codigoAjuda   = 3
	endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	GridSDTEntregasUEs_Empowerer.GridInternalName = GridSDTEntregasUEs.InternalName
	GridSDTEntregasUEs.Rows = 0

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Refresh

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&btnReceber.ColumnHeaderClass = !'WWIconActionColumn'
	&btnImprimir.ColumnHeaderClass = !'WWIconActionColumn'
	SDTEntregasUE__distCodigo.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distSituacao.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distCodigoTipoRemessa.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distDataEnvio.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distDataRecepcao.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distRecebedor.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distVincDescricao.ColumnHeaderClass = !'WWColumn'
	SDTEntregasUE__distObservacao.ColumnHeaderClass = !'WWColumn'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event GridSDTEntregasUEs.Load

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//this code should be inside the For Each used to load the grid
	&btnReceber = !'<i class="fas fa-check"></i>'
	
	&btnImprimir = !'<i class="fas fa-print"></i>'

	&btnReceber.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWIconActionColumn WWColumnWarning WWColumnWarningFirstColumn', !'WWIconActionColumn')
	&btnImprimir.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWIconActionColumn WWColumnWarning', !'WWIconActionColumn')
	SDTEntregasUE__distCodigo.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distSituacao.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distCodigoTipoRemessa.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distDataEnvio.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distDataRecepcao.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distRecebedor.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distVincDescricao.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWColumn WWColumnWarning', !'WWColumn')
	SDTEntregasUE__distObservacao.ColumnClass = iif(&SDTEntregasUE.CurrentItem.distReceber in ( 'N', ''), !'WWColumn WWColumnWarning', !'WWColumn')

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnAjuda'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	WPAjudaUE.PopUp(&prefCodigo, &codigoAjuda)
	Refresh

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event 'DobtnBuscar'

	Do 'Popular'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event &btnReceber.Click

//    If &SDTEntregasUE.CurrentItem.distReceber in ('N','')
//	   if ( &SDTEntregasUE.CurrentItem.distDataEnvio.Month()>9 and
//		    &SDTEntregasUE.CurrentItem.distDataEnvio.Year()=2024 ) or
//		    &SDTEntregasUE.CurrentItem.distDataEnvio.Year()>2024
//	        PRCDConfirmarEntrega(&prefCodigo, &SDTEntregasUE.CurrentItem.distCodigo)
//	        Do 'Popular'
//	   endif
//	Else
//	   msg('Essa entrega já foi confirmada !')
//    Endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	DVelop_ConfirmPanel_btnReceber.Confirm()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event DVelop_ConfirmPanel_btnReceber.Close

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If DVelop_ConfirmPanel_btnReceber.Result = !'Yes'
		Do 'Do btnReceber'
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Sub 'Do btnReceber'

    If &SDTEntregasUE.CurrentItem.distReceber in ('N')
       PRCDConfirmarEntrega(&prefCodigo, &SDTEntregasUE.CurrentItem.distCodigo,'E', &SDTEntregasUE.CurrentItem.distLocalDestino )
       Do 'Popular'
	Else
	   msg('Essa entrega já foi confirmada !')
    Endif

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */



	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event &btnImprimir.Click

	  PRINTGuiaDistribuicaoUE.Popup( &prefCodigo, &SDTEntregasUE.CurrentItem.distCodigo )

EndEvent

Sub 'Popular'

	&SDTEntregasUE.Clear()
	&dataBusca = now()
	&dataBusca = &dataBusca - 30

	for each
		order prefCodigo, (distCodigo)
		where prefCodigo       = &prefCodigo
		where distLocalDestino = &locCodigo or distLocalDestino = &locVinculada
		where distStatus       = 'A'
		where distCodigo       = &distCodigo when &distCodigo<>0
		where ( distDataEnvio.Year() = &dataBusca.Year() ) or ( distDataEnvio.Year() = &dataBusca.Year() and distDataCadastro.Year() = &dataBusca.Year() ) when &distCodigo = 0
		      &entregas                       = new()
		      &entregas.distCodigo            = distCodigo
			  &entregas.distCodigoTipoRemessa = distCodigoTipoRemessa
			  &entregas.distDataEnvio         = distDataEnvio
			  &entregas.distDataRecepcao      = distDataRecepcao
			  &entregas.distLocalDestino      = &locCodigo
			  // &entregas.distLocalDestino   = distLocalDestino
			  &entregas.distLocalOrigem       = distLocalOrigem
			  &entregas.distObservacao        = distObservacao
			  if distLocalDestino = &locVinculada
				 &entregas.distVincDescricao = &locVincDescricao
			  endif

			  &entregas.distRecebedor         = distRecebedor
			  &entregas.distReceber           = distReceber
			  if distReceber = 'S'
				 &entregas.distSituacao = 'Recebido'
			  else
				 &entregas.distSituacao = 'Aguardando'
			  endif
	   		  &SDTEntregasUE.Add( &entregas )
    endFor

EndSub


