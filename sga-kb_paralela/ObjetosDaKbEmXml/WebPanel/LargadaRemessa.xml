    <Source><![CDATA[
Event Start

	LoadWWPContext(&WWPContext)
	&prefCodigo = &WWPContext.prefCodigo

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//Code block: EditFormClass
	LayoutMainTable.Class = LayoutMainTable.Class + " " + ThemeClass:EditForm

	&DDO_TitleSettingsIcons = GetWWPTitleSettingsIcons()
	&DataEnvio.Visible = False
	&distCodigoTipoRemessa.Visible = False
	Do 'LoadCombodistCodigoTipoRemessa'
	Do 'LoadComboDataEnvio'
	Do 'LoadComborotaCodigo'

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_rotaCodigo.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&rotaCodigo.FromJson(Combo_rotaCodigo.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	Do 'LoadComboDataEnvio'

EndEvent

Event Combo_DataEnvio.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&DataEnvio.FromString(Combo_DataEnvio.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndEvent

Event Combo_distCodigoTipoRemessa.OnOptionClicked

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&distCodigoTipoRemessa.FromString(Combo_distCodigoTipoRemessa.SelectedValue_get)

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

	Do 'LoadComboDataEnvio'

EndEvent

Sub 'LoadComborotaCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//&rotaCodigo initial value has to be loaded manually at the beginning of this Subrutine
	For Each
		Order rotaDescricao
		Where prefCodigo = &prefCodigo and rotaStatus = Status.Ativo
		&Combo_DataItem = new()
		&Combo_DataItem.ID = rotaCodigo.ToString().Trim()
		&Combo_DataItem.Title = rotaDescricao
		&rotaCodigo_Data.Add(&Combo_DataItem)
	EndFor
	Combo_rotaCodigo.SelectedValue_set = &rotaCodigo.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboDataEnvio'

	&DataEnvio.SetEmpty()
	&DataEnvio_Data.Clear()
	For each trnsdistribuicao
		Order (distDataEnvio)
		Unique distDataEnvio
		Where prefCodigo = &prefCodigo
		Where distRotaCodigo in &rotaCodigo
		Where distCodigoTipoRemessa = &distCodigoTipoRemessa
		Where distStatus = Status.Ativo

		&Combo_DataItem = new()
		&Combo_DataItem.ID = distDataEnvio.ToString()
		&Combo_DataItem.Title = distDataEnvio.ToString()
		&DataEnvio_Data.Add(&Combo_DataItem)
	Endfor

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//&DataEnvio initial value has to be loaded manually at the beginning of this Subrutine
	//&DataEnvio_Data has to be loaded manually at the beginning of this Subrutine
	Combo_DataEnvio.SelectedValue_set = iif(&DataEnvio.IsEmpty(), '', &DataEnvio.ToString().Trim())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadCombodistCodigoTipoRemessa'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	//&distCodigoTipoRemessa initial value has to be loaded manually at the beginning of this Subrutine
	For Each
		Order disTipDescricao
		Where prefCodigo = &prefCodigo and disTipStatus = Status.Ativo
		&Combo_DataItem = new()
		&Combo_DataItem.ID = disTipNumero.ToString().Trim()
		&Combo_DataItem.Title = disTipDescricao
		&distCodigoTipoRemessa_Data.Add(&Combo_DataItem)
	EndFor
	Combo_distCodigoTipoRemessa.SelectedValue_set = iif(&distCodigoTipoRemessa.IsEmpty(), '', &distCodigoTipoRemessa.ToString().Trim())

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Event Enter

	// do 'CheckRequiredFields'
	// if &CheckRequiredFieldsResult
		&Arquivo = format(!'PublicTempStorage\Largadas-%1.xlsx',GUID.NewGuid())
		&IsSucess = LargadaGeraExcelRemessa(&prefCodigo,&distRemCodigo,&rotaCodigo.ToJson(),&Mensal,&DataEnvio,&distCodigoTipoRemessa,&Arquivo,&Message)
		// &IsSucess = LargadaGeraExcel(&prefCodigo,&distRemCodigo,&Arquivo,&Message)
		if not &IsSucess
			msg( DVMessageGetBasicNotificationMsg('Erro!',&Message.Description,DVMessageType.error,"",true,"","") )
		else
			&Url = &HttpRequest.BaseUrl + &Arquivo
			Link(&Url)
		endif

    // endif

EndEvent


Sub 'CheckRequiredFields'

EndSub

