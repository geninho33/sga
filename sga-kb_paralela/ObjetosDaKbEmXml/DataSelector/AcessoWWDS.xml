  <Part type="a2bc65a1-999f-4e9b-b837-72285cc9bb16">
    <Level>
      <Condition>
        <Source><![CDATA[(Acesso_Numero.ToString() like !'%' + &FilterFullText) OR (Acesso_Nome.ToLower() like !'%' + &FilterFullText.ToLower()) OR (Acesso_IP.ToLower() like !'%' + &FilterFullText.ToLower()) OR ("órgão central" like !'%' + &FilterFullText.ToLower() AND Acesso_Modulo = 1) OR ("unidade escolar" like !'%' + &FilterFullText.ToLower() AND Acesso_Modulo = 2) OR ("outros" like !'%' + &FilterFullText.ToLower() AND Acesso_Modulo = 9) When not &FilterFullText.IsEmpty()
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[prefCodigo = &PrefCodigo1 when &DynamicFiltersSelector1 = !'PREFCODIGO' AND &DynamicFiltersOperator1 = 0 AND (not &PrefCodigo1.IsEmpty())
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Nome.ToLower() like '%' +  &Acesso_Nome1.ToLower() when &DynamicFiltersSelector1 = !'ACESSO_NOME' AND &DynamicFiltersOperator1 = 0 AND (not &Acesso_Nome1.IsEmpty())
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[prefCodigo = &PrefCodigo2 when &DynamicFiltersEnabled2 AND &DynamicFiltersSelector2 = !'PREFCODIGO' AND &DynamicFiltersOperator2 = 0 AND (not &PrefCodigo2.IsEmpty())
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Nome.ToLower() like '%' +  &Acesso_Nome2.ToLower() when &DynamicFiltersEnabled2 AND &DynamicFiltersSelector2 = !'ACESSO_NOME' AND &DynamicFiltersOperator2 = 0 AND (not &Acesso_Nome2.IsEmpty())
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[prefCodigo = &PrefCodigo3 when &DynamicFiltersEnabled3 AND &DynamicFiltersSelector3 = !'PREFCODIGO' AND &DynamicFiltersOperator3 = 0 AND (not &PrefCodigo3.IsEmpty())
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Nome.ToLower() like '%' +  &Acesso_Nome3.ToLower() when &DynamicFiltersEnabled3 AND &DynamicFiltersSelector3 = !'ACESSO_NOME' AND &DynamicFiltersOperator3 = 0 AND (not &Acesso_Nome3.IsEmpty())
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Numero >= &TFAcesso_Numero when not &TFAcesso_Numero.IsEmpty()
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Numero <= &TFAcesso_Numero_To when not &TFAcesso_Numero_To.IsEmpty()
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Nome.ToLower() like &TFAcesso_Nome.ToLower() when &TFAcesso_Nome_Sel.IsEmpty() AND (not &TFAcesso_Nome.IsEmpty())
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Nome = &TFAcesso_Nome_Sel when not &TFAcesso_Nome_Sel.IsEmpty()
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_DataHora >= &TFAcesso_DataHora when not &TFAcesso_DataHora.IsEmpty()
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_DataHora <= &TFAcesso_DataHora_To when not &TFAcesso_DataHora_To.IsEmpty()
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_IP.ToLower() like &TFAcesso_IP.ToLower() when &TFAcesso_IP_Sel.IsEmpty() AND (not &TFAcesso_IP.IsEmpty())
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_IP = &TFAcesso_IP_Sel when not &TFAcesso_IP_Sel.IsEmpty()
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Modulo in &TFAcesso_Modulo_Sels when &TFAcesso_Modulo_Sels.Count > 0
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Saida >= &TFAcesso_Saida when not &TFAcesso_Saida.IsEmpty()
]]></Source>
      </Condition>
      <Condition>
        <Source><![CDATA[Acesso_Saida <= &TFAcesso_Saida_To when not &TFAcesso_Saida_To.IsEmpty()
]]></Source>
      </Condition>
