	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_FORNOME'
		Do 'LoadforNomeOptions'
	Case &DDOName.ToUpper() = !'DDO_NOTANUMERO'
		Do 'LoadnotaNumeroOptions'
	Case &DDOName.ToUpper() = !'DDO_NOTASERIE'
		Do 'LoadnotaSerieOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"RomaneioWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"RomaneioWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"RomaneioWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFROMANCODIGO"
				&TFromanCodigo.FromString(&GridStateFilterValue.Value)
				&TFromanCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFROMANDATA"
				&TFromanData.FromString(&GridStateFilterValue.Value)
				&TFromanData_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFFORNOME"
				&TFforNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFFORNOME_SEL"
				&TFforNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTANUMERO"
				&TFnotaNumero.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTANUMERO_SEL"
				&TFnotaNumero_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTASERIE"
				&TFnotaSerie.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTASERIE_SEL"
				&TFnotaSerie_Sel.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'ROMANDATA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&romanData1.FromString(&GridStateDynamicFilter.Value)
				&romanData_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'FORNOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&forNome1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'NOTANUMERO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&notaNumero1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'ROMANDATA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&romanData2.FromString(&GridStateDynamicFilter.Value)
					&romanData_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'FORNOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&forNome2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'NOTANUMERO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&notaNumero2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'ROMANDATA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&romanData3.FromString(&GridStateDynamicFilter.Value)
						&romanData_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'FORNOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&forNome3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'NOTANUMERO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&notaNumero3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadforNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFforNome = &SearchTxt
	&TFforNome_Sel.SetEmpty()
	For Each Romaneio
		Order prefCodigo, forCodigo
		using RomaneioWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &romanData1, &romanData_To1, &forNome1, &notaNumero1
					, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &romanData2, &romanData_To2, &forNome2
					, &notaNumero2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &romanData3, &romanData_To3
					, &forNome3, &notaNumero3, &TFromanCodigo, &TFromanCodigo_To, &TFromanData, &TFromanData_To
					, &TFforNome, &TFforNome_Sel, &TFnotaNumero, &TFnotaNumero_Sel, &TFnotaSerie, &TFnotaSerie_Sel)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each Romaneio
			Order prefCodigo, forCodigo
			&count += 1
		EndFor
		If not forNome.IsEmpty()
			&Option = forNome
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &Options.Item(&InsertIndex) < &Option
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadnotaNumeroOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFnotaNumero = &SearchTxt
	&TFnotaNumero_Sel.SetEmpty()
	For Each Romaneio
		Order prefCodigo, notaCodigo
		using RomaneioWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &romanData1, &romanData_To1, &forNome1, &notaNumero1
					, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &romanData2, &romanData_To2, &forNome2
					, &notaNumero2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &romanData3, &romanData_To3
					, &forNome3, &notaNumero3, &TFromanCodigo, &TFromanCodigo_To, &TFromanData, &TFromanData_To
					, &TFforNome, &TFforNome_Sel, &TFnotaNumero, &TFnotaNumero_Sel, &TFnotaSerie, &TFnotaSerie_Sel)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each Romaneio
			Order prefCodigo, notaCodigo
			&count += 1
		EndFor
		If not notaNumero.IsEmpty()
			&Option = notaNumero
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &Options.Item(&InsertIndex) < &Option
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadnotaSerieOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFnotaSerie = &SearchTxt
	&TFnotaSerie_Sel.SetEmpty()
	For Each Romaneio
		Order notaSerie
		using RomaneioWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &romanData1, &romanData_To1, &forNome1, &notaNumero1
					, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &romanData2, &romanData_To2, &forNome2
					, &notaNumero2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &romanData3, &romanData_To3
					, &forNome3, &notaNumero3, &TFromanCodigo, &TFromanCodigo_To, &TFromanData, &TFromanData_To
					, &TFforNome, &TFforNome_Sel, &TFnotaNumero, &TFnotaNumero_Sel, &TFnotaSerie, &TFnotaSerie_Sel)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each Romaneio
			Order notaSerie
			&count += 1
		EndFor
		If not notaSerie.IsEmpty()
			&Option = notaSerie
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

