  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[/*

SDT DVExtUC_SDTSidebarMenuOptionsData's Item has an "authorizationKey" property.
Possible values:
 - If it is empty, the item will be checked automatically based on its url
 - If it has the "public" value, the item will be authorized.
 - If it has aNother value, it will be used as the authorization key.
*/

//resolve access for this item
Do Case
		//Public
	Case &DVelop_Menu_Item.authorizationKey.ToLower() = !"public"
		&IsAuthorized = true
	Case Not &DVelop_Menu_Item.authorizationKey.IsEmpty()
		//Check with this key
		&IsAuthorized = SecIsAuthByFunctionalityKey(1)
	Otherwise
		//Check by url
		&Url = &DVelop_Menu_Item.link
		If Not &Url.IsEmpty()
			do 'Get Authorization Key From Url'
		&IsAuthorized = true
		Else
			&IsAuthorized = True
		EndIf
EndCase

Sub 'Get Authorization Key From Url'
	&AuthorizationKey.SetEmpty()
	&UrlResourceNameWithExtension.setEmpty()
	&UrlResourceName.setEmpty()

	If Not &Url.IsEmpty()

		//remove base url string
		&i = &Url.LastIndexOf(!"/")
		If &i > 0
			&Url = &Url.Substring(&i+1,&Url.Trim().Length() - &i )
		else
			&Url = &Url.Trim()
		endIf

		If &Url.LastIndexOf("?") > 0 //Remove Parameters
			&Url = &Url.Substring(1, &Url.LastIndexOf("?") - 1)
		EndIf

		If &Url.IsMatch(".aspx")
			//C#
			&UrlResourceName = &Url.Replace(".aspx", "")
		Else
			//Java
			&i = &UrlResourceNameWithExtension.IndexOf(!".") //first .
			&j = &UrlResourceNameWithExtension.LastIndexOf(!".") //last .
			If &i = 0 and &j = 0
				&UrlResourceName = &UrlResourceNameWithExtension
			Else
				If &i <> &j
					&UrlObjectName = &UrlResourceNameWithExtension.Substring(&j + 1, &UrlResourceNameWithExtension.Length() - &j)
					&UrlResourceName = &UrlResourceNameWithExtension.Substring(&i + 1, &j-&i-1)
					&i = &UrlResourceName.IndexOf(!".") //first .
					If &i > 0
						&UrlResourceName = &UrlResourceName.Substring(&i + 1, &UrlResourceName.Length() + &i) + "."
					Endif
					&UrlResourceName = &UrlResourceName + &UrlObjectName
				Else
					//has module
					&UrlResourceName = &UrlResourceNameWithExtension.Substring(&i + 1, &UrlResourceNameWithExtension.Trim().Length() - &i)
				EndIf
			EndIf
		EndIf
		&AuthorizationKey = &UrlResourceName.Trim().ToLower()
	EndIf
EndSub
]]></Source>
