  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[for each
	where prefCodigo 		  = &prefCodigo 
	where remCodigo  		  = &remCodigo 
	where remLocal   		  = &remLocal
    where remAreEnsCodigo 	  = &remAreEnsCodigo
	where remAreEnsSequencial = &remAreEnsSequencial
	where remAreEnsTurno 	  = &remAreEnsTurno	
	      exit
		  /*
		  remNormal     += &remNormal
		  remColesterol += &remColesterol
		  remDiabetico  += &remDiabetico
		  remGluten     += &remGluten
		  remLactose    += &remLactose
		  */
when none
	new
	  prefCodigo    	  = &prefCodigo 
	  remCodigo    		  = &remCodigo 
      remAreEnsCodigo 	  = &remAreEnsCodigo
      remAreEnsSequencial = &remAreEnsSequencial
	  remAreEnsTurno	  = &remAreEnsTurno		  
	  remLocal      	  = &remLocal
	  remNormal     	  = &remNormal
	  remColesterol 	  = &remColesterol
	  remDiabetico  	  = &remDiabetico
	  remGluten           = &remGluten
	  remLactose    	  = &remLactose	
	Endnew  
endFor		  
]]></Source>
