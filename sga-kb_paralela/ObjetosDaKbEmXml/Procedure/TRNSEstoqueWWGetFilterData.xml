Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"TRNSEstoqueWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"TRNSEstoqueWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"TRNSEstoqueWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFESTOCODIGO"
				&TFestoCodigo.FromString(&GridStateFilterValue.Value)
				&TFestoCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFESTOALTERACAO"
				&TFestoAlteracao.FromString(&GridStateFilterValue.Value)
				&TFestoAlteracao_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFESTOPRODUTO"
				&TFestoProduto.FromString(&GridStateFilterValue.Value)
				&TFestoProduto_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFESTOPRODUTODESCRICAO"
				&TFestoProdutoDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFESTOPRODUTODESCRICAO_SEL"
				&TFestoProdutoDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFESTOUNIDADESIGLA"
				&TFestoUnidadeSigla.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFESTOUNIDADESIGLA_SEL"
				&TFestoUnidadeSigla_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFESTOSALDO"
				&TFestoSaldo.FromString(&GridStateFilterValue.Value)
				&TFestoSaldo_To.FromString(&GridStateFilterValue.ValueTo)
