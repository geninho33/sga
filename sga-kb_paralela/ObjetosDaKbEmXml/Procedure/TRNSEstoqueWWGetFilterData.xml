					Case &DynamicFiltersSelector3 = !'ESTOLOCAL'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&estoLocal3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

