				&TFestoQuantidade_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFESTOSALDOATUAL"
				&TFestoSaldoAtual.FromString(&GridStateFilterValue.Value)
				&TFestoSaldoAtual_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFESTOLANCAMENTO"
				&TFestoLancamento.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFESTOLANCAMENTO_SEL"
				&TFestoLancamento_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFESTOOBSERVACAO"
				&TFestoObservacao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFESTOOBSERVACAO_SEL"
				&TFestoObservacao_Sel.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'ESTOPRODUTO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&estoProduto1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'ESTOPRODUTODESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&estoProdutoDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'ESTOQUANTIDADE'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&estoQuantidade1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'ESTOCADASTRO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&estoCadastro1.FromString(&GridStateDynamicFilter.Value)
				&estoCadastro_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'ESTOTIPO'
				&estoTipo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'ESTOLOCAL'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&estoLocal1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'ESTOPRODUTO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&estoProduto2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'ESTOPRODUTODESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&estoProdutoDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'ESTOQUANTIDADE'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&estoQuantidade2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'ESTOCADASTRO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&estoCadastro2.FromString(&GridStateDynamicFilter.Value)
					&estoCadastro_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'ESTOTIPO'
					&estoTipo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'ESTOLOCAL'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&estoLocal2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'ESTOPRODUTO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&estoProduto3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'ESTOPRODUTODESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&estoProdutoDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'ESTOQUANTIDADE'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&estoQuantidade3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'ESTOCADASTRO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&estoCadastro3.FromString(&GridStateDynamicFilter.Value)
						&estoCadastro_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'ESTOTIPO'
