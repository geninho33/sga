<Object parentGuid="6736cf57-35cb-46a5-97f1-4f72e9d64670" user="DESKTOP-OQ270FR\Geninho" versionDate="0001-01-01T00:00:00.0000000" lastUpdate="2026-04-14T01:22:21.0000000Z" checksum="e35359c414d23cab464d75704e152b39" fullyQualifiedName="PRCDDuplicarRefeicao" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="14a2ec41-c8c0-472c-b986-49f54980dbbe" name="PRCDDuplicarRefeicao" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Duplicar Refeição" parent="Procedures" parentType="00000000-0000-0000-0000-000000000008">
  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call(&WWPContext)

For each
	where prefCodigo  = &prefCodigo
	where pratoCodigo = &pratoCodigo
	
		  &pratoDscricao 	   = '( Cópia ) ' + pratoDscricao
		  &pratoComFreezer     = pratoComFreezer
		  &pratoSemFreezer 	   = pratoSemFreezer
		  &pratoForno		   = pratoForno
		  &pratoModoDeFazer    = pratoModoDeFazer
		  &pratoRepeticao 	   = pratoRepeticao
		  &pratoCozinhaCentral = pratoCozinhaCentral
		  &pratoCodigoPai	   = pratoCodigoPai
		  &pratoCodigoPaiAtend = pratoCodigoPaiAtend
		  &pratoTipoRefeicao   = pratoTipoRefeicao
		  &pratoStatus 		   = pratoStatus
		  &pratoDataCad		   = pratoDataCad
		  &pratoDataAlt		   = pratoDataAlt		
		  &pratoCodigo2 	   = PRCDGerarNovoCodigo('prato')  	

		  new
			prefCodigo 		    = &prefCodigo
			pratoCodigo 		= &pratoCodigo2
		    pratoDscricao 		= &pratoDscricao
		    pratoComFreezer 	= &pratoComFreezer
		    pratoSemFreezer 	= &pratoSemFreezer
		    pratoForno 			= &pratoForno
		    pratoModoDeFazer 	= &pratoModoDeFazer
		    pratoRepeticao 		= &pratoRepeticao
		    pratoCozinhaCentral = &pratoCozinhaCentral
		    pratoCodigoPai 		= &pratoCodigoPai
		    pratoCodigoPaiAtend = &pratoCodigoPaiAtend
		    pratoTipoRefeicao 	= &pratoTipoRefeicao
		    pratoStatus 		= status.Ativo
		    pratoDataCad 		= serverNow()
		    pratoDataAlt 		= serverNow()
		  endNew

		  For each trnspratosingredientes
			where prefCodigo   = &prefCodigo
			where pratoCodigo  = &pratoCodigo	  
		
				&pratIngrProdCodigo 	   = pratIngrProdCodigo
				&AreEnsCodigo 			   = AreEnsCodigo
				&AreEnsSequencial 		   = AreEnsSequencial
				&carGruTurno			   = carGruTurno
				&pratIngrProdDescricaoItem = pratIngrProdDescricaoItem
				&pratIngrTipoRemessa 	   = pratIngrTipoRemessa
				&pratIngrQuantidade 	   = pratIngrQuantidade
	
				new
					prefCodigo 	     		  = &prefCodigo
					pratoCodigo      		  = &pratoCodigo2
					//  pratIngrProdCodigo 		  = &pratIngrProdCodigo
					AreEnsCodigo 			  = &AreEnsCodigo
					AreEnsSequencial 		  = &AreEnsSequencial
					carGruTurno 			  = &carGruTurno
					// pratIngrProdDescricaoItem = &pratIngrProdDescricaoItem
					// pratIngrTipoRemessa 	  = &pratIngrTipoRemessa
					pratIngrQuantidade 		  = &pratIngrQuantidade
					pratIngrStatus 			  = status.Ativo
					pratIngrDataCad			  = serverNow()
					pratIngrDataAlt 		  = serverNow()
				endNew
		  EndFor
	msg('Duplicação realizada com sucesso !')
EndFor
]]></Source>
