	Where Bercario2_8183_Escola  = &Escola

	&Bercario2 += Bercario2_8183_Bercario_II
xEndfor

&Creche = 0
xFor each "Creche_8183"
	Where Creche_8183_Ano 	  = &Ano
	Where Creche_8183_Escola  = &Escola

	&Creche += Creche_8183_Creche
xEndfor

&Emeb = 0
xFor each "EMEB_8183"
	Where EMEB_8183_Ano   	= &Ano
	Where EMEB_8183_Escola  = &Escola

	&Emeb += EMEB_8183_EMEB
xEndfor

&Integral = 0
xFor each "Integral_8183"
	Where Integral_8183_Ano   	= &Ano
	Where Integral_8183_Escola  = &Escola
	
	&Integral += Integral_8183_Integral
xEndfor

&Funcionarios = 0
xFor each "Servidores_8183"
	Where Servidores_8183_Escola = &Escola
	
	&Funcionarios = Servidores_8183_Total
xEndfor
]]></Source>
