  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call(&WWPContext) 
&prefCodigo = &WWPContext.prefCodigo

&estoSaldo = 0 
&estoProduto = 0
msg('Processamento Iniciado !')

for each 		
	order prefCodigo, estoProduto, estoAlteracao
	where prefCodigo = &prefCodigo		
		  if estoProduto <> &estoProduto and &estoProduto<>0
		 	 &estoSaldo = 0 
			 PRCDAtualizarSaldo(&prefCodigo,&estoCodigo)
		  endif
	  
		  estoSaldo =  &estoSaldo 
		  if estoTipo = 'E'					
			 &estoSaldo = &estoSaldo + estoQuantidade
		  else 
			 if estoTipo = 'S'					
			    &estoSaldo = &estoSaldo - estoQuantidade 
			 else
				&ajusCodigo = estoAjusCodigo	
				&estoQuantidade = estoQuantidade
				for each trnsajuste
					where ajusCodigo = &ajusCodigo 
					where prefCodigo = &prefCodigo		
						  if tipajuAcao = 'S'
						 	 &estoSaldo = &estoSaldo - &estoQuantidade
						  else
						  	 &estoSaldo = &estoSaldo - &estoQuantidade	
						  endif   
				endFor	
			 endif			  
		  endif	 
		  &estoProduto = estoProduto			  
		  &estoCodigo  = estoCodigo			  
endFor

msg('Processamento Encerrado !')
]]></Source>
