    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_CROLOCCODIGO'
		Do 'LoadcroLocCodigoOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnscronogramalocalWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnscronogramalocalWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnscronogramalocalWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFCROLOCCODIGO"
				&TFcroLocCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCROLOCCODIGO_SEL"
				&TFcroLocCodigo_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCRODIA_SEL"
				&TFcroDia_SelsJson = &GridStateFilterValue.Value
				&TFcroDia_Sels.FromJson(&TFcroDia_SelsJson)
			Case &GridStateFilterValue.Name = !"TFCROHORA"
				&TFcroHora.FromString(&GridStateFilterValue.Value)
				&TFcroHora_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCROPRODSALDO"
				&TFcroProdSaldo.FromString(&GridStateFilterValue.Value)
				&TFcroProdSaldo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCROPRODQTDEFIXO"
				&TFcroProdQtdeFixo.FromString(&GridStateFilterValue.Value)
				&TFcroProdQtdeFixo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCROPREVIAENVIO"
				&TFcroPreviaEnvio.FromString(&GridStateFilterValue.Value)
				&TFcroPreviaEnvio_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCROLOCQTDE"
				&TFcroLocQtde.FromString(&GridStateFilterValue.Value)
				&TFcroLocQtde_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&CROCODIGO"
				&croCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'CROROTACODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&croRotaCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CRODIA'
				&croDia1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CROHORA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&croHora1.FromString(&GridStateDynamicFilter.Value)
				&croHora_To1.FromString(&GridStateDynamicFilter.ValueTo)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'CROROTACODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&croRotaCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CRODIA'
					&croDia2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CROHORA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&croHora2.FromString(&GridStateDynamicFilter.Value)
					&croHora_To2.FromString(&GridStateDynamicFilter.ValueTo)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'CROROTACODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&croRotaCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CRODIA'
						&croDia3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CROHORA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&croHora3.FromString(&GridStateDynamicFilter.Value)
						&croHora_To3.FromString(&GridStateDynamicFilter.ValueTo)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadcroLocCodigoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFcroLocCodigo = &SearchTxt
	&TFcroLocCodigo_Sel.SetEmpty()
	For Each trnscronogramalocal
		Order prefCodigo, croCodigo, croLocCodigo
		using trnscronogramalocalWWDS(&prefCodigo, &croCodigo, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &croRotaCodigo1, &croDia1
					, &croHora1, &croHora_To1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &croRotaCodigo2
					, &croDia2, &croHora2, &croHora_To2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &croRotaCodigo3, &croDia3, &croHora3, &croHora_To3, &TFcroLocCodigo, &TFcroLocCodigo_Sel
					, &TFcroDia_Sels, &TFcroHora, &TFcroHora_To, &TFcroProdSaldo, &TFcroProdSaldo_To, &TFcroProdQtdeFixo
					, &TFcroProdQtdeFixo_To, &TFcroPreviaEnvio, &TFcroPreviaEnvio_To, &TFcroLocQtde, &TFcroLocQtde_To)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnscronogramalocal
			Order prefCodigo, croCodigo, croLocCodigo
			&count += 1
		EndFor
		If not locDescricao.IsEmpty()
			&Option = croLocCodigo.ToString()
			&OptionDesc = locDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

