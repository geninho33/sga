	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_REMAREENSCODIGO'
		Do 'LoadremAreEnsCodigoOptions'
	Case &DDOName.ToUpper() = !'DDO_REMAREENSSEQUENCIAL'
		Do 'LoadremAreEnsSequencialOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsremessaatendimentoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsremessaatendimentoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsremessaatendimentoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFREMAREENSCODIGO"
				&TFremAreEnsCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMAREENSCODIGO_SEL"
				&TFremAreEnsCodigo_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMAREENSSEQUENCIAL"
				&TFremAreEnsSequencial.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMAREENSSEQUENCIAL_SEL"
				&TFremAreEnsSequencial_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMAREENSTURNO_SEL"
				&TFremAreEnsTurno_SelsJson = &GridStateFilterValue.Value
				&TFremAreEnsTurno_Sels.FromJson(&TFremAreEnsTurno_SelsJson)
			Case &GridStateFilterValue.Name = !"TFREMNORMAL"
				&TFremNormal.FromString(&GridStateFilterValue.Value)
				&TFremNormal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREMCOLESTEROL"
				&TFremColesterol.FromString(&GridStateFilterValue.Value)
				&TFremColesterol_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREMDIABETICO"
				&TFremDiabetico.FromString(&GridStateFilterValue.Value)
				&TFremDiabetico_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREMGLUTEN"
				&TFremGluten.FromString(&GridStateFilterValue.Value)
				&TFremGluten_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREMLACTOSE"
				&TFremLactose.FromString(&GridStateFilterValue.Value)
				&TFremLactose_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&REMCODIGO"
				&remCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'REMLOCALDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&remLocalDescricao1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'REMLOCALDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&remLocalDescricao2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'REMLOCALDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&remLocalDescricao3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadremAreEnsCodigoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFremAreEnsCodigo = &SearchTxt
	&TFremAreEnsCodigo_Sel.SetEmpty()
	For Each trnsremessaatendimento
		Order prefCodigo, remCodigo, remLocalDescricao, remAreEnsCodigo
		using trnsremessaatendimentoWWDS(&prefCodigo, &remCodigo, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &remLocalDescricao1, &DynamicFiltersEnabled2
					, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &remLocalDescricao2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &remLocalDescricao3, &TFremAreEnsCodigo, &TFremAreEnsCodigo_Sel, &TFremAreEnsSequencial, &TFremAreEnsSequencial_Sel, &TFremAreEnsTurno_Sels
					, &TFremNormal, &TFremNormal_To, &TFremColesterol, &TFremColesterol_To, &TFremDiabetico, &TFremDiabetico_To
					, &TFremGluten, &TFremGluten_To, &TFremLactose, &TFremLactose_To)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsremessaatendimento
			Order prefCodigo, remCodigo, remLocalDescricao, remAreEnsCodigo
			&count += 1
		EndFor
		If not AreEnsNome.IsEmpty()
			&Option = remAreEnsCodigo.ToString()
			&OptionDesc = AreEnsNome
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadremAreEnsSequencialOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFremAreEnsSequencial = &SearchTxt
	&TFremAreEnsSequencial_Sel.SetEmpty()
	For Each trnsremessaatendimento
