	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_TIPAJUCODIGO'
		Do 'LoadtipajuCodigoOptions'
	Case &DDOName.ToUpper() = !'DDO_AJUSLOCACODIGO'
		Do 'LoadajusLocaCodigoOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsajusteWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsajusteWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsajusteWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFAJUSCODIGO"
				&TFajusCodigo.FromString(&GridStateFilterValue.Value)
				&TFajusCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFAJUSDATA"
				&TFajusData.FromString(&GridStateFilterValue.Value)
				&TFajusData_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFTIPAJUCODIGO"
				&TFtipajuCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFTIPAJUCODIGO_SEL"
				&TFtipajuCodigo_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFTIPAJUACAO_SEL"
				&TFtipajuAcao_SelsJson = &GridStateFilterValue.Value
				&TFtipajuAcao_Sels.FromJson(&TFtipajuAcao_SelsJson)
			Case &GridStateFilterValue.Name = !"TFAJUSLOCACODIGO"
				&TFajusLocaCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAJUSLOCACODIGO_SEL"
				&TFajusLocaCodigo_Sel.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'TIPAJUNOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&tipajuNome1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'AJUSLOCADESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&ajusLocaDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'AJUSCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&ajusCodigo1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'TIPAJUNOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&tipajuNome2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'AJUSLOCADESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&ajusLocaDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'AJUSCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&ajusCodigo2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'TIPAJUNOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&tipajuNome3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'AJUSLOCADESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&ajusLocaDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'AJUSCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&ajusCodigo3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadtipajuCodigoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFtipajuCodigo = &SearchTxt
	&TFtipajuCodigo_Sel.SetEmpty()
	For Each trnsajuste
		Order tipajuCodigo, prefCodigo
		using trnsajusteWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &tipajuNome1, &ajusLocaDescricao1, &ajusCodigo1, &DynamicFiltersEnabled2
					, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &tipajuNome2, &ajusLocaDescricao2, &ajusCodigo2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &tipajuNome3, &ajusLocaDescricao3, &ajusCodigo3, &TFajusCodigo
					, &TFajusCodigo_To, &TFajusData, &TFajusData_To, &TFtipajuCodigo, &TFtipajuCodigo_Sel, &TFtipajuAcao_Sels
					, &TFajusLocaCodigo, &TFajusLocaCodigo_Sel)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsajuste
			Order tipajuCodigo, prefCodigo
			&count += 1
		EndFor
		If not tipajuNome.IsEmpty()
			&Option = tipajuCodigo.ToString()
			&OptionDesc = tipajuNome
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadajusLocaCodigoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFajusLocaCodigo = &SearchTxt
	&TFajusLocaCodigo_Sel.SetEmpty()
	For Each trnsajuste
		Order ajusLocaCodigo
		using trnsajusteWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &tipajuNome1, &ajusLocaDescricao1, &ajusCodigo1, &DynamicFiltersEnabled2
					, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &tipajuNome2, &ajusLocaDescricao2, &ajusCodigo2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &tipajuNome3, &ajusLocaDescricao3, &ajusCodigo3, &TFajusCodigo
					, &TFajusCodigo_To, &TFajusData, &TFajusData_To, &TFtipajuCodigo, &TFtipajuCodigo_Sel, &TFtipajuAcao_Sels
					, &TFajusLocaCodigo, &TFajusLocaCodigo_Sel)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsajuste
			Order ajusLocaCodigo
			&count += 1
		EndFor
		If not locDescricao.IsEmpty()
			&Option = ajusLocaCodigo.ToString()
			&OptionDesc = locDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

