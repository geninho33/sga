  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
if &Vincular
	do 'Vincular'
else
	do 'Desvincular'
endif


Sub 'Vincular'
	&IsSucess = true
	For each Romaneio
		Where prefCodigo = &prefCodigo
		Where romanCodigo in &romanCodigoCollection

		notaCodigo = &notaCodigo
	When none
		&IsSucess = false
		&Message.Type = MessageTypes.Warning
		&Message.Description = 'Nenhum Romaneio foi localizado. Processo não executado.'
	EndFor
EndSub

Sub 'Desvincular'
	&IsSucess = true
	For each Romaneio
		Where prefCodigo = &prefCodigo
		Where romanCodigo in &romanCodigoCollection

		For each Romaneio.Item
			&notaItemProduto = prodCodigo
			&notaItemQtde	 = romanItemQuantidade
			// do 'RemoveQtde'

			if not &IsSucess
				Exit
			endif
//		When none
//			&IsSucess = false
//			&Message.Type = MessageTypes.Warning
//			&Message.Description = 'Itens do Romaneio não foram localizados. Processo cancelado.'
		Endfor

		if not &IsSucess
			Exit
		endif

		notaCodigo.SetNull()
	When none
		&IsSucess = false
		&Message.Type = MessageTypes.Warning
		&Message.Description = 'Nenhum Romaneio foi localizado. Processo não executado.'
	EndFor
EndSub

Sub 'RemoveQtde'
	For each trnsnotaitens
		Where prefCodigo = &prefCodigo
		Where notaCodigo = &notaCodigo
		Where notaItemProduto = &notaItemProduto

		if notaItemQtde > &notaItemQtde
			notaItemQtde -= &notaItemQtde
		else
			Delete
		endif
//	When none
//		&IsSucess = false
//		&Message.Type = MessageTypes.Error
//		&Message.Description = format('Produto %1 da Nota %2 não foi localizado. Processo cancelado.',&notaItemProduto.ToString(),&notaCodigo)
	Endfor
EndSub
]]></Source>
