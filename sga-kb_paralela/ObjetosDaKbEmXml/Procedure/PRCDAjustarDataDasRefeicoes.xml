  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&temRefeicao = false

For Each trnscardapioprato
	where prefCodigo   = &prefCodigo
	Where carDapCodigo = &carDapCodigo		
		  if carPratoData.Month() <> &carDapMesAno.Month() or carPratoData.Year()<>&carDapMesAno.Year()  
			 &temRefeicao = True
			 exit
		  endif	  
EndFor

If &temRefeicao		
	
	&ultimaData = Ctod('01/01/1973')
	&ultimaGeracao = Ctod('01/01/1973')
	
	For Each trnscardapioprato
		Order carDapCodigo, carPratoData
		where prefCodigo   = &prefCodigo
		Where carDapCodigo = &carDapCodigo

			// log.Info('prefCodigo : ' + &prefCodigo.ToString() 
			// +' | carDapCodigo' + &carDapCodigo.ToString() + ' | CarDapMesAno ' 
			// + &carDapMesAno.ToString() +' | carPratoData : ' + carPratoData.ToString(), 'Teste4' )
		
			&datas = carPratoData.Day().ToString()+'/'+ &carDapMesAno.Month().ToString() + '/'+&carDapMesAno.Year().ToString()
			&dataGerada = CToD( &datas )
	
			If Dow( &dataGerada ) = 1
					&dataGerada = &dataGerada.AddDays( 1 )
			Else 
				if Dow( &dataGerada ) = 7						
					&dataGerada = &dataGerada.AddDays( 2 )
				EndIf				
			EndIf
		
		    //verifica a ultima geração
			if &dataGerada = &ultimaData and &ultimaData<>carPratoData
			   &dataGerada = &dataGerada.AddDays( 1 )
			   If Dow( &dataGerada ) = 7						
				  &dataGerada = &dataGerada.AddDays( 2 )
			   Else 
				  If Dow( &dataGerada ) = 1
				     &dataGerada = &dataGerada.AddDays( 1 )
				  EndIf							     		   
			   EndIf							   
			endif   			
		
			carPratoData = &dataGerada
		
		    if &ultimaData<>carPratoData
		       &ultimaGeracao = &dataGerada
			endif		
			&ultimaData = carPratoData
	EndFor
EndIf
]]></Source>
