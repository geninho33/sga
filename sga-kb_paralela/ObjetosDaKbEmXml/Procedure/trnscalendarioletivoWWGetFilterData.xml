Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnscalendarioletivoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnscalendarioletivoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnscalendarioletivoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFCALANO"
				&TFcalAno.FromString(&GridStateFilterValue.Value)
				&TFcalAno_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCALDATA"
				&TFcalData.FromString(&GridStateFilterValue.Value)
				&TFcalData_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCALDESCRICAO"
				&TFcalDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCALDESCRICAO_SEL"
				&TFcalDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCALDIAUTIL_SEL"
				&TFcalDiautil_SelsJson = &GridStateFilterValue.Value
				&TFcalDiautil_Sels.FromJson(&TFcalDiautil_SelsJson)
			Case &GridStateFilterValue.Name = !"TFCALFERIADO_SEL"
				&TFcalFeriado_SelsJson = &GridStateFilterValue.Value
				&TFcalFeriado_Sels.FromJson(&TFcalFeriado_SelsJson)
			Case &GridStateFilterValue.Name = !"TFCALSTATUS_SEL"
				&TFcalStatus_SelsJson = &GridStateFilterValue.Value
				&TFcalStatus_Sels.FromJson(&TFcalStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'CALDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&calDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CALDATA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&calData1.FromString(&GridStateDynamicFilter.Value)
				&calData_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'CALDIAUTIL'
				&calDiautil1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CALFERIADO'
				&calFeriado1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'CALDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&calDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CALDATA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&calData2.FromString(&GridStateDynamicFilter.Value)
					&calData_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'CALDIAUTIL'
					&calDiautil2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CALFERIADO'
					&calFeriado2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'CALDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&calDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CALDATA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&calData3.FromString(&GridStateDynamicFilter.Value)
						&calData_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'CALDIAUTIL'
						&calDiautil3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CALFERIADO'
						&calFeriado3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadcalDescricaoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFcalDescricao = &SearchTxt
	&TFcalDescricao_Sel.SetEmpty()
	For Each trnscalendarioletivo
		Order calDescricao
		using trnscalendarioletivoWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &calDescricao1, &calData1, &calData_To1, &calDiautil1
					, &calFeriado1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &calDescricao2, &calData2
					, &calData_To2, &calDiautil2, &calFeriado2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &calDescricao3, &calData3, &calData_To3, &calDiautil3, &calFeriado3, &TFcalAno
					, &TFcalAno_To, &TFcalData, &TFcalData_To, &TFcalDescricao, &TFcalDescricao_Sel, &TFcalDiautil_Sels
					, &TFcalFeriado_Sels, &TFcalStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnscalendarioletivo
			Order calDescricao
			&count += 1
		EndFor
		If not calDescricao.IsEmpty()
			&Option = calDescricao
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

