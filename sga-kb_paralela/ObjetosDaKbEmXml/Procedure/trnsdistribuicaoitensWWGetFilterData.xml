	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_DISTITEMPRODUTO'
		Do 'LoaddistItemProdutoOptions'
	Case &DDOName.ToUpper() = !'DDO_DISTITEMPRODUTOUN'
		Do 'LoaddistItemProdutoUNOptions'
	Case &DDOName.ToUpper() = !'DDO_DISTITEMPRODUTOUNPESO'
		Do 'LoaddistItemProdutoUNPesoOptions'
	Case &DDOName.ToUpper() = !'DDO_DISTITEMLOTE'
		Do 'LoaddistItemLoteOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsdistribuicaoitensWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsdistribuicaoitensWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsdistribuicaoitensWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFDISTITEMPRODUTO"
				&TFdistItemProduto.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTITEMPRODUTO_SEL"
				&TFdistItemProduto_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTITEMPRODUTOUN"
				&TFdistItemProdutoUN.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTITEMPRODUTOUN_SEL"
				&TFdistItemProdutoUN_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTITEMPRODUTOUNPESO"
				&TFdistItemProdutoUNPeso.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTITEMPRODUTOUNPESO_SEL"
				&TFdistItemProdutoUNPeso_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTITEMPRODUTOPESO"
				&TFdistItemProdutoPeso.FromString(&GridStateFilterValue.Value)
				&TFdistItemProdutoPeso_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFDISTITEMQUANTIDADE"
				&TFdistItemQuantidade.FromString(&GridStateFilterValue.Value)
				&TFdistItemQuantidade_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFDISTITEMVALIDADE"
				&TFdistItemValidade.FromString(&GridStateFilterValue.Value)
				&TFdistItemValidade_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFDISTITEMLOTE"
				&TFdistItemLote.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTITEMLOTE_SEL"
				&TFdistItemLote_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTITEMPRODUTOPESOTOTAL"
				&TFdistItemProdutoPesoTotal.FromString(&GridStateFilterValue.Value)
				&TFdistItemProdutoPesoTotal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&DISTCODIGO"
				&distCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoaddistItemProdutoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFdistItemProduto = &SearchTxt
	&TFdistItemProduto_Sel.SetEmpty()
	For Each trnsdistribuicaoitens
		using trnsdistribuicaoitensWWDS(&prefCodigo, &distCodigo, &TFdistItemProduto, &TFdistItemProduto_Sel, &TFdistItemProdutoUN, &TFdistItemProdutoUN_Sel
					, &TFdistItemProdutoUNPeso, &TFdistItemProdutoUNPeso_Sel, &TFdistItemProdutoPeso, &TFdistItemProdutoPeso_To, &TFdistItemQuantidade, &TFdistItemQuantidade_To
					, &TFdistItemValidade, &TFdistItemValidade_To, &TFdistItemLote, &TFdistItemLote_Sel, &TFdistItemProdutoPesoTotal, &TFdistItemProdutoPesoTotal_To)
		Where prefCodigo = &prefCodigo

		If not distItemProdutoDescricao.IsEmpty()
			&Option = distItemProduto.ToString()
			&OptionDesc = distItemProdutoDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			If (&InsertIndex = &Options.Count + 1) OR &OptionsDesc.Item(&InsertIndex) <> &OptionDesc
				&Options.Add(&Option, &InsertIndex)
				&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			EndIf
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoaddistItemProdutoUNOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFdistItemProdutoUN = &SearchTxt
	&TFdistItemProdutoUN_Sel.SetEmpty()
	For Each trnsdistribuicaoitens
		Order prefCodigo, distCodigo, distItemProdutoUN
