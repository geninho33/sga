	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_ALUNMATRICULA'
		Do 'LoadalunMatriculaOptions'
	Case &DDOName.ToUpper() = !'DDO_ALUNNOME'
		Do 'LoadalunNomeOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsalunoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsalunoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsalunoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFALUNMATRICULA"
				&TFalunMatricula.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFALUNMATRICULA_SEL"
				&TFalunMatricula_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFALUNNOME"
				&TFalunNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFALUNNOME_SEL"
				&TFalunNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFALUNNASCIMENTO"
				&TFalunNascimento.FromString(&GridStateFilterValue.Value)
				&TFalunNascimento_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFALUNSEXO_SEL"
				&TFalunSexo_SelsJson = &GridStateFilterValue.Value
				&TFalunSexo_Sels.FromJson(&TFalunSexo_SelsJson)
			Case &GridStateFilterValue.Name = !"TFALUNSTATUS_SEL"
				&TFalunStatus_SelsJson = &GridStateFilterValue.Value
				&TFalunStatus_Sels.FromJson(&TFalunStatus_SelsJson)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&ATENDIMENTOCODIGO"
				&AtendimentoCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'ALUNMATRICULA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&alunMatricula1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'ALUNNASCIMENTO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&alunNascimento1.FromString(&GridStateDynamicFilter.Value)
				&alunNascimento_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'ALUNNOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&alunNome1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'ALUNSEXO'
				&alunSexo1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'ALUNMATRICULA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&alunMatricula2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'ALUNNASCIMENTO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&alunNascimento2.FromString(&GridStateDynamicFilter.Value)
					&alunNascimento_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'ALUNNOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&alunNome2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'ALUNSEXO'
					&alunSexo2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'ALUNMATRICULA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&alunMatricula3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'ALUNNASCIMENTO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&alunNascimento3.FromString(&GridStateDynamicFilter.Value)
						&alunNascimento_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'ALUNNOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&alunNome3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'ALUNSEXO'
						&alunSexo3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadalunMatriculaOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFalunMatricula = &SearchTxt
	&TFalunMatricula_Sel.SetEmpty()
	For Each trnsaluno
		Order prefCodigo, AtendimentoCodigo, alunMatricula
		using trnsalunoWWDS(&prefCodigo, &AtendimentoCodigo, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &alunMatricula1, &alunNascimento1
					, &alunNascimento_To1, &alunNome1, &alunSexo1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2
					, &alunMatricula2, &alunNascimento2, &alunNascimento_To2, &alunNome2, &alunSexo2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &alunMatricula3, &alunNascimento3, &alunNascimento_To3, &alunNome3
					, &alunSexo3, &TFalunMatricula, &TFalunMatricula_Sel, &TFalunNome, &TFalunNome_Sel, &TFalunNascimento
					, &TFalunNascimento_To, &TFalunSexo_Sels, &TFalunStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsaluno
			Order prefCodigo, AtendimentoCodigo, alunMatricula
			&count += 1
		EndFor
		If not alunMatricula.IsEmpty()
			&Option = alunMatricula
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadalunNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFalunNome = &SearchTxt
	&TFalunNome_Sel.SetEmpty()
	For Each trnsaluno
		Order prefCodigo, AtendimentoCodigo, alunNome
		using trnsalunoWWDS(&prefCodigo, &AtendimentoCodigo, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &alunMatricula1, &alunNascimento1
					, &alunNascimento_To1, &alunNome1, &alunSexo1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2
					, &alunMatricula2, &alunNascimento2, &alunNascimento_To2, &alunNome2, &alunSexo2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &alunMatricula3, &alunNascimento3, &alunNascimento_To3, &alunNome3
					, &alunSexo3, &TFalunMatricula, &TFalunMatricula_Sel, &TFalunNome, &TFalunNome_Sel, &TFalunNascimento
					, &TFalunNascimento_To, &TFalunSexo_Sels, &TFalunStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsaluno
			Order prefCodigo, AtendimentoCodigo, alunNome
			&count += 1
		EndFor
		If not alunNome.IsEmpty()
			&Option = alunNome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

