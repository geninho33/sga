	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_FORCODIGO'
		Do 'LoadforCodigoOptions'
	Case &DDOName.ToUpper() = !'DDO_PRODCODIGO'
		Do 'LoadprodCodigoOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnscronogramaWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnscronogramaWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnscronogramaWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFCROCODIGO"
				&TFcroCodigo.FromString(&GridStateFilterValue.Value)
				&TFcroCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFFORCODIGO"
				&TFforCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFFORCODIGO_SEL"
				&TFforCodigo_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPRODCODIGO"
				&TFprodCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPRODCODIGO_SEL"
				&TFprodCodigo_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCROTOTAL"
				&TFcroTotal.FromString(&GridStateFilterValue.Value)
				&TFcroTotal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCRODTINICIAL"
				&TFcroDtInicial.FromString(&GridStateFilterValue.Value)
				&TFcroDtInicial_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCRODTFINAL"
				&TFcroDtFinal.FromString(&GridStateFilterValue.Value)
				&TFcroDtFinal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCROTIPOREMESSA"
				&TFcroTipoRemessa.FromString(&GridStateFilterValue.Value)
				&TFcroTipoRemessa_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCROREMESSA"
				&TFcroRemessa.FromString(&GridStateFilterValue.Value)
				&TFcroRemessa_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCROSTATUS_SEL"
				&TFcroStatus_SelsJson = &GridStateFilterValue.Value
				&TFcroStatus_Sels.FromJson(&TFcroStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'CROCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&croCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CRODTINICIAL'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&croDtInicial1.FromString(&GridStateDynamicFilter.Value)
				&croDtInicial_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'CRONUMERONOTA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&croNumeroNota1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PRODCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&prodCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CROTIPOREMESSA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&croTipoRemessa1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'CROCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&croCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CRODTINICIAL'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&croDtInicial2.FromString(&GridStateDynamicFilter.Value)
					&croDtInicial_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'CRONUMERONOTA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&croNumeroNota2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PRODCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&prodCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CROTIPOREMESSA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&croTipoRemessa2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'CROCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&croCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CRODTINICIAL'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&croDtInicial3.FromString(&GridStateDynamicFilter.Value)
						&croDtInicial_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'CRONUMERONOTA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&croNumeroNota3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PRODCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&prodCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CROTIPOREMESSA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&croTipoRemessa3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadforCodigoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFforCodigo = &SearchTxt
	&TFforCodigo_Sel.SetEmpty()
	For Each trnscronograma
		Order forCodigo
		using trnscronogramaWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &croCodigo1, &croDtInicial1, &croDtInicial_To1, &croNumeroNota1
					, &prodCodigo1, &croTipoRemessa1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &croCodigo2
					, &croDtInicial2, &croDtInicial_To2, &croNumeroNota2, &prodCodigo2, &croTipoRemessa2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &croCodigo3, &croDtInicial3, &croDtInicial_To3, &croNumeroNota3
					, &prodCodigo3, &croTipoRemessa3, &TFcroCodigo, &TFcroCodigo_To, &TFforCodigo, &TFforCodigo_Sel
					, &TFprodCodigo, &TFprodCodigo_Sel, &TFcroTotal, &TFcroTotal_To, &TFcroDtInicial, &TFcroDtInicial_To
					, &TFcroDtFinal, &TFcroDtFinal_To, &TFcroTipoRemessa, &TFcroTipoRemessa_To, &TFcroRemessa, &TFcroRemessa_To
					, &TFcroStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnscronograma
			Order forCodigo
			&count += 1
		EndFor
		If not forNome.IsEmpty()
			&Option = forCodigo.ToString()
			&OptionDesc = forNome
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadprodCodigoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFprodCodigo = &SearchTxt
	&TFprodCodigo_Sel.SetEmpty()
	For Each trnscronograma
		Order prodCodigo
		using trnscronogramaWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &croCodigo1, &croDtInicial1, &croDtInicial_To1, &croNumeroNota1
					, &prodCodigo1, &croTipoRemessa1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &croCodigo2
					, &croDtInicial2, &croDtInicial_To2, &croNumeroNota2, &prodCodigo2, &croTipoRemessa2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &croCodigo3, &croDtInicial3, &croDtInicial_To3, &croNumeroNota3
					, &prodCodigo3, &croTipoRemessa3, &TFcroCodigo, &TFcroCodigo_To, &TFforCodigo, &TFforCodigo_Sel
					, &TFprodCodigo, &TFprodCodigo_Sel, &TFcroTotal, &TFcroTotal_To, &TFcroDtInicial, &TFcroDtInicial_To
					, &TFcroDtFinal, &TFcroDtFinal_To, &TFcroTipoRemessa, &TFcroTipoRemessa_To, &TFcroRemessa, &TFcroRemessa_To
					, &TFcroStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnscronograma
			Order prodCodigo
			&count += 1
		EndFor
		If not prodDescricao.IsEmpty()
			&Option = prodCodigo.ToString()
			&OptionDesc = prodDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

