  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

LoadWWPContext.Call(&WWPContext)


&MaxItems = 100
Do Case
	Case &ComboName = !'croLocCodigo' //Generated by 'Auto DVelop Combo' (trnslocal)
		Do 'LoadComboItems_croLocCodigo'
EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadComboItems_croLocCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If &IsDynamicCall
		For Each trnslocal
			Order locDescricao
			Where prefCodigo = &Cond_prefCodigo
			Where locDescricao.ToLower() like !'%' + &SearchTxt.ToLower() When not &SearchTxt.IsEmpty()
			&Combo_DataItem = new()
			&Combo_DataItem.ID = locCodigo.ToString().Trim()
			&Combo_DataItem.Title = locDescricao
			&Combo_Data.Add(&Combo_DataItem)
			If &Combo_Data.Count > &MaxItems
				Exit
			EndIf
		EndFor
		&Combo_DataJson = &Combo_Data.ToJson()
	Else
		If &TrnMode <> TrnMode.Insert
			For Each trnscronogramalocal
				Where prefCodigo = &prefCodigo
				Where croCodigo = &croCodigo
				Where croLocCodigo = &croLocCodigo

				&SelectedValue = iif(croLocCodigo.IsEmpty(), '', croLocCodigo.ToString().Trim())
				&Cond_Aux_prefCodigo = prefCodigo
				&locCodigo = croLocCodigo
			EndFor
			For Each trnslocal
				Where locCodigo = &locCodigo
				Where prefCodigo = &Cond_Aux_prefCodigo
				&SelectedText = locDescricao
				Exit
			EndFor
		Else
			If Not &croLocCodigo.IsEmpty()
				&SelectedValue = &croLocCodigo.ToString().Trim()
				For Each trnslocal
					Where locCodigo = &croLocCodigo
					Where prefCodigo = &Cond_Aux_prefCodigo
					&SelectedText = locDescricao
					Exit
				EndFor
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

]]></Source>
