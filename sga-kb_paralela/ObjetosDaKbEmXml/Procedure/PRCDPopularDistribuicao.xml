<Object parentGuid="6736cf57-35cb-46a5-97f1-4f72e9d64670" user="DESKTOP-OQ270FR\Geninho" versionDate="2024-06-24T01:35:26.0000000Z" lastUpdate="2024-06-18T04:15:12.0000000Z" checksum="142bac6da1e8516019e655ec27f15d39" fullyQualifiedName="PRCDPopularDistribuicao" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="191cc600-b40d-47d4-adb5-8808b0d87816" name="PRCDPopularDistribuicao" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Populando a Distribuição de Alimentos para as Unidades" parent="Procedures" parentType="00000000-0000-0000-0000-000000000008">
  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call(&WWPContext)
&prefCodigo = &WWPContext.prefCodigo

// Log.Write(!"Write message", !"MyCompany.Test.TestLoggingWrite",LogLEvel.DEBUG)

&totalProdutos  = 0
&locCodigo2     = 0
&remItemPeriodo = &dataInicial.ToString() +  ' a ' + &dataFinal.ToString()
&carGru.Clear()


// Buscando a área de acordo com o atendimento
for each trnsremessaatendimento
	order prefCodigo,remCodigo,remLocal,remAreEnsCodigo,remAreEnsSequencial
	where prefCodigo  = &prefCodigo
	where remCodigo   = &remCodigo

	  // Log.Error(!"Error message",!"Remessa : " + &remCodigo.ToString() )
	  &AtendimentoNormalSegunda = remNormal
	  &AtendimentoNormalSegunda += remColesterol
	  &AtendimentoNormalSegunda += remDiabetico
	  &AtendimentoNormalSegunda += remGluten
	  &AtendimentoNormalSegunda += remLactose

	  if &AtendimentoNormalSegunda > 0
		  if remLocal<>&locCodigo2 or &locCodigo2 = 0
			 &distCodigo      = PRCDSalvarCabecalhoDistribuicao( &prefCodigo,&remCodigo,remLocal,&dataEnvio,&locCodigo,&disTipNumero,&dataInicial,&dataFinal,'')
			 &totalProdutos  += 1
		  endif

		  // buscando o prato
		  for each trnscardapio, trnscardapioprato
			  order prefCodigo, carDapCodigo, carPratoData
			  where prefCodigo   = &prefCodigo
			  where carPratoData >= &dataInicial and carPratoData <= &dataFinal
			  where carDapStatus = 'A'
	  		  where carDapGruCodigo<>0
			        &codigoGrupo =  PRCDBuscarGrupo(&prefCodigo, remLocal, remAreEnsCodigo, remAreEnsSequencial, carDapCodigo)
					if &codigoGrupo > 0						
						&carPratoRefeicao = carPratoRefeicao
						//Log.Error(!"Error message",!"Cardapio tem grupo : " + carDapCodigo.ToString() )
						&carGru.Add( PRCDBuscarGrupo(&prefCodigo, remLocal, remAreEnsCodigo, remAreEnsSequencial, carDapCodigo) )

						// buscando os ingredientes
						for each trnspratosingredientes
							order prefCodigo, pratoCodigo, AreEnsCodigo, AreEnsSequencial
							where prefCodigo          = &prefCodigo
							where AreEnsCodigo        = remAreEnsCodigo
							where AreEnsSequencial    = remAreEnsSequencial when remAreEnsSequencial<>0
							where pratoCodigo         = &carPratoRefeicao
							where pratIngrQuantidade  > 0							
							where pratIngrTipoRemessa = &disTipNumero
							      &pratIngrQuantidade = pratIngrQuantidade
						 	      &pratIngrProdCodigo = pratIngrProdCodigo

								  // Log.Error(!"Error message",!"Ingrediente : " + pratIngrProdCodigo.ToString() + ' Distribuição : ' + &distCodigo.ToString() )
		
								  // Calculando as quantidades
								  PRCDSalvarRemessaAlimentos( &prefCodigo,
															  &remCodigo,
															  &pratIngrProdCodigo,
															  remAreEnsCodigo,
															  remAreEnsSequencial,
															  0,
															  &AtendimentoNormalSegunda,
															  &pratIngrQuantidade,
															  &distCodigo,
															  &dataInicial,
															  &dataFinal,
															  0)
						endfor
					endif
		  endfor
      endif
      &AtendimentoNormalSegunda = 0
      &locCodigo2  = remLocal
endfor

if &carGru.count = 0
   msg('Não tem cardápio gerado para este período em nenhum grupo!')
endif
]]></Source>
