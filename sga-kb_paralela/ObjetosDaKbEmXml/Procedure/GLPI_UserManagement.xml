    <Source><![CDATA[// ==========================================
// MÉTODO: SearchUser
// ==========================================
// Busca usuário pelo login (CPF/matrícula)
Sub 'SearchUser'
    // Declaração de variáveis
    &HttpClient = new()
    &SEARCH_URL = &GLPI_URL + "/search/User?criteria[0][field]=9&criteria[0][searchtype]=equals&criteria[0][value]=" + &USER_LOGIN
    &HTTP_METHOD = "GET"
    &HTTP_STATUS = "0"
    &HTTP_RESPONSE = ""
    &USER_ID = 0
    &SUCCESS = False
    &ERROR_MESSAGE = ""

    // Configurar headers
    &HttpClient.AddHeader("App-Token", &APP_TOKEN)
    &HttpClient.AddHeader("Session-Token", &SESSION_TOKEN)

    // Executar requisição
    &HttpClient.Execute(&HTTP_METHOD, &SEARCH_URL)

    // Obter status e resposta
    &HTTP_STATUS = &HttpClient.StatusCode
    &HTTP_RESPONSE = &HttpClient.ToString()

    If &HTTP_STATUS = 200
        &UserSearchResponse = new()
        &UserSearchResponse.FromJson(&HTTP_RESPONSE)

        If &UserSearchResponse.Count > 0
            &USER_ID = &UserSearchResponse.Item(1).CurrentItem.id
            &SUCCESS = True
            &ERROR_MESSAGE = ""
        Else
            &USER_ID = 0
            &SUCCESS = True
            &ERROR_MESSAGE = "Usuário não encontrado"
        EndIf
    Else
        &SUCCESS = False
        &ERROR_MESSAGE = "Erro HTTP: " + &HTTP_STATUS.ToString()
    EndIf
EndSub

// ==========================================
// MÉTODO: CreateUser
// ==========================================
// Cria novo usuário no GLPI
Sub 'CreateUser'
    // Declaração de variáveis
    &HttpClient = new()
    &HTTP_URL = &GLPI_URL + "/User"
    &HTTP_METHOD = "POST"
    &HTTP_STATUS = 0
    &HTTP_RESPONSE = ""
    &USER_ID = 0
    &SUCCESS = False
    &ERROR_MESSAGE = ""

    // Configurar headers
    &HttpClient.AddHeader("App-Token", &APP_TOKEN)
    &HttpClient.AddHeader("Session-Token", &SESSION_TOKEN)
    &HttpClient.AddHeader("Content-Type", "application/json")

    // Separar nome e sobrenome
    // &NAME_PARTS = &USER_NAME.SplitRegEx(" ")
    // &FIRST_NAME = &NAME_PARTS.Item(1)
    // &LAST_NAME = ""
    // For &I = 2 To &NAME_PARTS.Count()
    //     &LAST_NAME += &NAME_PARTS.Item(&I)
    //    If &I < &NAME_PARTS.Count()
    //        &LAST_NAME += " "
    //    EndIf
    // EndFor

    // Construir payload JSON com SDT
    &UserInput = new()
    &UserInput.CurrentItem.name = &USER_LOGIN
    &UserInput.CurrentItem.realname = &USER_NAME
    &UserInput.CurrentItem.firstname = &FIRST_NAME
    &UserInput.CurrentItem.email = &USER_EMAIL
    &UserInput.CurrentItem.entities_id = &ENTITY_ID
    &UserInput.CurrentItem.profiles_id = 2 // Self-Service

    // Wrap input em um objeto "input"
    &Payload = new()
    &Payload.Add( &UserInput )
    &HttpClient.AddString( &Payload.ToJson() )

    // Executar requisição
    &HttpClient.Execute(&HTTP_METHOD, &HTTP_URL)

    // Obter status e resposta
    &HTTP_STATUS = &HttpClient.StatusCode
    &HTTP_RESPONSE = &HttpClient.ToString()

    If &HTTP_STATUS = 201 // Created
        &UserResponse = new()
        &UserResponse.FromJson(&HTTP_RESPONSE)

        If &UserResponse.CurrentItem.id > 0
            &USER_ID = &UserResponse.CurrentItem.id
            &SUCCESS = True
            &ERROR_MESSAGE = ""
        Else
            &SUCCESS = False
            &ERROR_MESSAGE = "Erro ao processar resposta da API"
        EndIf
    Else
        &SUCCESS = False
        &ERROR_MESSAGE = "Erro HTTP: " + &HTTP_STATUS.ToString() + " - " + &HTTP_RESPONSE
    EndIf
EndSub

// ==========================================
// MÉTODO: GetUserInfo
// ==========================================
// Obtém informações detalhadas do usuário
Sub 'GetUserInfo'
    // Declaração de variáveis
    &HttpClient = new()
    &HTTP_URL = &GLPI_URL + "/User/" + &USER_ID.ToString()
    &HTTP_METHOD = "GET"
    &HTTP_STATUS = 0
    &HTTP_RESPONSE = ""
    &USER_INFO = ""
    &SUCCESS = False

    // Configurar headers
    &HttpClient.AddHeader("App-Token", &APP_TOKEN)
    &HttpClient.AddHeader("Session-Token", &SESSION_TOKEN)

    // Executar requisição
    &HttpClient.Execute(&HTTP_METHOD, &HTTP_URL)

    // Obter status e resposta
    &HTTP_STATUS = &HttpClient.StatusCode
    &HTTP_RESPONSE = &HttpClient.ToString()

    If &HTTP_STATUS = 200
        &USER_INFO = &HTTP_RESPONSE

        If &USER_INFO<>""
            &SUCCESS = True
        Else
            &SUCCESS = False
        EndIf
    Else
        &SUCCESS = False
    EndIf
EndSub
]]></Source>
