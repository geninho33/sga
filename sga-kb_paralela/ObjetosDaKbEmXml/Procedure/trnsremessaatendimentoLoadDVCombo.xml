    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

LoadWWPContext.Call(&WWPContext)


&MaxItems = 100
Do Case
	Case &ComboName = !'prefCodigo' //Generated by 'Auto DVelop Combo' (trnsprefeituras)
		Do 'LoadComboItems_prefCodigo'
	Case &ComboName = !'remCodigo' //Generated by 'Auto DVelop Combo' (trnsremessas)
		Do 'LoadComboItems_remCodigo'
	Case &ComboName = !'remLocal' //Generated by 'Auto DVelop Combo' (trnslocal)
		Do 'LoadComboItems_remLocal'
EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadComboItems_prefCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If &IsDynamicCall
		For Each trnsprefeituras
			Order prefNome
			Where prefNome.ToLower() like !'%' + &SearchTxt.ToLower() When not &SearchTxt.IsEmpty()
			&Combo_DataItem = new()
			&Combo_DataItem.ID = prefCodigo.ToString().Trim()
			&Combo_DataItem.Title = prefNome
			&Combo_Data.Add(&Combo_DataItem)
			If &Combo_Data.Count > &MaxItems
				Exit
			EndIf
		EndFor
		&Combo_DataJson = &Combo_Data.ToJson()
	Else
		If &TrnMode <> TrnMode.Insert
			For Each trnsremessaatendimento
				Where prefCodigo = &prefCodigo
				Where remCodigo = &remCodigo
				Where remLocal = &remLocal
				Where remAreEnsCodigo = &remAreEnsCodigo
				Where remAreEnsSequencial = &remAreEnsSequencial
				Where remAreEnsTurno = &remAreEnsTurno

				&SelectedValue = iif(prefCodigo.IsEmpty(), '', prefCodigo.ToString().Trim())
				&SelectedText = prefNome
			EndFor
		Else
			If Not &prefCodigo.IsEmpty()
				&SelectedValue = &prefCodigo.ToString().Trim()
				For Each trnsprefeituras
					Where prefCodigo = &prefCodigo
					&SelectedText = prefNome
					Exit
				EndFor
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboItems_remCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If &IsDynamicCall
		For Each trnsremessas
			Order remStatus
			Where prefCodigo = &Cond_prefCodigo
			&Combo_DataItem = new()
			&Combo_DataItem.ID = remCodigo.ToString().Trim()
			Do Case
				Case remStatus.ToString().Trim() = "A"
					&Combo_DataItem.Title = "Ativo"
			
				Case remStatus.ToString().Trim() = "I"
					&Combo_DataItem.Title = "Inativo"
			
			EndCase
			&Combo_Data.Add(&Combo_DataItem)
			If &Combo_Data.Count > &MaxItems
				Exit
			EndIf
		EndFor
		&Combo_DataJson = &Combo_Data.ToJson()
	Else
		If &TrnMode <> TrnMode.Insert
			For Each trnsremessaatendimento
				Where prefCodigo = &prefCodigo
				Where remCodigo = &remCodigo
				Where remLocal = &remLocal
				Where remAreEnsCodigo = &remAreEnsCodigo
				Where remAreEnsSequencial = &remAreEnsSequencial
				Where remAreEnsTurno = &remAreEnsTurno

				&SelectedValue = iif(remCodigo.IsEmpty(), '', remCodigo.ToString().Trim())
				Do Case
					Case remStatus.ToString().Trim() = "A"
						&SelectedText = "Ativo"
				
					Case remStatus.ToString().Trim() = "I"
						&SelectedText = "Inativo"
				
				EndCase
			EndFor
		Else
			If Not &remCodigo.IsEmpty()
				&SelectedValue = &remCodigo.ToString().Trim()
				For Each trnsremessas
					Where remCodigo = &remCodigo
					Where prefCodigo = &Cond_prefCodigo
					Do Case
						Case remStatus.ToString().Trim() = "A"
							&SelectedText = "Ativo"
					
						Case remStatus.ToString().Trim() = "I"
							&SelectedText = "Inativo"
					
					EndCase
					Exit
				EndFor
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboItems_remLocal'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If &IsDynamicCall
		For Each trnslocal
			Order locDescricao
			Where prefCodigo = &Cond_prefCodigo
			Where locDescricao.ToLower() like !'%' + &SearchTxt.ToLower() When not &SearchTxt.IsEmpty()
			&Combo_DataItem = new()
			&Combo_DataItem.ID = locCodigo.ToString().Trim()
			&Combo_DataItem.Title = locDescricao
			&Combo_Data.Add(&Combo_DataItem)
			If &Combo_Data.Count > &MaxItems
				Exit
			EndIf
		EndFor
		&Combo_DataJson = &Combo_Data.ToJson()
	Else
		If &TrnMode <> TrnMode.Insert
			For Each trnsremessaatendimento
				Where prefCodigo = &prefCodigo
				Where remCodigo = &remCodigo
				Where remLocal = &remLocal
				Where remAreEnsCodigo = &remAreEnsCodigo
				Where remAreEnsSequencial = &remAreEnsSequencial
				Where remAreEnsTurno = &remAreEnsTurno

				&SelectedValue = iif(remLocal.IsEmpty(), '', remLocal.ToString().Trim())
				&Cond_Aux_prefCodigo = prefCodigo
				&locCodigo = remLocal
			EndFor
			For Each trnslocal
				Where locCodigo = &locCodigo
				Where prefCodigo = &Cond_Aux_prefCodigo
				&SelectedText = locDescricao
				Exit
			EndFor
		Else
			If Not &remLocal.IsEmpty()
				&SelectedValue = &remLocal.ToString().Trim()
				For Each trnslocal
					Where locCodigo = &remLocal
					Where prefCodigo = &Cond_Aux_prefCodigo
					&SelectedText = locDescricao
					Exit
				EndFor
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

