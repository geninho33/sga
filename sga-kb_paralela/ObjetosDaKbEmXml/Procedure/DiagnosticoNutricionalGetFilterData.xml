    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_DIAG_NUTRICIONAL_ALUNONOME'
		Do 'Loaddiag_nutricional_AlunoNomeOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"DiagnosticoNutricionalGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"DiagnosticoNutricionalGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"DiagnosticoNutricionalGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"DIAG_NUTRICIONAL_ANO"
				&diag_nutricional_Ano.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"DIAG_NUTRICIONAL_ESCOLA"
				&diag_nutricional_Escola.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"DIAG_NUTRICIONAL_NUMCOLETA"
				&diag_nutricional_NumColeta.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDIAG_NUTRICIONAL_ALUNONOME"
				&TFdiag_nutricional_AlunoNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDIAG_NUTRICIONAL_ALUNONOME_SEL"
				&TFdiag_nutricional_AlunoNome_Sel.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'Loaddiag_nutricional_AlunoNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFdiag_nutricional_AlunoNome = &SearchTxt
	&TFdiag_nutricional_AlunoNome_Sel.SetEmpty()
	For Each viewDiagNutricional
		Order diag_nutricional_NomeEscola, diag_nutricional_AlunoNome
		using DiagnosticoNutricionalDS(&diag_nutricional_Ano, &diag_nutricional_Escola, &diag_nutricional_NumColeta, &TFdiag_nutricional_AlunoNome, &TFdiag_nutricional_AlunoNome_Sel)

		&count = 0
		For Each viewDiagNutricional
			Order diag_nutricional_NomeEscola, diag_nutricional_AlunoNome
			&count += 1
		EndFor
		If not diag_nutricional_AlunoNome.IsEmpty()
			&Option = diag_nutricional_AlunoNome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

