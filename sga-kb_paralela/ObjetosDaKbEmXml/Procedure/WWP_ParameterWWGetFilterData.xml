&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_WWPPARAMETERKEY'
		Do 'LoadWWPParameterKeyOptions'
	Case &DDOName.ToUpper() = !'DDO_WWPPARAMETERCATEGORY'
		Do 'LoadWWPParameterCategoryOptions'
	Case &DDOName.ToUpper() = !'DDO_WWPPARAMETERDESCRIPTION'
