Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"WorkWithPlus.WWP_ParameterWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"WorkWithPlus.WWP_ParameterWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"WorkWithPlus.WWP_ParameterWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"FILTERFULLTEXT"
				&FilterFullText.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFWWPPARAMETERKEY"
				&TFWWPParameterKey.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFWWPPARAMETERKEY_SEL"
				&TFWWPParameterKey_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFWWPPARAMETERCATEGORY"
				&TFWWPParameterCategory.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFWWPPARAMETERCATEGORY_SEL"
				&TFWWPParameterCategory_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFWWPPARAMETERDESCRIPTION"
				&TFWWPParameterDescription.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFWWPPARAMETERDESCRIPTION_SEL"
				&TFWWPParameterDescription_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFWWPPARAMETERVALUETRIMMED"
				&TFWWPParameterValueTrimmed.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFWWPPARAMETERVALUETRIMMED_SEL"
				&TFWWPParameterValueTrimmed_Sel.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadWWPParameterKeyOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFWWPParameterKey = &SearchTxt
	&TFWWPParameterKey_Sel.SetEmpty()
	For Each WWP_Parameter
		Order WWPParameterKey
		using WWP_ParameterWWDS(&FilterFullText, &TFWWPParameterKey, &TFWWPParameterKey_Sel, &TFWWPParameterCategory, &TFWWPParameterCategory_Sel, &TFWWPParameterDescription
					, &TFWWPParameterDescription_Sel, &TFWWPParameterValueTrimmed, &TFWWPParameterValueTrimmed_Sel)

		Option Distinct
