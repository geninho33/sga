    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_CARGRUDESCRICAO'
		Do 'LoadcarGruDescricaoOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnscardapiogrupoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnscardapiogrupoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnscardapiogrupoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFCARGRUCODIGO"
				&TFcarGruCodigo.FromString(&GridStateFilterValue.Value)
				&TFcarGruCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCARGRUDESCRICAO"
				&TFcarGruDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARGRUDESCRICAO_SEL"
				&TFcarGruDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARGRUCOZINHACENTRAL_SEL"
				&TFcarGruCozinhaCentral_SelsJson = &GridStateFilterValue.Value
				&TFcarGruCozinhaCentral_Sels.FromJson(&TFcarGruCozinhaCentral_SelsJson)
			Case &GridStateFilterValue.Name = !"TFCARGRUSTATUS_SEL"
				&TFcarGruStatus_SelsJson = &GridStateFilterValue.Value
				&TFcarGruStatus_Sels.FromJson(&TFcarGruStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'CARGRUCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carGruCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARGRUDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carGruDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARDAPDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carDapDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARGRUCOZINHACENTRAL'
				&carGruCozinhaCentral1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARGRUSTATUS'
				&carGruStatus1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'CARGRUCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carGruCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARGRUDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carGruDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARDAPDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carDapDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARGRUCOZINHACENTRAL'
					&carGruCozinhaCentral2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARGRUSTATUS'
					&carGruStatus2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'CARGRUCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carGruCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARGRUDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carGruDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARDAPDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carDapDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARGRUCOZINHACENTRAL'
						&carGruCozinhaCentral3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARGRUSTATUS'
						&carGruStatus3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadcarGruDescricaoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFcarGruDescricao = &SearchTxt
	&TFcarGruDescricao_Sel.SetEmpty()
	For Each trnscardapiogrupo
		Order carGruDescricao
		using trnscardapiogrupoWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &carGruCodigo1, &carGruDescricao1, &carDapDescricao1, &carGruCozinhaCentral1
					, &carGruStatus1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &carGruCodigo2, &carGruDescricao2
					, &carDapDescricao2, &carGruCozinhaCentral2, &carGruStatus2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &carGruCodigo3, &carGruDescricao3, &carDapDescricao3, &carGruCozinhaCentral3, &carGruStatus3, &TFcarGruCodigo
					, &TFcarGruCodigo_To, &TFcarGruDescricao, &TFcarGruDescricao_Sel, &TFcarGruCozinhaCentral_Sels, &TFcarGruStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnscardapiogrupo
			Order carGruDescricao
			&count += 1
		EndFor
		If not carGruDescricao.IsEmpty()
			&Option = carGruDescricao
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

