    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_ACESSO_NOME'
		Do 'LoadAcesso_NomeOptions'
	Case &DDOName.ToUpper() = !'DDO_ACESSO_IP'
		Do 'LoadAcesso_IPOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"Auditoria.AcessoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"Auditoria.AcessoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"Auditoria.AcessoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"FILTERFULLTEXT"
				&FilterFullText.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFACESSO_NUMERO"
				&TFAcesso_Numero.FromString(&GridStateFilterValue.Value)
				&TFAcesso_Numero_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFACESSO_NOME"
				&TFAcesso_Nome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFACESSO_NOME_SEL"
				&TFAcesso_Nome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFACESSO_DATAHORA"
				&TFAcesso_DataHora.FromString(&GridStateFilterValue.Value)
				&TFAcesso_DataHora_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFACESSO_IP"
				&TFAcesso_IP.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFACESSO_IP_SEL"
				&TFAcesso_IP_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFACESSO_MODULO_SEL"
				&TFAcesso_Modulo_SelsJson = &GridStateFilterValue.Value
				&TFAcesso_Modulo_Sels.FromJson(&TFAcesso_Modulo_SelsJson)
			Case &GridStateFilterValue.Name = !"TFACESSO_SAIDA"
				&TFAcesso_Saida.FromString(&GridStateFilterValue.Value)
				&TFAcesso_Saida_To.FromString(&GridStateFilterValue.ValueTo)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'PREFCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&PrefCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'ACESSO_NOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&Acesso_Nome1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'PREFCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&PrefCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'ACESSO_NOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&Acesso_Nome2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'PREFCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&PrefCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'ACESSO_NOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&Acesso_Nome3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadAcesso_NomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFAcesso_Nome = &SearchTxt
	&TFAcesso_Nome_Sel.SetEmpty()
	For Each Acesso
		Order Acesso_Nome
		using AcessoWWDS(&FilterFullText, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &PrefCodigo1, &Acesso_Nome1, &DynamicFiltersEnabled2
					, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &PrefCodigo2, &Acesso_Nome2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3
					, &DynamicFiltersOperator3, &PrefCodigo3, &Acesso_Nome3, &TFAcesso_Numero, &TFAcesso_Numero_To, &TFAcesso_Nome
					, &TFAcesso_Nome_Sel, &TFAcesso_DataHora, &TFAcesso_DataHora_To, &TFAcesso_IP, &TFAcesso_IP_Sel, &TFAcesso_Modulo_Sels
					, &TFAcesso_Saida, &TFAcesso_Saida_To)

		&count = 0
		For Each Acesso
			Order Acesso_Nome
			&count += 1
		EndFor
		If not Acesso_Nome.IsEmpty()
			&Option = Acesso_Nome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadAcesso_IPOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFAcesso_IP = &SearchTxt
	&TFAcesso_IP_Sel.SetEmpty()
	For Each Acesso
		Order Acesso_IP
		using AcessoWWDS(&FilterFullText, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &PrefCodigo1, &Acesso_Nome1, &DynamicFiltersEnabled2
					, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &PrefCodigo2, &Acesso_Nome2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3
					, &DynamicFiltersOperator3, &PrefCodigo3, &Acesso_Nome3, &TFAcesso_Numero, &TFAcesso_Numero_To, &TFAcesso_Nome
					, &TFAcesso_Nome_Sel, &TFAcesso_DataHora, &TFAcesso_DataHora_To, &TFAcesso_IP, &TFAcesso_IP_Sel, &TFAcesso_Modulo_Sels
					, &TFAcesso_Saida, &TFAcesso_Saida_To)

		&count = 0
		For Each Acesso
			Order Acesso_IP
			&count += 1
		EndFor
		If not Acesso_IP.IsEmpty()
			&Option = Acesso_IP
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

