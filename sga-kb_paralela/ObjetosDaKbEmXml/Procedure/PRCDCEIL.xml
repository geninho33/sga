  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[if &qtdeUnidade=0
	&qtde = 1
else
	&qtde = &qtdeUnidade
endif

&resto            = Mod(&totalPerCapta, &qtde )
&valorArredondado = trunc(&totalPerCapta,0 )

if &resto >= ( &qtde/2 ) or &valorArredondado<1
	&Complemento  = &qtde - &resto
    &valorRetorno = &valorArredondado + &Complemento
else
    &valorRetorno = &valorArredondado
endif

if &valorRetorno< &qtde
   &valorRetorno = &qtde	
endif   

/*
&valorArredondado = &totalPerCapt - (&resto/100)

&porcentagem = (&resto*100)/&qtdeUnidade

if &porcentagem<=50
   &valorRetorno = 	&totalPerCapta-&resto
else
   &Complemento	 = &qtdeUnidade - &resto
   &valorRetorno = 	&totalPerCapta + &Complemento
endif
*/


]]></Source>
