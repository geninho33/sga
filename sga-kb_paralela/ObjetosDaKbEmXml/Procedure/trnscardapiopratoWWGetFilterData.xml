	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_CARPRATOTURNO'
		Do 'LoadcarPratoTurnoOptions'
	Case &DDOName.ToUpper() = !'DDO_CARPRATOREFEICAO'
		Do 'LoadcarPratoRefeicaoOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnscardapiopratoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnscardapiopratoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnscardapiopratoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFCARPRATODATA"
				&TFcarPratoData.FromString(&GridStateFilterValue.Value)
				&TFcarPratoData_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCARPRATOTURNOHORARIO"
				&TFcarPratoTurnoHorario.FromString(&GridStateFilterValue.Value)
				&TFcarPratoTurnoHorario_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCARPRATOTURNO"
				&TFcarPratoTurno.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARPRATOTURNO_SEL"
				&TFcarPratoTurno_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARPRATOREFEICAO"
				&TFcarPratoRefeicao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARPRATOREFEICAO_SEL"
				&TFcarPratoRefeicao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&CARDAPCODIGO"
				&carDapCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'CARPRATOTURNONOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carPratoTurnoNome1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARPRATODATA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carPratoData1.FromString(&GridStateDynamicFilter.Value)
				&carPratoData_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'CARPRATOREFEICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carPratoRefeicao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARPRATOTURNO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carPratoTurno1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'CARPRATOTURNONOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carPratoTurnoNome2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARPRATODATA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carPratoData2.FromString(&GridStateDynamicFilter.Value)
					&carPratoData_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'CARPRATOREFEICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carPratoRefeicao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARPRATOTURNO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carPratoTurno2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'CARPRATOTURNONOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carPratoTurnoNome3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARPRATODATA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carPratoData3.FromString(&GridStateDynamicFilter.Value)
						&carPratoData_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'CARPRATOREFEICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carPratoRefeicao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARPRATOTURNO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carPratoTurno3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadcarPratoTurnoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFcarPratoTurno = &SearchTxt
	&TFcarPratoTurno_Sel.SetEmpty()
	For Each trnscardapioprato
		Order prefCodigo, carDapCodigo, carPratoData, carPratoTurno
		using trnscardapiopratoWWDS(&prefCodigo, &carDapCodigo, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &carPratoTurnoNome1, &carPratoData1
					, &carPratoData_To1, &carPratoRefeicao1, &carPratoTurno1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2
					, &carPratoTurnoNome2, &carPratoData2, &carPratoData_To2, &carPratoRefeicao2, &carPratoTurno2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &carPratoTurnoNome3, &carPratoData3, &carPratoData_To3, &carPratoRefeicao3
					, &carPratoTurno3, &TFcarPratoData, &TFcarPratoData_To, &TFcarPratoTurnoHorario, &TFcarPratoTurnoHorario_To, &TFcarPratoTurno
					, &TFcarPratoTurno_Sel, &TFcarPratoRefeicao, &TFcarPratoRefeicao_Sel)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnscardapioprato
			Order prefCodigo, carDapCodigo, carPratoData, carPratoTurno
			&count += 1
		EndFor
		If not carPratoTurnoNome.IsEmpty()
			&Option = carPratoTurno.ToString()
			&OptionDesc = carPratoTurnoNome
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

