  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&LastChar = &LinkURL.LastIndexOf(!"/")
If &LastChar > 0
	&URL = &LinkURL.Substring(&LastChar+1, &LinkURL.Length())
Else
	&URL = &LinkURL.Trim()
Endif
&GAMApplication = GAMApplication.Get()
&URL = &GAMApplication.Environment.URL + &URL

//Complete package and extension
If not &GAMApplication.Environment.ProgramExtension.IsEmpty()
	If &URL.IndexOf(!"."+&GAMApplication.Environment.ProgramExtension) = 0
		&URL = &URL + !"." + &GAMApplication.Environment.ProgramExtension
	Endif
Endif
If not &GAMApplication.Environment.ProgramPackage.IsEmpty()  AND  &GAMApplication.Environment.ProgramPackage <> !"null"
	If &URL.IndexOf(&GAMApplication.Environment.ProgramPackage+!".") = 0
		&URL = &GAMApplication.Environment.ProgramPackage + !"." + &URL
	Endif
Endif

If &URL.IndexOf(!"?") = 0
	&URL += !"?"
Endif
]]></Source>
