	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_NOTANUMERO'
		Do 'LoadnotaNumeroOptions'
	Case &DDOName.ToUpper() = !'DDO_NOTASERIE'
		Do 'LoadnotaSerieOptions'
	Case &DDOName.ToUpper() = !'DDO_NOTAFORNECEDORNOME'
		Do 'LoadnotaFornecedorNomeOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsnotaWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsnotaWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsnotaWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFNOTACODIGO"
				&TFnotaCodigo.FromString(&GridStateFilterValue.Value)
				&TFnotaCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTANUMERO"
				&TFnotaNumero.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTANUMERO_SEL"
				&TFnotaNumero_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTASERIE"
				&TFnotaSerie.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTASERIE_SEL"
				&TFnotaSerie_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTADATA"
				&TFnotaData.FromString(&GridStateFilterValue.Value)
				&TFnotaData_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTAFORNECEDORNOME"
				&TFnotaFornecedorNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTAFORNECEDORNOME_SEL"
				&TFnotaFornecedorNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTATOTAL"
				&TFnotaTotal.FromString(&GridStateFilterValue.Value)
				&TFnotaTotal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTASTATUS_SEL"
				&TFnotaStatus_SelsJson = &GridStateFilterValue.Value
				&TFnotaStatus_Sels.FromJson(&TFnotaStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'NOTANUMERO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&notaNumero1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'NOTADATA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&notaData1.FromString(&GridStateDynamicFilter.Value)
				&notaData_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'NOTASTATUS'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&notaStatus1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'NOTAFORNECEDORNOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&notaFornecedorNome1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'NOTANUMERO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&notaNumero2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'NOTADATA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&notaData2.FromString(&GridStateDynamicFilter.Value)
					&notaData_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'NOTASTATUS'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&notaStatus2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'NOTAFORNECEDORNOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&notaFornecedorNome2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'NOTANUMERO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&notaNumero3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'NOTADATA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&notaData3.FromString(&GridStateDynamicFilter.Value)
						&notaData_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'NOTASTATUS'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&notaStatus3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'NOTAFORNECEDORNOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&notaFornecedorNome3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadnotaNumeroOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFnotaNumero = &SearchTxt
	&TFnotaNumero_Sel.SetEmpty()
	For Each trnsnota
		Order notaNumero
		using trnsnotaWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &notaNumero1, &notaData1, &notaData_To1, &notaStatus1
					, &notaFornecedorNome1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &notaNumero2, &notaData2
					, &notaData_To2, &notaStatus2, &notaFornecedorNome2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &notaNumero3, &notaData3, &notaData_To3, &notaStatus3, &notaFornecedorNome3, &TFnotaCodigo
					, &TFnotaCodigo_To, &TFnotaNumero, &TFnotaNumero_Sel, &TFnotaSerie, &TFnotaSerie_Sel, &TFnotaData
					, &TFnotaData_To, &TFnotaFornecedorNome, &TFnotaFornecedorNome_Sel, &TFnotaTotal, &TFnotaTotal_To, &TFnotaStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsnota
			Order notaNumero
			&count += 1
		EndFor
		If not notaNumero.IsEmpty()
			&Option = notaNumero
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadnotaSerieOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFnotaSerie = &SearchTxt
	&TFnotaSerie_Sel.SetEmpty()
	For Each trnsnota
		Order notaSerie
		using trnsnotaWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &notaNumero1, &notaData1, &notaData_To1, &notaStatus1
					, &notaFornecedorNome1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &notaNumero2, &notaData2
					, &notaData_To2, &notaStatus2, &notaFornecedorNome2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &notaNumero3, &notaData3, &notaData_To3, &notaStatus3, &notaFornecedorNome3, &TFnotaCodigo
					, &TFnotaCodigo_To, &TFnotaNumero, &TFnotaNumero_Sel, &TFnotaSerie, &TFnotaSerie_Sel, &TFnotaData
					, &TFnotaData_To, &TFnotaFornecedorNome, &TFnotaFornecedorNome_Sel, &TFnotaTotal, &TFnotaTotal_To, &TFnotaStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsnota
			Order notaSerie
			&count += 1
		EndFor
		If not notaSerie.IsEmpty()
			&Option = notaSerie
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadnotaFornecedorNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFnotaFornecedorNome = &SearchTxt
	&TFnotaFornecedorNome_Sel.SetEmpty()
	For Each trnsnota
		Order prefCodigo, notaFornecedor
		using trnsnotaWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &notaNumero1, &notaData1, &notaData_To1, &notaStatus1
					, &notaFornecedorNome1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &notaNumero2, &notaData2
					, &notaData_To2, &notaStatus2, &notaFornecedorNome2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &notaNumero3, &notaData3, &notaData_To3, &notaStatus3, &notaFornecedorNome3, &TFnotaCodigo
					, &TFnotaCodigo_To, &TFnotaNumero, &TFnotaNumero_Sel, &TFnotaSerie, &TFnotaSerie_Sel, &TFnotaData
					, &TFnotaData_To, &TFnotaFornecedorNome, &TFnotaFornecedorNome_Sel, &TFnotaTotal, &TFnotaTotal_To, &TFnotaStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsnota
			Order prefCodigo, notaFornecedor
			&count += 1
		EndFor
		If not notaFornecedorNome.IsEmpty()
			&Option = notaFornecedorNome
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &Options.Item(&InsertIndex) < &Option
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

