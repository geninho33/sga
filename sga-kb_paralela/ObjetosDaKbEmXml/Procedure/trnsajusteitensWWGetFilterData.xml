    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_AJUSITEMPRODUTO'
		Do 'LoadajusItemProdutoOptions'
	Case &DDOName.ToUpper() = !'DDO_AJUSITEMUN'
		Do 'LoadajusItemUNOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsajusteitensWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsajusteitensWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsajusteitensWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFAJUSITEMPRODUTO"
				&TFajusItemProduto.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAJUSITEMPRODUTO_SEL"
				&TFajusItemProduto_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAJUSITEMUN"
				&TFajusItemUN.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAJUSITEMUN_SEL"
				&TFajusItemUN_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAJUSITEMQUANTIDADE"
				&TFajusItemQuantidade.FromString(&GridStateFilterValue.Value)
				&TFajusItemQuantidade_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&AJUSCODIGO"
				&ajusCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadajusItemProdutoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFajusItemProduto = &SearchTxt
	&TFajusItemProduto_Sel.SetEmpty()
	For Each trnsajusteitens
		using trnsajusteitensWWDS(&prefCodigo, &ajusCodigo, &TFajusItemProduto, &TFajusItemProduto_Sel, &TFajusItemUN, &TFajusItemUN_Sel
					, &TFajusItemQuantidade, &TFajusItemQuantidade_To)
		Where prefCodigo = &prefCodigo

		If not ajusItemProdutoDescricao.IsEmpty()
			&Option = ajusItemProduto.ToString()
			&OptionDesc = ajusItemProdutoDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			If (&InsertIndex = &Options.Count + 1) OR &OptionsDesc.Item(&InsertIndex) <> &OptionDesc
				&Options.Add(&Option, &InsertIndex)
				&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			EndIf
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadajusItemUNOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFajusItemUN = &SearchTxt
	&TFajusItemUN_Sel.SetEmpty()
	For Each trnsajusteitens
		Order prefCodigo, ajusCodigo, ajusItemUN
		using trnsajusteitensWWDS(&prefCodigo, &ajusCodigo, &TFajusItemProduto, &TFajusItemProduto_Sel, &TFajusItemUN, &TFajusItemUN_Sel
					, &TFajusItemQuantidade, &TFajusItemQuantidade_To)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsajusteitens
			Order prefCodigo, ajusCodigo, ajusItemUN
			&count += 1
		EndFor
		If not uniDescricao.IsEmpty()
			&Option = ajusItemUN.ToString()
			&OptionDesc = uniDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

