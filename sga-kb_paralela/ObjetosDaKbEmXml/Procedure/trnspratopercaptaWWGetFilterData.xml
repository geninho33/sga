    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_AREENSNOME'
		Do 'LoadAreEnsNomeOptions'
	Case &DDOName.ToUpper() = !'DDO_AREENSETAPANOME'
		Do 'LoadAreEnsEtapaNomeOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnspratopercaptaWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnspratopercaptaWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnspratopercaptaWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFAREENSNOME"
				&TFAreEnsNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAREENSNOME_SEL"
				&TFAreEnsNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAREENSCODIGO"
				&TFAreEnsCodigo.FromString(&GridStateFilterValue.Value)
				&TFAreEnsCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFAREENSSEQUENCIAL"
				&TFAreEnsSequencial.FromString(&GridStateFilterValue.Value)
				&TFAreEnsSequencial_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFAREENSETAPANOME"
				&TFAreEnsEtapaNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAREENSETAPANOME_SEL"
				&TFAreEnsEtapaNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARGRUTURNO_SEL"
				&TFcarGruTurno_SelsJson = &GridStateFilterValue.Value
				&TFcarGruTurno_Sels.FromJson(&TFcarGruTurno_SelsJson)
			Case &GridStateFilterValue.Name = !"TFPRATPERCAPTA"
				&TFpratPerCapta.FromString(&GridStateFilterValue.Value)
				&TFpratPerCapta_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&PRATOCODIGO"
				&pratoCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadAreEnsNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFAreEnsNome = &SearchTxt
	&TFAreEnsNome_Sel.SetEmpty()
	For Each trnspratopercapta
		Order prefCodigo, pratoCodigo, AreEnsNome
		using trnspratopercaptaWWDS(&prefCodigo, &pratoCodigo, &TFAreEnsNome, &TFAreEnsNome_Sel, &TFAreEnsCodigo, &TFAreEnsCodigo_To
					, &TFAreEnsSequencial, &TFAreEnsSequencial_To, &TFAreEnsEtapaNome, &TFAreEnsEtapaNome_Sel, &TFcarGruTurno_Sels, &TFpratPerCapta
					, &TFpratPerCapta_To)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnspratopercapta
			Order prefCodigo, pratoCodigo, AreEnsNome
			&count += 1
		EndFor
		If not AreEnsNome.IsEmpty()
			&Option = AreEnsNome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadAreEnsEtapaNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFAreEnsEtapaNome = &SearchTxt
	&TFAreEnsEtapaNome_Sel.SetEmpty()
	For Each trnspratopercapta
		Order prefCodigo, pratoCodigo, AreEnsEtapaNome
		using trnspratopercaptaWWDS(&prefCodigo, &pratoCodigo, &TFAreEnsNome, &TFAreEnsNome_Sel, &TFAreEnsCodigo, &TFAreEnsCodigo_To
					, &TFAreEnsSequencial, &TFAreEnsSequencial_To, &TFAreEnsEtapaNome, &TFAreEnsEtapaNome_Sel, &TFcarGruTurno_Sels, &TFpratPerCapta
					, &TFpratPerCapta_To)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnspratopercapta
			Order prefCodigo, pratoCodigo, AreEnsEtapaNome
			&count += 1
		EndFor
		If not AreEnsEtapaNome.IsEmpty()
			&Option = AreEnsEtapaNome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

