  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[Header
	print printCabecalho			
	print printCabecalhoDados
End

&Title		= 'Relatório de Estoque de Produtos'
&AppName    = 'Sistema de Gestão de Alimentação Escolar ' 

LoadWWPContext.Call(&WWPContext)
&prefCodigo = &WWPContext.prefCodigo

For each
	where prefCodigo = &prefCodigo
	      &prefLogo =  prefLogo
		  &prefLocalDeposito = prefLocalDeposito
endFor			

For each trnsprodutos, trnsprodutosgrupo, trnsunidades
	order prodDescricao           when &ordem = 'D'
	order prodCodigo              when &ordem = 'C'
	order prodTipo, prodDescricao when &ordem = 'G'
	
	where prefCodigo     = &prefCodigo
	where prodGrupCodigo = prodTipo           	
	where prodStatus     = 'A'
	where prodTipo       =  &grupo when not &grupo.IsEmpty()
	where prodSaldo      > 0       when &situacaoSaldo = 'M'
	where prodSaldo      = 0       when &situacaoSaldo = 'I'
	where prodSaldo      < 0       when &situacaoSaldo = 'N'
	where not prodDescricao.IsEmpty()
	for each
		where locCodigo  = &prefLocalDeposito
		&locDescricao =  locDescricao
	When none
		&locDescricao.SetEmpty()
	endFor									

	print printDados
	
Endfor
]]></Source>
