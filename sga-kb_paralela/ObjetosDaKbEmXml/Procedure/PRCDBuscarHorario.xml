  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[if &situacao = 'A'
	
	msg('Aguarde, estamos atualizando o seu cardápio !')
	
	// Fazendo a apuração dos tipos de refeição
	for each trnsrefeicaotipo
		where prefCodigo = &prefCodigo
		
		      // Atualizando as variáveis
		      &carPratoTurno = refTipCodigo
			  &refTipHorario = refTipHorario
	    
			  // Procurando os pratos no cardápio para atualizar		   
			  For each trnscardapioprato
				  where prefCodigo = &prefCodigo
                  where carPratoTurno = &carPratoTurno
				        if carPratoHorario<>&refTipHorario
						   carPratoHorario = &refTipHorario	
						endif
			  endfor		
	endfor
	
else	
	for each
		where prefCodigo      = &prefCodigo
		where refTipDescricao = &carPratoTurnoNome
    	      &carPratoHorario = refTipHorario
	endFor		  
endif
]]></Source>
