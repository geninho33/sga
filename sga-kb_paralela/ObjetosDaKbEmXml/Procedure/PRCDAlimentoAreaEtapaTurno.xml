  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&retorno = false

for each trnscardapioprato
	order prefCodigo, carDapCodigo
    where prefCodigo   = &prefCodigo
    where carDapCodigo = &remCardapio				  
       &pratoCodigo = carPratoCodigo 
	
	  // buscando os ingredientes		
	  for each trnspratosingredientes
		  order prefCodigo, pratoCodigo,AreEnsCodigo, AreEnsSequencial
		  where prefCodigo          = &prefCodigo
		  where pratoCodigo         = &pratoCodigo
		  where AreEnsCodigo        = &AreEnsCodigo
		  where AreEnsSequencial    = &AreEnsSequencial
		  where pratIngrTipoRemessa = &remTipoRemessa when &remTipoRemessa<>0
             &retorno = true
			exit
	  endFor

      if not &retorno
	  	  for each trnspratosingredientes
			  order prefCodigo, pratoCodigo,AreEnsCodigo, AreEnsSequencial
			  where prefCodigo          = &prefCodigo
			  where pratoCodigo         = &pratoCodigo
			  where AreEnsCodigo        = &AreEnsCodigo
			  where pratIngrTipoRemessa = &remTipoRemessa when &remTipoRemessa<>0
             &retorno = true
			exit
		  endFor
      endif
  
/*  
      if not &retorno
	  	  for each trnspratosingredientes
			  order prefCodigo, pratoCodigo,AreEnsCodigo, AreEnsSequencial
			  where prefCodigo          = &prefCodigo
			  where pratoCodigo         = &pratoCodigo
			  where AreEnsCodigo        = &AreEnsCodigo
                    &retorno = true
			exit
		  endFor
      endif  
*/

endFor	

/*
  msg('Prefeitura : ' + &prefCodigo.ToString() + 
    ' | Prato : ' + &pratoCodigo.ToString() + 
	' | Area : ' + &AreEnsCodigo.ToString() + 
	' | Etapa : ' + &AreEnsSequencial.ToString() + 
	' | Turno : ' + &AtendimentoTurno.ToString() + 
	' | Remessa : ' + &remTipoRemessa.ToString() )
*/
]]></Source>
