					, &refTipstatus2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &refTipCodigo3, &refTipDescricao3
					, &refTipperiodo3, &refTipstatus3, &TFrefTipCodigo, &TFrefTipCodigo_To, &TFrefTipAbreviatura, &TFrefTipAbreviatura_Sel
