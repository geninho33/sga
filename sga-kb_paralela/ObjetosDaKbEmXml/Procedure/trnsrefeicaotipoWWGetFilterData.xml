&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_REFTIPABREVIATURA'
		Do 'LoadrefTipAbreviaturaOptions'
	Case &DDOName.ToUpper() = !'DDO_REFTIPDESCRICAO'
		Do 'LoadrefTipDescricaoOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsrefeicaotipoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsrefeicaotipoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsrefeicaotipoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFREFTIPCODIGO"
				&TFrefTipCodigo.FromString(&GridStateFilterValue.Value)
				&TFrefTipCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREFTIPABREVIATURA"
				&TFrefTipAbreviatura.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREFTIPABREVIATURA_SEL"
				&TFrefTipAbreviatura_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREFTIPDESCRICAO"
				&TFrefTipDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREFTIPDESCRICAO_SEL"
				&TFrefTipDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREFTIPPERIODO_SEL"
				&TFrefTipperiodo_SelsJson = &GridStateFilterValue.Value
				&TFrefTipperiodo_Sels.FromJson(&TFrefTipperiodo_SelsJson)
			Case &GridStateFilterValue.Name = !"TFREFTIPHORARIO"
				&TFrefTipHorario.FromString(&GridStateFilterValue.Value)
				&TFrefTipHorario_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREFTIPHORARIO2"
				&TFrefTipHorario2.FromString(&GridStateFilterValue.Value)
				&TFrefTipHorario2_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREFTIPSTATUS_SEL"
				&TFrefTipstatus_SelsJson = &GridStateFilterValue.Value
				&TFrefTipstatus_Sels.FromJson(&TFrefTipstatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'REFTIPCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&refTipCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'REFTIPDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&refTipDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'REFTIPPERIODO'
				&refTipperiodo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'REFTIPSTATUS'
				&refTipstatus1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'REFTIPCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&refTipCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'REFTIPDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&refTipDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'REFTIPPERIODO'
					&refTipperiodo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'REFTIPSTATUS'
					&refTipstatus2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'REFTIPCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&refTipCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'REFTIPDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&refTipDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'REFTIPPERIODO'
						&refTipperiodo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'REFTIPSTATUS'
						&refTipstatus3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadrefTipAbreviaturaOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFrefTipAbreviatura = &SearchTxt
	&TFrefTipAbreviatura_Sel.SetEmpty()
	For Each trnsrefeicaotipo
		Order refTipAbreviatura
		using trnsrefeicaotipoWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &refTipCodigo1, &refTipDescricao1, &refTipperiodo1, &refTipstatus1
					, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &refTipCodigo2, &refTipDescricao2, &refTipperiodo2
					, &refTipstatus2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &refTipCodigo3, &refTipDescricao3
					, &refTipperiodo3, &refTipstatus3, &TFrefTipCodigo, &TFrefTipCodigo_To, &TFrefTipAbreviatura, &TFrefTipAbreviatura_Sel
					, &TFrefTipDescricao, &TFrefTipDescricao_Sel, &TFrefTipperiodo_Sels, &TFrefTipHorario, &TFrefTipHorario_To, &TFrefTipHorario2
					, &TFrefTipHorario2_To, &TFrefTipstatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsrefeicaotipo
			Order refTipAbreviatura
			&count += 1
		EndFor
		If not refTipAbreviatura.IsEmpty()
			&Option = refTipAbreviatura
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

