    <Source><![CDATA[for each
	where prefCodigo = &prefCodigo
	where prodCodigo = &mapaUeProdCodigo
	      &prodDescricao = prodDescricao
endFor		  

for each
	where prefCodigo       = &prefCodigo
	where mapaUeData       > &mapaUeData
    where mapaUeLocCodigo  = &mapaUeLocCodigo
    where mapaUeProdCodigo = &mapaUeProdCodigo
	      &retorno = '  ==> ' + &prodDescricao + ' | A data do lançamento tem que ser superior ou igual a  '+ mapaUeData.ToString() + chr(13)
endFor
]]></Source>
