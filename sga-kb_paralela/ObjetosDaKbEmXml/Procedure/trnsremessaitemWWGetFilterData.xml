Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsremessaitemWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsremessaitemWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsremessaitemWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFREMITEMPRODUTO"
				&TFremItemProduto.FromString(&GridStateFilterValue.Value)
				&TFremItemProduto_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREMITEMPRODUTODESCRICAO"
				&TFremItemProdutoDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMITEMPRODUTODESCRICAO_SEL"
				&TFremItemProdutoDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMITEMUNIDADE"
				&TFremItemUnidade.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMITEMUNIDADE_SEL"
				&TFremItemUnidade_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMITEMQTDEEMBALAGENS"
				&TFremItemQtdeEmbalagens.FromString(&GridStateFilterValue.Value)
				&TFremItemQtdeEmbalagens_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREMITEMPESOUNIDADE"
				&TFremItemPesoUnidade.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMITEMPESOUNIDADE_SEL"
				&TFremItemPesoUnidade_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMITEMPESOCONSUMO"
