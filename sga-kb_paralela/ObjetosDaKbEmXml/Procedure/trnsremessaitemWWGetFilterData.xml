					Case &DynamicFiltersSelector3 = !'REMITEMLOTE'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&remItemLote3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

