				&TFremItemPesoTotal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFREMTIPOREMESSA"
				&TFremTipoRemessa.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFREMTIPOREMESSA_SEL"
				&TFremTipoRemessa_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&REMCODIGO"
				&remCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'REMITEMPERIODO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&remItemPeriodo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'REMITEMVALIDADE'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&remItemValidade1.FromString(&GridStateDynamicFilter.Value)
				&remItemValidade_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'REMTIPOREMESSA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&remTipoRemessa1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'REMITEMLOTE'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&remItemLote1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'REMITEMPERIODO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&remItemPeriodo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'REMITEMVALIDADE'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&remItemValidade2.FromString(&GridStateDynamicFilter.Value)
					&remItemValidade_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'REMTIPOREMESSA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&remTipoRemessa2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'REMITEMLOTE'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&remItemLote2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'REMITEMPERIODO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&remItemPeriodo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'REMITEMVALIDADE'
