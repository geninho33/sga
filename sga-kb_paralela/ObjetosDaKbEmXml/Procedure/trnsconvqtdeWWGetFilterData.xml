Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsconvqtdeWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsconvqtdeWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsconvqtdeWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFUNICONORIGEMDESCRICAO"
				&TFuniConOrigemDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUNICONORIGEMDESCRICAO_SEL"
				&TFuniConOrigemDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUNICONDESTINODESCRICAO"
				&TFuniConDestinoDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUNICONDESTINODESCRICAO_SEL"
				&TFuniConDestinoDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUNICONVQTDEGERAR"
				&TFuniConvQtdeGerar.FromString(&GridStateFilterValue.Value)
				&TFuniConvQtdeGerar_To.FromString(&GridStateFilterValue.ValueTo)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'UNICONORIGEMDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&uniConOrigemDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'UNICONDESTINODESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&uniConDestinoDescricao1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'UNICONORIGEMDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&uniConOrigemDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'UNICONDESTINODESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&uniConDestinoDescricao2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'UNICONORIGEMDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&uniConOrigemDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'UNICONDESTINODESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&uniConDestinoDescricao3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoaduniConOrigemDescricaoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFuniConOrigemDescricao = &SearchTxt
