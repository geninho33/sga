					, &TFuniConvQtdeGerar, &TFuniConvQtdeGerar_To)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsconvqtde
			Order prefCodigo, uniConvUnidadeOrigem
			&count += 1
		EndFor
		If not uniConOrigemDescricao.IsEmpty()
			&Option = uniConOrigemDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &Options.Item(&InsertIndex) < &Option
				&InsertIndex = &InsertIndex + 1
			EndDo
