	Case &DDOName.ToUpper() = !'DDO_UNICONORIGEMDESCRICAO'
		Do 'LoaduniConOrigemDescricaoOptions'
	Case &DDOName.ToUpper() = !'DDO_UNICONDESTINODESCRICAO'
		Do 'LoaduniConDestinoDescricaoOptions'
