  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&Link = ''
&GAMApplication = GAMApplication.Get() 

&MenuItemName = "GAM_Repository"
do 'CreateMenu'
&RepositoryAppMenuId = &GAMApplicationMenu.Id
&AppMenuId  = &RepositoryAppMenuId

&MenuItemName = "Configuration"
&GAMPermissionName = !"gamrepositoryconfiguration_Execute"
do 'CreateMenuItem'

&MenuItemName = "Connections"
&GAMPermissionName = !"gamwwconnections_Execute"
do 'CreateMenuItem'

&MenuItemName = "Change Repository"
&GAMPermissionName = !"gamchangerepository_Execute"
do 'CreateMenuItem'

&MenuItemName = "GAM_OtherConfigurations"
do 'CreateMenu'
&OtherConfigsAppMenuId = &GAMApplicationMenu.Id
&AppMenuId  = &GAMApplicationMenu.Id

&MenuItemName = "Security Policies"
&GAMPermissionName = !"gamwwsecuritypolicy_Execute"
do 'CreateMenuItem'

&MenuItemName = "Authentication Types"
&GAMPermissionName = !"gamwwauthtypes_Execute"
do 'CreateMenuItem'

&MenuItemName = "Event Subscriptions"
&GAMPermissionName = !"gamwweventsubscriptions_Execute"
do 'CreateMenuItem'

      

&MenuItemName = "GAM_Security"
do 'CreateMenu'
&SecurityMenuID = &GAMApplicationMenu.Id
&AppMenuId  = &GAMApplicationMenu.Id

&MenuItemName = "Users"
&GAMPermissionName = !"gamwwusers_Execute"
do 'CreateMenuItem'

&MenuItemName = "Roles"
&GAMPermissionName = !"gamwwroles_Execute"
do 'CreateMenuItem'

&MenuItemName = "Applications"
&GAMPermissionName = !"gamwwapplications_Execute"
do 'CreateMenuItem' 
   

&MenuItemName = "Repository"
&AppSubMenuId = &RepositoryAppMenuId
do 'CreateMenuSubmenu'

&MenuItemName = "Other Configurations"
&AppSubMenuId = &OtherConfigsAppMenuId
do 'CreateMenuSubmenu'

&MenuItemName = !"MainMenu"
do 'CreateMenu'
&AppMenuId  = &GAMApplicationMenu.Id

&MenuItemName = "Home"
&GAMPermissionName = !"home_Execute"
&IconClass = !"menu-icon fa fa-home"
do 'CreateMenuItem'

&MenuItemName = "Security"
&AppSubMenuId = &SecurityMenuID
&IconClass = !"menu-icon fa fa-key"
do 'CreateMenuSubmenu'

&GAMApplication.Load(&GAMApplication.Id)
&GAMApplication.MainMenuId = &GAMApplicationMenu.Id
&GAMApplication.Save()
Commit

Sub 'CreateMenu'
	&GAMApplicationMenu = new()
	&GAMApplicationMenu.Name = &MenuItemName
	&IsOk = &GAMApplication.AddMenu(&GAMApplicationMenu, &GAMErrorCollection)
	if &IsOk
		Commit
	else
		Do 'Errors'
	endif
EndSub

Sub 'CreateMenuSubmenu'
	&GAMApplicationMenuOption = new()
	&GAMApplicationMenuOption.Name = &MenuItemName
	&GAMApplicationMenuOption.Type = GamMenuOptionType.Menu
	&GAMApplicationMenuOption.SubMenuId	= &AppSubMenuId
	
	&GAMProperty = new()
	&GAMProperty.Id = "IconClass"
	&GAMProperty.Value = &IconClass
	&GAMApplicationMenuOption.Properties.Add(&GAMProperty)
	
	&GAMProperty = new()
	&GAMProperty.Id = "Link"
	&GAMProperty.Value = &Link
	&GAMApplicationMenuOption.Properties.Add(&GAMProperty)
	
	&GAMApplication.AddMenuOption(&AppMenuId, &GAMApplicationMenuOption, &GAMErrorCollection)
	if &IsOk
		Commit
	else
		Do 'Errors'
	endif
EndSub

Sub 'CreateMenuItem'
	&GAMApplicationMenuOption = new()
	&GAMApplicationMenuOption.Name = &MenuItemName
	&GAMApplicationMenuOption.Type = GamMenuOptionType.Simple
	&GAMApplicationPermission = &GAMApplication.GetPermissionByName(&GAMPermissionName, &GAMErrorCollection)
	&GAMApplicationMenuOption.PermissionResourceGUID = &GAMApplicationPermission.GUID
	&GAMApplicationMenuOption.Resource	= Trim(&GAMApplicationPermission.Resource)
	
	If (not &IconClass.IsEmpty())
		&GAMProperty = new()
		&GAMProperty.Id = "IconClass"
		&GAMProperty.Value = &IconClass
		&GAMApplicationMenuOption.Properties.Add(&GAMProperty)
		
		&GAMProperty = new()
		&GAMProperty.Id = "Link"
		&GAMProperty.Value = &Link
		&GAMApplicationMenuOption.Properties.Add(&GAMProperty)
	EndIf

	&IsOk = &GAMApplication.AddMenuOption(&AppMenuId, &GAMApplicationMenuOption, &GAMErrorCollection)
	
	if &IsOk
		Commit
	else
		Do 'Errors'
	endif
EndSub


Sub 'Errors'
	For &Error in &GAMErrorCollection
		Msg(Format(!"%1 (GAM%2)", &Error.Message, &Error.Code))
	EndFor
endsub
]]></Source>
