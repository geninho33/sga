  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call(&WWPContext)

for each
	where prefCodigo            = &prefCodigo
	where distRemCodigo	        = &remCodigo
	where distLocalOrigem       = &distLocalOrigem
	where distLocalDestino      = &locCodigo
	where distCodigoTipoRemessa = &remTipoRemessa when &remTipoRemessa<>0
	where distPeriodo           = &dataInicial.ToString() +  ' a ' + &dataFinal.ToString() when not &dataFinal.IsEmpty()
	where distObservacao        = &distObservacao
	      &distCodigo = distCodigo
when none
	&distCodigo = PRCDGerarNovoCodigo('distribuicao')
	new
		prefCodigo 		      = &prefCodigo
		distCodigo            = &distCodigo
		distDataEnvio         = &distDataEnvio
	    distRemCodigo	      = &remCodigo
	    distLocalOrigem       = &distLocalOrigem
		distLocalDestino      = &locCodigo
		distRotaCodigo        = PRCDBuscarRota(&prefCodigo,&locCodigo)
		distStatus            = 'A'
		distPeriodo           = &dataInicial.ToString() +  ' a ' + &dataFinal.ToString()
		distCodigoTipoRemessa = &remTipoRemessa
		distDataCadastro      = serverNow()
		distDataAlteracao     = serverNow()
		distUserName          = &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
		distObservacao		  = &distObservacao
		distReceber           = 'N'
	Endnew
endFor
]]></Source>
