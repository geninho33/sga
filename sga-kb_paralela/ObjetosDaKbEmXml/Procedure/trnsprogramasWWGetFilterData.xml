  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_PROGDESCRICAO'
		Do 'LoadprogDescricaoOptions'
	Case &DDOName.ToUpper() = !'DDO_PROGSIGLA'
		Do 'LoadprogSiglaOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsprogramasWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsprogramasWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsprogramasWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFPROGCODIGO"
				&TFprogCodigo.FromString(&GridStateFilterValue.Value)
				&TFprogCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFPROGDESCRICAO"
				&TFprogDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPROGDESCRICAO_SEL"
				&TFprogDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPROGSIGLA"
				&TFprogSigla.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPROGSIGLA_SEL"
				&TFprogSigla_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPROGAPARECEREMESSA_SEL"
				&TFprogApareceRemessa_SelsJson = &GridStateFilterValue.Value
				&TFprogApareceRemessa_Sels.FromJson(&TFprogApareceRemessa_SelsJson)
			Case &GridStateFilterValue.Name = !"TFPROGORIGEM_SEL"
				&TFprogOrigem_SelsJson = &GridStateFilterValue.Value
				&TFprogOrigem_Sels.FromJson(&TFprogOrigem_SelsJson)
			Case &GridStateFilterValue.Name = !"TFPROTIPOLICITACAO_SEL"
				&TFproTipoLicitacao_SelsJson = &GridStateFilterValue.Value
				&TFproTipoLicitacao_Sels.FromJson(&TFproTipoLicitacao_SelsJson)
			Case &GridStateFilterValue.Name = !"TFPROGSTATUS_SEL"
				&TFprogStatus_SelsJson = &GridStateFilterValue.Value
				&TFprogStatus_Sels.FromJson(&TFprogStatus_SelsJson)
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadprogDescricaoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFprogDescricao = &SearchTxt
	&TFprogDescricao_Sel.SetEmpty()
	For Each trnsprogramas
		Order progDescricao
		using trnsprogramasWWDS(&TFprogCodigo, &TFprogCodigo_To, &TFprogDescricao, &TFprogDescricao_Sel, &TFprogSigla, &TFprogSigla_Sel
					, &TFprogApareceRemessa_Sels, &TFprogOrigem_Sels, &TFproTipoLicitacao_Sels, &TFprogStatus_Sels)

		&count = 0
		For Each trnsprogramas
			Order progDescricao
			&count += 1
		EndFor
		If not progDescricao.IsEmpty()
			&Option = progDescricao
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadprogSiglaOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFprogSigla = &SearchTxt
	&TFprogSigla_Sel.SetEmpty()
	For Each trnsprogramas
		Order progSigla
		using trnsprogramasWWDS(&TFprogCodigo, &TFprogCodigo_To, &TFprogDescricao, &TFprogDescricao_Sel, &TFprogSigla, &TFprogSigla_Sel
					, &TFprogApareceRemessa_Sels, &TFprogOrigem_Sels, &TFproTipoLicitacao_Sels, &TFprogStatus_Sels)

		&count = 0
		For Each trnsprogramas
			Order progSigla
			&count += 1
		EndFor
		If not progSigla.IsEmpty()
			&Option = progSigla
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

