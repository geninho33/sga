  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[if &situacao = 'N'
	// Cancelando a nota
	for each  trnsnota
		where prefCodigo = &prefCodigo
		where notaCodigo = &codigo
	      notaStatus = "C"
		  notaDsCancelamento = &notaDsCancelamento
	endFor

	// Fazendo ajuste no estoque
	for each trnsnotaitens
		where prefCodigo = &prefCodigo
		where notaCodigo = &codigo
          PRCDEstoqueMovimentacao(notaCodigo,notaItemProduto,0,notaItemQtde,'C','I',notaItemQtdeAntes)
	endFor
else
	if &situacao = 'D'

		// Cancelando Distribuição
		for each  trnsdistribuicao
			where prefCodigo     = &prefCodigo
			where distCodigo     = &codigo
	          distStatus         = "C"
		      distDSCancelamento = &notaDsCancelamento
		endFor

		// Fazendo ajuste no estoque
		for each  trnsdistribuicaoitens
			where prefCodigo = &prefCodigo
			where distCodigo = &codigo
		       PRCDEstoqueMovimentacao( distCodigo,distItemProduto,0,distItemQuantidade,'D','I',distItemQtdeAntes)
		endfor
	else
		// Cancelando o Ajuste
		for each  trnsajuste
			where prefCodigo     = &prefCodigo
			where ajusCodigo     = &codigo
	          ajusStatus         = "C"
		      ajusOBS            = ajusOBS +' ( ' + &notaDsCancelamento +' ) '
		endFor

		// Fazendo ajuste no estoque
		for each  trnsajusteitens
			where prefCodigo = &prefCodigo
			where ajusCodigo = &codigo
		          PRCDEstoqueMovimentacao( ajusCodigo,ajusItemProduto,0,ajusItemQuantidade,ajusTipo,'I',ajusItemQuantidadeAntes)
		endfor
	endif

endif
]]></Source>
