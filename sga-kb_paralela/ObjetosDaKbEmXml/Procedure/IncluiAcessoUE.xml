  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[//&GAMUser = GAMUser.Get()
//
//For each trnsusuarios
//	where usuGUID = &GAMUser.GUID or usuEmail = &GAMUser.EMail
//	&prefCodigo = prefCodigo
//EndFor

For Each Acesso
	Order (Acesso_Numero)
	&Acesso_Numero = Acesso_Numero + 1
	Exit
When None
	&Acesso_Numero = 1
EndFor

//msg('Pref: ' + &prefCodigo.ToString().Trim() + ' - Acesso: ' + &Acesso_Numero.ToString().Trim() + ' - Módulo: ' + &Acesso_Modulo.ToString().Trim())

&Acesso = New()
&Acesso.Acesso_Numero    = &Acesso_Numero
&Acesso.Acesso_Nome      = &UserName
&Acesso.Acesso_DataHora  = ServerNow()
&Acesso.Acesso_IP		 = RemoteAddr()
&Acesso.Acesso_Modulo	 = &Acesso_Modulo
&Acesso.prefCodigo		 = &prefCodigo
&Acesso.Save()

if &Acesso.Success()
	Commit
else
	Rollback
	msg('Prefeitura: ' + &prefCodigo.ToString().Trim())
endif
]]></Source>
