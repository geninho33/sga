  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&itens = 0
for each
	where prefCodigo       = &prefCodigo
	where mapaUeCodigo     = &mapaUeCodigo
		 PRCDAtualizarEstoqueMapaUE(&prefCodigo,mapaUeLocCodigo,mapaUeProdCodigo,mapaUeQuantidade,'E')
         mapaUeAjuste = 'C'  
		 mapaUeObsAjuste = mapaUeObsAjuste + ' | Qtde Anterior : ' + mapaUeQuantidade.ToString()
		 mapaUeQuantidade = mapaUeQtdeAjuste
		 PRCDAtualizarEstoqueMapaUE(&prefCodigo,mapaUeLocCodigo,mapaUeProdCodigo,mapaUeQtdeAjuste,'S')
		 msg('Aplicação feita com sucesso !')
endFor
]]></Source>
