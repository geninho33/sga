&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_CARDAPDESCRICAO'
		Do 'LoadcarDapDescricaoOptions'
	Case &DDOName.ToUpper() = !'DDO_CARDAPNUTRICIONISTA'
		Do 'LoadcarDapNutricionistaOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnscardapioWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnscardapioWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnscardapioWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFCARDAPCODIGO"
				&TFcarDapCodigo.FromString(&GridStateFilterValue.Value)
				&TFcarDapCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCARDAPDESCRICAO"
				&TFcarDapDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARDAPDESCRICAO_SEL"
				&TFcarDapDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARDAPNUTRICIONISTA"
				&TFcarDapNutricionista.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARDAPNUTRICIONISTA_SEL"
				&TFcarDapNutricionista_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARDAPMESANO"
				&TFcarDapMesAno.FromString(&GridStateFilterValue.Value)
				&TFcarDapMesAno_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFCARDAPSTATUS_SEL"
				&TFcarDapStatus_SelsJson = &GridStateFilterValue.Value
				&TFcarDapStatus_Sels.FromJson(&TFcarDapStatus_SelsJson)
			Case &GridStateFilterValue.Name = !"TFCARDAPLIBERARACESSO_SEL"
				&TFcarDapLiberarAcesso_SelsJson = &GridStateFilterValue.Value
				&TFcarDapLiberarAcesso_Sels.FromJson(&TFcarDapLiberarAcesso_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'CARDAPCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carDapCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARDAPDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carDapDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARDAPMESANO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carDapMesAno1.FromString(&GridStateDynamicFilter.Value)
				&carDapMesAno_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'CARDAPNUTRICIONISTA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&carDapNutricionista1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'CARDAPSTATUS'
				&carDapStatus1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'CARDAPCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carDapCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARDAPDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carDapDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARDAPMESANO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carDapMesAno2.FromString(&GridStateDynamicFilter.Value)
					&carDapMesAno_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'CARDAPNUTRICIONISTA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&carDapNutricionista2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'CARDAPSTATUS'
					&carDapStatus2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'CARDAPCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carDapCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARDAPDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carDapDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARDAPMESANO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carDapMesAno3.FromString(&GridStateDynamicFilter.Value)
						&carDapMesAno_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'CARDAPNUTRICIONISTA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&carDapNutricionista3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'CARDAPSTATUS'
						&carDapStatus3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadcarDapDescricaoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFcarDapDescricao = &SearchTxt
	&TFcarDapDescricao_Sel.SetEmpty()
	For Each trnscardapio
		Order carDapDescricao
		using trnscardapioWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &carDapCodigo1, &carDapDescricao1, &carDapMesAno1, &carDapMesAno_To1
					, &carDapNutricionista1, &carDapStatus1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &carDapCodigo2
					, &carDapDescricao2, &carDapMesAno2, &carDapMesAno_To2, &carDapNutricionista2, &carDapStatus2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &carDapCodigo3, &carDapDescricao3, &carDapMesAno3, &carDapMesAno_To3
					, &carDapNutricionista3, &carDapStatus3, &TFcarDapCodigo, &TFcarDapCodigo_To, &TFcarDapDescricao, &TFcarDapDescricao_Sel
					, &TFcarDapNutricionista, &TFcarDapNutricionista_Sel, &TFcarDapMesAno, &TFcarDapMesAno_To, &TFcarDapStatus_Sels, &TFcarDapLiberarAcesso_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnscardapio
			Order carDapDescricao
			&count += 1
		EndFor
		If not carDapDescricao.IsEmpty()
			&Option = carDapDescricao
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadcarDapNutricionistaOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFcarDapNutricionista = &SearchTxt
	&TFcarDapNutricionista_Sel.SetEmpty()
	For Each trnscardapio
		Order carDapNutricionista
		using trnscardapioWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &carDapCodigo1, &carDapDescricao1, &carDapMesAno1, &carDapMesAno_To1
					, &carDapNutricionista1, &carDapStatus1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &carDapCodigo2
					, &carDapDescricao2, &carDapMesAno2, &carDapMesAno_To2, &carDapNutricionista2, &carDapStatus2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &carDapCodigo3, &carDapDescricao3, &carDapMesAno3, &carDapMesAno_To3
					, &carDapNutricionista3, &carDapStatus3, &TFcarDapCodigo, &TFcarDapCodigo_To, &TFcarDapDescricao, &TFcarDapDescricao_Sel
					, &TFcarDapNutricionista, &TFcarDapNutricionista_Sel, &TFcarDapMesAno, &TFcarDapMesAno_To, &TFcarDapStatus_Sels, &TFcarDapLiberarAcesso_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnscardapio
			Order carDapNutricionista
			&count += 1
		EndFor
		If not usuNome.IsEmpty()
			&Option = carDapNutricionista.ToString()
			&OptionDesc = usuNome
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

