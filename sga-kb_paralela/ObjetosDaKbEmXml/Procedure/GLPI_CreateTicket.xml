  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// Declaração de variáveis (devem estar definidas no contexto ou como parâmetros)
LoadWWPContext( &wwPContext )

// Declaração de variáveis
&HttpClient    = new()
&HTTP_URL      =  &wwPContext.GLPI_URL + "/Ticket"
&HTTP_METHOD   = "POST"
&HTTP_STATUS   = 0
&HTTP_RESPONSE = ""
&TICKET_ID     = 0
&SUCCESS       = False
&ERROR_MESSAGE = ""

// Configurar headers
&HttpClient.AddHeader("App-Token", &wwPContext.APP_TOKEN)
&HttpClient.AddHeader("Session-Token", &wwPContext.USER_TOKEN)
&HttpClient.AddHeader("Content-Type", "application/json")

// Construir payload JSON com SDT
&TicketInput = new()
&TicketInput.name 				= &TICKET_TITLE
&TicketInput.content 			= &TICKET_DESCRIPTION
&TicketInput.priority 			= 3 // Média
&TicketInput.requesttypes_id 	= 1 // Solicitação
&TicketInput.type			    = 1 // Incidente
&TicketInput.users_id_recipient = &wwPContext.GLPI_USER_ID
&TicketInput.entities_id 		= &ENTITY_ID

// Wrap input em um objeto "input"
&Payload = new()
&Payload.Add( &TicketInput )
&HttpClient.AddString(&Payload.ToJson())

// Executar requisição
&HttpClient.Execute(&HTTP_METHOD, &HTTP_URL)

// Obter status e resposta
&HTTP_STATUS = &HttpClient.StatusCode
&HTTP_RESPONSE = &HttpClient.ToString()

If &HTTP_STATUS = 201 // Created
    &TicketResponse = new()
    &TicketResponse.FromJson(&HTTP_RESPONSE)

    If &TicketResponse.id > 0
        &TICKET_ID = &TicketResponse.id
        &SUCCESS = True
        &ERROR_MESSAGE = ""
    Else
        &SUCCESS = False
        &ERROR_MESSAGE = "Erro ao processar resposta da API"
    EndIf
Else
    &SUCCESS = False
    &ERROR_MESSAGE = "Erro HTTP: " + &HTTP_STATUS.ToString() + " - " + &HTTP_RESPONSE
EndIf
]]></Source>
