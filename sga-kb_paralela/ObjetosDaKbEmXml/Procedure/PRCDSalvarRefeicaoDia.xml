  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[for each trnsrefeicaotipo
	where prefCodigo   = &prefCodigo
	where refTipCodigo = &carPratoTurno
	      &carPratoHorario = refTipHorario
endFor		  
         
for each trnscardapioprato
	where prefCodigo      = &prefCodigo
    where carDapCodigo    = &carDapCodigo	
	where carPratoCodigo  = &carPratoCodigo
	where carPratoData    = &carPratoData
	where carPratoHorario = &carPratoHorario
	      exit
   when none	
	new
	  prefCodigo       = &prefCodigo
	  carDapCodigo     = &carDapCodigo
	  carPratoCodigo   = &carPratoCodigo
	  carPratoData     = &carPratoData
	  carPratoTurno    = &carPratoTurno
	  carPratoHorario  = &carPratoHorario
	endnew
endfor

]]></Source>
