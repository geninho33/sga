<Object parentGuid="afa47377-41d5-4ae8-9755-6f53150aa361" user="DESKTOP-OQ270FR\Geninho" versionDate="2024-06-24T01:35:26.0000000Z" lastUpdate="2024-06-18T04:15:12.0000000Z" checksum="807f8b8aea02f264714cb066dfa48b89" fullyQualifiedName="PRCDPopularRemessaAlimento" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="5a754b4e-75c2-4273-9bff-7147ca46f9c1" name="PRCDPopularRemessaAlimento" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Popular a tabela de Alimentos da Remessa">
  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&totalProdutos  = 0
&remItemPeriodo = &dataInicial.ToString() +  ' a ' + &dataFinal.ToString()
&carPratoRefeicao = 0
&carPratoCodigo   = 0

// Log.Write(!"Write message", !"MyCompany.Test.TestLoggingWrite",LogLEvel.DEBUG)
// Log.Error(!"Error message",!"Entrou 0" )

for each trnsremessaatendimento
	order prefCodigo,remCodigo,remLocal,remAreEnsCodigo,remAreEnsSequencial
	where prefCodigo  = &prefCodigo
	where remCodigo   = &remCodigo	
	// buscando o prato
	&total += ( remColesterol +  remDiabetico +  remNormal + remGluten + remLactose )
	
	for each trnscardapio, trnscardapioprato
	  order prefCodigo, carDapCodigo, carPratoData
	  where prefCodigo   = &prefCodigo
	  where carPratoData >= &dataInicial and carPratoData <= &dataFinal	  
	  where carDapStatus = 'A'
	  where carDapGruCodigo<>0
		&carPratoRefeicao = carPratoRefeicao
		&codigoGrupo      = PRCDBuscarGrupo(&prefCodigo,remLocal,remAreEnsCodigo,remAreEnsSequencial, carDapCodigo)
		
		// msg("Entrou em Grupo: " + &codigoGrupo.ToString() )
		
	    //if &codigoGrupo>0
		   
			for each trnspratosingredientes
				order prefCodigo, pratoCodigo, AreEnsCodigo, AreEnsSequencial
				where prefCodigo          = &prefCodigo
				where pratoCodigo         = &carPratoRefeicao
				where AreEnsCodigo        = remAreEnsCodigo
				where AreEnsSequencial    = remAreEnsSequencial when remAreEnsSequencial<>0
			    where pratIngrQuantidade>0
				where pratIngrTipoRemessa = &disTipNumero
					  &pratIngrQuantidade = pratIngrQuantidade*&total
					  &pratIngrProdCodigo = pratIngrProdCodigo
					 
					  PRCDSalvarRemessaAlimentos( &prefCodigo,
												  &remCodigo,
												  &pratIngrProdCodigo,
												  remAreEnsCodigo,
												  remAreEnsSequencial,
												  0,
												  1,
												  &pratIngrQuantidade,
												  0,
												  &dataInicial,
												  &dataFinal,
												  0)
			endfor
	    //endif
	endfor
endfor

&AtendimentoNormalSegunda = 0
]]></Source>
