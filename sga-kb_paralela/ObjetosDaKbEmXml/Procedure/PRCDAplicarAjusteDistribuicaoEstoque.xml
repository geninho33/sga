  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&tem = False

// varrendo os produtos distribuição
For Each
	   Where distRemCodigo    = &lanestRemessa
	   Where distLocalDestino = &lanestItemLocCodigo
	   Where prefCodigo       = &prefCodigo
	   Where distStatus       = 'A'
       &distCodigo      = distCodigo
	   For Each
		   Where prefCodigo      = &prefCodigo
		   Where distCodigo      = &distCodigo
		   Where distItemProduto = &lanestItemProdCodigo
		         distItemQtdeAntes  = distItemQuantidade
				 distItemQuantidade = (distItemQuantidade - &lanestItemQuantidade)
				 PRCDEstoqueMovimentacao(&distCodigo, &lanestItemProdCodigo, 0, &lanestItemQuantidade,'DD','N',distItemQtdeAntes)
				 &tem = True
	   EndFor
EndFor

if &tem
	for each
		where prefCodigo           = &prefCodigo
		where lanestcodigo         = &lanestCodigo
		where lanestItemLocCodigo  = &lanestItemLocCodigo
		where lanestItemProdCodigo = &lanestItemProdCodigo
              lanestItemStatus     = status.Ativo
	endfor
endif
]]></Source>
