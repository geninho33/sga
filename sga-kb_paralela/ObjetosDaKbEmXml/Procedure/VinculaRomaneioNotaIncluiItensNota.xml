  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&IsSucess = true
For each trnsnotaitens
	Where prefCodigo = &prefCodigo
	Where notaCodigo = &notaCodigo
	Where notaItemProduto = &notaItemProduto
	
	notaItemQtde += &notaItemQtde
when none
	New
		prefCodigo 		 = &prefCodigo
		notaCodigo 		 = &notaCodigo
		notaItemProduto  = &notaItemProduto
		notaItemQtde	 = &notaItemQtde
		notaItemValor	 = &notaItemValor
		notaItemValidade = &notaItemValidade
		notaItemLote	 = &notaItemLote
	When Duplicate
		&IsSucess = false
		&Message.Type = MessageTypes.Error
		&Message.Description = 'Erro de duplicidade na tentativa de incluir o item. Processo cancelado.'
	EndNew
Endfor
]]></Source>
