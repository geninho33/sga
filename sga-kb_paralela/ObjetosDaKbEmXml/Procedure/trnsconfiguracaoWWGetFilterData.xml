	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_PSNOME'
		Do 'LoadpsNomeOptions'
	Case &DDOName.ToUpper() = !'DDO_PSDESCRICAO'
		Do 'LoadpsDescricaoOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsconfiguracaoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsconfiguracaoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsconfiguracaoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFPSCODIGO"
				&TFpsCodigo.FromString(&GridStateFilterValue.Value)
				&TFpsCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFPSNOME"
				&TFpsNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPSNOME_SEL"
				&TFpsNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPSDESCRICAO"
				&TFpsDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPSDESCRICAO_SEL"
				&TFpsDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPSATRIBUTO_SEL"
				&TFpsAtributo_SelsJson = &GridStateFilterValue.Value
				&TFpsAtributo_Sels.FromJson(&TFpsAtributo_SelsJson)
			Case &GridStateFilterValue.Name = !"TFPSSTATUS_SEL"
				&TFpsStatus_SelsJson = &GridStateFilterValue.Value
				&TFpsStatus_Sels.FromJson(&TFpsStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'PSCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&psCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PSNOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&psNome1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PSDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&psDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PSSTATUS'
				&psStatus1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PSVALOR'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&psValor1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'PSCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&psCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PSNOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&psNome2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PSDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&psDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PSSTATUS'
					&psStatus2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PSVALOR'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&psValor2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'PSCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&psCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PSNOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&psNome3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PSDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&psDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PSSTATUS'
						&psStatus3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PSVALOR'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&psValor3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadpsNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFpsNome = &SearchTxt
	&TFpsNome_Sel.SetEmpty()
	For Each trnsconfiguracao
		Order psNome
		using trnsconfiguracaoWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &psCodigo1, &psNome1, &psDescricao1, &psStatus1
					, &psValor1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &psCodigo2, &psNome2
					, &psDescricao2, &psStatus2, &psValor2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &psCodigo3, &psNome3, &psDescricao3, &psStatus3, &psValor3, &TFpsCodigo
					, &TFpsCodigo_To, &TFpsNome, &TFpsNome_Sel, &TFpsDescricao, &TFpsDescricao_Sel, &TFpsAtributo_Sels
					, &TFpsStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsconfiguracao
			Order psNome
			&count += 1
		EndFor
		If not psNome.IsEmpty()
			&Option = psNome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadpsDescricaoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFpsDescricao = &SearchTxt
	&TFpsDescricao_Sel.SetEmpty()
	For Each trnsconfiguracao
		Order psDescricao
		using trnsconfiguracaoWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &psCodigo1, &psNome1, &psDescricao1, &psStatus1
					, &psValor1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &psCodigo2, &psNome2
					, &psDescricao2, &psStatus2, &psValor2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &psCodigo3, &psNome3, &psDescricao3, &psStatus3, &psValor3, &TFpsCodigo
					, &TFpsCodigo_To, &TFpsNome, &TFpsNome_Sel, &TFpsDescricao, &TFpsDescricao_Sel, &TFpsAtributo_Sels
					, &TFpsStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsconfiguracao
			Order psDescricao
			&count += 1
		EndFor
		If not psDescricao.IsEmpty()
			&Option = psDescricao
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

