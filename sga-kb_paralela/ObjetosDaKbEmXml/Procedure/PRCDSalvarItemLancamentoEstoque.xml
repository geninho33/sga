  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
LoadWWPContext.Call(&WWPContext)

// preparando as variaveis para lançar na auditoria
&AdmLogCha     = &prefCodigo.ToString().Trim() +'-'+ &lanestItemLocCodigo.ToString().Trim() +'-'+ &lanestItemProdCodigo.ToString().Trim()
&prodDescricao = &lanestItemProdCodigo.ToString().Trim() + ' - ' +   find(prodDescricao,prefCodigo = &prefCodigo and prodCodigo = &lanestItemProdCodigo, '' )
&locDescricao  = &lanestItemLocCodigo.ToString().Trim() + ' - ' +   find( locDescricao,prefCodigo = &prefCodigo and locCodigo = &lanestItemLocCodigo, '' )
&AdmLogDad     = '==>> Codigo Lista :' + &lanestcodigo.ToString().Trim() +
                 '- Unidade Escolar : ' + &locDescricao +
			     '- Produto : ' + &prodDescricao +
			     ' - Qtde Atual ' + &lanestItemQuantidade.ToString().Trim()

for each
	Where prefCodigo = &prefCodigo
	where lanestcodigo = &lanestcodigo
    where lanestItemLocCodigo = &lanestItemLocCodigo
    where lanestItemProdCodigo = &lanestItemProdCodigo
      if lanestItemQuantidade <> &lanestItemQuantidade
	     PRCDAtualiarEstoqueUE(&prefCodigo,&lanestItemLocCodigo,&lanestItemProdCodigo,lanestItemQuantidade,'S',0,'Unidade')
		 PRCDAtualiarEstoqueUE(&prefCodigo,&lanestItemLocCodigo,&lanestItemProdCodigo,&lanestItemQuantidade,'E',0,'Unidade')
	  endif
      &AdmLogDad          += ' - Qtde Anterior: ' + lanestItemQuantidade.ToString().Trim()
	  lanestItemQuantidade = &lanestItemQuantidade
	  lanestItemObservacao = &lanestItemObservacao
	  lanestItemValidade   = &lanestItemValidade
	  lanestItemAlteracao  = servernow()
when none
	if &lanestItemQuantidade>0 or not &lanestItemObservacao.IsEmpty()
		new
			prefCodigo           = &prefCodigo
			lanestcodigo         = &lanestcodigo
			lanestItemLocCodigo  = &lanestItemLocCodigo
			lanestItemProdCodigo = &lanestItemProdCodigo
			lanestItemQuantidade = &lanestItemQuantidade
			lanestItemObservacao = &lanestItemObservacao
			lanestItemValidade   = &lanestItemValidade
			//lanestItemAlteracao  = servernow()

			lanestItemCadastro   = servernow()
			lanestItemUserName   = &WWPContext.locCodigo.ToString()
			lanestItemStatus     =  Status.Ativo
			PRCDAtualiarEstoqueUE(&prefCodigo,&lanestItemLocCodigo,&lanestItemProdCodigo,&lanestItemQuantidade,'E',0,'Unidade')
			&AdmLogDad          += ' - Qtde Anterior: 0,00'
		endNew
	endif
endFor

PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, &Mode, &AdmLogDad)
]]></Source>
