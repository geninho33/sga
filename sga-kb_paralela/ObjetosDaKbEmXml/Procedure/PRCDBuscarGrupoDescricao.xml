  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[for each trnscardapiogrupo
  where prefCodigo   = &prefCodigo
  where carGruCodigo = &carDapGruCodigo
        &grupDescricao   = carGruDescricao
	    if carGruStatus = 'I'
		   &grupDescricao += ' ( Inativo )'
	    endif	
when none 
   &grupDescricao = 'Sem Grupo '
endfor			
]]></Source>
