  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
&DataInicial.Set(&distDataEnvio.Year(),&distDataEnvio.Month(),1)
&DataFinal = &DataInicial.EndOfMonth()
&rotaCodigo.FromJson(&rotaCodigoJson)
&Linha = 0
&Coluna = 0
&Locais = 0
&Titulo1 = 'Alimentação Escolar - Largada %1'
&IsSucess = true

For each
	Where disTipNumero = &distItemTipoRemessa

	&Titulo1 = format(&Titulo1,disTipDescricao)
When none
	&Titulo1 = format(&Titulo1,'(Desconhecido)')
Endfor

&ExcelDocument.Open(&Arquivo)
&ExcelDocument.AutoFit = true

/* Rotas */
For each trnsdistribuicao
	Order prefCodigo,distRotaCodigo
	Unique prefCodigo,distRotaCodigo
	Where prefCodigo 	= &prefCodigo
	Where distStatus	= Status.Ativo
	Where distRotaCodigo in &rotaCodigo                                 When &rotaCodigo.Count>0
	where distRemCodigo = &distRemCodigo                                when &distRemCodigo<>0
	Where distCodigoTipoRemessa = &distItemTipoRemessa                  when &distRemCodigo=0
	Where distDataEnvio = &distDataEnvio                                When not &Mensal and &distRemCodigo=0
	Where distDataEnvio >= &DataInicial and distDataEnvio <= &DataFinal When &Mensal and &distRemCodigo=0

	&distRotaCodigo = distRotaCodigo

	if &Mensal
		&Titulo2 = format('Rota: %1 - Mes/Ano: %2/%3',&distRotaCodigo.ToString().Trim(),&distDataEnvio.MonthName(),&distDataEnvio.Year().ToString().Trim())
	else
		&Titulo2 = format('Rota: %1 - Data: %2',&distRotaCodigo.ToString().Trim(),&distDataEnvio.ToFormattedString())
	endif

	&Linha += 1
	&ExcelDocument.Cells(&Linha,2).Text = &Titulo1
	&ExcelDocument.Cells(&Linha,2).Bold = true
	&ExcelDocument.Cells(&Linha,2).Size = 15

	&Linha += 1
	&ExcelDocument.Cells(&Linha,2).Text = &Titulo2
	&ExcelDocument.Cells(&Linha,2).Bold = true
	&ExcelDocument.Cells(&Linha,2).Size = 15

	&Linha += 1 // Linha em branco

	do 'LocaisHeader'
	if not &IsSucess
		Exit
	endif

	do 'Produtos'
	if not &IsSucess
		Exit
	endif

	&Linha += 2 // Linhas em branco

	do 'Legenda'

	&Linha += 5 // Linhas em branco
When none
	&Message.Type = MessageTypes.Error
	&Message.Id = 'Rotas'
	&Message.Description = 'Nenhuma rota localizada'
	&IsSucess = False
Endfor

// Grava e fecha a planilha
&ExcelDocument.Close()

if not &IsSucess
	&File.Source = &Arquivo
	&File.Delete()
endif


Sub 'Produtos'

	&Item = 0
	For each trnsdistribuicaoitens
		Order prefCodigo, distItemProdutoDescricao
		Unique distItemProduto, distItemProdutoDescricao
		Where prefCodigo 	 = &prefCodigo
		Where distRotaCodigo = &distRotaCodigo
		Where distDataEnvio  = &distDataEnvio                               When not &Mensal and &distRemCodigo=0
		Where distDataEnvio >= &DataInicial and distDataEnvio <= &DataFinal When &Mensal and &distRemCodigo=0
		Where distItemTipoRemessa = &distItemTipoRemessa                    when &distRemCodigo=0

		&Item += 1
		&distItemProduto = distItemProduto

		&Linha += 1
		&ExcelDocument.Cells(&Linha,2).Number = &Item
		&ExcelDocument.Cells(&Linha,2).Size = 12

		&ExcelDocument.Cells(&Linha,3).Text = distItemProdutoDescricao
		&ExcelDocument.Cells(&Linha,3).Size = 12

		&Coluna = 3
		do 'Locais'

	When none
		&Message.Type = MessageTypes.Error
		&Message.Id = 'Produtos'
		&Message.Description = format('Não existem registros de Produtos para a Rota: %1',&distRotaCodigo.ToString().Trim())
		&IsSucess = False
	Endfor

Endsub

Sub 'Locais'

	&TotaldistItemQuantidade = 0
	for &distLocalDestino in &distLocalDestinoCollection

		&Coluna += 1
		&SomadistItemQuantidade = 0

		For each trnsdistribuicaoitens
			Where prefCodigo 	 = &prefCodigo
			Where distDataEnvio  = &distDataEnvio When not &Mensal and &distRemCodigo=0
			Where distDataEnvio >= &DataInicial and distDataEnvio <= &DataFinal When &Mensal and &distRemCodigo=0
			Where distRotaCodigo = &distRotaCodigo
			Where distLocalDestino = &distLocalDestino
			Where distItemProduto = &distItemProduto

			&SomadistItemQuantidade += distItemQuantidade
		Endfor

		if &SomadistItemQuantidade > 0
			&ExcelDocument.Cells(&Linha,&Coluna).Number = &SomadistItemQuantidade
			&ExcelDocument.Cells(&Linha,&Coluna).Size = 12

			&TotaldistItemQuantidade += &SomadistItemQuantidade
		endif

	endfor

	&Coluna += 1
	&ExcelDocument.Cells(&Linha,&Coluna).Number = &TotaldistItemQuantidade
	&ExcelDocument.Cells(&Linha,&Coluna).Size = 12

Endsub

Sub 'LocaisHeader'

	&distLocalDestinoCollection.Clear()
	&Coluna = 3
	&Linha += 1
	&ExcelDocument.Cells(&Linha,&Coluna).Text = 'Itens'
	&ExcelDocument.Cells(&Linha,&Coluna).Bold = true
	&ExcelDocument.Cells(&Linha,&Coluna).Size = 12

	For each trnsdistribuicao
		Order distLocalDestino
		Unique distLocalDestino
		Where prefCodigo 	 = &prefCodigo
		Where distRotaCodigo = &distRotaCodigo
		Where distDataEnvio  = &distDataEnvio                               When not &Mensal and &distRemCodigo=0
		Where distDataEnvio >= &DataInicial and distDataEnvio <= &DataFinal When &Mensal and &distRemCodigo=0
		Where distCodigoTipoRemessa = &distItemTipoRemessa                  when &distRemCodigo=0

		&distLocalDestinoCollection.Add(distLocalDestino)

		&locCodigo = distLocalDestino
		do 'BuscaCodigoLargada'

		&Coluna += 1
		&ExcelDocument.Cells(&Linha,&Coluna).Number = iif(&locCodigoLargada.IsEmpty(),distLocalDestino,&locCodigoLargada)
		&ExcelDocument.Cells(&Linha,&Coluna).Bold = true
		&ExcelDocument.Cells(&Linha,&Coluna).Size = 12

	When none
		&Message.Type = MessageTypes.Error
		&Message.Id = 'LocaisHeader'
		&Message.Description = format('Não existem registros de Locais para a Rota: %1',&distRotaCodigo.ToString().Trim())
		&IsSucess = False
	Endfor

	&Coluna += 1
	&ExcelDocument.Cells(&Linha,&Coluna).Text = '      Total'
	&ExcelDocument.Cells(&Linha,&Coluna).Bold = true
	&ExcelDocument.Cells(&Linha,&Coluna).Size = 12

Endsub

Sub 'Legenda'
	&Locais = 0
	&Coluna = 2
	&Linha += 1
	&ExcelDocument.Cells(&Linha,&Coluna).Text = 'Unidades (locais):'
	&ExcelDocument.Cells(&Linha,&Coluna).Bold = true
	&ExcelDocument.Cells(&Linha,&Coluna).Size = 12
	&Coluna = 4
	&ExcelDocument.Cells(&Linha,&Coluna).Text = 'Seq'
	&ExcelDocument.Cells(&Linha,&Coluna).Bold = true
	&ExcelDocument.Cells(&Linha,&Coluna).Size = 12

	For each trnslocal
		Where prefCodigo = &prefCodigo
		Where locCodigo in &distLocalDestinoCollection

		&Locais += 1
		&Coluna = 2
		&Linha += 1
		if not locCodigoLargada.IsEmpty()
			&ExcelDocument.Cells(&Linha,&Coluna).Number = locCodigoLargada
		else
			&ExcelDocument.Cells(&Linha,&Coluna).Number = locCodigo
		endif
		&ExcelDocument.Cells(&Linha,&Coluna).Size = 12
		&Coluna = 3
		&ExcelDocument.Cells(&Linha,&Coluna).Text = locDescricao
		&ExcelDocument.Cells(&Linha,&Coluna).Size = 12
		&Coluna = 4
		&ExcelDocument.Cells(&Linha,&Coluna).Text = &Locais.ToString().Trim()
		&ExcelDocument.Cells(&Linha,&Coluna).Size = 12

	Endfor

EndSub

Sub 'BuscaCodigoLargada'
	&locCodigoLargada = find(locCodigoLargada,prefCodigo = &prefCodigo and locCodigo = &locCodigo)
Endsub
]]></Source>
