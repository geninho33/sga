  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&totalLocais =  0
&carGruCodigo = 0
&carGru.Clear()

for each trnscardapio
	where prefCodigo = &prefCodigo
	where carDapMesAno.Month() = &dataFinal.Month() and carDapMesAno.Year() = &dataFinal.Year()
	where carDapStatus = 'A'
	where carDapGruCodigo<>0
	      PRCDSalvarRemessaCardapio(&prefCodigo,&remCodigo,carDapCodigo)
      	  &carGru.Add( carDapGruCodigo )
endfor

for &carGruCodigo in &carGru
	for each Atendimento
		order prefCodigo, carGruCodigo
		where carGruCodigo = &carGruCodigo
		where prefCodigo   = &prefCodigo
			  PRCDSalvarRemessaAtendimento( &prefCodigo,
											&remCodigo,
											locCodigo,
											AreEnsCodigo,
											AreEnsSequencial,
											AtendimentoTurno,
											AtendimentoNormalSegunda,
											AtendimentoColesterolSegunda,
											AtendimentoDiabeticoSegunda,
											AtendimentoGlutenSegunda,
											AtendimentoLactoseSegunda)
		&totalLocais += 1
	endFor
endFor

if &totalLocais>0
   // msg('Total de Unidades Atendidas : ' + &totalLocais.tostring())
endif

if &carGru.count = 0
   msg('Não tem cardápio gerado para este período !')
endif
]]></Source>
