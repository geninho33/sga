	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

LoadWWPContext.Call(&WWPContext)

Do Case
	Case &ComboName = !'notaItemProduto'
		Do 'LoadComboItems_notaItemProduto'
EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadComboItems_notaItemProduto'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For Each
		Order prodDescricao
		Where prefCodigo = &prefCodigo and
prodStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = prodCodigo.ToString().Trim()
		&Combo_DataItem.Title = prodDescricao
		&Combo_Data.Add(&Combo_DataItem)
	EndFor
	If &TrnMode <> TrnMode.Insert
		For Each trnsnotaitens
			Where prefCodigo = &prefCodigo
			Where notaCodigo = &notaCodigo
			Where notaItemProduto = &notaItemProduto

			&SelectedValue = iif(notaItemProduto.IsEmpty(), '', notaItemProduto.ToString().Trim())
		EndFor
	Else
		If Not &notaItemProduto.IsEmpty()
			&SelectedValue = &notaItemProduto.ToString().Trim()
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

]]></Source>
