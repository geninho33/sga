  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&Title           = 'Relatório de Estoque - '
&AppName         = 'Sistema de Gestão de Alimentação Escolar'
&numeroLinha     = 0
&Page            = 0
&linhas 		 = 0
&estoUeLocCodigo = 0

LoadWWPContext.Call(&WWPContext)
&prefCodigo = &WWPContext.prefCodigo

For each  trnsprodutos, TRNSEstoqueUE
	order prefCodigo, estoUeLocCodigo, prodDescricao
	where prefCodigo = &prefCodigo
	where prodCodigo = estoUeProdCodigo
	where estoUeLocCodigo = &locCodigo when &locCodigo<>0
	where estoUeSaldo > 0
	where prodStatus = 'A'
		  &estoUeProdCodigo      = estoUeProdCodigo
		  &estoUeProdDescricao   = prodDescricao
		  &estoUeProdOBSConsumo  = find(uniDescricao,uniCodigo=prodUnidMedConsumo and prefCodigo = &prefCodigo,'')
		  &estoUeSaldo 			 = estoUeSaldo
		  &estoUeAlteracao 		 = estoUeAlteracao
	      &estoUeTipDistribuicao = find( disTipDescricao , prefCodigo = &prefCodigo and disTipNumero = prodCodigoTipoRemessa,'')
		  if &linhas = 0 or &linhas>56 or &estoUeLocCodigo<>estoUeLocCodigo
		     &linhas = 0
			 if &estoUeLocCodigo<>estoUeLocCodigo
				&estoUeLocCodigo = estoUeLocCodigo
				Do 'TituloUnidade'
				Eject
			 endif
		     Do 'Cabecalho'
		  endif

	// &prodCodigo       = distItemProduto
	print printDados
	&estoUeLocCodigo = estoUeLocCodigo
	&linhas         +=1

endFor

sub 'TituloUnidade'
   for each
       where prefCodigo = &prefCodigo
	   where locCodigo = &estoUeLocCodigo
		     &Title = 'Relatório de Estoque - ' + locDescricao
   endfor
endSub


sub 'Cabecalho'
	For each
	 	where prefCodigo = &prefCodigo
              &prefLogo =  prefLogo
	          print printCabecalho
	          print printCabecalhoDados
 	endFor
endSub
]]></Source>
