    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

LoadWWPContext.Call(&WWPContext)

Do Case
	Case &ComboName = !'notaFornecedor'
		Do 'LoadComboItems_notaFornecedor'
EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadComboItems_notaFornecedor'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For Each
		Order forNome
		Where prefCodigo = &prefCodigo and forStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = forCodigo.ToString().Trim()
		&Combo_DataItem.Title = forNome
		&Combo_Data.Add(&Combo_DataItem)
	EndFor
	If &TrnMode <> TrnMode.Insert
		For Each trnsnota
			Where prefCodigo = &prefCodigo
			Where notaCodigo = &notaCodigo

			&SelectedValue = iif(notaFornecedor.IsEmpty(), '', notaFornecedor.ToString().Trim())
		EndFor
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

]]></Source>
