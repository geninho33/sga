  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call( &WWPContext )
&data = now()
&lanestcodigo = 0
&tem          = False

for each trnslancarestoqueUE
	where prefCodigo               = &prefCodigo
	where lanestdatInicial.Month() = &data.Month()
	where lanestdatInicial.Year()  = &data.Year()
      &lanestcodigo = lanestcodigo
	  for each trnslancarestoqueUEitem
		  where lanestcodigo        = &lanestcodigo
		  where lanestItemLocCodigo = &locCodigo
           &tem = true
        exit
	  endfor
endfor

if &lanestcodigo = 0

	&lanestcodigo = PRCDGerarNovoCodigo('Lancar Estoque')
	&mes          = &data.Month() -1
	&ano          = &data.Year()

	if &mes = 0
	   &mes = 12
	   &ano = &data.Year() -1
	endif

	new
		prefCodigo  	    = &prefCodigo
		lanestcodigo 	    = &lanestcodigo
		lanestdatInicial    = date.New(&data.Year(),&data.Month(),1)
		lanestdatFinal      = &data.EndOfMonth()
		lanestCadastro      = serverNow()
        lanestAlteracao     = serverNow()
        lanestUsername      = &WWPContext.UserName
		lanestStatus        = Status.Ativo
		lanestObs           = 'Saldo de Fechamento de ' + &mes.ToString().Trim() + '/' + &ano.ToString().Trim()
		lanestTipoRemessa   = 0
		lanestCodigoRemessa = 0
	endnew
endif

if not &tem and &lanestcodigo<>0
	&mesAno = &data - 15
	for each trnsprodutos
		order prefCodigo, prodCodigoTipoRemessa, prodDescricao
		where prefCodigo = &prefCodigo
		where prodStatus = 'A'
			  &lanestItemQuantidade = PRCDAnaliseEstoque(&prefCodigo,&locCodigo,prodCodigo,&mesAno)
			  &estoUeCodigo = 0
			  &estoUeCodigo = find(estoUeCodigo,prefCodigo = &prefCodigo and estoUeProdCodigo = prodCodigo and estoUeLocCodigo = &locCodigo, 0 )
			  if &lanestItemQuantidade < 0
				 &lanestItemQuantidade = 0
			  endif
			  new
				lanestcodigo              = &lanestcodigo
				lanestItemLocCodigo       = &locCodigo
				lanestItemProdCodigo      = prodCodigo
				lanestItemQuantidade      = &lanestItemQuantidade
				lanestItemStatus          = Status.Ativo
				lanestItemTipoRemessa     = prodCodigoTipoRemessa
				lanestItemCadastro        = serverNow()
				lanestItemAlteracao       = serverNow()
				lanestItemUserName        = &WWPContext.UserName
				// lanestItemValidade        =
				// lanestItemObservacao      = ''
			  endNew
		      if &estoUeCodigo<>0
			     PRCDSalvarSaldoUE(&prefCodigo, &estoUeCodigo, &lanestItemQuantidade,prodCodigo,&locCodigo )
			  endif

	endFor
endif
]]></Source>
