    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

LoadWWPContext.Call(&WWPContext)

Do Case
	Case &ComboName = !'locCodigo'
		Do 'LoadComboItems_locCodigo'
EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadComboItems_locCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For Each
		Order locDescricao
		Where prefCodigo = &prefCodigo and locStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = locCodigo.ToString().Trim()
		&Combo_DataItem.Title = locDescricao
		&Combo_Data.Add(&Combo_DataItem)
	EndFor
	If &TrnMode <> TrnMode.Insert
		For Each Atendimento
			Where prefCodigo = &prefCodigo
			Where AtendimentoCodigo = &AtendimentoCodigo

			&SelectedValue = iif(locCodigo.IsEmpty(), '', locCodigo.ToString().Trim())
		EndFor
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

]]></Source>
