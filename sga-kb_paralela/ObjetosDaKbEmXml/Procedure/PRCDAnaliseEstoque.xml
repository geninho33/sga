  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&estoUeSaldo = 0


for each
	order prefCodigo, (lanestcodigo)
	where lanestStatus = 'A'
	where prefCodigo   = &prefCodigo
		  &lanestCodigo = lanestcodigo
		  exit
endfor

for each trnsdistribuicao, trnsdistribuicaoitens
	order distDataEnvio
	where prefCodigo            = &prefCodigo
	where lanestcodigo 			= &lanestCodigo
	where distLocalDestino      = &locCodigo
	where distDataEnvio.Month() = &dataCorrente.Month()
	where distDataEnvio.year()  = &dataCorrente.year()
	where distItemProduto       = &prodCodigo
	where distStatus            = 'A'
	where distReceber           = 'S'
	      &estoUeSaldo         += distItemQuantidade
Endfor

/*
for each
	order prefCodigo, lanestItemAlteracao
	where lanestItemLocCodigo         = &locCodigo
	where prefCodigo                  = &prefCodigo
	where lanestItemAlteracao.Month() = &dataCorrente.Month()
	where lanestItemAlteracao.year()  = &dataCorrente.year()
	where lanestItemProdCodigo        = &prodCodigo
	  	  &estoUeSaldo               += lanestItemQuantidade
endfor
*/

for each
	order prefCodigo, mapaUeData
	where prefCodigo         = &prefCodigo
	where mapaUeLocCodigo    = &locCodigo
	where mapaUeData.Month() = &dataCorrente.Month()
	where mapaUeData.year()  = &dataCorrente.year()
	where mapaUeProdCodigo   = &prodCodigo
	  	  &estoUeSaldo      -= mapaUeQuantidade
endFor
]]></Source>
