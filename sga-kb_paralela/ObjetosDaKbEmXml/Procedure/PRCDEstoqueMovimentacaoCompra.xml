  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// Log.Write(!"Write message", !"MyCompany.Test.TestLoggingWrite",LogLEvel.DEBUG)
// Log.Error(!" "+&tipo,!"Tipo : " )

LoadWWPContext.Call(&WWPContext)
&tem         = false
&saldoMexido = false
&saldo 		 = 0
&prefCodigo  = &WWPContext.prefCodigo
&tipoRT		 = &tipo

// PGeraLog.Call(&Pgmname, 'Prod. Cod. : ' + &prodCodigo.ToString().Trim() + '-  Quantidade: ' + &quantidade.ToString().Trim() + ' |   &uniConvUnidadeOrigem : ' + &uniConvUnidadeOrigem.ToString() )	

if &uniConvUnidadeOrigem>0

	for each
		where prefCodigo           = &prefCodigo
		where uniConvUnidadeOrigem = &uniConvUnidadeOrigem
	      &quantidadeReal  = &quantidade*uniConvQtdeGerar
	      &unidade         = uniConvUnidadeDestino
	      &uniDescricao    = uniConDestinoDescricao
	endFor

    if &quantidadeReal = 0 
		&quantidadeReal = &quantidade
	endif	
else
	&quantidadeReal = &quantidade
endif

if &locaCodigo = 0
	for each
		where notaCodigo = &codigo
		where prefCodigo = &prefCodigo
              &locaCodigoLocal = notaLocal
	endFor
else
	&locaCodigoLocal = &locaCodigo
endif

if &locaCodigoLocal = 0
   &locaCodigoLocal = prefLocalDeposito
endif

if &unidade = 0
	for each
		where prefCodigo = &prefCodigo
	    where prodCodigo = &prodCodigo
		// where prodLocalCodigo = &locaCodigoLocal
		
          &saldo   = prodSaldo
          &unidade = prodUnidMedCompra
		  For each
			  where prefCodigo = &prefCodigo
		      where uniCodigo  = &unidade
               &uniDescricao = uniDescricao
		  EndFor
	endfor
endif

// PGeraLog.Call(&Pgmname, 'Lançamento de Estoque : ' + &prodCodigo.ToString().Trim() + '-  Qtdade: ' + &quantidadeReal.ToString().Trim()+ ' | Novo saldo: ' + &saldo.ToString().Trim() )	

new 
 estoCodigo = PRCDGerarNovoCodigo('estoque')
 estoNfCodigo = &codigo
 if &tipoRT= 'C'
	estoNfCodigo = &codigo
	estoTipo     = 'E'
 else
	estoTipo     = 'F'
 endif

 prefCodigo       = &prefCodigo
 estoLocal        = &locaCodigoLocal
 estoProduto      = &prodCodigo
 estoQuantidade   = &quantidadeReal
 estoUnidade      = &unidade
 estoUnidadeSigla = &uniDescricao
 estoSaldo        = &saldo
 estoUserName	  = GAMUser.GetEmail()
endNew

PRCDEstoqueAtualizar(&prodCodigo,&locaCodigoLocal,&quantidadeReal,&tipoRT)
&retorno = 'A'
]]></Source>
