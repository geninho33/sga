  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// Declaração de variáveis (devem estar definidas no contexto ou como parâmetros)
LoadWWPContext( &wwPContext )

// Declaração de variáveis
&HttpClient = new()
&SEARCH_URL = &wwPContext.GLPI_URL + "/search/User?criteria[0][field]=9&criteria[0][searchtype]=equals&criteria[0][value]=" + &wwPContext.login
&HTTP_METHOD = "GET"
&HTTP_STATUS = 0
&HTTP_RESPONSE = ""
&USER_ID = 0
&SUCCESS = False
&ERROR_MESSAGE = ""

// Configurar headers
&HttpClient.AddHeader("App-Token", &wwPContext.APP_TOKEN)
&HttpClient.AddHeader("Session-Token", &wwPContext.USER_TOKEN)


// Executar requisição
&HttpClient.Execute(&HTTP_METHOD, &SEARCH_URL)

// Obter status e resposta
&HTTP_STATUS = &HttpClient.StatusCode
&HTTP_RESPONSE = &HttpClient.ToString()

If &HTTP_STATUS = 200
    &UserSearchResponse = new()
    &UserSearchResponse.FromJson(&HTTP_RESPONSE)

    If &UserSearchResponse.Count > 0
       &USER_ID = &UserSearchResponse.Item(1).id
       &SUCCESS = True
       &ERROR_MESSAGE = ""
    Else
       &USER_ID = 0
       &SUCCESS = True
       &ERROR_MESSAGE = "Usuário não encontrado"
    EndIf
Else
    &SUCCESS = False
    &ERROR_MESSAGE = "Erro HTTP: " + &HTTP_STATUS.ToString()
EndIf
]]></Source>
