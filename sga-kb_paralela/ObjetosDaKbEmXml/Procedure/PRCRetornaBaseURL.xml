  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[			
&BaseURL = &HTTPRequest.ScriptPath
//&BaseURL = strreplace(&BaseURL, 'https://', '')
//&BaseURL = strreplace(&BaseURL, 'http://', '')
&Host    = &HTTPRequest.ServerHost

&Ret     = &BaseURL.Matches('sge\d{4}')
			
for &match in &Ret     
	&MunCod.FromString(&match.Value.Substring(4,4))
	Exit
endfor		


]]></Source>
