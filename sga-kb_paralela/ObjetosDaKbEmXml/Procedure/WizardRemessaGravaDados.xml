  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
// Carrega dados Context
LoadWWPContext(&WWPContext)
&prefCodigo = &WWPContext.prefCodigo

// Carrega dados do WizardData e das guias
&WizardData.FromXML(FileXmlToWizardData(&WebSessionKey))
//&WizardData.FromJson(&WebSession.Get(&WebSessionKey))
//&GuiasGrid.FromJson(&WebSession.Get(&WebSessionKey + !'_Guias'))
//&WizardData.Guias.Grid.FromJson(&GuiasGrid.ToJson())
//log.Info(&WizardData.ToJson(),&Pgmname+'.WIZARDDATA')

/* Carrega coleção de grupos de Cardápio do período */
&CarGruCodigoCollection.FromJson(&Websession.Get(!'WizardRemessa_carDapGruCodigoCollection'))

do 'GeraRemessa'

do 'GeraDistribuicao'

&IsSucess = true
&Message.Type = MessageTypes.Info
&Message.Id = 'OK'
&Message.Description = 'Processo finalizado com sucesso!'


Sub 'GeraRemessa'

	/* Registra remessa */
	&dataInicial = &WizardData.Periodo.DataInicial
	&dataFinal   = &WizardData.Periodo.DataFinal
	&remCodigo	 = PRCDGerarNovoCodigo('remessas')

	New
		prefCodigo		 = &prefCodigo
		remCodigo		 = &remCodigo
		remStatus		 = Status.Ativo
		remCadastro		 = ServerDate()
		remAlteracao	 = ServerDate()
		remUsuario		 = &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
		remGerSemana1Ini = &dataInicial
		remGerSemana1Fim = remGerSemana1Ini.AddDays(6)

		if remGerSemana1Fim < &dataFinal
			remGerSemana2Ini = remGerSemana1Fim.AddDays(1)
			remGerSemana2Fim = iif(remGerSemana2Ini.AddDays(6) > &dataFinal,&dataFinal,remGerSemana2Ini.AddDays(6))
		endif

		if not remGerSemana2Fim.IsEmpty() and remGerSemana2Fim < &dataFinal
			remGerSemana3Ini = remGerSemana2Fim.AddDays(1)
			remGerSemana3Fim = iif(remGerSemana3Ini.AddDays(6) > &dataFinal,&dataFinal,remGerSemana3Ini.AddDays(6))
		endif

		if not remGerSemana3Fim.IsEmpty() and remGerSemana3Fim < &dataFinal
			remGerSemana4Ini = remGerSemana3Fim.AddDays(1)
			remGerSemana4Fim = iif(remGerSemana4Ini.AddDays(6) > &dataFinal,&dataFinal,remGerSemana4Ini.AddDays(6))
		endif

		if not remGerSemana4Fim.IsEmpty() and remGerSemana4Fim < &dataFinal
			remGerSemana5Ini = remGerSemana4Fim.AddDays(1)
			remGerSemana5Fim = &dataFinal
		endif

		remRancho		 = true
	EndNew

	/* Registra atendimento da remessa */
	&AtendimentoCodigoCollection.FromJson(&WizardData.Atendimento.IgnorarAtendimentoJson)

	for &GridLocaisItem in &WizardData.Atendimento.GridLocais

		For each Atendimento
			Where prefCodigo = &prefCodigo
			Where locCodigo = &GridLocaisItem.locCodigo
			Where carGruCodigo in &CarGruCodigoCollection
			Where carGruStatus = Status.Ativo
			Where not AtendimentoCodigo in &AtendimentoCodigoCollection

			New
				prefCodigo			= &prefCodigo
				remCodigo			= &remCodigo
				remLocal			= locCodigo
				remAreEnsCodigo		= AreEnsCodigo
				remAreEnsSequencial = AreEnsSequencial
				remAreEnsTurno		= AtendimentoTurno
				remNormal			= AtendimentoNormalSegunda
			Endnew
		Endfor

	endfor

	/* Registra itens da remessa */
	for &GuiasGridItem in &WizardData.Guias.Grid

		For each trnsremessaitem
			where prefCodigo	 = &prefCodigo
			where remCodigo  	 = &remCodigo
			where remItemProduto = &GuiasGridItem.prodCodigo
				remItemQtde		 += &GuiasGridItem.Quantidade
				remItemPesoTotal += &GuiasGridItem.Quantidade * &GuiasGridItem.prodPesoConsumo
		When none
			New
				prefCodigo		 = &prefCodigo
				remCodigo		 = &remCodigo
				remItemCodigo	 = PRCDGerarNovoCodigo('remessaItem')
				remItemPeriodo	 = format('%1 a %2',&dataInicial.ToString(),&dataFinal.ToString())
				remItemProduto	 = &GuiasGridItem.prodCodigo
				remItemQtde		 = &GuiasGridItem.Quantidade
				remItemPesoTotal = &GuiasGridItem.Quantidade * &GuiasGridItem.prodPesoConsumo
			EndNew
		Endfor

	endfor

Endsub

Sub 'GeraDistribuicao'

	&distDataEnvio  = &WizardData.Periodo.DataEnvio
	&remTipoRemessa = &WizardData.Alimentos.prodCodigoTipoRemessa

	/* Busca local de origem */
	For each
		Where prefCodigo = &prefCodigo
	  	&distLocalOrigem = prefLocalDeposito
  	When none
	  	&distLocalOrigem = 0
	Endfor

	&locCodigo = 0
	for &GuiasGridItem in &WizardData.Guias.Grid

		if &GuiasGridItem.locCodigo <> &locCodigo

			/* Registra cabeçalho da Distribuição */
			&distCodigo = PRCDGerarNovoCodigo('distribuicao')
			&locCodigo	= &GuiasGridItem.locCodigo
			&distObservacao = &GuiasGridItem.distObservacao

			New
				prefCodigo 		      = &prefCodigo
				distCodigo            = &distCodigo
				distDataEnvio         = &distDataEnvio
				distRemCodigo	      = &remCodigo
				distLocalOrigem       = &distLocalOrigem
				distLocalDestino      = &locCodigo
				distRotaCodigo        = PRCDBuscarRota(&prefCodigo,&locCodigo)
				distStatus            = Status.Ativo
				distPeriodo           = format('%1 a %2',&dataInicial.ToString(),&dataFinal.ToString())
				distCodigoTipoRemessa = &remTipoRemessa
				distDataCadastro      = serverNow()
				distDataAlteracao     = serverNow()
				distUserName          = &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
				distObservacao		  = &distObservacao
			Endnew

		endif

		/* Grava produto */
		New
			distCodigo			= &distCodigo
			prefCodigo			= &prefCodigo
			distItemProduto		= &GuiasGridItem.prodCodigo
			distItemQuantidade	= &GuiasGridItem.Quantidade
			distItemPesoTotal	= (&GuiasGridItem.prodPesoConsumo * &GuiasGridItem.Quantidade)
			distItemStatus		= Status.Ativo
		EndNew

		/* Atualiza estoque */
		PRCDEstoqueMovimentacao(&distCodigo,&GuiasGridItem.prodCodigo,&distLocalOrigem,&GuiasGridItem.Quantidade,'D','N',0,&Retorno)

	endfor

Endsub
]]></Source>
