  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
If &IsEditableByUser
	&VarValue = LoadUserKeyValue(&VarProgramName + !'.' + &VarName)
Else
	&VarValue = WWP_GetSystemParameter(!'CF_' + &VarProgramName + !'_' + &VarName)
EndIf
If &VarValue.IsEmpty()
	&VarValue = &DefValue
EndIf
]]></Source>
