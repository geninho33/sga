  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call(&WWPContext)
For each
	where prefCodigo = &prefCodigo
	where croCodigo  = &croCodigo
		  &forCodigo      = forCodigo
		  &croMarca       = croMarca
		  &prodCodigo     = prodCodigo
		  &croDtInicial   = croDtInicial
		  &croDtFinal     = croDtFinal
		  &croNumeroNota  = croNumeroNota
		  &croCodigoNew   = PRCDGerarNovoCodigo('cronograma')
		  &croTipoRemessa = croTipoRemessa
		  new
			prefCodigo     = &prefCodigo
		    forCodigo      = &forCodigo
			prodCodigo     = &prodCodigo
			croCodigo      = &croCodigoNew
			croMarca       = &croMarca
			croDtInicial   = &croDtInicial
		    croDtFinal     = &croDtFinal
			croNumeroNota  = &croNumeroNota
			croStatus      = 'C'
			croDataCad     = serverNow()
			croUsuario     = &WWPContext.UserName
			croDataAlt     = serverNow()
			croFeito       = 'N'
			croRemessa     = 0
			croTipoRemessa = &croTipoRemessa
		  endNew

		  For each trnscronogramalocal
			  where prefCodigo   = &prefCodigo
			  where croCodigo = &croCodigo
				  &croLocCodigo  = croLocCodigo
				  &croLocQtde    = croLocQtde
				  &croRotaCodigo = croRotaCodigo
				  &croDia        = croDia
				  &croHora       = croHora				  
				  new
					prefCodigo    = &prefCodigo
					croCodigo     = &croCodigoNew
					croLocCodigo  = &croLocCodigo
					croLocQtde    = &croLocQtde
					croDia        = &croDia
					croHora       = &croHora
					// croRotaCodigo = &croRotaCodigo
				  endNew
		endFor
	  msg('Duplicação realizada com sucesso !')
endFor
]]></Source>
