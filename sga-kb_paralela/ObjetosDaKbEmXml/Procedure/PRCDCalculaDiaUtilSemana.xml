  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// Primeiro dia do mês
&FirstDay ="01/"+ &Month.ToString().Trim() + "/" + &Year.ToString()  

// Dia da semana (1 = domingo, 2 = segunda-feira, ..., 7 = sábado)
&DayOfWeek = DoW( CTOD( &FirstDay.Trim( ) ) ) 

// Calcula o deslocamento necessário para o primeiro dia útil
&Offset = 1 - &DayOfWeek + ((&WeekNumber - 1) * 7)

// Calcula o primeiro dia da semana
&FirstDayOfWeek = &FirstDayOfWeek.AddDays( &Offset )

// Verifica se o primeiro dia é sábado (6) ou domingo (7) e, se for, ajusta para a próxima segunda-feira

// Sábado
If &DayOfWeek = 6  
	
   // Adiciona 2 dias (segunda-feira)	
   &FirstDayOfWeek = &FirstDayOfWeek.AddDays( 2 ) 
Endif

// Domingo
If &DayOfWeek = 7  
	
   // Adiciona 1 dia (segunda-feira)	
   &FirstDayOfWeek = &FirstDayOfWeek.AddDays( 1 )  
EndIf
]]></Source>
