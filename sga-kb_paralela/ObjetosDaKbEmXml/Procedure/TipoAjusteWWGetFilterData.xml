    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_TIPAJUNOME'
		Do 'LoadtipajuNomeOptions'
	Case &DDOName.ToUpper() = !'DDO_TIPAJUSIGLA'
		Do 'LoadtipajuSiglaOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"TipoAjusteWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"TipoAjusteWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"TipoAjusteWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFTIPAJUCODIGO"
				&TFtipajuCodigo.FromString(&GridStateFilterValue.Value)
				&TFtipajuCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFTIPAJUNOME"
				&TFtipajuNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFTIPAJUNOME_SEL"
				&TFtipajuNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFTIPAJUSIGLA"
				&TFtipajuSigla.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFTIPAJUSIGLA_SEL"
				&TFtipajuSigla_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFTIPAJUACAO_SEL"
				&TFtipajuAcao_SelsJson = &GridStateFilterValue.Value
				&TFtipajuAcao_Sels.FromJson(&TFtipajuAcao_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'TIPAJUNOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&tipajuNome1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'TIPAJUSIGLA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&tipajuSigla1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'TIPAJUACAO'
				&tipajuAcao1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'TIPAJUNOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&tipajuNome2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'TIPAJUSIGLA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&tipajuSigla2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'TIPAJUACAO'
					&tipajuAcao2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'TIPAJUNOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&tipajuNome3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'TIPAJUSIGLA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&tipajuSigla3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'TIPAJUACAO'
						&tipajuAcao3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadtipajuNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFtipajuNome = &SearchTxt
	&TFtipajuNome_Sel.SetEmpty()
	For Each TipoAjuste
		Order tipajuNome
		using TipoAjusteWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &tipajuNome1, &tipajuSigla1, &tipajuAcao1, &DynamicFiltersEnabled2
					, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &tipajuNome2, &tipajuSigla2, &tipajuAcao2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &tipajuNome3, &tipajuSigla3, &tipajuAcao3, &TFtipajuCodigo
					, &TFtipajuCodigo_To, &TFtipajuNome, &TFtipajuNome_Sel, &TFtipajuSigla, &TFtipajuSigla_Sel, &TFtipajuAcao_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each TipoAjuste
			Order tipajuNome
			&count += 1
		EndFor
		If not tipajuNome.IsEmpty()
			&Option = tipajuNome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadtipajuSiglaOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFtipajuSigla = &SearchTxt
	&TFtipajuSigla_Sel.SetEmpty()
	For Each TipoAjuste
		Order tipajuSigla
		using TipoAjusteWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &tipajuNome1, &tipajuSigla1, &tipajuAcao1, &DynamicFiltersEnabled2
					, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &tipajuNome2, &tipajuSigla2, &tipajuAcao2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &tipajuNome3, &tipajuSigla3, &tipajuAcao3, &TFtipajuCodigo
					, &TFtipajuCodigo_To, &TFtipajuNome, &TFtipajuNome_Sel, &TFtipajuSigla, &TFtipajuSigla_Sel, &TFtipajuAcao_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each TipoAjuste
			Order tipajuSigla
			&count += 1
		EndFor
		If not tipajuSigla.IsEmpty()
			&Option = tipajuSigla
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

