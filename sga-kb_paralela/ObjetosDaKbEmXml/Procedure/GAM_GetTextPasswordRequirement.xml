  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
&TextHTML.SetEmpty()
&GAMSession = GAMSession.Get(&GAMErrorCollection)
If &GAMSession.SecurityPolicy.Id.IsEmpty()
	&GAMRepository = GAMRepository.Get()
	&SecurityPolicyId = &GAMRepository.DefaultSecurityPolicyId
Else
	&SecurityPolicyId = &GAMSession.SecurityPolicy.Id
Endif

If not &SecurityPolicyId.IsEmpty()
	&GAMSecurityPolicy.Load(&SecurityPolicyId)
	&aText.Clear()
	If &GAMSecurityPolicy.Success()
		If &GAMSecurityPolicy.MinimumLengthPassword	> 0
			&Text = Format("GAM_Passwordmustbeatleast1characterslong", &GAMSecurityPolicy.MinimumLengthPassword.ToString().Trim() )
			&aText.Add(&Text)
		Endif
		If &GAMSecurityPolicy.MinimumUpperCaseCharactersPassword > 0
			If &GAMSecurityPolicy.MinimumUpperCaseCharactersPassword = 1
				&Text = Format("GAM_Atleast1mustbeanuppercaseletter", &GAMSecurityPolicy.MinimumUpperCaseCharactersPassword.ToString().Trim() )
			Else
				&Text = Format("GAM_Atleast1mustbeuppercaseletters", &GAMSecurityPolicy.MinimumUpperCaseCharactersPassword.ToString().Trim() )
			Endif
			&aText.Add(&Text)		
		Endif
		If &GAMSecurityPolicy.MinimumNumericCharactersPassword > 0
			If &GAMSecurityPolicy.MinimumNumericCharactersPassword = 1
				&Text = Format("GAM_Atleast1mustbeanumber", &GAMSecurityPolicy.MinimumNumericCharactersPassword.ToString().Trim() )
			Else
				&Text = Format("GAM_Atleast1mustbenumbers", &GAMSecurityPolicy.MinimumNumericCharactersPassword.ToString().Trim() )
			Endif
			&aText.Add(&Text)
		Endif
		If &GAMSecurityPolicy.MinimumSpecialCharactersPassword > 0
			If &GAMSecurityPolicy.MinimumSpecialCharactersPassword = 1
				&Text = Format("GAM_Atleast1mustbeaspecialcharacter", &GAMSecurityPolicy.MinimumSpecialCharactersPassword.ToString().Trim() )
			Else
				&Text = Format("GAM_Atleast1mustbespecialcharacters", &GAMSecurityPolicy.MinimumSpecialCharactersPassword.ToString().Trim() )
			Endif
			&aText.Add(&Text)
		Endif
	Endif

	If &aText.Count > 0
		&TextHTML = !'<ul style="list-style-type: none; margin: 0; padding: 0; margin-top: -13px;">'
		For &Text in &aText
			&TextHTML += Format(!"<li>%1</li>", &Text.Trim() )
		EndFor
		&TextHTML += !"</ul>"
	Endif
Endif
]]></Source>
