&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_PRATINGRPRODCODIGO'
		Do 'LoadpratIngrProdCodigoOptions'
	Case &DDOName.ToUpper() = !'DDO_AREENSETAPANOME'
		Do 'LoadAreEnsEtapaNomeOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnspratosingredientesWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnspratosingredientesWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnspratosingredientesWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFPRATINGRPRODCODIGO"
				&TFpratIngrProdCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPRATINGRPRODCODIGO_SEL"
				&TFpratIngrProdCodigo_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAREENSETAPANOME"
				&TFAreEnsEtapaNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAREENSETAPANOME_SEL"
				&TFAreEnsEtapaNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFCARGRUTURNO_SEL"
				&TFcarGruTurno_SelsJson = &GridStateFilterValue.Value
				&TFcarGruTurno_Sels.FromJson(&TFcarGruTurno_SelsJson)
			Case &GridStateFilterValue.Name = !"TFPRATINGRQUANTIDADE"
				&TFpratIngrQuantidade.FromString(&GridStateFilterValue.Value)
				&TFpratIngrQuantidade_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFPRATINGRSTATUS_SEL"
				&TFpratIngrStatus_SelsJson = &GridStateFilterValue.Value
				&TFpratIngrStatus_Sels.FromJson(&TFpratIngrStatus_SelsJson)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&PRATOCODIGO"
				&pratoCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'PRATINGRPRODCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&pratIngrProdCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'AREENSETAPANOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&AreEnsEtapaNome1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'PRATINGRPRODCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&pratIngrProdCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'AREENSETAPANOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&AreEnsEtapaNome2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'PRATINGRPRODCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&pratIngrProdCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'AREENSETAPANOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&AreEnsEtapaNome3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadpratIngrProdCodigoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFpratIngrProdCodigo = &SearchTxt
	&TFpratIngrProdCodigo_Sel.SetEmpty()
	For Each trnspratosingredientes
		Order prefCodigo, pratoCodigo, AreEnsSequencial, pratIngrProdCodigo
		using trnspratosingredientesWWDS(&prefCodigo, &pratoCodigo, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &pratIngrProdCodigo1, &AreEnsEtapaNome1
					, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &pratIngrProdCodigo2, &AreEnsEtapaNome2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &pratIngrProdCodigo3, &AreEnsEtapaNome3, &TFpratIngrProdCodigo, &TFpratIngrProdCodigo_Sel
					, &TFAreEnsEtapaNome, &TFAreEnsEtapaNome_Sel, &TFcarGruTurno_Sels, &TFpratIngrQuantidade, &TFpratIngrQuantidade_To, &TFpratIngrStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnspratosingredientes
			Order prefCodigo, pratoCodigo, AreEnsSequencial, pratIngrProdCodigo
			&count += 1
		EndFor
		If not pratIngrProdDescricaoItem.IsEmpty()
			&Option = pratIngrProdCodigo.ToString()
			&OptionDesc = pratIngrProdDescricaoItem
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadAreEnsEtapaNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFAreEnsEtapaNome = &SearchTxt
	&TFAreEnsEtapaNome_Sel.SetEmpty()
	For Each trnspratosingredientes
		Order prefCodigo, pratoCodigo, AreEnsSequencial, AreEnsEtapaNome
		using trnspratosingredientesWWDS(&prefCodigo, &pratoCodigo, &DynamicFiltersSelector1, &DynamicFiltersOperator1, &pratIngrProdCodigo1, &AreEnsEtapaNome1
					, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &pratIngrProdCodigo2, &AreEnsEtapaNome2, &DynamicFiltersEnabled3
					, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &pratIngrProdCodigo3, &AreEnsEtapaNome3, &TFpratIngrProdCodigo, &TFpratIngrProdCodigo_Sel
					, &TFAreEnsEtapaNome, &TFAreEnsEtapaNome_Sel, &TFcarGruTurno_Sels, &TFpratIngrQuantidade, &TFpratIngrQuantidade_To, &TFpratIngrStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnspratosingredientes
			Order prefCodigo, pratoCodigo, AreEnsSequencial, AreEnsEtapaNome
			&count += 1
		EndFor
		If not AreEnsEtapaNome.IsEmpty()
			&Option = AreEnsEtapaNome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

