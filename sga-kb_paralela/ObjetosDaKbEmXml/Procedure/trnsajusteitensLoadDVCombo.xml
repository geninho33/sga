    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

LoadWWPContext.Call(&WWPContext)


&MaxItems = 100
Do Case
	Case &ComboName = !'prefCodigo' //Generated by 'Auto DVelop Combo' (trnsprefeituras)
		Do 'LoadComboItems_prefCodigo'
	Case &ComboName = !'ajusItemProduto' //Generated by 'Auto DVelop Combo' (trnsprodutos)
		Do 'LoadComboItems_ajusItemProduto'
EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadComboItems_prefCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If &IsDynamicCall
		For Each trnsprefeituras
			Order prefNome
			Where prefNome.ToLower() like !'%' + &SearchTxt.ToLower() When not &SearchTxt.IsEmpty()
			&Combo_DataItem = new()
			&Combo_DataItem.ID = prefCodigo.ToString().Trim()
			&Combo_DataItem.Title = prefNome
			&Combo_Data.Add(&Combo_DataItem)
			If &Combo_Data.Count > &MaxItems
				Exit
			EndIf
		EndFor
		&Combo_DataJson = &Combo_Data.ToJson()
	Else
		If &TrnMode <> TrnMode.Insert
			For Each trnsajusteitens
				Where prefCodigo = &prefCodigo
				Where ajusCodigo = &ajusCodigo
				Where ajusItemProduto = &ajusItemProduto

				&SelectedValue = iif(prefCodigo.IsEmpty(), '', prefCodigo.ToString().Trim())
				&SelectedText = prefNome
			EndFor
		Else
			If Not &prefCodigo.IsEmpty()
				&SelectedValue = &prefCodigo.ToString().Trim()
				For Each trnsprefeituras
					Where prefCodigo = &prefCodigo
					&SelectedText = prefNome
					Exit
				EndFor
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboItems_ajusItemProduto'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	If &IsDynamicCall
		For Each trnsprodutos
			Order prodPrograma
			Where prefCodigo = &Cond_prefCodigo
			Where prodPrograma.ToString() like !'%' + &SearchTxt When not &SearchTxt.IsEmpty()
			&Combo_DataItem = new()
			&Combo_DataItem.ID = prodCodigo.ToString().Trim()
			&Combo_DataItem.Title = trim(prodPrograma.ToFormattedString())
			&Combo_Data.Add(&Combo_DataItem)
			If &Combo_Data.Count > &MaxItems
				Exit
			EndIf
		EndFor
		&Combo_DataJson = &Combo_Data.ToJson()
	Else
		If &TrnMode <> TrnMode.Insert
			For Each trnsajusteitens
				Where prefCodigo = &prefCodigo
				Where ajusCodigo = &ajusCodigo
				Where ajusItemProduto = &ajusItemProduto

				&SelectedValue = iif(ajusItemProduto.IsEmpty(), '', ajusItemProduto.ToString().Trim())
				&Cond_Aux_prefCodigo = prefCodigo
				&prodCodigo = ajusItemProduto
			EndFor
			For Each trnsprodutos
				Where prodCodigo = &prodCodigo
				Where prefCodigo = &Cond_Aux_prefCodigo
				&SelectedText = trim(prodPrograma.ToFormattedString())
				Exit
			EndFor
		Else
			If Not &ajusItemProduto.IsEmpty()
				&SelectedValue = &ajusItemProduto.ToString().Trim()
				For Each trnsprodutos
					Where prodCodigo = &ajusItemProduto
					Where prefCodigo = &Cond_Aux_prefCodigo
					&SelectedText = trim(prodPrograma.ToFormattedString())
					Exit
				EndFor
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

