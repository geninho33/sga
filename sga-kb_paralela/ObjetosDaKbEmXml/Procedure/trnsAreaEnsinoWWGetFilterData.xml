    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_AREENSNOME'
		Do 'LoadAreEnsNomeOptions'
	Case &DDOName.ToUpper() = !'DDO_AREENSSIGLA'
		Do 'LoadAreEnsSiglaOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsAreaEnsinoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsAreaEnsinoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsAreaEnsinoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFAREENSCODIGO"
				&TFAreEnsCodigo.FromString(&GridStateFilterValue.Value)
				&TFAreEnsCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFAREENSNOME"
				&TFAreEnsNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAREENSNOME_SEL"
				&TFAreEnsNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAREENSSIGLA"
				&TFAreEnsSigla.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFAREENSSIGLA_SEL"
				&TFAreEnsSigla_Sel.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'AREENSNOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&AreEnsNome1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'AREENSNOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&AreEnsNome2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'AREENSNOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&AreEnsNome3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadAreEnsNomeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFAreEnsNome = &SearchTxt
	&TFAreEnsNome_Sel.SetEmpty()
	For Each trnsAreaEnsino
		Order AreEnsNome
		using trnsAreaEnsinoWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &AreEnsNome1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2
					, &AreEnsNome2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &AreEnsNome3, &TFAreEnsCodigo
					, &TFAreEnsCodigo_To, &TFAreEnsNome, &TFAreEnsNome_Sel, &TFAreEnsSigla, &TFAreEnsSigla_Sel)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsAreaEnsino
			Order AreEnsNome
			&count += 1
		EndFor
		If not AreEnsNome.IsEmpty()
			&Option = AreEnsNome
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadAreEnsSiglaOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFAreEnsSigla = &SearchTxt
	&TFAreEnsSigla_Sel.SetEmpty()
	For Each trnsAreaEnsino
		Order AreEnsSigla
		using trnsAreaEnsinoWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &AreEnsNome1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2
					, &AreEnsNome2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &AreEnsNome3, &TFAreEnsCodigo
					, &TFAreEnsCodigo_To, &TFAreEnsNome, &TFAreEnsNome_Sel, &TFAreEnsSigla, &TFAreEnsSigla_Sel)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsAreaEnsino
			Order AreEnsSigla
			&count += 1
		EndFor
		If not AreEnsSigla.IsEmpty()
			&Option = AreEnsSigla
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

