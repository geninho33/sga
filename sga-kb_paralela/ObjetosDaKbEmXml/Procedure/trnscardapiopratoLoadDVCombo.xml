EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadComboItems_carPratoRefeicao'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For Each
		Order pratoDscricao
		Where prefCodigo = &prefCodigo and
pratoStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = pratoCodigo.ToString().Trim()
		&Combo_DataItem.Title = pratoDscricao
		&Combo_Data.Add(&Combo_DataItem)
	EndFor
	If &TrnMode <> TrnMode.Insert
		For Each trnscardapioprato
			Where prefCodigo = &prefCodigo
			Where carDapCodigo = &carDapCodigo
			Where carPratoCodigo = &carPratoCodigo

			&SelectedValue = iif(carPratoRefeicao.IsEmpty(), '', carPratoRefeicao.ToString().Trim())
		EndFor
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

