  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// &preferencia = PRCDPreferencia(&prefCodigo,1)

// if &preferencia = &preferencia2
	if &locCodigo = 0
		For each
			where prefCodigo = &prefCodigo
			where distCodigo = &distCodigo
      		  &locCodigoDestino = distLocalDestino
		endFor
	else
		&locCodigoDestino = &locCodigo
	endif

	for each
		where prefCodigo       = &prefCodigo
		where estoUeLocCodigo  = &locCodigoDestino
		where estoUeProdCodigo = &prodCodigo
		if &movimentacao = 'S'
			estoUeSaldo = estoUeSaldo - &qtde
		else
			estoUeSaldo = estoUeSaldo + &qtde
		endif
		estoUeAlteracao = ServerNow()
		estoUeUserName  = 'IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
	when none
     new
		   prefCodigo       = &prefCodigo
		   estoUeCodigo     = PRCDGerarNovoCodigo('estoqueUE')
		   estoUeLocCodigo  = &locCodigoDestino
		   estoUeProdCodigo = &prodCodigo
		   estoUeUserName   = 'IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
	  	   estoUeAlteracao  = ServerNow()
		   estoUeCadastro   = ServerNow()
	 	   if &movimentacao = 'S'
		 	  estoUeSaldo = estoUeSaldo - &qtde
		   else
		  	  estoUeSaldo = estoUeSaldo + &qtde
		   endif
     endNew
	endFor

// endif
]]></Source>
