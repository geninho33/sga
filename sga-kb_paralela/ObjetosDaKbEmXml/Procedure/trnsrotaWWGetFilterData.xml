  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_ROTADESCRICAO'
		Do 'LoadrotaDescricaoOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsrotaWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsrotaWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsrotaWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFROTACODIGO"
				&TFrotaCodigo.FromString(&GridStateFilterValue.Value)
				&TFrotaCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFROTADESCRICAO"
				&TFrotaDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFROTADESCRICAO_SEL"
				&TFrotaDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFROTASTATUS_SEL"
				&TFrotaStatus_SelsJson = &GridStateFilterValue.Value
				&TFrotaStatus_Sels.FromJson(&TFrotaStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'ROTADESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&rotaDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'ROTASTATUS'
				&rotaStatus1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'ROTADESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&rotaDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'ROTASTATUS'
					&rotaStatus2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'ROTADESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&rotaDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'ROTASTATUS'
						&rotaStatus3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadrotaDescricaoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFrotaDescricao = &SearchTxt
	&TFrotaDescricao_Sel.SetEmpty()
	For Each trnsrota
		Order rotaDescricao
		using trnsrotaWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &rotaDescricao1, &rotaStatus1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2
					, &DynamicFiltersOperator2, &rotaDescricao2, &rotaStatus2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &rotaDescricao3, &rotaStatus3, &TFrotaCodigo, &TFrotaCodigo_To, &TFrotaDescricao, &TFrotaDescricao_Sel
					, &TFrotaStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsrota
			Order rotaDescricao
			&count += 1
		EndFor
		If not rotaDescricao.IsEmpty()
			&Option = rotaDescricao
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

