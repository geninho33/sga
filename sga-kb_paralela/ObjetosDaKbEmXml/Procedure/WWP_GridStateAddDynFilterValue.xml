  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
&GridStateDynamicFilter.Dsc = &FilterDsc
&GridStateDynamicFilter.Value = &FilterValue
&GridStateDynamicFilter.ValueDsc = &FilterValueDsc
&GridStateDynamicFilter.Operator = &FilterOperator
&GridStateDynamicFilter.ValueTo = &FilterValueTo
If &IsRange
	&GridStateDynamicFilter.ValueToDsc = &FilterValueToDsc
	If &FilterValueToDsc.IsEmpty() And Not &FilterValueDsc.IsEmpty()
		&GridStateDynamicFilter.ValueDsc = format('from %1', &FilterValueDsc)
	Else
		If &FilterValueDsc.IsEmpty() And Not &FilterValueToDsc.IsEmpty()
			&GridStateDynamicFilter.ValueToDsc = format('up to %1', &FilterValueToDsc)
		EndIf
	EndIf
EndIf
]]></Source>
