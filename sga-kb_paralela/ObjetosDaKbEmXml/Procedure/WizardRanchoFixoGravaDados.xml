  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
// Carrega dados Context
LoadWWPContext(&WWPContext)
&prefCodigo = &WWPContext.prefCodigo

// Carrega dados do WizardData
&WizardData.FromXml(FileXmlToWizardData(&WebSessionKey))

do 'GravaRemessa'

do 'GravaDistribuicao'

&IsSucess = true


Sub 'GravaRemessa'

	/* Registra remessa */
	&dataInicial = &WizardData.Periodo.DataInicial
	&dataFinal   = &WizardData.Periodo.DataFinal
	&remCodigo	 = PRCDGerarNovoCodigo('remessas')

	New
		prefCodigo		 = &prefCodigo
		remCodigo		 = &remCodigo
		remStatus		 = Status.Ativo
		remCadastro		 = ServerDate()
		remAlteracao	 = ServerDate()
		remUsuario		 = &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
		remGerSemana1Ini = &dataInicial
		remGerSemana1Fim = &dataFinal
		remRancho		 = true
	EndNew

EndSub

Sub 'GravaDistribuicao'

	&distDataEnvio  = &WizardData.Periodo.DataEnvio
	&remTipoRemessa = &WizardData.Alimentos.prodCodigoTipoRemessa

	/* Busca local de origem */
	For each
		Where prefCodigo = &prefCodigo
	  	&distLocalOrigem = prefLocalDeposito
  	When none
	  	&distLocalOrigem = 0
	Endfor

	&locCodigo = 0
	for &GuiasGridItem in &WizardData.Guias.Grid
		if &locCodigo <> &GuiasGridItem.locCodigo
			&locCodigo = &GuiasGridItem.locCodigo
			&distObservacao = &GuiasGridItem.distObservacao
			&distCodigo = PRCDSalvarCabecalhoDistribuicao(&prefCodigo,&remCodigo,&locCodigo,&distDataEnvio,&distLocalOrigem,&remTipoRemessa,&dataInicial,&dataFinal,&distObservacao)
		endif

		&prodCodigo 		= &GuiasGridItem.prodCodigo
		&AreEnsCodigo 		= 0
		&AreEnsSequencial 	= 0
		&AreEnsTurno		= turno.Int
		&Quantidade			= &GuiasGridItem.Quantidade
		&PerCapta			= 1
	  	PRCDSalvarRemessaAlimentos(&prefCodigo,&remCodigo,&prodCodigo,&AreEnsCodigo,&AreEnsSequencial,&AreEnsTurno,&Quantidade,&PerCapta,&distCodigo,&dataInicial,&dataFinal,0)

		/* Atualiza estoque */
		PRCDEstoqueMovimentacao(&distCodigo,&prodCodigo,&distLocalOrigem,&Quantidade,'D','N',0,&Retorno)

	endfor

Endsub
]]></Source>
