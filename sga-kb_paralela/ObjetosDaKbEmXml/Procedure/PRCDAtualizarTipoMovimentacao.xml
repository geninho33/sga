  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&estoTipo = ''
&estoSaldo = 0
&estoProduto = 0
&total = 0
LoadWWPContext.Call(&WWPContext) 
&prefCodigo = &WWPContext.prefCodigo

msg('Iniciando o ajuste de tipo !')

For each
	order prefCodigo,estoProduto,(estoCodigo)
	where prefCodigo = &prefCodigo
	if  estoTipo.Trim().IsEmpty() and &estoProduto = estoProduto		
		if estoAjusCodigo = 0 and estoDistCodigo = 0 and estoNfCodigo = 0 and estoRomanCodigo.IsEmpty()
		   msg('Produto : ' + estoProduto.ToString() )	
		   estoTipo = 'R'	
		   &total += 1
		else	
			if  &estoSaldo =  ( estoSaldo + estoQuantidade ) 
				estoTipo = 'E'
				&total += 1 
			endif 	 
			if  &estoSaldo =  ( estoSaldo - estoQuantidade ) 
				estoTipo = 'S'
				&total += 1 
			endif 	 
	    endif
	
	endif	 
	&estoProduto = estoProduto
	&estoSaldo   = estoSaldo
endFor	 
msg('Foram feitos um total :  ' + &total.ToString() )
]]></Source>
