  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// Declaração de variáveis (devem estar definidas no contexto ou como parâmetros)
LoadWWPContext( &wwPContext )

&HTTP_URL = &wwPContext.GLPI_URL + "/initSession"
&HTTP_METHOD = "POST"
&HTTP_STATUS = 0
&HTTP_RESPONSE = ""
&SUCCESS = False
&ERROR_MESSAGE = ""
&SESSION_TOKEN = ""

// Configurar headers
&HttpClient.AddHeader("app-token", &wwPContext.APP_TOKEN)
&HttpClient.AddHeader("Authorization", "user_token " + &wwPContext.USER_TOKEN)
&HttpClient.AddHeader("Content-Type", "application/json")

// Executar requisição
&HttpClient.Execute(&HTTP_METHOD, &HTTP_URL)

// Obter status e resposta
&HTTP_STATUS = &HttpClient.StatusCode
&HTTP_RESPONSE = &HttpClient.ToString()

If &HTTP_STATUS = 200
    // Parsear resposta JSON
    &JSON_SDT = new() // SDT para armazenar a resposta JSON
    &JSON_SDT.FromJson(&HTTP_RESPONSE)

    If &JSON_SDT.success // Supondo que SDT_JSON_RESPONSE tenha um campo Success
        &SESSION_TOKEN = &JSON_SDT.session_token // Ajuste conforme o campo do SDT
        &SUCCESS = True
        &ERROR_MESSAGE = ""
    Else
        &SUCCESS = False
        &ERROR_MESSAGE = "Erro ao processar resposta da API"
    EndIf
Else
    &SUCCESS = False
    &ERROR_MESSAGE = "Erro HTTP: " + &HTTP_STATUS.ToString()
EndIf
]]></Source>
