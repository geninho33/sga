&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_LANESTTIPOREMESSA'
		Do 'LoadlanestTipoRemessaOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnslancarestoqueUEWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnslancarestoqueUEWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnslancarestoqueUEWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFLANESTCODIGO"
				&TFlanestcodigo.FromString(&GridStateFilterValue.Value)
				&TFlanestcodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFLANESTDATINICIAL"
				&TFlanestdatInicial.FromString(&GridStateFilterValue.Value)
				&TFlanestdatInicial_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFLANESTDATFINAL"
				&TFlanestdatFinal.FromString(&GridStateFilterValue.Value)
				&TFlanestdatFinal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFLANESTTIPOREMESSA"
				&TFlanestTipoRemessa.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFLANESTTIPOREMESSA_SEL"
				&TFlanestTipoRemessa_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFLANESTCODIGOREMESSA"
				&TFlanestCodigoRemessa.FromString(&GridStateFilterValue.Value)
				&TFlanestCodigoRemessa_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFLANESTSTATUS_SEL"
				&TFlanestStatus_SelsJson = &GridStateFilterValue.Value
				&TFlanestStatus_Sels.FromJson(&TFlanestStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'LANESTDATINICIAL'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&lanestdatInicial1.FromString(&GridStateDynamicFilter.Value)
				&lanestdatInicial_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'LANESTDATFINAL'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&lanestdatFinal1.FromString(&GridStateDynamicFilter.Value)
				&lanestdatFinal_To1.FromString(&GridStateDynamicFilter.ValueTo)
			Case &DynamicFiltersSelector1 = !'LANESTCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&lanestcodigo1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'LANESTDATINICIAL'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&lanestdatInicial2.FromString(&GridStateDynamicFilter.Value)
					&lanestdatInicial_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'LANESTDATFINAL'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&lanestdatFinal2.FromString(&GridStateDynamicFilter.Value)
					&lanestdatFinal_To2.FromString(&GridStateDynamicFilter.ValueTo)
				Case &DynamicFiltersSelector2 = !'LANESTCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&lanestcodigo2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'LANESTDATINICIAL'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&lanestdatInicial3.FromString(&GridStateDynamicFilter.Value)
						&lanestdatInicial_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'LANESTDATFINAL'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&lanestdatFinal3.FromString(&GridStateDynamicFilter.Value)
						&lanestdatFinal_To3.FromString(&GridStateDynamicFilter.ValueTo)
					Case &DynamicFiltersSelector3 = !'LANESTCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&lanestcodigo3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadlanestTipoRemessaOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFlanestTipoRemessa = &SearchTxt
	&TFlanestTipoRemessa_Sel.SetEmpty()
	For Each trnslancarestoqueUE
		Order lanestTipoRemessa
		using trnslancarestoqueUEWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &lanestdatInicial1, &lanestdatInicial_To1, &lanestdatFinal1, &lanestdatFinal_To1
					, &lanestcodigo1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &lanestdatInicial2, &lanestdatInicial_To2
					, &lanestdatFinal2, &lanestdatFinal_To2, &lanestcodigo2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &lanestdatInicial3, &lanestdatInicial_To3, &lanestdatFinal3, &lanestdatFinal_To3, &lanestcodigo3, &TFlanestcodigo
					, &TFlanestcodigo_To, &TFlanestdatInicial, &TFlanestdatInicial_To, &TFlanestdatFinal, &TFlanestdatFinal_To, &TFlanestTipoRemessa
					, &TFlanestTipoRemessa_Sel, &TFlanestCodigoRemessa, &TFlanestCodigoRemessa_To, &TFlanestStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnslancarestoqueUE
			Order lanestTipoRemessa
			&count += 1
		EndFor
		If not disTipDescricao.IsEmpty()
			&Option = lanestTipoRemessa.ToString()
			&OptionDesc = disTipDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

