  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&croStatus       = 'A'
&diaSemana       = ''

for each trnscronograma
	where prefCodigo = &prefCodigo
	where croCodigo  = &crocodigo
	      croFeito = 'S'
		  &croTipoRemessa  = croTipoRemessa
          &remCodigo       = PRCDRemessaCriar(croDtInicial,croDtFinal)
		  croRemessa       = &remCodigo
		  &croStatus       = croStatus
		  croStatus        = 'A'
endFor

for each trnscronograma, trnscronogramalocal
	where prefCodigo = &prefCodigo
	where croCodigo  = &croCodigo
	where croLocQtde > 0
	      
	      if croDia = '0'
			 &diaSemana       = ''
          endif			 
          if croDia = '2'
			 &diaSemana       = ' | Segunda-feira'
          endif			 
          if croDia = '3'
			 &diaSemana       = ' | Terça-feira'
          endif			 
          if croDia = '4'
			 &diaSemana       = ' | Quarta-feira'
          endif			 
          if croDia = '5'
			 &diaSemana       = ' | Quinta-feira'
          endif			 
          if croDia = '6'
			 &diaSemana       = ' | Sexta-feira'
          endif			 
          if croDia = '7'
			 &diaSemana       = ' | Sábado'
          endif			 
	  
	      &distObservacao =  ' Cronograma :  ' + &croCodigo.ToString() +
		  ' | Perído de ' + croDtInicial.ToString() +' a '+croDtFinal.ToString() + &diaSemana

          &distCodigo = PRCDSalvarCabecalhoDistribuicao( &prefCodigo,
		                                                 &remCodigo,
														 croLocCodigo,
														 croDtInicial,
														 &locCodigoOrigem,
														 croTipoRemessa,
														 croDtInicial,
														 croDtFinal,
														 &distObservacao)
		  new
			prefCodigo           = &prefCodigo
			distCodigo           = &distCodigo
			distItemProduto      = prodCodigo
			distItemQuantidade   = croLocQtde
			distiItemSaldoAntes  = PRCDBuscarSaldoProdutoUE(&prefCodigo,prodCodigo,croLocCodigo)
			distiItemSaldoDepois = distiItemSaldoAntes + croLocQtde
			distItemPesoTotal    = distItemProdutoPeso*&croLocQtde
		  endnew

		  // if croLocQtde>0
		  if &croStatus<>'R'
			  PRCDEstoqueMovimentacao( &distCodigo,prodCodigo,croLocCodigo,croLocQtde,'D','N',0)
		  endif
		  // endif

endFor
]]></Source>
