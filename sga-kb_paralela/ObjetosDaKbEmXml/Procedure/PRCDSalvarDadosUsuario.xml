  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[for each
	where usuGUID = &UserId
	      prefCodigo = &prefCodigo
		  //usuGUID  = &UserId      
		  // usuPref = &prefCodigo
		  usuCargo   = &carCodigo
		  usuNome    = &nome
		  usuEmail   = &EMail
		  usuUsuario = &Login
		  usuStatus  = 'A'
	when none	
	new
		prefCodigo = &prefCodigo
		usuGUID    = &UserId
		usuCargo   = &carCodigo
		// usuPref = &prefCodigo
		usuNome    = &nome
		usuEmail   = &EMail
		usuUsuario = &Login		  
		usuCodigo  = PRCDGerarNovoCodigo('usuario')
		usuStatus  = 'A'
	endnew  
endfor
]]></Source>
