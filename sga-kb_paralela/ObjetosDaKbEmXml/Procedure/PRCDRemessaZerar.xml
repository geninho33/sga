  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// zerar distribuição
for each trnsdistribuicao
   where prefCodigo            = &prefCodigo
	where distRemCodigo         = &remCodigo
	where distCodigoTipoRemessa = &disTipNumero
      &distCodigo = distCodigo
      &distLocalDestino = distLocalDestino
	  &distReceber = distReceber
	  for each trnsdistribuicaoitens
		 where prefCodigo = &prefCodigo
		 where distCodigo = &distCodigo
	       if &distReceber = 'S'
	       	  PRCDAtualiarEstoqueUE(prefCodigo,&distLocalDestino,distItemProduto,distItemQuantidade,'S',0,'Unidade')
		   endif
	       PRCDEstoqueMovimentacao( &distCodigo,distItemProduto,&distLocalDestino,distItemQuantidade,'D','I',distItemQtdeAntes)
	  endfor
	  distReceber        = 'N'
	  distStatus         = "C"
      distDSCancelamento = &dsCancelamento
endFor
msg("Remessa zerada com sucesso !")
]]></Source>
