  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&retorno = 0
&perCapta = 0

for each
	where prefCodigo = &prefCodigo
	where prodCodigo = &prodCodigo
	where prodCalculoDifer = 'S'			  
	For each Rancho.AreasEnsino.PerCapta
		order prefCodigo,RanchoAno,(RanchoMes),RanchoAreasEnsinoCodigo,prodCodigo
		Where prefCodigo 				= &prefCodigo
		where RanchoMes = &distDataEnvio.Month()
		where RanchoAno = &distDataEnvio.Year()
		Where RanchoAreasEnsinoCodigo 	> 0
		Where prodCodigo 			  	= &prodCodigo
		Where RanchoAreasEnsinoPerCaptaValor > 0
	          &perCapta = RanchoAreasEnsinoPerCaptaValor
		      Exit
	Endfor
endfor

if &perCapta>0 and &quantidade>0
   &retorno = &quantidade/&perCapta
endif   
]]></Source>
