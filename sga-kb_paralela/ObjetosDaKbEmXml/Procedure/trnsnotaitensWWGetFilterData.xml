	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsnotaitensWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsnotaitensWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsnotaitensWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFNOTAITEMPRODUTO"
				&TFnotaItemProduto.FromString(&GridStateFilterValue.Value)
				&TFnotaItemProduto_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMPRODUTOUNIDADE"
				&TFnotaItemProdutoUnidade.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMPRODUTOUNIDADE_SEL"
				&TFnotaItemProdutoUnidade_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMPRODUTOUNDPESO"
				&TFnotaItemProdutoUndPeso.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMPRODUTOUNDPESO_SEL"
				&TFnotaItemProdutoUndPeso_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMPRODUTOPESO"
				&TFnotaItemProdutoPeso.FromString(&GridStateFilterValue.Value)
				&TFnotaItemProdutoPeso_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMLOTE"
				&TFnotaItemLote.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMLOTE_SEL"
				&TFnotaItemLote_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMVALIDADE"
				&TFnotaItemValidade.FromString(&GridStateFilterValue.Value)
				&TFnotaItemValidade_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMQTDE"
				&TFnotaItemQtde.FromString(&GridStateFilterValue.Value)
				&TFnotaItemQtde_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMVALOR"
				&TFnotaItemValor.FromString(&GridStateFilterValue.Value)
				&TFnotaItemValor_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMTOTAL"
				&TFnotaItemTotal.FromString(&GridStateFilterValue.Value)
				&TFnotaItemTotal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFNOTAITEMPESOTOTAL"
				&TFnotaItemPesoTotal.FromString(&GridStateFilterValue.Value)
				&TFnotaItemPesoTotal_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"PARM_&PREFCODIGO"
				&prefCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"PARM_&NOTACODIGO"
				&notaCodigo.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadnotaItemProdutoUnidadeOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFnotaItemProdutoUnidade = &SearchTxt
	&TFnotaItemProdutoUnidade_Sel.SetEmpty()
	For Each trnsnotaitens
		Order prefCodigo, notaCodigo, notaItemProdutoUnidade
		using trnsnotaitensWWDS(&prefCodigo, &notaCodigo, &TFnotaItemProduto, &TFnotaItemProduto_To, &TFnotaItemProdutoUnidade, &TFnotaItemProdutoUnidade_Sel
					, &TFnotaItemProdutoUndPeso, &TFnotaItemProdutoUndPeso_Sel, &TFnotaItemProdutoPeso, &TFnotaItemProdutoPeso_To, &TFnotaItemLote, &TFnotaItemLote_Sel
					, &TFnotaItemValidade, &TFnotaItemValidade_To, &TFnotaItemQtde, &TFnotaItemQtde_To, &TFnotaItemValor, &TFnotaItemValor_To
					, &TFnotaItemTotal, &TFnotaItemTotal_To, &TFnotaItemPesoTotal, &TFnotaItemPesoTotal_To)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnsnotaitens
			Order prefCodigo, notaCodigo, notaItemProdutoUnidade
			&count += 1
		EndFor
		If not uniDescricao.IsEmpty()
			&Option = notaItemProdutoUnidade.ToString()
			&OptionDesc = uniDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

