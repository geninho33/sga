&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_NOTAITEMPRODUTOUNIDADE'
		Do 'LoadnotaItemProdutoUnidadeOptions'
	Case &DDOName.ToUpper() = !'DDO_NOTAITEMPRODUTOUNDPESO'
		Do 'LoadnotaItemProdutoUndPesoOptions'
	Case &DDOName.ToUpper() = !'DDO_NOTAITEMLOTE'
