  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[for each trnsnotaitens	
	order prefCodigo,(notaCodigo), notaItemProduto
	where prefCodigo = &prefCodigo
	where notaItemProduto = &prodCodigo
      	  &prodValorunitario = notaItemValor
	  	  exit
when none
	for each
		where prefCodigo = &prefCodigo
		where prodCodigo = &prodCodigo
			  &prodValorunitario = prodValorunitario
	endfor
endfor
]]></Source>
