  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&GAMRepository = GAMRepository.Get()

&GAMRoleName = 'AdministradorAlimentacao'
Do 'Role'
&Permissoes = PermissoesADM()
PermissoesInsUpd(&GAMKeyNumLong, &Permissoes)
&GAMKeyNumLong.SetEmpty()

Sub 'Role'
	&GAMKeyNumLong.SetEmpty()
	&GAMRoleFilter.Name = &GAMRoleName.Trim()
	&GAMRoles = &GAMRepository.GetRoles(&GAMRoleFilter, &GAMError)
	If &GAMRoles.Count > 0
		For &GAMRoleItem in &GAMRoles
			&GAMRole.Load(&GAMRoleItem.Id)
		EndFor
	Else
		&GAMRole = New()
	Endif
	&GAMRole.Name = &GAMRoleName
	&GAMRole.Description = &GAMRoleName
	&GAMRole.Save()
	if &GAMRole.Success()
		&GAMKeyNumLong = &GAMRole.Id
	else
		&GAMError = &GAMRole.GetErrors()
		For &aGamError in &GAMError
			Log.Error(Format("Error Saving GAM Role %1: (%2) %3",&GAMRole.Name, &aGamError.Code, &aGAMError.Message),&Pgmname)
		EndFOr
	endif
EndSub
]]></Source>
