  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[//&carPratoCodigoCollection.Clear()
//For each trnscardapioprato
//	Unique carPratoRefeicao
//	Where prefCodigo = &prefCodigo
//	Where carPratoData >= &DataInicial
//	Where carPratoData <= &DataFinal
//
//	&carPratoCodigoCollection.Add(carPratoRefeicao)
//Endfor

&PropertiesCollection.Clear()
For each trnspratosingredientes, trnscardapioprato
	Order pratIngrProdCodigo, AreEnsCodigo
	Where prefCodigo = &prefCodigo
	Where carPratoData >= &DataInicial
	Where carPratoData <= &DataFinal
	Where carDapStatus = Status.Ativo
	Where pratIngrProdCodigo = &pratIngrProdCodigo
	Where pratoCodigo = carPratoRefeicao
 	Where pratIngrStatus = Status.Ativo
	Where pratIngrQuantidade > 0


	/* Calcula oferta */
	&Oferta = 0
	For each trnspratosingredientes
		&Percapta = pratIngrQuantidade
		&Oferta += 1
		//		&wTexto = 'Pref: ' + prefCodigo.ToString().Trim() + ' - pratoCodigo: ' + pratoCodigo.ToString().Trim() + ' - pratIngrProdCodigo: ' + pratIngrProdCodigo.ToString().Trim() + ' - AreEnsCodigo: ' + AreEnsCodigo.ToString().Trim() + ' - AreEnsSequencial: ' + AreEnsSequencial.ToString().Trim() + ' - carGruTurno: ' + carGruTurno.ToString().Trim() + ' - Oferta: ' + &Oferta.ToString().Trim() + '   '
		//		PGeraLog.Call(&Pgmname, &wTexto)
	Endfor

	if &Oferta > 0
		&Properties = new()
		&Properties.Set(!'AreEnsCodigo',AreEnsCodigo.ToString())
		&Properties.Set(!'Oferta',&Oferta.ToString())
		&Properties.Set(!'Percapta',&Percapta.ToString())
		&PropertiesCollection.Add(&Properties)
	endif

EndFor

log.Info(format('Produto: %1',&pratIngrProdCodigo),'BuscaPercaptaOfertaDosCardapios')
log.Info(&PropertiesCollection.ToJson(),'BuscaPercaptaOfertaDosCardapios')
]]></Source>
