  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&GAMApplication = GAMApplication.Get()
&GAMRole.Load(&GAMKeyNumLong)
if &GAMRole.Success()
	&GAMPermissionFilter.ApplicationId = &GAMApplication.Id

	&GamPermissions = &GAMRole.GetPermissions(&GAMPermissionFilter, &GAMErrors)
	For &GamPermissionItem in &GamPermissions
		For &Permissao in &Permissoes
			if &GamPermissionItem.Name.Trim().ToUpper() = &Permissao.Trim().ToUpper()
				if not &GamPermissionItem.Type = GAMPermissionAccessType.Allow
					&GamPermissionItem.Type = GAMPermissionAccessType.Allow
					&isOK = &GAMRole.UpdatePermission(&GamPermissionItem, &GAMErrors)
					If &isOK
						Commit
					endif
				endif
			endif
		EndFor
	EndFor

	&GamPermissions = &GAMRole.GetUnassignedPermissions(&GAMPermissionFilter, &GAMErrors)
	For &GamPermissionItem in &GamPermissions
		For &Permissao in &Permissoes
			if &GamPermissionItem.Name.Trim().ToUpper() = &Permissao.Trim().ToUpper()
				&GamPermissionItem.Type = GAMPermissionAccessType.Allow
				&isOK = &GAMRole.AddPermission(&GamPermissionItem, &GAMErrors)
				If &isOK
					Commit
				endif
			endif
		EndFor
	endfor
endif
]]></Source>
