    <Source><![CDATA[
	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

LoadWWPContext.Call(&WWPContext)

Do Case
	Case &ComboName = !'prodCodigo'
		Do 'LoadComboItems_prodCodigo'
	Case &ComboName = !'forCodigo'
		Do 'LoadComboItems_forCodigo'
EndCase

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadComboItems_prodCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For Each
		Order prodDescricao
		Where prefCodigo=&prefCodigo and 
prodStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = prodCodigo.ToString().Trim()
		&Combo_DataItem.Title = prodDescricao
		&Combo_Data.Add(&Combo_DataItem)
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadComboItems_forCodigo'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	For Each
		Order forNome
		Where prefCodigo = &prefCodigo and
forStatus = 'A'
		&Combo_DataItem = new()
		&Combo_DataItem.ID = forCodigo.ToString().Trim()
		&Combo_DataItem.Title = forNome
		&Combo_Data.Add(&Combo_DataItem)
	EndFor
	If &TrnMode <> TrnMode.Insert
		For Each Romaneio
			Where prefCodigo = &prefCodigo
			Where romanCodigo = &romanCodigo

			&SelectedValue = iif(forCodigo.IsEmpty(), '', forCodigo.ToString().Trim())
		EndFor
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

]]></Source>
