Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsdistribuicaotipoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsdistribuicaotipoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsdistribuicaotipoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFDISTIPCODIGO"
				&TFdisTipCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTIPCODIGO_SEL"
				&TFdisTipCodigo_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTIPDESCRICAO"
				&TFdisTipDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTIPDESCRICAO_SEL"
				&TFdisTipDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTIPDESCRICAOPLURAL"
				&TFdisTipDescricaoPlural.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTIPDESCRICAOPLURAL_SEL"
				&TFdisTipDescricaoPlural_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFDISTIPDIAS"
				&TFdisTipDias.FromString(&GridStateFilterValue.Value)
				&TFdisTipDias_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFDISTIPSEMANAS"
				&TFdisTipSemanas.FromString(&GridStateFilterValue.Value)
				&TFdisTipSemanas_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFDISTIPREMESSAMES"
				&TFdisTipRemessaMes.FromString(&GridStateFilterValue.Value)
				&TFdisTipRemessaMes_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFDISTIPSTATUS_SEL"
				&TFdisTipStatus_SelsJson = &GridStateFilterValue.Value
				&TFdisTipStatus_Sels.FromJson(&TFdisTipStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'DISTIPCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&disTipCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'DISTIPDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&disTipDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'DISTIPDIAS'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&disTipDias1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'DISTIPNUMERO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&disTipNumero1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'DISTIPSTATUS'
				&disTipStatus1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'DISTIPCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&disTipCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'DISTIPDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&disTipDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'DISTIPDIAS'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&disTipDias2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'DISTIPNUMERO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&disTipNumero2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'DISTIPSTATUS'
					&disTipStatus2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'DISTIPCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&disTipCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'DISTIPDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&disTipDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'DISTIPDIAS'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&disTipDias3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'DISTIPNUMERO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&disTipNumero3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'DISTIPSTATUS'
						&disTipStatus3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

