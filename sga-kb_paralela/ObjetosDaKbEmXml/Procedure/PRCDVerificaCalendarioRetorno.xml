    <Source><![CDATA[&retorno = ''

for each
	where prefCodigo = &prefCodigo
	where calData    = &dia
	      if calFeriado = 'S' or calDiautil = 'N'
		     &retorno = calDescricao
		  endif	  
endFor		  
	      
]]></Source>
