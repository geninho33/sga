  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call(&WWPContext)
&prefCodigo   = &WWPContext.prefCodigo
&ajusCodigo   = PRCDGerarNovoCodigo('AJUSTE')
&tipajuCodigo = 99

new
   ajusCodigo       = &ajusCodigo
   prefCodigo       = &prefCodigo
   ajusUserName     = &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
   ajusData         = serverNow()
   ajusDataCadastro = serverNow()
//   ajusTipo         = &ajusTipo
   ajusOBS          = "Inventário Nr. : " + &ajusCodigo.ToString() +' | '+  &WWPContext.UserName +' | IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
   ajusOBS          = ajusOBS + chr(13) + 'Quantidade Lançado Inventário : ' +  &ajusItemSaldo.ToString()
   ajusLocaCodigo   = &prodLocalCodigo
   ajusStatus       = 'L'
   tipajuCodigo     = &tipajuCodigo
endNew

new
   ajusCodigo         = &ajusCodigo
   prefCodigo         = &prefCodigo
   ajusItemProduto    = &prodCodigo
   ajusItemQuantidade = &ajusItemQuantidade
   // ajustItemUN        = &item.
endnew

PRCDEstoqueMovimentacao(&ajusCodigo, &prodCodigo, &prodLocalCodigo, &ajusItemQuantidade, &ajusTipo, 'N',0)
]]></Source>
