  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// msg(' Codigo :  ' + &estoUeCodigo.ToString() + 
//	' | Saldo : ' + &estoUeSaldo.ToString() + 
//  ' | Local : ' + &locCodigo.ToString() +  
// 	' | Prefeitura : ' + &prefCodigo.ToString() +
//	' | Produto : ' + &prodCodigo.ToString() )

for each
	where prefCodigo      = &prefCodigo
	where estoUeCodigo    = &estoUeCodigo
	where estoUeLocCodigo = &locCodigo
	      if estoUeSaldo <> &estoUeSaldo
	         estoUeSaldo = &estoUeSaldo
		  endif
	when none
	  new 
		  prefCodigo       = &prefCodigo
		  estoUeCodigo     = PRCDGerarNovoCodigo('estoqueUE')
		  estoUeLocCodigo  = &locCodigo
		  estoUeProdCodigo = &prodCodigo
		  estoUeSaldo      = &estoUeSaldo
		  estoUeCadastro   = ServerNow()
		  estoUeAlteracao  = ServerNow()
		  estoUeUserName   = 'IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
		  estoUEQtdeFixa   = 0
	   endNew
endFor
]]></Source>
