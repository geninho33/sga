  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[for each trnsdistribuicao
	// buscando a distribuição de acordo
	// com o local do cronograma
	where prefCodigo       = &prefCodigo
	where distRemCodigo    = &remcodigo
	where distLocalDestino = &locCodigo
	      &distCodigo = distCodigo
		  distObservacao += &distObservacao

		  // Verificando se o produto já foi lançado
		  for each trnsdistribuicaoitens
			  where prefCodigo      = &prefCodigo
			  where distCodigo      = &distCodigo
			  where distItemProduto = &prodCodigo
				    // Se foi lançado
				    // só acrescenta na
				    // distribuição a quantidade
			        distItemQuantidade    = &croLocQtde
			when none
				// Se não foi lançado
				// só acrescenta na
				// distribuição o produto
				new
					prefCodigo         = &prefCodigo
					distCodigo         = &distCodigo
					distItemProduto    = &prodCodigo
					distItemQuantidade = &croLocQtde
					distiItemSaldoAntes  = PRCDBuscarSaldoProdutoUE(&prefCodigo,&prodCodigo,&locCodigo) 
					distiItemSaldoDepois = distiItemSaldoAntes + &croLocQtde					
					distItemPesoTotal  = distItemProdutoPeso*&croLocQtde
				endnew
			endFor
endfor
]]></Source>
