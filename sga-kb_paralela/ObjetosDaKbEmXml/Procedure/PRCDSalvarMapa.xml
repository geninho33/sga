  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
// preparando as variaveis para lançar na auditoria
&AdmLogCha     = &prefCodigo.ToFormattedString() + '-'+  &mapaUeLocCodigo.ToFormattedString() +'-'+ &mapaUeProdCodigo.ToFormattedString()
&prodDescricao = &mapaUeProdCodigo.ToFormattedString() + ' - ' +   find(prodDescricao,prefCodigo = &prefCodigo and prodCodigo = &mapaUeProdCodigo, '' )
&locDescricao  = &mapaUeLocCodigo.ToFormattedString() + ' - ' +   find( locDescricao,prefCodigo = &prefCodigo and locCodigo = &mapaUeLocCodigo, '' )
&AdmLogDad     = 'UE Codigo : ' + &locDescricao + ' - Produto : ' + &prodDescricao + ' - Qtde Atual ' + &mapaUeQuantidade.ToString()

&itens = 0
for each
	where prefCodigo       = &prefCodigo
	where mapaUeData       = &mapaUeData
    where mapaUeLocCodigo  = &mapaUeLocCodigo
	where mapaUeUserName   = 'IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
    where mapaUeProdCodigo = &mapaUeProdCodigo
		  if mapaUeQuantidade <> &mapaUeQuantidade or mapaUeObs <> &mapaUeObs
			 if mapaUeQuantidade <> &mapaUeQuantidade
				PRCDAtualizarEstoqueMapaUE(&prefCodigo,&mapaUeLocCodigo,&mapaUeProdCodigo,mapaUeQuantidade,'E')
			 endif
			 mapaUeObs           = &mapaUeObs
			 mapaUeDataAlteracao = serverNow()
			 mapaUeUserName      = 'IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
			 if mapaUeQuantidade <> &mapaUeQuantidade		    
				&AdmLogDad      += ' - Qtde Anterior: ' + mapaUeQuantidade.ToString()
				mapaUeQuantidade  = &mapaUeQuantidade
				mapaUeSaldoAntes  = PRCDBuscarSaldoProdutoUE(&prefCodigo,&mapaUeProdCodigo,&mapaUeLocCodigo) 
				mapaUeSaldoDepois = &mapaUeQuantidade + PRCDBuscarSaldoProdutoUE(&prefCodigo,&mapaUeProdCodigo,&mapaUeLocCodigo) 
				PRCDAtualizarEstoqueMapaUE(&prefCodigo,&mapaUeLocCodigo,&mapaUeProdCodigo,&mapaUeQuantidade,'S')
			 endif
			 &itens =1
		  endif
   when none
	  if &mapaUeQuantidade <> 0
		  new
			  prefCodigo          = &prefCodigo
			  mapaUeCodigo        = PRCDGerarNovoCodigo('mapaUE')
			  mapaUeData          = &mapaUeData
		      mapaUeLocCodigo     = &mapaUeLocCodigo
		      mapaUeProdCodigo    = &mapaUeProdCodigo
		      mapaUeObs           = &mapaUeObs
			  mapaUeQuantidade    = &mapaUeQuantidade
			  mapaUeDataAlteracao = serverNow()
			  mapaUeUserName      = 'IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
			  mapaUeDataCadastro  = serverNow()			  
			  mapaUeSaldoAntes    = PRCDBuscarSaldoProdutoUE(&prefCodigo,&mapaUeProdCodigo,&mapaUeLocCodigo) 
			  PRCDAtualizarEstoqueMapaUE(&prefCodigo,&mapaUeLocCodigo,&mapaUeProdCodigo,&mapaUeQuantidade,'S')
			  mapaUeSaldoDepois   = PRCDBuscarSaldoProdutoUE(&prefCodigo,&mapaUeProdCodigo,&mapaUeLocCodigo)
			  &AdmLogDad          += ' - Qtde Anterior: 0,00'
		  endnew
		  &itens = 1
	  endif
endFor

PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, &Mode, &AdmLogDad)
]]></Source>
