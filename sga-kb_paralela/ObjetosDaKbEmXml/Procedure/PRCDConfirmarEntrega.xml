  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[// preparando as variaveis para lançar na auditoria

for each
	where prefCodigo = &prefCodigo
	where distCodigo = &distCodigo
	      if &situacao = 'E'
	         distReceber = 'S'
			 distDataRecepcao = Date.Today()
		  else
			 distReceber = 'N'
			 distDataRecepcao = Date.New(1000,01,01)
		  endif
		  // &distLocalDestino = distLocalDestino
		  &locDescricao     = distLocalDestino.ToString() + ' - ' +   find( locDescricao,prefCodigo = &prefCodigo and locCodigo = distLocalDestino, '' )
          &AdmLogCha        = &prefCodigo.ToString().Trim() + '-' + distCodigo.ToString().Trim() + '-' + distLocalDestino.ToString().Trim()
endFor

for each trnsdistribuicaoitens
  where prefCodigo = &prefCodigo
  where distCodigo = &distCodigo
        PRCDAtualiarEstoqueUE(prefCodigo,&distLocalDestino,distItemProduto,distItemQuantidade,&situacao,0,'Unidade')
		&AdmLogDad     = 'Unidade Escolar : ' + &locDescricao
		&prodDescricao = distItemProduto.ToString() + ' - ' +   find(prodDescricao,prefCodigo = &prefCodigo and prodCodigo = distItemProduto, '' )
		&AdmLogDad     += '- Produto : ' + &prodDescricao +	 ' - Qtde : ' + distItemQuantidade.ToString()
		PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, &Mode, &AdmLogDad)
endFor
]]></Source>
