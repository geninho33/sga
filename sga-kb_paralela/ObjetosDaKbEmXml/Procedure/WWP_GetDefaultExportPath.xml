  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
&IsCSharp = False
csharp [!&IsCSharp!] = true;

If &IsCSharp
	&Path = !'PrivateTempStorage' + &File.Separator
	
	&Directory.Source = !'PrivateTempStorage'
	If not &Directory.Exists()
		&Directory.Create()
	EndIf
Else
	&Path = &File.Separator + !"WEB-INF" + &File.Separator
EndIf
]]></Source>
