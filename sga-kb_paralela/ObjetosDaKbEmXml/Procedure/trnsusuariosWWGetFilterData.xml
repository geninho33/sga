	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_USUUSUARIO'
		Do 'LoadusuUsuarioOptions'
	Case &DDOName.ToUpper() = !'DDO_USUNOME'
		Do 'LoadusuNomeOptions'
	Case &DDOName.ToUpper() = !'DDO_USUEMAIL'
		Do 'LoadusuEmailOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsusuariosWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsusuariosWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsusuariosWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFUSUCODIGO"
				&TFusuCodigo.FromString(&GridStateFilterValue.Value)
				&TFusuCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFPREFCODIGO"
				&TFprefCodigo.FromString(&GridStateFilterValue.Value)
				&TFprefCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFUSUUSUARIO"
				&TFusuUsuario.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUSUUSUARIO_SEL"
				&TFusuUsuario_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUSUNOME"
				&TFusuNome.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUSUNOME_SEL"
				&TFusuNome_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUSUCARGO"
				&TFusuCargo.FromString(&GridStateFilterValue.Value)
				&TFusuCargo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFUSUEMAIL"
				&TFusuEmail.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUSUEMAIL_SEL"
				&TFusuEmail_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFUSUSTATUS_SEL"
				&TFusuStatus_SelsJson = &GridStateFilterValue.Value
				&TFusuStatus_Sels.FromJson(&TFusuStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'USUUSUARIO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&usuUsuario1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'USUNOME'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&usuNome1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'USUGUID'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&usuGUID1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'USUEMAIL'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&usuEmail1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PREFCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&prefCodigo1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'USUUSUARIO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&usuUsuario2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'USUNOME'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&usuNome2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'USUGUID'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&usuGUID2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'USUEMAIL'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&usuEmail2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PREFCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&prefCodigo2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'USUUSUARIO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&usuUsuario3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'USUNOME'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&usuNome3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'USUGUID'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&usuGUID3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'USUEMAIL'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&usuEmail3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PREFCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&prefCodigo3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadusuUsuarioOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFusuUsuario = &SearchTxt
	&TFusuUsuario_Sel.SetEmpty()
	For Each trnsusuarios
		Order usuUsuario
		using trnsusuariosWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &usuUsuario1, &usuNome1, &usuGUID1, &usuEmail1
					, &prefCodigo1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &usuUsuario2, &usuNome2
					, &usuGUID2, &usuEmail2, &prefCodigo2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &usuUsuario3, &usuNome3, &usuGUID3, &usuEmail3, &prefCodigo3, &TFusuCodigo
					, &TFusuCodigo_To, &TFprefCodigo, &TFprefCodigo_To, &TFusuUsuario, &TFusuUsuario_Sel, &TFusuNome
					, &TFusuNome_Sel, &TFusuCargo, &TFusuCargo_To, &TFusuEmail, &TFusuEmail_Sel, &TFusuStatus_Sels)

		&count = 0
		For Each trnsusuarios
			Order usuUsuario
			&count += 1
		EndFor
		If not usuUsuario.IsEmpty()
			&Option = usuUsuario
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

