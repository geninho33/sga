Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnsprodutosposicaoWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnsprodutosposicaoWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnsprodutosposicaoWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFPRODQTDEMINIMO"
				&TFprodQtdeMinimo.FromString(&GridStateFilterValue.Value)
				&TFprodQtdeMinimo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFPRODSALDO"
				&TFprodSaldo.FromString(&GridStateFilterValue.Value)
				&TFprodSaldo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFPRODQTDEMAXIMO"
				&TFprodQtdeMaximo.FromString(&GridStateFilterValue.Value)
				&TFprodQtdeMaximo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFPRODCODIGO"
				&TFprodCodigo.FromString(&GridStateFilterValue.Value)
				&TFprodCodigo_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFPRODDESCRICAO"
				&TFprodDescricao.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPRODDESCRICAO_SEL"
				&TFprodDescricao_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPRODUNIDMEDCOMPRA"
				&TFprodUnidMedCompra.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPRODUNIDMEDCOMPRA_SEL"
				&TFprodUnidMedCompra_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPRODTIPO"
				&TFprodTipo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFPRODTIPO_SEL"
				&TFprodTipo_Sel.FromString(&GridStateFilterValue.Value)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'PRODPROGRAMA'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&prodPrograma1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PRODCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&prodCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PRODDESCRICAO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&prodDescricao1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PRODSALDO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&prodSaldo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'PRODTIPO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&prodTipo1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'PRODPROGRAMA'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&prodPrograma2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PRODCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&prodCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PRODDESCRICAO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&prodDescricao2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PRODSALDO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&prodSaldo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'PRODTIPO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&prodTipo2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'PRODPROGRAMA'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&prodPrograma3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PRODCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&prodCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PRODDESCRICAO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&prodDescricao3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PRODSALDO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&prodSaldo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'PRODTIPO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&prodTipo3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadprodDescricaoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFprodDescricao = &SearchTxt
	&TFprodDescricao_Sel.SetEmpty()
	For Each trnsprodutos
		Order prodDescricao
		using trnsprodutosposicaoWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &prodPrograma1, &prodCodigo1, &prodDescricao1, &prodSaldo1
					, &prodTipo1, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &prodPrograma2, &prodCodigo2
					, &prodDescricao2, &prodSaldo2, &prodTipo2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3
					, &prodPrograma3, &prodCodigo3, &prodDescricao3, &prodSaldo3, &prodTipo3, &TFprodQtdeMinimo
					, &TFprodQtdeMinimo_To, &TFprodSaldo, &TFprodSaldo_To, &TFprodQtdeMaximo, &TFprodQtdeMaximo_To, &TFprodCodigo
					, &TFprodCodigo_To, &TFprodDescricao, &TFprodDescricao_Sel, &TFprodUnidMedCompra, &TFprodUnidMedCompra_Sel, &TFprodTipo
					, &TFprodTipo_Sel)
		Where prefCodigo = &prefCodigo
		Where prodStatus = 'A'

		&count = 0
		For Each trnsprodutos
			Order prodDescricao
			&count += 1
		EndFor
		If not prodDescricao.IsEmpty()
			&Option = prodDescricao
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

