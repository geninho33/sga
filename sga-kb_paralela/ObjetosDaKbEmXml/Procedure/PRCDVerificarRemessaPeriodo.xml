  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&retorno = false
&distCodigo = 0

for each
	where prefCodigo            = &prefCodigo
	where distCodigoTipoRemessa = &disTipNumero
	//where strSearch( distObservacao,'Cronograma :  ' + &croCodigo.ToString(),1)>0
	where strSearch( distObservacao,&croDtInicial.ToString(),1)>0
	where strSearch( distObservacao,&croDtFinal.ToString(),1)>0
	      &distCodigo = distCodigo
		  exit
endFor

if &distCodigo<>0
	for each
	    where prefCodigo = &prefCodigo
		where distCodigo = &distCodigo
		where distItemProduto = &prodCodigo
              &retorno = true
	EndFor
endif
]]></Source>
