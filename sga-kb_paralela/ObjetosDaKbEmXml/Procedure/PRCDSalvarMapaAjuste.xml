  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&itens = 0
for each
	where prefCodigo       = &prefCodigo
	where mapaUeData       = &mapaUeData
    where mapaUeLocCodigo  = &mapaUeLocCodigo
    where mapaUeProdCodigo = &mapaUeProdCodigo	
	  if ( mapaUeQtdeAjuste <> &mapaUeQuantidade or mapaUeObsAjuste<>&mapaUeObs ) and mapaUeAjuste<>'C'
		 // PRCDAtualizarEstoqueMapaUE(&prefCodigo,&mapaUeLocCodigo,&mapaUeProdCodigo,mapaUeQuantidade,'E') 
	     mapaUeObsAjuste     = &mapaUeObs
		 mapaUeQtdeAjuste    = &mapaUeQuantidade
		 mapaUeDataAlteracao = serverNow()
		 mapaUeUserName      = 'IP : ' + RemoteAddr() + ' | H:M:S : '+ Time()
		 mapaUeAjuste        = 'A'
		 // PRCDAtualizarEstoqueMapaUE(&prefCodigo,&mapaUeLocCodigo,&mapaUeProdCodigo,&mapaUeQuantidade,'S')
		 &itens =1
	  endif  
endFor	   
	   
]]></Source>
