  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[Do case
	Case &PathAndMethod = "/oauth/gam/access_token - POST"

		&BaseURL = "https://www.sge%1.com.br/rest"

	Case &PathAndMethod = "/Get_TotalAlunosPorUnidadeEscolar - GET" or
		 &PathAndMethod = "/Get_TotalAlunosPorAreaEnsino - GET"

		&BaseURL = "https://www.sge%1.com.br/Totalizadores"
Endcase

LoadWWPContext(&WWPContext)
&BaseURL = format(&BaseURL,&WWPContext.prefCodigo.ToString().Replace(' ','0'))
]]></Source>
