  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&retorno = True

if not &dataSituacaoIni.IsEmpty() or not &dataSituacaofin.IsEmpty()
 	Do Case
	    Case not &dataSituacaoIni.IsEmpty() and &dataSituacaofin.IsEmpty()
	     msg('A data "FINAL" precisa ser informada ! ')
		 &retorno = false
	    Case &dataSituacaoIni.IsEmpty() and not &dataSituacaofin.IsEmpty()
	     msg('A data "INICIAL" precisa ser informada !')
		 &retorno = false
		Case &dataSituacaoIni>&dataSituacaofin
	     msg('A data "INICIAL" é maior que a "FINAL" !')
		 &retorno = false
		Otherwise	 		
	     if  substr( &dataSituacaoIni.ToString(),4,7) <> substr( &remCadastro.ToString(),4,7)
		     &retorno = false
			 msg('A data "INICIAL" não faz parte do mesmo mês e ano do Cardápio ! ')
		 endif	 
	     if  substr( &dataSituacaoFin.ToString(),4,7) <> substr( &remCadastro.ToString(),4,7)
		     &retorno = false
			 msg('A data "FINAL" não faz parte do mesmo mês e ano do Cardápio ! ')
		 endif	 	 
	endCase
endif
]]></Source>
