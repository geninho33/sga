  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&DataIni = ymdtod(&Data.Year(),&Data.Month(),1)
&Semana  = iif(&Data.DayOfWeek() = 1, 0, 1)

do while &DataIni <= &Data
	if &DataIni.DayOfWeek() = 1
		&Semana += 1
	endif
	&DataIni += 1
enddo
	
]]></Source>
