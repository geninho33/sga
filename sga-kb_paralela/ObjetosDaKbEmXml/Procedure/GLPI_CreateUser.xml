  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[	// Declaração de variáveis (devem estar definidas no contexto ou como parâmetros)
	LoadWWPContext( &wwPContext )

    // Declaração de variáveis
    &HttpClient = new()
    &HTTP_URL =  &wwPContext.GLPI_URL + "/User"
    &HTTP_METHOD = "POST"
    &HTTP_STATUS = 0
    &HTTP_RESPONSE = ""
    &USER_ID = 0
    &SUCCESS = False
    &ERROR_MESSAGE = ""

    // Configurar headers
	&HttpClient.AddHeader("App-Token", &wwPContext.APP_TOKEN)	
	&HttpClient.AddHeader("Content-Type", "application/json; charset=UTF-8")

    // payload {"input":{...}}

//	 &BodyJson =
//		'{"input":{'
//		+ '"name":"'        + &wwPContext.login.Trim()     + '",'
//		+ '"realname":"'    + &wwPContext.firstName.Trim() + ' ' + &wwPContext.lastName.Trim() + '",'
//		+ '"firstname":"'   + &wwPContext.firstName.Trim() + '",'
//		+ '"email":"'       + &wwPContext.email.Trim()     + '",'
//		+ '"entities_id":"' + &ENTITY_ID.ToString().Trim() + '"} }'
//
//msg( &BodyJson )

&properties.Set('name',&wwPContext.login.Trim())
&properties.Set('realname', &wwPContext.firstName.Trim() + ' ' + &wwPContext.lastName.Trim() )
&properties.Set('firstname',&wwPContext.firstName.Trim())
&properties.Set('email',&wwPContext.email.Trim())
&properties.Set('entities_id',&ENTITY_ID.ToString().Trim())
&BodyJson = format('{"input":%1}',&properties.ToJson() )

&HttpClient.AddString(&BodyJson)
&HttpClient.Execute(&HTTP_METHOD, &HTTP_URL)

&HTTP_STATUS   = &HttpClient.StatusCode
&HTTP_RESPONSE = &HttpClient.ToString()

If &HTTP_STATUS = 201 or &HTTP_STATUS = 200
    &UserResponse = new()
    &UserResponse.FromJson(&HTTP_RESPONSE)

    If &UserResponse.CurrentItem.id > 0
        &USER_ID = &UserResponse.CurrentItem.id

		if &USER_ID > 0
			&SUCCESS = true
		else
			&SUCCESS = false
		endif

        If &SUCCESS
            Do "salvarUsuario"
        Else
            &ERROR_MESSAGE = !"Sem ID na resposta: " + &HTTP_RESPONSE
        EndIf
    Else
        &SUCCESS = False
        &ERROR_MESSAGE = !"Sem ID na resposta: " + &HTTP_RESPONSE
    EndIf
Else
    &SUCCESS = False
    &ERROR_MESSAGE = !"Erro HTTP: " + &HTTP_STATUS.ToString() + !" - " + &HTTP_RESPONSE
EndIf

Sub "salvarUsuario"
    for each
        where usuUsuario = &wwPContext.login
        where prefCodigo = &wwPContext.prefCodigo
            usuGLPI_USER_ID = &USER_ID
    endfor
EndSub
]]></Source>
