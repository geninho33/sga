  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
&GridState.FromXml(&Session.Get(&ListObjectName + !"GridState"))
&index = 1
Do while &GridState.FilterValues.Count >= &index
	If &GridState.FilterValues.Item(&index).Dsc.Trim().IsEmpty()
		&GridState.FilterValues.Remove(&index)
	Else
		&index += 1
	EndIf
Enddo
&TotalFilters = &GridState.FilterValues.Count + &GridState.DynamicFilters.Count
&AppliedFiltersDescription = ''
If &TotalFilters > 0
	&EmptyDateStr = Trim(&AuxDate.ToFormattedString())
	&EmptyTimeStr = &AuxDateTime.ToFormattedString()
	&EmptyTimeStr = Trim(&EmptyTimeStr.Replace(&EmptyDateStr, ''))
	&index = 1
	For &GridStateFilterValue in &GridState.FilterValues
		&FilterDescription = &GridStateFilterValue.Dsc
		&GridStateFilterValue.ValueDsc = &GridStateFilterValue.ValueDsc.Replace(&EmptyTimeStr, '')
		&GridStateFilterValue.ValueToDsc = &GridStateFilterValue.ValueToDsc.Replace(&EmptyTimeStr, '')
		Do Case
			Case Not &GridStateFilterValue.ValueDsc.IsEmpty() And Not &GridStateFilterValue.ValueToDsc.IsEmpty()
				&FilterDescription += format(" (%1 - %2)", &GridStateFilterValue.ValueDsc, &GridStateFilterValue.ValueToDsc)
			Case Not &GridStateFilterValue.ValueDsc.IsEmpty()
				&FilterDescription += format(" (%1)", &GridStateFilterValue.ValueDsc)
			Case Not &GridStateFilterValue.ValueToDsc.IsEmpty()
				&FilterDescription += format(" (%1)", &GridStateFilterValue.ValueToDsc)
		EndCase
		Do 'Add Filter To Description'
	EndFor

	For &DynamicFiltersItem in &GridState.DynamicFilters
		&FilterDescription = &DynamicFiltersItem.Dsc
		&DynamicFiltersItem.ValueDsc = &DynamicFiltersItem.ValueDsc.Replace(&EmptyTimeStr, '')
		&DynamicFiltersItem.ValueToDsc = &DynamicFiltersItem.ValueToDsc.Replace(&EmptyTimeStr, '')
		Do Case
			Case Not &DynamicFiltersItem.ValueDsc.IsEmpty() And Not &DynamicFiltersItem.ValueToDsc.IsEmpty()
				&FilterDescription += format(" (%1 - %2)", &DynamicFiltersItem.ValueDsc, &DynamicFiltersItem.ValueToDsc)
			Case Not &DynamicFiltersItem.ValueDsc.IsEmpty()
				&FilterDescription += format(" (%1)", &DynamicFiltersItem.ValueDsc)
			Case Not &DynamicFiltersItem.ValueToDsc.IsEmpty()
				&FilterDescription += format(" (%1)", &DynamicFiltersItem.ValueToDsc)
		EndCase
		Do 'Add Filter To Description'
	EndFor
	&AppliedFiltersDescription = format('WWP_FilteringByCaption', &AppliedFiltersDescription)
EndIf

Sub 'Add Filter To Description'
	If &index >= 6
		If &index = 6
			&AppliedFiltersDescription += '...'
		EndIf
	Else
	  If &index > 1
			&AppliedFiltersDescription += iif(&index = &TotalFilters, !' ' + 'WWP_WordsListLastSeparator', 'WWP_WordsListSeparator') + !' '
		EndIf
	  &AppliedFiltersDescription += &FilterDescription
	EndIf
	&index += 1
EndSub
]]></Source>
