  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[&prodPesoConsumo   = PRCDBuscaPesoConsumo(&prefCodigo,&remProdCodigo)
if &distCodigo<>0
	for each
		where prefCodigo 		        = &prefCodigo
		where distCodigo  		        = &distCodigo
		where distItemProduto 	        = &remProdCodigo
		where distItemAreEnsCodigo      = &remProdAreEnsCodigo
	    where distiItemAreEnsSequencial = &remProdAreEnsSequencial
          distItemQuantidade       += &remProdQtde
		  distItemPerCapta          = &remProdPerCapta
		  distItemQtdeVezes        += 1
		  &distItemPesoTotal        = &remProdPerCapta*&remProdQtde
	      distItemPesoTotal        += &distItemPesoTotal
		  // distItemPesoTotal   += prcdceil(&remProdPerCapta*&remProdQtde)
	when none
		new
			prefCodigo 		          = &prefCodigo
			distCodigo  	          = &distCodigo
			distItemProduto           = &remProdCodigo
		    distItemAreEnsCodigo      = &remProdAreEnsCodigo
	        distiItemAreEnsSequencial = &remProdAreEnsSequencial
	        distItemQuantidade        = &remProdQtde
			distiItemSaldoAntes  	  = PRCDBuscarSaldoProdutoUE(&prefCodigo,&remProdCodigo,distItemLocCodigo) 
			distiItemSaldoDepois 	  = distiItemSaldoAntes + &remProdQtde					

			distItemPerCapta          = &remProdPerCapta
			distItemQtdeVezes         = 1
			&distItemPesoTotal        = &remProdPerCapta*&remProdQtde
		    distItemPesoTotal         = &distItemPesoTotal
			distItemStatus            = 'A'
			// distItemPesoTotal   = prcdceil(&remProdPerCapta*&remProdQtde)
		Endnew
	endFor
else
	for each
		where prefCodigo         = &prefCodigo
		where remCodigo  	     = &remCodigo
		where remItemProduto     = &remProdCodigo
		where remItemCodigo      = &remItemCodigo when &remItemCodigo<>0
	      remItemPesoTotal      += &remProdPerCapta
	      if &remProdPerCapta>0 and &prodPesoConsumo>0
	         remItemQtde        += (&remProdPerCapta/&prodPesoConsumo)
	      endif
	when none
		if &remProdPerCapta>0 and &prodPesoConsumo>0
		   &remProdQtde2 = (&remProdPerCapta/&prodPesoConsumo)
		endif
		new
			prefCodigo 		  = &prefCodigo
			remCodigo  		  = &remCodigo
			remItemCodigo     = PRCDGerarNovoCodigo('remessaItem')
			remItemProduto	  = &remProdCodigo
			remItemPesoTotal  = &remProdPerCapta
			remItemPeriodo    = &dataIni.ToString() +  ' a ' + &dataFin.ToString()
		    remItemQtde       = &remProdQtde2
		Endnew
	endFor
endif
]]></Source>
