  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[
&File.Source="log"
//msg("&File: " + &File.GetAbsoluteName(), nowait)

&Directory.Source = &File.GetAbsoluteName()
if not &Directory.Exists()
	&Directory.Create()

	//msg("if", nowait)
else
	//msg("else", nowait)
endif

//msg("&Directory: " + &Directory.GetAbsoluteName(), nowait)


&ServerDate = ServerDate()
&File.Source= &Directory.GetAbsoluteName() + "\log_"+&ServerDate.year().ToString().Trim()+&ServerDate.Month().ToString().PadLeft(2,"0")+&ServerDate.Day().ToString().PadLeft(2,"0")+'.txt'
//msg("&File: " + &File.GetAbsoluteName(), nowait)
if not &File.Exists()
	&File.Create()

	//msg("if", nowait)
else
	//msg("else", nowait)
endif

&Texto += " - " + &Txt


&ServerNow = ServerNow()

&File.OpenWrite()
&File.WriteLine(&ServerNow.ToFormattedString()+ ' ** ' + &programa + ' ** ' + &Texto)
&File.Close()

