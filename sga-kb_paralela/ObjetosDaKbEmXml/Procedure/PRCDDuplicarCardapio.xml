<Object parentGuid="6736cf57-35cb-46a5-97f1-4f72e9d64670" user="DESKTOP-OQ270FR\Geninho" versionDate="2024-10-29T05:27:13.0000000Z" lastUpdate="2024-10-28T13:45:19.0000000Z" checksum="9af21f1c24b601b65b6218de41e1b001" fullyQualifiedName="PRCDDuplicarCardapio" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="63121ef0-4288-4aed-b1e2-f62cd897631b" name="PRCDDuplicarCardapio" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Duplicar Cardápio" parent="Procedures" parentType="00000000-0000-0000-0000-000000000008">
  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call(&WWPContext)

For each
	where prefCodigo   = &prefCodigo
	where carDapCodigo = &carDapCodigo
		&carDapDescricao      = '( Cópia ) ' + carDapDescricao
		&carDapUsuario        = carDapUsuario
		&carDapNutricionista  = carDapNutricionista
		&carDapNutricionista1 = carDapNutricionista1
		&carDapNutricionista2 = carDapNutricionista2
		&carDapNutricionista3 = carDapNutricionista3
		&carDapMesAno         = carDapMesAno
		&carDapNecessidade    = carDapNecessidade
		&carDapLiberarAcesso  = carDapLiberarAcesso
		&carDapStatus         = carDapStatus
		&carDapGruCodigo      = carDapGruCodigo
		&carDapCodigo2        = PRCDGerarNovoCodigo('cardapio')
		new
			prefCodigo 		     = &prefCodigo
			carDapCodigo 		 = &carDapCodigo2
			carDapDescricao      = &carDapDescricao
			carDapUsuario        = &carDapUsuario
			carDapNutricionista  = &carDapNutricionista
			carDapNutricionista1 = &carDapNutricionista1
			carDapNutricionista2 = &carDapNutricionista2
			carDapNutricionista3 = &carDapNutricionista3
			carDapMesAno         = &carDapMesAno
			carDapNecessidade    = &carDapNecessidade
			carDapStatus         = &carDapStatus
			carDapGruCodigo      = &carDapGruCodigo
			carDapLiberarAcesso  = 'N'
			carDapDataCadastro   = serverNow()
			carDapDataAlteracao  = serverNow()
			carDapUsuario        = &WWPContext.UserName
			&AdmLogCha = carDapCodigo.ToFormattedString()
			&AdmLogDad = carDapMesAno.ToFormattedString() + 
			             '-' + carDapNecessidade.ToFormattedString() + 
						 '-' + carDapDescricao.Trim() + 
						 '-' + carDapGruCodigo.ToFormattedString() + 
						 '-' + carDapLiberarAcesso + 
						 '-' + carDapStatus + 
						 ' ! De:' + &carDapCodigo.ToString().Trim() + 
						 ' para: ' + &carDapCodigo2.ToString().Trim()
			PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, 'INS', &AdmLogDad)
		endNew

	For each trnscardapioprato
	  where prefCodigo   = &prefCodigo
	  where carDapCodigo = &carDapCodigo
			&carPratoCodigo   = carPratoCodigo
			&carPratoHorario  = carPratoHorario
			&carPratoData     = carPratoData
			&carPratoRefeicao = carPratoRefeicao
			&carPratoTurno	  = carPratoTurno
			new
				prefCodigo 	     = &prefCodigo
				carDapCodigo     = &carDapCodigo2
				carPratoCodigo   = &carPratoCodigo
				carPratoHorario  = &carPratoHorario
				carPratoData     = &carPratoData
				carPratoRefeicao = &carPratoRefeicao
				carPratoTurno	 = &carPratoTurno
				&AdmLogCha = carDapCodigo.ToString().Trim() + 
				             '-' + 
							 carPratoCodigo.ToString().Trim()
				&AdmLogDad = carPratoCodigo.ToFormattedString() + 
				             '-' + carPratoData.ToFormattedString() + 
							 '-' + carPratoRefeicao.ToFormattedString() + 
							 '-' + carPratoTurno.ToFormattedString() + 
							 '-' + carPratoTurnoHorario.ToFormattedString()
				PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, 'INS', &AdmLogDad)
			endNew
	EndFor
	msg('Duplicação realizada com sucesso !')
EndFor
]]></Source>
