<Object parentGuid="6736cf57-35cb-46a5-97f1-4f72e9d64670" user="DESKTOP-OQ270FR\Geninho" versionDate="2025-06-25T15:51:42.0000000Z" lastUpdate="2025-06-25T03:52:02.0000000Z" checksum="f108f4d401a2bef6e855fc3b3b234fe6" fullyQualifiedName="PRCDEstoqueMovimentacao" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361" guid="a858e0ea-eeb8-4225-9d4f-2b26d1899d01" name="PRCDEstoqueMovimentacao" type="84a12160-f59b-4ad7-a683-ea4481ac23e9" description="Lançamento de Movimentação de Estoque" parent="Procedures" parentType="00000000-0000-0000-0000-000000000008">
  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[LoadWWPContext.Call(&WWPContext)
&saldo 		    = 0
&qtde  		    = &quantidade
&prefCodigo     = &WWPContext.prefCodigo
&estoObservacao = ''

if &tipo.IsEmpty()
   &tipoRT = PRCDBuscarAcaoAjuste(&codigo)
else
   &tipoRT = &tipo
endif

if &locaCodigo = 0
	Do Case
	   Case &tipoRT= 'D' or &tipoRT= 'DD'
			for each
				where prefCodigo = &prefCodigo
				where distCodigo = &codigo
			          &locaCodigoLocal = distLocalOrigem
			endFor
       Case  &tipoRT= 'C' or &tipoRT= 'CC'
			for each
				where notaCodigo = &codigo
				where prefCodigo = &prefCodigo
	              &locaCodigoLocal = notaLocal
			endFor
	  Case  &tipoRT= 'R' or &tipoRT= 'RR'
			for each
				where romanCodigo = &codigo
				where prefCodigo = &prefCodigo
		              &locaCodigoLocal = romanLocal
			endFor
	   Otherwise
			for each
				where estoCodigo = &codigo
				where prefCodigo = &prefCodigo
	                  &locaCodigoLocal = estoLocal
			endFor
	EndCase
else
	&locaCodigoLocal = &locaCodigo
endif

if &locaCodigoLocal = 0
   &locaCodigoLocal = prefLocalDeposito
endif

For each
	where prefCodigo = &prefCodigo
    where prodCodigo = &prodCodigo
	// where prodLocalCodigo = &locaCodigoLocal

          &saldo   = prodSaldo
          &unidade = prodUnidMedCompra
          For each
	          where prefCodigo = &prefCodigo
	          where uniCodigo  = &unidade
	                &uniDescricao = uniDescricao
          EndFor
Endfor

for each
	order prefCodigo, estoNfCodigo,    (estoCodigo) when &tipoRT in ('C','CC')
	order prefCodigo, estoDistCodigo,  (estoCodigo) when &tipoRT in ('D','DD','RM','RD')
	order prefCodigo, estoRomanCodigo, (estoCodigo) when &tipoRT in ('R','RR')
	order prefCodigo, estoAjusCodigo,  (estoCodigo) when not &tipoRT in ('D','C','DD','CC','R','RR','RD','RM')

	where prefCodigo      = &prefCodigo
	where estoNfCodigo    = &codigo when &tipoRT in ('C','CC')
	where estoDistCodigo  = &codigo when &tipoRT in ('D','DD','RM','RD')
	where estoRomanCodigo = &codigo when &tipoRT in ('R','RR')
	where estoAjusCodigo  = &codigo when not &tipoRT in ('D','C','DD','CC','R','RR','RD','RM')
	where estoProduto     = &prodCodigo

	// atualizando o estoque no produto
	&estoCodigo = estoCodigo
    

	Do Case
		Case &tipoRT in ('D','S','RD','RR','DD','RM') and &situacao = 'N'
			if &quantidade <  &QtdeAnterior
			   &qtde     = &QtdeAnterior - &quantidade
			   &estoTipo = 'E'
			else
			  &qtde     = &quantidade - &QtdeAnterior
			  &estoTipo = 'S'
			endif

		Case &tipoRT in ('E','CC','C','R')  and &situacao = 'N'
			if &quantidade < estoQuantidade
				&qtde = &QtdeAnterior - &quantidade
				&estoTipo = 'S'
			else
				&qtde = &quantidade - &QtdeAnterior
				&estoTipo = 'E'
			endif

			// Quando for para excluir registro
		Case &tipoRT in ('D','S','RD','RR','DD','RM') and &situacao = 'I'
			 &qtde     = &quantidade
			 &estoTipo = 'E'
		Case &tipoRT in ('E','CC','C','R')  and &situacao = 'I'
			 &qtde     = &quantidade
			 &estoTipo = 'S'
	EndCase
    exit
endFor

// Lancamento da movimentação
if &estoCodigo<>0
   if &situacao = 'N'
	   &estoObservacao = 'Movimentaco n. ' +
						 &estoCodigo.ToString() +
						 '  | Correção de Quantidade : ' +
						 &QtdeAnterior.ToString()+
						 ' para ' +
						 &quantidade.ToString() +
						 ' | Usuário : ' +
						 GAMUser.GetEmail()
   else
	   &estoObservacao = 'Movimentaco n. ' +
						  &estoCodigo.ToString() +
						 '  | Correção de Quantidade : ' +
						  &QtdeAnterior.ToString()+
						 ' para 0   ( Exclusão )'  +
						 ' | Usuário : ' +
						 GAMUser.GetEmail()
   endif

endif

if &estoTipo.IsEmpty()
   if &tipoRT in ('D','S','RD','RR','DD','RM')	
	  &estoTipo = 'S' 
   else  	  
	  &estoTipo = 'E'  
   endif	  
endif	

new
 	Do Case
	    Case &tipoRT= 'C' or &tipoRT= 'DD'
			 If &tipoRT= 'C'
				estoNfCodigo = &codigo
			 else
				estoDistCodigo = &codigo
			 endif

	    Case &tipoRT=  'D' or &tipoRT= 'CC' or &tipoRT= 'RD'
			 If &tipoRT= 'CC'
				estoNfCodigo = &codigo
			 else
				estoDistCodigo = &codigo
			 endif
	    Case &tipoRT=  'R' or &tipoRT= 'RR'
			 estoRomanCodigo = &codigo
	    Case &tipoRT=  'RM'
	         estoDistCodigo = &codigo
		Otherwise
			 estoAjusCodigo = &codigo
			 if &tipoRT= 'E'
				&tipo2 = 'C'
			 else
				&tipo2 = 'D'
			 endif
	EndCase
	estoTipo         = &estoTipo
	estoCodigo 		 = PRCDGerarNovoCodigo('estoque')
	prefCodigo       = &prefCodigo
	estoLocal        = &locaCodigoLocal
	estoProduto      = &prodCodigo
	estoQuantidade   = &qtde
	estoUnidade      = &unidade
	estoUnidadeSigla = &uniDescricao
	estoSaldo        = &saldo
	estoUserName	 = GAMUser.GetEmail()
	estoObservacao   = &estoObservacao
endNew

//PGeraLog.Call(&Pgmname, 'Produto: ' + &prodCodigo.ToString().Trim() + '-' + 'Local: ' + &locaCodigoLocal.ToString().Trim() + '-' + 'Qtdade: ' + &Quantidade.ToString().Trim() + '-' + 'Tipo In: ' + &tipo2 + '-' + 'Situação: ' + &situacao + '-' + 'Tipo Out: ' + &tipo2)
//PRCDEstoqueAtualizar(&prodCodigo,&locaCodigoLocal,&quantidade,&estoTipo)
PRCDEstoqueAtualizar(&prodCodigo,&locaCodigoLocal,&qtde,&estoTipo)
&retorno = 'A'
]]></Source>
