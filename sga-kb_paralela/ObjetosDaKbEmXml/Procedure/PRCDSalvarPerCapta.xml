  <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
    <Source><![CDATA[for each
  where prefCodigo         = &prefCodigo
	where pratoCodigo        = &pratoCodigo
	where pratIngrProdCodigo = &pratIngrProdCodigo
	where AreEnsCodigo       = &AreEnsCodigo
	where AreEnsSequencial   = &AreEnsSequencial
  if pratIngrQuantidade <> &pratIngrQuantidade
    pratIngrQuantidade = &pratIngrQuantidade
	  pratIngrDataAlt    = serverNow()
		&carGruTurno       = carGruTurno
		&AdmLogCha = &pratoCodigo.ToString().Trim() + '-' + &pratIngrProdCodigo.ToString().Trim() + '-' + &AreEnsCodigo.ToString().Trim() + '-' + &AreEnsSequencial.ToString().Trim() + '-' + &carGruTurno.ToString().Trim()
		&AdmLogDad = &pratIngrProdCodigo.ToFormattedString() + '-' + &AreEnsCodigo.ToFormattedString() + '-' + &AreEnsSequencial.ToString().Trim() + '-' + &carGruTurno.ToFormattedString() + '-' + &pratIngrQuantidade.ToFormattedString() + '-' + Status.Ativo		
		PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, 'UPD', &AdmLogDad)
  endif
when none
	new
    prefCodigo		   	 = &prefCodigo
		pratoCodigo        = &pratoCodigo
		pratIngrProdCodigo = &pratIngrProdCodigo
		AreEnsCodigo       = &AreEnsCodigo
		AreEnsSequencial   = &AreEnsSequencial
    pratIngrQuantidade = &pratIngrQuantidade
		carGruTurno        = turno.Int
		&carGruTurno       = carGruTurno
		pratIngrStatus     = Status.Ativo
		pratIngrDataCad = serverNow()
    pratIngrDataAlt = serverNow()
		&AdmLogCha = &pratoCodigo.ToString().Trim() + '-' + &pratIngrProdCodigo.ToString().Trim() + '-' + &AreEnsCodigo.ToString().Trim() + '-' + &AreEnsSequencial.ToString().Trim() + '-' + &carGruTurno.ToString().Trim()
		&AdmLogDad = &pratIngrProdCodigo.ToFormattedString() + '-' + &AreEnsCodigo.ToFormattedString() + '-' + &AreEnsSequencial.ToString().Trim() + '-' + &carGruTurno.ToFormattedString() + '-' + &pratIngrQuantidade.ToFormattedString() + '-' + Status.Ativo		
		PRC_AliEscGravaLog(&AdmLogCha, &Pgmname, 'INS', &AdmLogDad)
	endNew
endFor
]]></Source>
