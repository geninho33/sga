	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

&Options = new()
&OptionsDesc = new()
&OptionIndexes = new()
LoadWWPContext.Call(&WWPContext)

Do 'LoadGridState'
Do Case
	Case &DDOName.ToUpper() = !'DDO_SALALOCCODIGO'
		Do 'LoadsalaLocCodigoOptions'
	Case &DDOName.ToUpper() = !'DDO_SALANUMERO'
		Do 'LoadsalaNumeroOptions'
EndCase

&OptionsJson = &Options.ToJson()
&OptionsDescJson = &OptionsDesc.ToJson()
&OptionIndexesJson = &OptionIndexes.ToJson()

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */


Sub 'LoadGridState'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	// Load grid state from session.
	If &Session.Get(!"trnssalasWWGridState") = !""
		&GridState.FromXml(LoadGridState.Udp(!"trnssalasWWGridState"))
	Else
		&GridState.FromXml(&Session.Get(!"trnssalasWWGridState"))
	Endif	

	For &GridStateFilterValue in &GridState.FilterValues
		Do Case
			Case &GridStateFilterValue.Name = !"TFSALALOCCODIGO"
				&TFsalaLocCodigo.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFSALALOCCODIGO_SEL"
				&TFsalaLocCodigo_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFSALANUMERO"
				&TFsalaNumero.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFSALANUMERO_SEL"
				&TFsalaNumero_Sel.FromString(&GridStateFilterValue.Value)
			Case &GridStateFilterValue.Name = !"TFSALATURNO_SEL"
				&TFsalaTurno_SelsJson = &GridStateFilterValue.Value
				&TFsalaTurno_Sels.FromJson(&TFsalaTurno_SelsJson)
			Case &GridStateFilterValue.Name = !"TFSALAALUNOS"
				&TFsalaAlunos.FromString(&GridStateFilterValue.Value)
				&TFsalaAlunos_To.FromString(&GridStateFilterValue.ValueTo)
			Case &GridStateFilterValue.Name = !"TFSALASTATUS_SEL"
				&TFsalaStatus_SelsJson = &GridStateFilterValue.Value
				&TFsalaStatus_Sels.FromJson(&TFsalaStatus_SelsJson)
		EndCase
	EndFor
	If &GridState.DynamicFilters.Count >= 1
		&GridStateDynamicFilter = &GridState.DynamicFilters.Item(1)
		&DynamicFiltersSelector1 = &GridStateDynamicFilter.Selected
		Do Case
			Case &DynamicFiltersSelector1 = !'SALATURNO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&salaTurno1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'SALALOCCODIGO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&salaLocCodigo1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'SALANUMERO'
				&DynamicFiltersOperator1 = &GridStateDynamicFilter.Operator
				&salaNumero1.FromString(&GridStateDynamicFilter.Value)
			Case &DynamicFiltersSelector1 = !'SALASTATUS'
				&salaStatus1.FromString(&GridStateDynamicFilter.Value)
		EndCase
		If &GridState.DynamicFilters.Count >= 2
			&DynamicFiltersEnabled2 = True
			&GridStateDynamicFilter = &GridState.DynamicFilters.Item(2)
			&DynamicFiltersSelector2 = &GridStateDynamicFilter.Selected
			Do Case
				Case &DynamicFiltersSelector2 = !'SALATURNO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&salaTurno2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'SALALOCCODIGO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&salaLocCodigo2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'SALANUMERO'
					&DynamicFiltersOperator2 = &GridStateDynamicFilter.Operator
					&salaNumero2.FromString(&GridStateDynamicFilter.Value)
				Case &DynamicFiltersSelector2 = !'SALASTATUS'
					&salaStatus2.FromString(&GridStateDynamicFilter.Value)
			EndCase
			If &GridState.DynamicFilters.Count >= 3
				&DynamicFiltersEnabled3 = True
				&GridStateDynamicFilter = &GridState.DynamicFilters.Item(3)
				&DynamicFiltersSelector3 = &GridStateDynamicFilter.Selected
				Do Case
					Case &DynamicFiltersSelector3 = !'SALATURNO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&salaTurno3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'SALALOCCODIGO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&salaLocCodigo3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'SALANUMERO'
						&DynamicFiltersOperator3 = &GridStateDynamicFilter.Operator
						&salaNumero3.FromString(&GridStateDynamicFilter.Value)
					Case &DynamicFiltersSelector3 = !'SALASTATUS'
						&salaStatus3.FromString(&GridStateDynamicFilter.Value)
				EndCase
			EndIf
		EndIf
	EndIf

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadsalaLocCodigoOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFsalaLocCodigo = &SearchTxt
	&TFsalaLocCodigo_Sel.SetEmpty()
	For Each trnssalas
		Order salaLocCodigo
		using trnssalasWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &salaTurno1, &salaLocCodigo1, &salaNumero1, &salaStatus1
					, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &salaTurno2, &salaLocCodigo2, &salaNumero2
					, &salaStatus2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &salaTurno3, &salaLocCodigo3
					, &salaNumero3, &salaStatus3, &TFsalaLocCodigo, &TFsalaLocCodigo_Sel, &TFsalaNumero, &TFsalaNumero_Sel
					, &TFsalaTurno_Sels, &TFsalaAlunos, &TFsalaAlunos_To, &TFsalaStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnssalas
			Order salaLocCodigo
			&count += 1
		EndFor
		If not locDescricao.IsEmpty()
			&Option = salaLocCodigo.ToString()
			&OptionDesc = locDescricao
			
			&InsertIndex = 1
			Do while &InsertIndex <= &Options.Count AND &OptionsDesc.Item(&InsertIndex) < &OptionDesc
				&InsertIndex = &InsertIndex + 1
			EndDo
			&Options.Add(&Option, &InsertIndex)
			&OptionsDesc.Add(&OptionDesc, &InsertIndex)
			&OptionIndexes.Add(trim(&count.ToFormattedString()), &InsertIndex)
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

Sub 'LoadsalaNumeroOptions'

	/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */

	&TFsalaNumero = &SearchTxt
	&TFsalaNumero_Sel.SetEmpty()
	For Each trnssalas
		Order salaNumero
		using trnssalasWWDS(&DynamicFiltersSelector1, &DynamicFiltersOperator1, &salaTurno1, &salaLocCodigo1, &salaNumero1, &salaStatus1
					, &DynamicFiltersEnabled2, &DynamicFiltersSelector2, &DynamicFiltersOperator2, &salaTurno2, &salaLocCodigo2, &salaNumero2
					, &salaStatus2, &DynamicFiltersEnabled3, &DynamicFiltersSelector3, &DynamicFiltersOperator3, &salaTurno3, &salaLocCodigo3
					, &salaNumero3, &salaStatus3, &TFsalaLocCodigo, &TFsalaLocCodigo_Sel, &TFsalaNumero, &TFsalaNumero_Sel
					, &TFsalaTurno_Sels, &TFsalaAlunos, &TFsalaAlunos_To, &TFsalaStatus_Sels)
		Where prefCodigo = &prefCodigo

		&count = 0
		For Each trnssalas
			Order salaNumero
			&count += 1
		EndFor
		If not salaNumero.IsEmpty()
			&Option = salaNumero
			
			&Options.Add(&Option)
			&OptionIndexes.Add(trim(&count.ToFormattedString()))
		EndIf
		If &Options.Count = 50
			Exit
		EndIf
	EndFor

	/* Generated by DVelop Work With Plus Pattern [End] - Do not change */

EndSub

